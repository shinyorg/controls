@namespace Shiny.Blazor.Controls.Office
@using Shiny.Blazor.Controls
@using Shiny.Controls.Office.Icons
@using Shiny.Controls.Office.Spreadsheet
@using Shiny.Controls.Office.Spreadsheet.Calc
@using Shiny.Controls.Office.Spreadsheet.View
@implements IDisposable

@*
    The formatting bar above a SpreadsheetView.

    Two tabs. Home is what any editor has - clipboard, font, alignment, number formats and the editing
    commands - and Data is what only a spreadsheet has: rows and columns in and out, column widths and
    visibility, and the function library. The second tab is why this is its own control rather than a
    copy of the document toolbar.

    The split is by what a command changes, not by how often it is reached: Home changes how a cell
    looks, Data changes the shape of the sheet under it.

    Everything goes through SpreadsheetController, so a button here raises the same undoable command a
    keyboard shortcut would - not a second path into the workbook. It also means the bar works on its
    own: hand it `view.Controller` and put it wherever the app's chrome belongs.
*@
@*
    The wrapper is not decoration. This file's scoped rules are written `.sheet-toolbar ::deep .x`,
    which compiles to `.sheet-toolbar[scope-of-this-file] .x` - so the class has to sit on an element
    declared *here*. Passing it to the ribbon as CssClass puts it on the ribbon's own root, which
    carries the ribbon's scope id instead, and every rule in this stylesheet silently stops matching:
    the buttons then fell through to whatever the host app styles a bare <button> as.
*@
<div class="sheet-toolbar @Class" style="@Style">
<Ribbon ShowTabStrip="ShowTabs"
        HeaderBackgroundColor="@AccentBackground"
        HeaderForegroundColor="@AccentInk"
        AccentColor="@AccentInk"
        AllowCollapse="ShowTabs"
        SmallItemRows="2">
    <QuickAccess>
        @* Undo and redo apply whatever the selection is, so they sit outside the groups. *@
        <RibbonButton Size="RibbonItemSize.Small" Tooltip="Undo" Icon="@Ico(OfficeIcon.Undo)"
                      Disabled="@(Disabled || !(Controller?.CanUndo ?? false))" Clicked="() => Run(c => c.Undo())" />
        <RibbonButton Size="RibbonItemSize.Small" Tooltip="Redo" Icon="@Ico(OfficeIcon.Redo)"
                      Disabled="@(Disabled || !(Controller?.CanRedo ?? false))" Clicked="() => Run(c => c.Redo())" />
    </QuickAccess>

    <ChildContent>
        <RibbonTab Title="Home" Key="home">

            @* Clipboard leads, as it does in Excel: cut/copy/paste apply to whatever is selected and
               are reached far more often than any formatting command. *@
            @* Paste is large and the other two stack beside it - Excel's own arrangement, and the
               shape three items want: filling two-deep columns left copy alone in a second column
               with a hole under it. *@
            <RibbonGroup Title="Clipboard" Priority="110">
                <RibbonButton Text="Paste" Tooltip="Paste"
                              Icon="@Ico(OfficeIcon.Paste)"
                              Disabled="@(Disabled || !(Controller?.CanPaste ?? false))"
                              Clicked="() => Run(c => c.Paste())" />
                <RibbonButton Size="RibbonItemSize.Small" Tooltip="Cut" Icon="@Ico(OfficeIcon.Cut)"
                              Disabled="Disabled" Clicked="() => Run(c => c.Cut())" />
                <RibbonButton Size="RibbonItemSize.Small" Tooltip="Copy" Icon="@Ico(OfficeIcon.Copy)"
                              Disabled="Disabled" Clicked="() => Run(c => c.Copy())" />
            </RibbonGroup>

            @* Rows, which is how Excel's Font group is arranged: the two boxes on top, the run of
               marks underneath. Filling columns instead put bold above italic and underline above
               strikethrough, and forced the font picker to share a column with a toggle - where the
               column took the picker's width and stretched the 16px B across all of it. *@
            <RibbonGroup Title="Font" Priority="100">
                <RibbonRow>
                <RibbonContent Size="RibbonItemSize.Small">
                    <FontPickerButton AvailableFonts="FontFamilies"
                                      SelectedFont="@Format.FontName"
                                      Disabled="Disabled"
                                      SelectedFontChanged="OnFontChanged" />
                </RibbonContent>
                <RibbonContent Size="RibbonItemSize.Small">
                    <FontSizePickerButton AvailableFontSizes="FontSizes"
                                          SelectedFontSize="Format.FontSize"
                                          Disabled="Disabled"
                                          SelectedFontSizeChanged="OnSizeChanged" />
                </RibbonContent>
                </RibbonRow>

                <RibbonRow>
                <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Bold" Icon="@Ico(OfficeIcon.Bold)"
                                    Checked="Format.Bold" Disabled="Disabled" Clicked="_ => Run(c => c.ToggleBold())" />
                <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Italic" Icon="@Ico(OfficeIcon.Italic)"
                                    Checked="Format.Italic" Disabled="Disabled" Clicked="_ => Run(c => c.ToggleItalic())" />
                <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Underline" Icon="@Ico(OfficeIcon.Underline)"
                                    Checked="Format.Underline" Disabled="Disabled" Clicked="_ => Run(c => c.ToggleUnderline())" />
                <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Strikethrough" Icon="@Ico(OfficeIcon.Strikethrough)"
                                    Checked="Format.Strike" Disabled="Disabled" Clicked="_ => Run(c => c.ToggleStrikethrough())" />

                <RibbonSeparator />

                @* Both are pickers with their own popup, so they are hosted rather than made into
                   ribbon buttons - a ribbon button cannot own a colour surface. Sized to the row: a
                   solid swatch is the heaviest mark on the bar, and at the picker's own 30px beside
                   16px glyphs it read as the one thing on the ribbon that had gone wrong. *@
                <RibbonContent Size="RibbonItemSize.Small">
                    <ColorPickerButton Text="Text colour"
                                       SelectedColor="@ColorHex"
                                       ShowOpacity="false"
                                       Disabled="Disabled"
                                       Style="--shiny-picker-height: 24px"
                                       SelectedColorChanged="OnColorChanged" />
                </RibbonContent>
                <RibbonContent Size="RibbonItemSize.Small">
                    <SpreadsheetFillButton Current="FillOrNull"
                                           Disabled="Disabled"
                                           ShowTooltips="ShowTooltips"
                                           Picked="OnFillPicked" />
                </RibbonContent>
                </RibbonRow>
            </RibbonGroup>

            @*
                Excel's own two rows: how the text sits in the cell top-to-bottom on one, left-to-right
                on the other, with the things that nudge it inside that box at the end of each. Filling
                columns turned three runs of three into a 2xN grid that read align-left / align-right
                down the first column, and put the wrap toggle under an indent arrow.
            *@
            <RibbonGroup Title="Alignment" Priority="90">
                <RibbonRow>
                    <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Align top" Icon="@Ico(OfficeIcon.AlignTop)"
                                        Checked="@(Format.VerticalAlignment == CellVerticalAlignment.Top)" Disabled="Disabled"
                                        Clicked="_ => Run(c => c.SetVerticalAlignment(CellVerticalAlignment.Top))" />
                    <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Align middle" Icon="@Ico(OfficeIcon.AlignMiddle)"
                                        Checked="@(Format.VerticalAlignment == CellVerticalAlignment.Center)" Disabled="Disabled"
                                        Clicked="_ => Run(c => c.SetVerticalAlignment(CellVerticalAlignment.Center))" />
                    <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Align bottom" Icon="@Ico(OfficeIcon.AlignBottom)"
                                        Checked="@(Format.VerticalAlignment == CellVerticalAlignment.Bottom)" Disabled="Disabled"
                                        Clicked="_ => Run(c => c.SetVerticalAlignment(CellVerticalAlignment.Bottom))" />

                    @* Wrapping is about the height the text takes in the cell, which is what the row
                       above it is about. *@
                    <RibbonSeparator />

                    <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Wrap text" Icon="@Ico(OfficeIcon.WrapText)"
                                        Checked="Format.WrapText" Disabled="Disabled" Clicked="_ => Run(c => c.ToggleWrapText())" />
                </RibbonRow>

                <RibbonRow>
                    <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Align left" Icon="@Ico(OfficeIcon.AlignLeft)"
                                        Checked="@(Format.HorizontalAlignment == CellHorizontalAlignment.Left)" Disabled="Disabled"
                                        Clicked="_ => Run(c => c.SetAlignment(CellHorizontalAlignment.Left))" />
                    <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Centre" Icon="@Ico(OfficeIcon.AlignCenter)"
                                        Checked="@(Format.HorizontalAlignment == CellHorizontalAlignment.Center)" Disabled="Disabled"
                                        Clicked="_ => Run(c => c.SetAlignment(CellHorizontalAlignment.Center))" />
                    <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Align right" Icon="@Ico(OfficeIcon.AlignRight)"
                                        Checked="@(Format.HorizontalAlignment == CellHorizontalAlignment.Right)" Disabled="Disabled"
                                        Clicked="_ => Run(c => c.SetAlignment(CellHorizontalAlignment.Right))" />

                    @* The indent pair moves text inside the cell it is already aligned in, which is a
                       third thing again - and the two arrows are close enough to the alignment marks
                       to need the break. *@
                    <RibbonSeparator />

                    <RibbonButton Size="RibbonItemSize.Small" Tooltip="Decrease indent" Icon="@Ico(OfficeIcon.Outdent)"
                                  Disabled="Disabled" Clicked="() => Run(c => c.AdjustIndent(-1))" />
                    <RibbonButton Size="RibbonItemSize.Small" Tooltip="Increase indent" Icon="@Ico(OfficeIcon.Indent)"
                                  Disabled="Disabled" Clicked="() => Run(c => c.AdjustIndent(1))" />
                </RibbonRow>
            </RibbonGroup>

            @* The named formats on top and the four marks that nudge one underneath - Excel's
               arrangement. Filling columns put "Formats" in a column of its own with a hole beneath
               it, and split the decimal pair across two columns. *@
            <RibbonGroup Title="Number" Priority="80">
                <RibbonRow>
                    @* Was a hand-rolled chevron button over a backdrop and an absolutely positioned
                       panel. A ribbon menu button is the same thing with the dismissal, keyboard and
                       flipping already handled.

                       No icon, deliberately: the only mark that fits is the currency one sitting on
                       the row below, and the same glyph twice in one group reads as a duplicated
                       command. The label and the chevron say what it is. *@
                    <RibbonMenuButton Size="RibbonItemSize.Small" Text="Formats" Tooltip="More number formats"
                                      Disabled="Disabled" Menu="FormatMenu" />
                </RibbonRow>

                <RibbonRow>
                <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Currency" Icon="@Ico(OfficeIcon.Currency)"
                                    Checked="@(Preset == NumberFormatPreset.Currency)" Disabled="Disabled"
                                    Clicked="_ => Run(c => c.SetNumberFormat(NumberFormatPreset.Currency))" />
                <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Percent" Icon="@Ico(OfficeIcon.Percent)"
                                    Checked="@(Preset == NumberFormatPreset.Percent)" Disabled="Disabled"
                                    Clicked="_ => Run(c => c.SetNumberFormat(NumberFormatPreset.Percent))" />
                <RibbonButton Size="RibbonItemSize.Small" Tooltip="Fewer decimal places" Icon="@Ico(OfficeIcon.DecimalDecrease)"
                              Disabled="Disabled" Clicked="() => Run(c => c.AdjustDecimals(-1))" />
                <RibbonButton Size="RibbonItemSize.Small" Tooltip="More decimal places" Icon="@Ico(OfficeIcon.DecimalIncrease)"
                              Disabled="Disabled" Clicked="() => Run(c => c.AdjustDecimals(1))" />
                </RibbonRow>
            </RibbonGroup>

            <RibbonGroup Title="Editing" Priority="70">
                @* AutoSum stays a split button: totalling a column is the common case by a wide margin,
                   and making it a menu choice would put a click in front of it every time. It is on
                   both tabs, as it is in Excel - the face of this group and the head of the Data tab's
                   function library. It is the one command here reached often enough that a tab switch
                   in front of it would be felt. *@
                <RibbonSplitButton Text="AutoSum" Tooltip="AutoSum"
                                   Icon="@Ico(OfficeIcon.Sum)" Disabled="Disabled"
                                   Clicked="() => Run(c => c.ApplyAutoFunction(AutoFunction.Sum))"
                                   Menu="FunctionMenu" />

                <RibbonButton Size="RibbonItemSize.Small" Tooltip="Clear contents"
                              Icon="@Ico(OfficeIcon.Delete)" Disabled="Disabled" Clicked="() => Run(c => c.ClearSelection())" />
                <RibbonButton Size="RibbonItemSize.Small" Tooltip="Clear formatting"
                              Icon="@Ico(OfficeIcon.ClearFormat)" Disabled="Disabled" Clicked="() => Run(c => c.ClearFormatting())" />
            </RibbonGroup>

            @*
                Its own group rather than a fourth item in Editing: finding changes nothing, and the
                box is as wide as the three buttons beside it put together. Last on Home, which is what
                decides the order groups fold into the overflow in on a narrow window - and not gated
                on Disabled, because a read-only workbook can still be searched.
            *@
            <RibbonGroup Title="Find" Priority="65">
                @* Large: the bar is one control as tall as the group, and on a row of its own it left
                   the row underneath empty for the width of a search box. *@
                <RibbonContent>
                    <OfficeFindBar Find="@Controller?.Find"
                                   ShowTooltips="ShowTooltips"
                                   Moved="StateHasChanged" />
                </RibbonContent>
            </RibbonGroup>

            @if (ToolbarContent != null)
            {
                @* Never folds into an overflow button: whatever the host added is theirs, and it is
                   not for this control to decide it is the least important thing on the bar. It goes
                   on Home rather than a tab of its own, so a host's commands are on the tab that
                   opens. *@
                <RibbonGroup Title="@ToolbarContentTitle" Priority="200" CanCollapse="false">
                    <RibbonContent>@ToolbarContent</RibbonContent>
                </RibbonGroup>
            }

            @if (!ShowTabs)
            {
                @* With the strip hidden there is only ever the first tab, so the structural groups
                   come back onto it rather than becoming unreachable. The ribbon folds groups into
                   overflow buttons worst-first when the bar runs out of room, which is what makes one
                   crowded tab survivable and a second unreachable one not. *@
                @DataGroups
            }
        </RibbonTab>

        @if (ShowTabs)
        {
            @* Everything that changes the shape of the sheet rather than the look of a cell. All of it
               was on Home, where insert-row sat between clear-formatting and a colour picker; with one
               tab the structural commands could never grow past the two that fitted. *@
            <RibbonTab Title="Data" Key="data">
                @DataGroups
            </RibbonTab>
        }
    </ChildContent>
</Ribbon>
</div>

@code {
    SpreadsheetController? attached;

    /// <summary>The presets on offer, in the order the MAUI toolbar's action sheet lists them.</summary>
    static readonly NumberFormatPreset[] Presets =
    [
        NumberFormatPreset.General,
        NumberFormatPreset.Number,
        NumberFormatPreset.Currency,
        NumberFormatPreset.Percent,
        NumberFormatPreset.Scientific,
        NumberFormatPreset.ShortDate,
        NumberFormatPreset.Time,
        NumberFormatPreset.Text
    ];

    static readonly AutoFunction[] Functions =
    [
        AutoFunction.Sum,
        AutoFunction.Average,
        AutoFunction.Count,
        AutoFunction.Min,
        AutoFunction.Max
    ];

    /// <summary>The grid this bar drives. Set by <see cref="SpreadsheetView"/>, or by a host directly.</summary>
    [Parameter, EditorRequired] public SpreadsheetController? Controller { get; set; }

    /// <summary>Shows the current formatting but refuses to change it.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Whether the icon-only buttons carry a hover tooltip.
    /// </summary>
    /// <remarks>
    /// On by default, and the tooltip is the only place these commands are named. Turning it off falls
    /// back to the browser's own <c>title</c>; either way the buttons keep an aria-label.
    /// </remarks>
    [Parameter] public bool ShowTooltips { get; set; } = true;

    [Parameter] public IReadOnlyList<string> FontFamilies { get; set; } =
    [
        "Calibri", "Cambria", "Arial", "Times New Roman", "Georgia", "Verdana", "Courier New"
    ];

    [Parameter] public IReadOnlyList<double> FontSizes { get; set; } =
    [
        8, 9, 10, 11, 12, 14, 16, 18, 20, 24, 28, 36, 48, 72
    ];

    /// <summary>Extra items appended after the built-in controls.</summary>
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    /// <summary>Group title for <see cref="ToolbarContent"/>.</summary>
    [Parameter] public string ToolbarContentTitle { get; set; } = "Actions";

    /// <summary>
    /// Whether the bar shows the ribbon's tab strip, and with it the collapse chevron.
    /// </summary>
    /// <remarks>
    /// <para>
    /// On by default, which is a change: it was off while there was a single "Home" to show, and a
    /// strip carrying one tab is noise. There are two now, and the strip is the only way to reach the
    /// second.
    /// </para>
    /// <para>
    /// Turning it off does not hide the Data tab's commands - it folds them back onto the one tab,
    /// where the ribbon's own group collapsing deals with the width. A hidden strip that also hid a
    /// third of the bar would be a setting that quietly removes commands.
    /// </para>
    /// </remarks>
    [Parameter] public bool ShowTabs { get; set; } = true;

    [Parameter] public string? Class { get; set; }

    [Parameter] public string? Style { get; set; }

    /// <summary>Raised after a command runs, so a host can repaint and track the dirty state.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    bool Disabled => this.ReadOnly || this.Controller is null;

    /// <summary>The active cell's formatting — what every toggle in the bar shows the state of.</summary>
    ResolvedFormat Format => this.Controller?.ActiveFormat ?? ResolvedFormat.Default;

    NumberFormatPreset? Preset => NumberFormats.PresetOf(this.Format.NumberFormatCode);

    string ColorHex => OfficeColors.ToHex(this.Format.Foreground);

    /// <summary>The fill, as the highlight button takes it: null when the cell has none.</summary>
    ArgbColor? FillOrNull => this.Format.Background.IsTransparent ? null : this.Format.Background;

    TooltipTrigger TooltipMode => this.ShowTooltips ? TooltipTrigger.HoverOrFocus : TooltipTrigger.Manual;

    /// <summary>
    /// A shared-set icon as the ribbon takes it - inline SVG markup rather than a MarkupString.
    /// </summary>
    static string Ico(OfficeIcon icon) => OfficeToolbarIcons.Get(icon).Value;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(this.attached, this.Controller))
            return;

        // Subscribed rather than redrawn from the parent's render, because moving the selection with
        // the arrow keys never re-renders this component - and the bar would then go on showing the
        // formatting of a cell the user left several keystrokes ago.
        this.Detach();
        this.attached = this.Controller;

        if (this.attached is not null)
            this.attached.Changed += this.OnControllerChanged;
    }

    void OnControllerChanged(object? sender, EventArgs e) => this.InvokeAsync(this.StateHasChanged);

    async Task Run(Action<SpreadsheetController> action)
    {
        if (this.Controller is not { } controller || this.Disabled)
            return;

        action(controller);
        await this.RaiseChangedAsync();
    }

    Task OnFontChanged(string family)
        => family is { Length: > 0 } ? this.Run(c => c.SetFontFamily(family)) : Task.CompletedTask;

    Task OnSizeChanged(double size)
        => size > 0 ? this.Run(c => c.SetFontSize(size)) : Task.CompletedTask;

    Task OnColorChanged(string hex)
        => OfficeColors.TryParse(hex, out var color) ? this.Run(c => c.SetTextColor(color)) : Task.CompletedTask;

    Task OnFillPicked(ArgbColor? color) => this.Run(c => c.SetFillColor(color));

    /// <summary>The number-format presets, as ribbon menu lines with a live sample of each.</summary>
    List<RibbonMenuEntry> FormatMenu => Presets
        .Select(preset => new RibbonMenuEntry
        {
            Text = $"{NumberFormats.DisplayName(preset)}   {this.SampleOf(preset)}",
            IsChecked = this.Preset == preset,
            IsDisabled = this.Disabled,
            OnClick = EventCallback.Factory.Create(this, () => this.Run(c => c.SetNumberFormat(preset)))
        })
        .ToList();

    List<RibbonMenuEntry> FunctionMenu => Functions
        .Select(function => new RibbonMenuEntry
        {
            Text = $"{AutoFunctions.DisplayName(function)}   {AutoFunctions.NameOf(function)}",
            IsDisabled = this.Disabled,
            OnClick = EventCallback.Factory.Create(this, () => this.Run(c => c.ApplyAutoFunction(function)))
        })
        .ToList();

    /// <summary>The widths behind the fit-to-contents button, with what each one measures.</summary>
    /// <remarks>
    /// The pixel width is beside the name for the same reason the format menu carries a live sample:
    /// "Wide" on its own is a promise the reader cannot check.
    /// </remarks>
    List<RibbonMenuEntry> WidthMenu => ColumnWidthPresets.All
        .Select(preset => new RibbonMenuEntry
        {
            Text = $"{preset.Name}   {ColumnWidthPresets.PixelsOf(preset.Characters):0} px",
            IsDisabled = this.Disabled,
            OnClick = EventCallback.Factory.Create(this, () => this.Run(c => c.SetColumnWidth(ColumnWidthPresets.PixelsOf(preset.Characters))))
        })
        .ToList();

    /// <summary>The mark for an aggregate. Sum's sigma is shared with the AutoSum split button.</summary>
    static OfficeIcon IconOf(AutoFunction function) => function switch
    {
        AutoFunction.Average => OfficeIcon.Average,
        AutoFunction.Count => OfficeIcon.Count,
        AutoFunction.Min => OfficeIcon.Min,
        AutoFunction.Max => OfficeIcon.Max,
        _ => OfficeIcon.Sum
    };

    /// <summary>
    /// The structural half of the bar, which is the Data tab - or the tail of the only tab when the
    /// strip is hidden. One definition, because two would drift.
    /// </summary>
    RenderFragment DataGroups => @<text>
        @* A sheet has no page setup to put this beside, so it sits with the other things that are about
   the sheet rather than about a cell. *@
            <RibbonGroup Title="Sheet" Priority="76">
                @* Large: one control is the whole group, and on a single row it left the row
                   underneath it empty for the width of a menu button. *@
                <RibbonContent>
                    <OfficeWatermarkButton Disabled="Disabled"
                                           ShowTooltips="ShowTooltips"
                                           HasWatermark="@(Watermark is not null)"
                                           Picked="WatermarkChanged" />
                </RibbonContent>
            </RibbonGroup>

        @* Insert on one row and delete on the other, rows and columns in the same order on both -
           so the pair a command belongs to is its line rather than a rule you have to notice. *@
        <RibbonGroup Title="Cells" Priority="60">
            <RibbonRow>
                <RibbonButton Size="RibbonItemSize.Small" Tooltip="Insert row above" Icon="@Ico(OfficeIcon.InsertRow)"
                              Disabled="Disabled" Clicked="() => Run(c => c.InsertRows())" />
                <RibbonButton Size="RibbonItemSize.Small" Tooltip="Insert column left" Icon="@Ico(OfficeIcon.InsertColumn)"
                              Disabled="Disabled" Clicked="() => Run(c => c.InsertColumns())" />
            </RibbonRow>
            <RibbonRow>
                <RibbonButton Size="RibbonItemSize.Small" Tooltip="Delete rows" Icon="@Ico(OfficeIcon.DeleteRow)"
                              Disabled="Disabled" Clicked="() => Run(c => c.DeleteRows())" />
                <RibbonButton Size="RibbonItemSize.Small" Tooltip="Delete columns" Icon="@Ico(OfficeIcon.DeleteColumn)"
                              Disabled="Disabled" Clicked="() => Run(c => c.DeleteColumns())" />
            </RibbonRow>
        </RibbonGroup>

        <RibbonGroup Title="Columns" Priority="50">
            @* Fitting to contents is the common case, so it stays the face; the presets behind the
               chevron are the only way back to a chosen width, which a fit cannot give you. *@
            <RibbonSplitButton Text="Width" Tooltip="Fit columns to contents"
                               Icon="@Ico(OfficeIcon.ColumnWidth)" Disabled="Disabled"
                               Clicked="() => Run(c => c.AutoFitColumns())"
                               Menu="WidthMenu" />

            <RibbonButton Size="RibbonItemSize.Small" Tooltip="Hide columns" Icon="@Ico(OfficeIcon.Hide)"
                          Disabled="Disabled" Clicked="() => Run(c => c.SetColumnsHidden(true))" />
            <RibbonButton Size="RibbonItemSize.Small" Tooltip="Unhide columns" Icon="@Ico(OfficeIcon.Unhide)"
                          Disabled="Disabled" Clicked="() => Run(c => c.SetColumnsHidden(false))" />
        </RibbonGroup>

        @* Labelled, unlike the rest of the bar: five aggregates told apart by icon alone would be
           five guesses. The label is the formula name rather than the friendly one, because the
           button writes =AVERAGE(...) into a cell and that is the thing worth naming. *@
        <RibbonGroup Title="Functions" Priority="40">
            @foreach (var function in Functions)
            {
                <RibbonButton Size="RibbonItemSize.Small"
                              Text="@AutoFunctions.NameOf(function)"
                              Tooltip="@AutoFunctions.DisplayName(function)"
                              Icon="@Ico(IconOf(function))"
                              Disabled="Disabled"
                              Clicked="() => Run(c => c.ApplyAutoFunction(function))" />
            }
        </RibbonGroup>
    </text>;

    /// <summary>
    /// What a preset does to a number, so the menu shows the format rather than naming it.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Formatted through the same resolver the grid paints with, so the sample is the truth rather
    /// than a hard-coded string that drifts from what the button actually applies.
    /// </para>
    /// <para>
    /// The number differs by preset because one number cannot demonstrate all of them: 1234.5 as a
    /// percentage is 123450%, and as a date it is a morning in 1903. Each row shows the format doing
    /// the thing someone would pick it for.
    /// </para>
    /// </remarks>
    string SampleOf(NumberFormatPreset preset)
    {
        if (this.Controller?.Workbook.Styles is not { } styles)
            return string.Empty;

        var value = preset switch
        {
            NumberFormatPreset.Percent => 0.256,
            NumberFormatPreset.ShortDate or NumberFormatPreset.Time => ExcelDate.FromDateTime(DateTime.Now),
            _ => 1234.5
        };

        var format = ResolvedFormat.Default with { NumberFormatCode = NumberFormats.CodeOf(preset) };
        return styles.Format(CellValue.FromNumber(value), format);
    }

    async Task RaiseChangedAsync()
    {
        this.StateHasChanged();

        if (this.Changed.HasDelegate)
            await this.Changed.InvokeAsync();
    }

    void Detach()
    {
        if (this.attached is not null)
            this.attached.Changed -= this.OnControllerChanged;

        this.attached = null;
    }

    public void Dispose() => this.Detach();

    /// <summary>
    /// The colour this control wears: its ribbon's header band and tab underline.
    /// </summary>
    /// <remarks>
    /// Defaults to <see cref="OfficeAccent.Spreadsheet"/> - the colour Microsoft's own Excel wears,
    /// because that is what a user reads as "a spreadsheet" before any label has been looked at. Set
    /// it to take on the app's own brand instead, or to <c>null</c> to leave the bar on the theme's
    /// neutrals like the rest of the chrome.
    /// </remarks>
    [Parameter] public OfficeAccent? Accent { get; set; } = OfficeAccent.Spreadsheet;

    /// <summary>The mark currently drawn behind the grid, so the button can offer to take it off.</summary>
    [Parameter] public OfficeWatermark? Watermark { get; set; }

    /// <summary>
    /// Raised when the button picks a picture, or clears the one already set.
    /// </summary>
    /// <remarks>
    /// A callback rather than the bar owning it: a watermark is drawn by the grid, and the bar has no
    /// grid - it has a controller, which is the workbook rather than the view of it.
    /// </remarks>
    [Parameter] public EventCallback<OfficeWatermark?> WatermarkChanged { get; set; }

    string? AccentBackground => this.Accent is { } a ? Css(a.Color) : null;

    string? AccentInk => this.Accent is { } a ? Css(a.Ink) : null;

    static string Css(ArgbColor value)
        => $"rgba({value.R},{value.G},{value.B},{(value.A / 255d).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)})";

}
