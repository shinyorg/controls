                          Clicked="() => Run(c => c.ClearFilters())" />
            <RibbonButton Size="RibbonItemSize.Small" Text="Reapply" Tooltip="Reapply Filters"
                          Disabled="Disabled" Clicked="() => Run(c => c.ReapplyFilters())" />
        </RibbonGroup>

        <RibbonGroup Title="Data Tools" Priority="55">
            <RibbonButton Text="Data Validation" Tooltip="Data Validation"
                          Icon="@Ico(OfficeIcon.DataValidation)" Disabled="Disabled"
                          Clicked="() => Run(c => c.ShowDialog(SpreadsheetDialogs.DataValidation(c)))" />
            <RibbonButton Size="RibbonItemSize.Small" Text="Clear Validation" Tooltip="Clear Validation"
