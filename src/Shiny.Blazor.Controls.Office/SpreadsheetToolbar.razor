    // ---- Review ----

    RenderFragment ReviewGroups => @<text>
        <RibbonGroup Title="Notes" Priority="60">
            <RibbonButton Text="@(Controller?.ActiveNote is null ? "New Note" : "Edit Note")" Tooltip="Note (Shift+F2)"
                          Icon="@Ico(OfficeIcon.NewNote)" Disabled="Disabled"
                          Clicked="() => Run(c => c.ShowDialog(SpreadsheetDialogs.Note(c)))" />
            <RibbonButton Size="RibbonItemSize.Small" Text="Delete" Tooltip="Delete Note"
                          Icon="@Ico(OfficeIcon.DeleteNote)" Disabled="@(Disabled || Controller?.ActiveNote is null)"
                          Clicked="() => Run(c => c.DeleteNote())" />
            <RibbonButton Size="RibbonItemSize.Small" Text="Previous" Tooltip="Previous Note"
                          Icon="@Ico(OfficeIcon.Previous)" Disabled="@(Controller is null)"
                          Clicked="() => View(c => c.NextNote(backwards: true))" />
            <RibbonButton Size="RibbonItemSize.Small" Text="Next" Tooltip="Next Note"
                          Icon="@Ico(OfficeIcon.Next)" Disabled="@(Controller is null)"
                          Clicked="() => View(c => c.NextNote())" />
            <RibbonToggleButton Size="RibbonItemSize.Small" Text="Show All Notes" Tooltip="Show All Notes"
                                Icon="@Ico(OfficeIcon.ShowNotes)" Checked="@(Controller?.ShowAllNotes ?? false)"
                                Disabled="@(Controller is null)" Clicked="_ => View(c => c.ShowAllNotes = !c.ShowAllNotes)" />
        </RibbonGroup>
    </text>;

    // ---- View ----

    RenderFragment ViewGroups => @<text>
        <RibbonGroup Title="Show" Priority="60">
            <RibbonToggleButton Size="RibbonItemSize.Small" Text="Gridlines" Tooltip="Gridlines"
                                Icon="@Ico(OfficeIcon.Gridlines)" Checked="@(Controller?.ShowGridlines ?? true)"
                                Disabled="@(Controller is null)" Clicked="_ => View(c => c.ShowGridlines = !c.ShowGridlines)" />
            <RibbonToggleButton Size="RibbonItemSize.Small" Text="Headings" Tooltip="Headings"
                                Icon="@Ico(OfficeIcon.Headings)" Checked="@(Controller?.ShowHeadings ?? true)"
                                Disabled="@(Controller is null)" Clicked="_ => View(c => c.ShowHeadings = !c.ShowHeadings)" />
            <RibbonToggleButton Size="RibbonItemSize.Small" Text="Formula Bar" Tooltip="Formula Bar"
                                Icon="@Ico(OfficeIcon.FormulaBar)" Checked="ShowFormulaBar"
                                Disabled="@(Controller is null)" Clicked="_ => ToggleFormulaBar()" />
            <RibbonToggleButton Size="RibbonItemSize.Small" Text="Formulas" Tooltip="Show Formulas (Ctrl+`)"
                                Icon="@Ico(OfficeIcon.ShowFormulas)" Checked="@(Controller?.ShowFormulas ?? false)"
                                Disabled="@(Controller is null)" Clicked="_ => View(c => c.ToggleShowFormulas())" />
        </RibbonGroup>

        <RibbonGroup Title="Zoom" Priority="55">
            <RibbonButton Text="Zoom" Tooltip="Zoom"
                          Icon="@Ico(OfficeIcon.ZoomIn)" Disabled="@(Controller is null)"
                          Clicked="() => View(c => c.ShowDialog(SpreadsheetDialogs.Zoom(c, c.Viewport.Width * c.Zoom, c.Viewport.Height * c.Zoom)))" />
            <RibbonButton Size="RibbonItemSize.Small" Text="100%" Tooltip="Zoom to 100%"
                          Icon="@Ico(OfficeIcon.Zoom100)" Disabled="@(Controller is null)"
                          Clicked="() => View(c => c.Zoom = 1)" />
            <RibbonButton Size="RibbonItemSize.Small" Text="Zoom to Selection" Tooltip="Zoom to Selection"
                          Disabled="@(Controller is null)"
                          Clicked="() => View(ZoomToSelection)" />
        </RibbonGroup>

        <RibbonGroup Title="Window" Priority="50">
            <RibbonMenuButton Text="Freeze Panes" Tooltip="Freeze Panes"
                              Icon="@Ico(OfficeIcon.FreezePanes)" Disabled="Disabled" Menu="FreezeMenu" />
        </RibbonGroup>
    </text>;

    /// <summary>
    /// What a preset does to a number, so the menu shows the format rather than naming it.
    /// </summary>
    /// <remarks>
    /// Formatted through the same resolver the grid paints with, so the sample is the truth rather
    /// than a hard-coded string that drifts from what the button actually applies. The number differs
    /// by preset because one number cannot demonstrate all of them.
    /// </remarks>
    string SampleOf(NumberFormatPreset preset)
    {
        if (this.Controller?.Workbook.Styles is not { } styles)
            return string.Empty;

        var value = preset switch
        {
            NumberFormatPreset.Percent => 0.256,
            NumberFormatPreset.ShortDate or NumberFormatPreset.Time => ExcelDate.FromDateTime(DateTime.Now),
            _ => 1234.5
        };

        var format = ResolvedFormat.Default with { NumberFormatCode = NumberFormats.CodeOf(preset) };
        return styles.Format(CellValue.FromNumber(value), format);
    }

    async Task RaiseChangedAsync()
    {
        this.StateHasChanged();

        if (this.Changed.HasDelegate)
            await this.Changed.InvokeAsync();
    }

    void Detach()
    {
        if (this.attached is not null)
            this.attached.Changed -= this.OnControllerChanged;

        this.attached = null;
    }

    public void Dispose() => this.Detach();

    /// <summary>
    /// The colour this control wears: its ribbon's header band and tab underline.
    /// </summary>
    /// <remarks>
    /// Defaults to <see cref="OfficeAccent.Spreadsheet"/> - the colour Microsoft's own Excel wears,
    /// because that is what a user reads as "a spreadsheet" before any label has been looked at. Set
    /// it to take on the app's own brand instead, or to <c>null</c> to leave the bar on the theme's
    /// neutrals like the rest of the chrome.
    /// </remarks>
    [Parameter] public OfficeAccent? Accent { get; set; } = OfficeAccent.Spreadsheet;

    /// <summary>The mark currently drawn behind the grid, so the button can offer to take it off.</summary>
    [Parameter] public OfficeWatermark? Watermark { get; set; }

    /// <summary>
    /// Raised when the button picks a picture, or clears the one already set.
    /// </summary>
    [Parameter] public EventCallback<OfficeWatermark?> WatermarkChanged { get; set; }

    string? AccentBackground => this.Accent is { } a ? Css(a.Color) : null;

    string? AccentInk => this.Accent is { } a ? Css(a.Ink) : null;

    static string Css(ArgbColor value)
        => $"rgba({value.R},{value.G},{value.B},{(value.A / 255d).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)})";
}
