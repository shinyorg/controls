@using SkiaSharp
@using SkiaSharp.Views.Blazor
@using Shiny.Controls.Office.Packaging
@using Shiny.Controls.Office.Presentation
@implements IAsyncDisposable
@inject IJSRuntime Js

@*
    The lone slide editor: a canvas and the hidden input the platform types into. No chrome —
    SlideEditorView adds that. Anything a toolbar needs is on Controller.
*@
<div class="shiny-slide-editor @Class"
     style="@Style"
     @ref="host"
     @onwheel="OnWheel"
     @onwheel:preventDefault="true"
     @onpointerdown="OnPointerDown"
     @onpointerdown:preventDefault="true"
     @onpointermove="OnPointerMove"
     @onpointerup="OnPointerUp"
     @ondblclick="OnDoubleClick">

    <SKCanvasView @ref="canvas"
                  class="shiny-slide-editor-canvas"
                  IgnorePixelScaling="false"
                  OnPaintSurface="OnPaint" />

    @*
        The real text input, parked at the caret rather than offscreen: a hidden input scrolls the
        page when the browser focuses it, and on mobile the IME candidate window follows this
        element's position.
    *@
    <div class="shiny-slide-editor-input"
         style="@InputStyle"
         contenteditable="true"
         spellcheck="false"
         @ref="input"
         @onkeydown="OnKeyDown"
         @onkeydown:preventDefault="preventKeyDefault"
         @onfocus="OnFocus"
         @onblur="OnBlur"></div>
</div>

@code {
    SKCanvasView? canvas;
    ElementReference input;
    ElementReference host;
    IJSObjectReference? dropModule;
    IJSObjectReference? dropHandle;
    IJSObjectReference? inputModule;
    IJSObjectReference? inputHandle;
    IJSObjectReference? keysModule;
    IJSObjectReference? keysHandle;
    DotNetObjectReference<SlideEditor>? selfReference;
    SkiaTextMeasurer? measurer;
    SlidePainter? painter;
    SlideEditorController? controller;
    bool preventKeyDefault;
    bool focused;
    bool focusInput;
    bool applyingParameters;
    double lastWidth;
    double lastHeight;

    /// <summary>
    /// The theme the canvas was last painted with.
    /// </summary>
    /// <remarks>
    /// SKCanvasView only repaints when Invalidate is called; a Blazor re-render does not touch the
    /// canvas contents. Without this comparison a theme change updates the parameter, re-renders the
    /// component and leaves the old pixels on screen — the toggle appears to do nothing at all.
    /// </remarks>
    SlideTheme? paintedTheme;
    ThemeSchemeWatcher scheme = null!;

    double dpr = 1;

    static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.InvariantCulture;

    /// <summary>The deck to edit. Must have been opened with <c>editable: true</c>.</summary>
    [Parameter] public SlideDeck? Deck { get; set; }

    /// <summary>
    /// Chrome colours. Left unset the surface follows the page's light/dark scheme;
    /// setting it pins the choice, including to <see cref="SlideTheme.Light"/>.
    /// </summary>
    [Parameter] public SlideTheme? Theme { get; set; }

    SlideTheme EffectiveTheme => OfficeScheme.Resolve(this.scheme, this.Theme);

    [Parameter] public int SlideIndex { get; set; }

    [Parameter] public EventCallback<int> SlideIndexChanged { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Whether dragging an image file onto the slide inserts it. On by default.</summary>
    [Parameter] public bool AllowFileDrop { get; set; } = true;

    /// <summary>Raised when a dropped file could not be inserted, so a host can say so.</summary>
    [Parameter] public EventCallback<OfficeDropRejected> DropRejected { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public string? Style { get; set; }

    /// <summary>Raised after every edit.</summary>
    [Parameter] public EventCallback DeckChanged { get; set; }

    /// <summary>
    /// Raised when the selection or caret moves, without the deck having changed.
    /// </summary>
    /// <remarks>
    /// Separate from <see cref="DeckChanged"/> because chrome around the editor has to follow the
    /// selection too: without this a wrapper's toolbar only refreshes once an edit happens, so
    /// selecting a shape leaves its Delete button greyed out and the status line stale.
    /// </remarks>
    [Parameter] public EventCallback SelectionChanged { get; set; }

    /// <summary>The live controller — selection, caret, formatting commands, undo.</summary>
    public SlideEditorController? Controller => this.controller;

    protected override void OnInitialized()
        // The canvas only redraws when told to, so a scheme flip has to invalidate it explicitly.
        => this.scheme = new ThemeSchemeWatcher(this.Js, () =>
        {
            this.canvas?.Invalidate();
            this.StateHasChanged();
            return Task.CompletedTask;
        });

    protected override void OnParametersSet()
    {
        // First, before any of the early returns below, for the reason on paintedTheme.
        if (this.paintedTheme != this.EffectiveTheme)
        {
            this.paintedTheme = this.EffectiveTheme;
            this.canvas?.Invalidate();
        }

        if (this.Deck is null)
        {
            this.controller = null;
            return;
        }

        this.measurer ??= new SkiaTextMeasurer();
        this.painter ??= new SlidePainter(this.measurer);

        if (this.controller is null || !ReferenceEquals(this.controller.Deck, this.Deck))
        {
            if (this.controller is not null)
            {
                this.controller.Changed -= this.OnControllerChanged;
                this.controller.Edited -= this.OnEdited;
            }

            this.controller = new SlideEditorController(this.Deck, this.measurer);
            this.controller.Changed += this.OnControllerChanged;

            // Every edit reports through the controller, including a drag - which is driven straight
            // through the commands and never passes through a keyboard handler.
            this.controller.Edited += this.OnEdited;

            if (this.lastWidth > 0)
                this.controller.Resize(this.lastWidth, this.lastHeight);
        }

        this.controller.IsReadOnly = this.ReadOnly;

        // Assigning Index raises Changed, which would otherwise write the controller's state back to
        // the parent mid-update and undo the navigation the parent just requested.
        this.applyingParameters = true;
        try
        {
            this.controller.Index = this.SlideIndex;
        }
        finally
        {
            this.applyingParameters = false;
        }
    }

    async void OnControllerChanged(object? sender, EventArgs e)
    {
        if (this.controller is { } controller && !this.applyingParameters && controller.Index != this.SlideIndex)
        {
            this.SlideIndex = controller.Index;
            if (this.SlideIndexChanged.HasDelegate)
                await this.SlideIndexChanged.InvokeAsync(controller.Index);
        }

        this.canvas?.Invalidate();
        this.StateHasChanged();

        if (this.SelectionChanged.HasDelegate)
            await this.SelectionChanged.InvokeAsync();
    }

    async void OnEdited(object? sender, EventArgs e)
    {
        this.canvas?.Invalidate();
        this.StateHasChanged();

        if (this.DeckChanged.HasDelegate)
            await this.DeckChanged.InvokeAsync();
    }

    SlideEditorSurfacePainter? surfacePainter;
    SlideShowPainter? previewPainter;
    SlideShowController? preview;
    System.Threading.Timer? previewTicker;

    /// <summary>The accent the selection chrome is drawn in.</summary>
    [Parameter] public Shiny.Controls.Office.Spreadsheet.ArgbColor? ChromeAccent { get; set; }

    void OnPaint(SKPaintSurfaceEventArgs e)
    {
        var info = e.Info;
        var surface = e.Surface.Canvas;

        if (this.controller is null || this.painter is null)
        {
            var theme = this.EffectiveTheme;
            surface.Clear(new SKColor(theme.Surround.R, theme.Surround.G, theme.Surround.B));
            return;
        }

        // The surface arrives in device pixels; the layout works in CSS pixels.
        var scale = (float)this.dpr;
        var width = info.Width / this.dpr;
        var height = info.Height / this.dpr;

        if (this.lastWidth <= 0 || Math.Abs(width - this.lastWidth) > 0.5 || Math.Abs(height - this.lastHeight) > 0.5)
        {
            this.lastWidth = width;
            this.lastHeight = height;
            this.controller.Resize(width, height);
        }

        // Every view and all the chrome come from the shared surface painter, so MAUI draws the same.
        this.surfacePainter ??= new SlideEditorSurfacePainter(this.painter);
        this.surfacePainter.Paint(surface, this.controller, new SlideEditorSurfaceOptions
        {
            Theme = this.EffectiveTheme,
            Scale = scale,
            IsFocused = this.focused,
            IsReadOnly = this.ReadOnly,
            Watermark = this.Watermark,
            Accent = this.ChromeAccent ?? new Shiny.Controls.Office.Spreadsheet.ArgbColor(255, 0x2F, 0x6F, 0xED)
        });

        // A Preview plays over the slide itself, inside its own rectangle.
        if (this.preview is { } running && running.Frame() is { } frame && this.controller.SinglePlacement() is { } placement)
        {
            this.previewPainter ??= new SlideShowPainter(this.painter);
            surface.Save();
            surface.Scale(scale);
            this.previewPainter.PaintInto(surface, frame, this.controller.Deck,
                new SKRect((float)placement.X, (float)placement.Y, (float)(placement.X + placement.Width), (float)(placement.Y + placement.Height)),
                this.Watermark);
            surface.Restore();
        }
    }

    /// <summary>
    /// Plays the current slide's transition and animations in place — the Preview button on the
    /// Transitions and Animations tabs.
    /// </summary>
    public void Preview()
    {
        if (this.controller is not { Count: > 0 } controller)
            return;

        this.StopPreview();
        controller.ClearSelection();
        this.preview = SlideShowController.Preview(controller.Deck, controller.Index);
        this.previewTicker = new System.Threading.Timer(_ => _ = this.InvokeAsync(() =>
        {
            if (this.preview is not { } running)
                return;

            running.Tick();
            this.canvas?.Invalidate();

            if (running.IsPreviewDone)
                this.StopPreview();
        }), null, 0, 33);
    }

    /// <summary>Ends a preview early; a click on the slide does the same.</summary>
    public void StopPreview()
    {
        this.previewTicker?.Dispose();
        this.previewTicker = null;

        if (this.preview is not null)
        {
            this.preview = null;
            this.canvas?.Invalidate();
        }
    }

    /// <summary>Repaints the surface — after a view setting (ruler, gridlines, markers) that is not an edit.</summary>
    public void Invalidate()
    {
        this.canvas?.Invalidate();
        this.StateHasChanged();
    }

    /// <summary>True while a Preview is playing.</summary>
    public bool IsPreviewing => this.preview is not null;

    // ---- pointer ----

    void OnPointerDown(PointerEventArgs e)
    {
        if (this.controller is null)
            return;

        this.StopPreview();

        // Shift extends (text) or adds (shapes); Ctrl or Cmd adds or takes a shape out.
        this.controller.PointerDown(e.OffsetX, e.OffsetY, e.ShiftKey, e.CtrlKey || e.MetaKey);

        // Focus is taken deliberately: the host element prevents the pointer's default action, which
        // is what otherwise moves focus off the hidden input a few milliseconds later.
        this.focusInput = true;
    }

    void OnPointerMove(PointerEventArgs e)
    {
        if (this.controller is null || (e.Buttons & 1) != 1)
            return;

        // Shift: 15-degree rotation steps, proportional corners, and a move held to one axis.
        this.controller.PointerMove(e.OffsetX, e.OffsetY, e.ShiftKey);
    }

    void OnPointerUp(PointerEventArgs e) => this.controller?.PointerUp();

    void OnDoubleClick(MouseEventArgs e)
    {
        this.controller?.PointerDoubleClick(e.OffsetX, e.OffsetY);
        this.focusInput = true;
    }

    /// <summary>
    /// Ctrl+wheel (and a trackpad pinch, which browsers report as one) zooms about the pointer; a
    /// zoomed slide scrolls; otherwise the wheel pages through the deck as it always has.
    /// </summary>
    void OnWheel(WheelEventArgs e)
    {
        if (this.controller is null)
            return;

        if (e.CtrlKey || e.MetaKey)
        {
            var factor = Math.Exp(-e.DeltaY * 0.0025);
            this.controller.ZoomAt(this.controller.EffectiveZoom * factor, e.OffsetX, e.OffsetY);
            return;
        }

        if (this.controller.Mode == SlideViewMode.Grid)
        {
            this.controller.Scroll(e.DeltaY);
            return;
        }

        if (this.controller.CanPan)
        {
            this.controller.PanBy(e.ShiftKey ? e.DeltaY : e.DeltaX, e.ShiftKey ? 0 : e.DeltaY);
            return;
        }

        if (this.controller.IsEditingText)
            return;

        if (e.DeltaY > 0)
            this.controller.Next();
        else
            this.controller.Previous();
    }

    void OnFocus()
    {
        this.focused = true;
        this.canvas?.Invalidate();
    }

    void OnBlur()
    {
        this.focused = false;
        this.canvas?.Invalidate();
    }

    // ---- text input ----

    /// <summary>
    /// The single entry point for inserted text.
    /// </summary>
    /// <remarks>
    /// <c>beforeinput</c> rather than key events: it is the only event that reports IME composition,
    /// autocorrect, dictation and paste as ordinary insertions.
    /// </remarks>
    [JSInvokable]
    public Task HandleBeforeInput(string inputType, string? data)
    {
        if (this.controller is null || this.ReadOnly || !this.controller.IsEditingText)
            return Task.CompletedTask;

        switch (inputType)
        {
            case "insertText":
            case "insertCompositionText":
            case "insertFromPaste":
            case "insertReplacementText":
                if (!string.IsNullOrEmpty(data))
                    this.controller.InsertText(data);

                break;

            case "insertParagraph":
                this.controller.InsertParagraph();
                break;

            // Shift+Enter: a line break inside the paragraph, PowerPoint's soft return.
            case "insertLineBreak":
                this.controller.InsertLineBreak();
                break;

            case "deleteContentBackward":
                this.controller.Backspace();
                break;

            case "deleteContentForward":
                this.controller.Delete();
                break;

            default:
                return Task.CompletedTask;
        }

        this.Repaint();
        return Task.CompletedTask;
    }

    /// <summary>
    /// A shortcut the editor recognises but a surrounding view acts on: <c>show-beginning</c> (F5),
    /// <c>show-current</c> (Shift+F5), <c>link</c> (Ctrl+K), <c>find</c> (Ctrl+F), <c>replace</c> (Ctrl+H).
    /// </summary>
    [Parameter] public EventCallback<string> CommandRequested { get; set; }

    async Task RequestAsync(string command)
    {
        if (this.CommandRequested.HasDelegate)
            await this.CommandRequested.InvokeAsync(command);
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (this.controller is null)
            return;

        var extend = e.ShiftKey;
        var command = e.CtrlKey || e.MetaKey;
        this.preventKeyDefault = true;

        // Shortcuts that mean the same with or without a caret — PowerPoint's.
        switch (e.Key)
        {
            case "F5":
                await this.RequestAsync(e.ShiftKey ? "show-current" : "show-beginning");
                return;

            case "k" or "K" when command:
                await this.RequestAsync("link");
                return;

            case "f" or "F" when command:
                await this.RequestAsync("find");
                return;

            case "h" or "H" when command:
                await this.RequestAsync("replace");
                return;

            // Save and Print are the window's: a surrounding view with the Office shell answers them.
            case "s" or "S" when command && !e.ShiftKey && this.CommandRequested.HasDelegate:
                await this.RequestAsync("save");
                return;

            case "p" or "P" when command && !e.ShiftKey && this.CommandRequested.HasDelegate:
                await this.RequestAsync("print");
                return;

            // Ctrl+Shift+> and < grow and shrink the font, a step on the size ladder.
            case ">" or "." when command && e.ShiftKey:
                this.controller.GrowFont(1);
                this.Repaint();
                return;

            case "<" or "," when command && e.ShiftKey:
                this.controller.GrowFont(-1);
                this.Repaint();
                return;

            // Paragraph alignment, with or without a caret (a selected shape aligns all its text).
            case "e" or "E" when command:
                this.controller.SetParagraphAlignment(Shiny.Controls.Office.Text.TextAlignment.Center);
                this.Repaint();
                return;

            case "l" or "L" when command:
                this.controller.SetParagraphAlignment(Shiny.Controls.Office.Text.TextAlignment.Left);
                this.Repaint();
                return;

            case "r" or "R" when command:
                this.controller.SetParagraphAlignment(Shiny.Controls.Office.Text.TextAlignment.Right);
                this.Repaint();
                return;

            case "j" or "J" when command:
                this.controller.SetParagraphAlignment(Shiny.Controls.Office.Text.TextAlignment.Justify);
                this.Repaint();
                return;

            // Ctrl+G groups, Ctrl+Shift+G ungroups.
            case "g" or "G" when command && !this.controller.IsEditingText:
                if (e.ShiftKey)
                    this.controller.Ungroup();
                else
                    this.controller.Group();

                this.Repaint();
                return;

            // Ctrl+= subscript, Ctrl+Shift+= (Ctrl++) superscript.
            case "=" or "+" when command && this.controller.IsEditingText:
                if (e.ShiftKey || e.Key == "+")
                    this.controller.ToggleSuperscript();
                else
                    this.controller.ToggleSubscript();

                this.Repaint();
                return;

            // Ctrl+Space clears character formatting.
            case " " when command:
                this.controller.ClearFormatting();
                this.Repaint();
                return;

            case "Escape" when this.IsPreviewing:
                this.StopPreview();
                return;
        }

        // Undo and redo work whether or not a caret is inside text — moving a shape is undoable too.
        switch (e.Key)
        {
            case "z" when command:
                if (e.ShiftKey)
                    this.controller.Redo();
                else
                    this.controller.Undo();

                this.Repaint();
                return;

            case "y" when command:
                this.controller.Redo();
                this.Repaint();
                return;

            // PowerPoint's New Slide, and it works from inside text too. Nothing in a browser binds
            // Ctrl+M that losing would hurt (Firefox mutes the tab).
            case "m" when command:
                this.controller.NewSlide();
                this.Repaint();
                return;
        }

        if (!this.controller.IsEditingText)
        {
            switch (e.Key)
            {
                case "Escape":
                    this.controller.ClearSelection();
                    break;

                case "a" or "A" when command:
                    this.controller.SelectAllShapes();
                    break;

                case "Delete":
                case "Backspace":
                    this.controller.DeleteSelectedShape();
                    this.Repaint();
                    break;

                case "Enter" when this.controller.SelectedShape >= 0:
                    // Enter on a selected shape steps into its text, which is what PowerPoint's F2 does
                    // and what a keyboard-only user needs, since they cannot double-click.
                    this.controller.BeginTextEditing(0, 0);
                    break;

                // With a shape selected the arrows move it, as in PowerPoint - Alt or Ctrl for a
                // fine nudge. With nothing selected they still page through the deck.
                case "ArrowLeft" or "ArrowRight" or "ArrowUp" or "ArrowDown" when this.controller.SelectedShape >= 0:
                    this.controller.Nudge(
                        e.Key == "ArrowLeft" ? -1 : e.Key == "ArrowRight" ? 1 : 0,
                        e.Key == "ArrowUp" ? -1 : e.Key == "ArrowDown" ? 1 : 0,
                        fine: e.AltKey || command);
                    this.Repaint();
                    break;

                case "c" when command:
                    this.controller.CopyShape();
                    break;

                case "x" when command:
                    this.controller.CutShape();
                    this.Repaint();
                    break;

                case "v" when command:
                    this.controller.Paste();
                    this.Repaint();
                    break;

                case "d" when command:
                    this.controller.DuplicateShape();
                    this.Repaint();
                    break;

                // PowerPoint's: Ctrl+Shift+] to the front, Ctrl+] one step, and [ the other way.
                case "]" or "}" when command:
                    this.controller.Arrange(e.ShiftKey ? ShapeZOrder.BringToFront : ShapeZOrder.BringForward);
                    this.Repaint();
                    break;

                case "[" or "{" when command:
                    this.controller.Arrange(e.ShiftKey ? ShapeZOrder.SendToBack : ShapeZOrder.SendBackward);
                    this.Repaint();
                    break;

                case "ArrowRight" or "ArrowDown" or "PageDown" or " ":
                    this.controller.Next();
                    break;

                case "ArrowLeft" or "ArrowUp" or "PageUp":
                    this.controller.Previous();
                    break;

                case "Home": this.controller.Index = 0; break;
                case "End": this.controller.Index = this.controller.Count - 1; break;

                default:
                    this.preventKeyDefault = false;
                    break;
            }

            return;
        }

        switch (e.Key)
        {
            case "ArrowLeft": this.controller.MoveLeft(extend); break;
            case "ArrowRight": this.controller.MoveRight(extend); break;
            case "ArrowUp": this.controller.MoveUp(extend); break;
            case "ArrowDown": this.controller.MoveDown(extend); break;
            case "Home": this.controller.MoveToLineStart(extend); break;
            case "End": this.controller.MoveToLineEnd(extend); break;

            case "Escape":
                this.controller.EndTextEditing();
                break;

            case "Tab":
                this.controller.HandleTab(extend);
                this.Repaint();
                break;

            case "a" when command:
                this.controller.SelectAll();
                break;

            case "b" when command:
                this.controller.ToggleBold();
                this.Repaint();
                break;

            case "i" when command:
                this.controller.ToggleItalic();
                this.Repaint();
                break;

            case "u" when command:
                this.controller.ToggleUnderline();
                this.Repaint();
                break;

            default:
                // Everything else — printable characters included — arrives through beforeinput,
                // which is what makes IME and dictation work. Swallowing it here breaks both.
                this.preventKeyDefault = false;
                break;
        }
    }

    string InputStyle
    {
        get
        {
            if (this.controller?.CaretRect() is not { } caret)
                return "left:-9999px;top:0";

            // Parked at the caret so the IME composition window appears in the right place.
            return $"left:{Css(caret.X)}px;top:{Css(caret.Y)}px;height:{Css(Math.Max(12, caret.Height))}px";
        }
    }

    static string Css(double value) => value.ToString("0.##", Culture);

    public async Task FocusAsync()
    {
        if (this.inputModule is null)
            return;

        try
        {
            await this.inputModule.InvokeVoidAsync("focus", this.input);
        }
        catch (JSException ex)
        {
            // Reported rather than swallowed: a focus that quietly fails looks exactly like an editor
            // that has stopped accepting input, with nothing anywhere to say why.
            Console.Error.WriteLine($"[Shiny.Office] Could not focus the slide editor: {ex.Message}");
        }
    }

    /// <summary>
    /// Repaints after an action that may not have changed the deck.
    /// </summary>
    /// <remarks>
    /// Deliberately does not raise <c>DeckChanged</c>: every real edit already reports through the
    /// controller's <c>Edited</c> event, and raising it here as well made one keystroke look like two.
    /// </remarks>
    void Repaint()
    {
        this.canvas?.Invalidate();
        this.StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Before the DPR read: the canvas paints its first frame off this, and starting the
            // watch second would flash a white page in a dark app.
            await this.scheme.StartAsync(this.host);

            try
            {
                this.dpr = await this.Js.InvokeAsync<double>("eval", "window.devicePixelRatio || 1");
            }
            catch (Exception)
            {
                this.dpr = 1;
            }

            if (this.dpr <= 0)
                this.dpr = 1;

            this.canvas?.Invalidate();

            if (await OfficeFonts.EnsureLoadedAsync(this.Js))
            {
                this.canvas?.Invalidate();
                this.StateHasChanged();
            }

            await this.AttachInputAsync();
            await this.AttachKeysAsync();
            await this.AttachDropAsync();
        }

        if (this.focusInput)
        {
            this.focusInput = false;
            await this.FocusAsync();
        }
    }

    // ---- file drop ----

    /// <summary>
    /// Receives one dropped file from the browser, and places it where it landed.
    /// </summary>
    /// <remarks>
    /// Unlike the document, a slide has real positions: the picture goes exactly where the pointer
    /// was, centred on it, which is what dropping onto a canvas is expected to mean. The size is
    /// capped to the slide so a photograph dropped at full resolution does not arrive many times
    /// larger than the deck it is in.
    /// </remarks>
    [JSInvokable]
    public async Task HandleFileDrop(string name, string contentType, string? base64, double x, double y)
    {
        if (this.controller is null || this.ReadOnly)
            return;

        if (base64 is null)
        {
            await this.RaiseDropRejectedAsync(name, "The file is too large to embed.");
            return;
        }

        if (ImageContentTypes.Resolve(name, contentType) is not { } resolved)
        {
            await this.RaiseDropRejectedAsync(name, "Only images can be dropped onto a slide.");
            return;
        }

        if (this.controller.ToSlide(x, y) is not { } point)
            return;

        var width = Math.Min(this.controller.Deck.SlideWidth / 2, 400);
        var height = width * 0.75;

        this.controller.AddPicture(
            Convert.FromBase64String(base64),
            resolved,
            point.X - (width / 2),
            point.Y - (height / 2),
            width,
            height,
            Path.GetFileNameWithoutExtension(name));

        this.canvas?.Invalidate();
        this.StateHasChanged();

        if (this.DeckChanged.HasDelegate)
            await this.DeckChanged.InvokeAsync();
    }

    async Task RaiseDropRejectedAsync(string name, string reason)
    {
        if (this.DropRejected.HasDelegate)
            await this.DropRejected.InvokeAsync(new OfficeDropRejected(name, reason));
    }

    async Task AttachDropAsync()
    {
        if (!this.AllowFileDrop)
            return;

        try
        {
            this.dropModule = await this.Js.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Shiny.Blazor.Controls.Office/officeDrop.js");

            this.dropHandle = await this.dropModule.InvokeAsync<IJSObjectReference>(
                "attach", this.host, this.selfReference, nameof(HandleFileDrop));
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Shiny.Office] File drop is unavailable: {ex.Message}");
        }
    }

    /// <summary>
    /// Cancels the browser's own action for the editor's shortcuts — F5 reloading the page, Ctrl+R,
    /// Ctrl+L, Ctrl+D — synchronously, which Blazor's render-time preventDefault cannot.
    /// </summary>
    async Task AttachKeysAsync()
    {
        try
        {
            this.keysModule = await this.Js.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Shiny.Blazor.Controls.Office/slideEditor.js");

            this.keysHandle = await this.keysModule.InvokeAsync<IJSObjectReference>("attach", this.input);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Shiny.Office] Slide editor shortcuts are unavailable: {ex.Message}");
        }
    }

    async Task AttachInputAsync()
    {
        try
        {
            this.selfReference = DotNetObjectReference.Create(this);

            // The same module the document editor uses — it only attaches beforeinput, which is
            // exactly what this needs too.
            this.inputModule = await this.Js.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Shiny.Blazor.Controls.Office/documentEditor.js");

            this.inputHandle = await this.inputModule.InvokeAsync<IJSObjectReference>("attach", this.input, this.selfReference);
        }
        catch (Exception ex)
        {
            // Prerendering or a host without JS interop leaves the editor navigable but unable to
            // accept text. Reported rather than swallowed: silence is indistinguishable from an editor
            // that simply ignores the keyboard.
            Console.Error.WriteLine($"[Shiny.Office] Slide text input is unavailable: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (this.controller is not null)
        {
            this.controller.Changed -= this.OnControllerChanged;
            this.controller.Edited -= this.OnEdited;
        }

        await this.scheme.DisposeAsync();

        try
        {
            if (this.inputModule is not null && this.inputHandle is not null)
            {
                await this.inputModule.InvokeVoidAsync("detach", this.inputHandle);

                // The JS detach cannot free the handle: Blazor hands the module the unwrapped object,
                // which carries no reference id. Only .NET disposing it drops the JS-side entry that
                // otherwise keeps the listener closure - and with it the detached element - alive.
                await this.inputHandle.DisposeAsync();
            }

            if (this.inputModule is not null)
                await this.inputModule.DisposeAsync();

            if (this.dropModule is not null && this.dropHandle is not null)
            {
                await this.dropModule.InvokeVoidAsync("detach", this.dropHandle);

                // The JS detach cannot free the handle: Blazor hands the module the unwrapped object,
                // which carries no reference id. Only .NET disposing it drops the JS-side entry that
                // otherwise keeps the listener closure - and with it the detached element - alive.
                await this.dropHandle.DisposeAsync();
            }

            if (this.dropModule is not null)
                await this.dropModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone; there is nothing left to detach from.
        }

        this.StopPreview();

        try
        {
            if (this.keysModule is not null && this.keysHandle is not null)
            {
                await this.keysModule.InvokeVoidAsync("detach", this.keysHandle);
                await this.keysHandle.DisposeAsync();
            }

            if (this.keysModule is not null)
                await this.keysModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }

        this.surfacePainter?.Dispose();
        this.previewPainter?.Dispose();
        this.selfReference?.Dispose();
        this.painter?.Dispose();
        this.measurer?.Dispose();
    }

    /// <summary>
    /// A picture drawn behind the content - a logo, a DRAFT stamp, a company mark.
    /// </summary>
    /// <remarks>
    /// A <b>display</b> watermark: it is drawn, not written into the file. The three Office formats
    /// have no common notion of one, so persisting would mean three unrelated mechanisms where drawing
    /// means one. See <see cref="OfficeWatermark"/>.
    /// </remarks>
    [Parameter] public OfficeWatermark? Watermark { get; set; }

}
