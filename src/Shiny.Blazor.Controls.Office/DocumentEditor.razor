@using SkiaSharp
@using SkiaSharp.Views.Blazor
@using Shiny.Controls.Office.Document
@using Shiny.Controls.Office.Packaging
@using Shiny.Controls.Office.Skia
@implements IAsyncDisposable
@inject IJSRuntime Js

@*
    The lone editor: a canvas and the hidden input the platform types into. No chrome of any kind —
    DocumentEditorView adds that. Anything a toolbar needs is on Controller.
*@
<div class="shiny-doc-editor @Class"
     style="@Style"
     @ref="host"
     @onwheel="OnWheel"
     @onwheel:preventDefault="true"
     @onpointerdown="OnPointerDown"
     @onpointerdown:preventDefault="true"
     @onpointermove="OnPointerMove"
     @onpointerup="OnPointerUp"
     @onclick="OnClick"
     @oncontextmenu="OnContextMenu"
     @oncontextmenu:preventDefault="true">

    <SKCanvasView @ref="canvas"
                  class="shiny-doc-editor-canvas"
                  IgnorePixelScaling="false"
                  OnPaintSurface="OnPaint" />

    @*
        The real text input. It is a one-line contenteditable parked under the caret rather than an
        offscreen element, because a hidden input scrolls the page when the browser focuses it, and
        on mobile the IME candidate window follows this element's position.
    *@
    <div class="shiny-doc-editor-input"
         style="@InputStyle"
         contenteditable="true"
         spellcheck="false"
         @ref="input"
         @onkeydown="OnKeyDown"
         @onkeydown:preventDefault="preventKeyDefault"
         @onfocus="OnFocus"
         @onblur="OnBlur"></div>

    @*
        The spelling menu. Rendered here rather than through a shared popup component so it stays
        inside the editor's own stacking and scroll context - the coordinates come straight from the
        canvas hit test.
    *@
    @if (this.spellingMenu is not null)
    {
        <div class="shiny-doc-spelling-menu"
             style="left:@(this.spellingMenu.X.ToString(Culture))px; top:@(this.spellingMenu.Y.ToString(Culture))px"
             @onpointerdown:stopPropagation="true">

            @if (this.spellingMenu.Suggestions.Count == 0)
            {
                <div class="doc-spell-empty">No suggestions</div>
            }
            else
            {
                @foreach (var suggestion in this.spellingMenu.Suggestions)
                {
                    <button type="button" class="doc-spell-item" @onclick="() => ApplySuggestionAsync(suggestion)">@suggestion</button>
                }
            }

            <div class="doc-spell-sep"></div>
            <button type="button" class="doc-spell-item doc-spell-action" @onclick="IgnoreAsync">Ignore</button>
            <button type="button" class="doc-spell-item doc-spell-action" @onclick="LearnAsync">Add to dictionary</button>
        </div>
    }
</div>

@code {
    SKCanvasView? canvas;
    ElementReference input;
    ElementReference host;
    IJSObjectReference? dropModule;
    IJSObjectReference? dropHandle;
    IJSObjectReference? inputModule;
    IJSObjectReference? inputHandle;
    DotNetObjectReference<DocumentEditor>? selfReference;
    SkiaTextMeasurer? measurer;
    DocumentPainter? painter;
    DocumentEditorController? controller;
    bool preventKeyDefault;
    bool focused;
    bool dragging;
    bool panning;
    bool panMoved;
    double panOriginX;
    double panOriginY;
    double panScroll;
    double panScrollX;
    TextHandle? draggingHandle;
    DocumentPosition? tapCandidate;

    /// <summary>How far a finger may travel before a press stops being a tap.</summary>
    const double TapSlop = 6;
    bool focusInput;
    double dpr = 1;
    double lastWidth;
    double lastHeight;

    /// <summary>
    /// The theme the canvas was last painted with.
    /// </summary>
    /// <remarks>
    /// SKCanvasView only repaints when Invalidate is called; a Blazor re-render does not touch the
    /// canvas contents. Without this comparison a theme change updates the parameter, re-renders the
    /// component, and leaves the old pixels on screen - the toggle appears to do nothing at all.
    /// </remarks>
    DocumentTheme? paintedTheme;
    ThemeSchemeWatcher scheme = null!;

    /// <summary>The document to edit. Must have been opened with <c>editable: true</c>.</summary>
    [Parameter] public WordDocument? Document { get; set; }

    /// <summary>
    /// Chrome colours. Left unset the surface follows the page's light/dark scheme;
    /// setting it pins the choice, including to <see cref="DocumentTheme.Light"/>.
    /// </summary>
    [Parameter] public DocumentTheme? Theme { get; set; }

    DocumentTheme EffectiveTheme => OfficeScheme.Resolve(this.scheme, this.Theme);

    [Parameter] public double Zoom { get; set; } = 1.0;

    /// <summary>
    /// Continuous column, or sheets of paper with the document's own headers and footers.
    /// </summary>
    /// <remarks>
    /// Print by default here, unlike <c>DocumentView</c>: an editor is where a page break, a header
    /// and a page number are authored, and none of them can be seen in a reflowed column.
    /// </remarks>
    [Parameter] public DocumentPageLayout PageLayout { get; set; } = DocumentPageLayout.Print;

    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Whether dragging an image file onto the editor inserts it. On by default.</summary>
    [Parameter] public bool AllowFileDrop { get; set; } = true;

    /// <summary>Raised when a dropped file could not be inserted, so a host can say so.</summary>
    [Parameter] public EventCallback<OfficeDropRejected> DropRejected { get; set; }

    /// <summary>
    /// The spell checker for this editor.
    /// </summary>
    /// <remarks>
    /// The browser has no spell-checking API a canvas can call — it only checks native editable
    /// elements, and exposes neither the results nor the suggestions — so on Blazor this defaults to
    /// no checking at all. Supply an implementation (a bundled dictionary, or a call to your own
    /// server) to turn it on. The MAUI package registers the platform's checker automatically.
    /// </remarks>
    [Parameter] public ISpellChecker? SpellChecker { get; set; }

    [Parameter] public bool SpellCheckEnabled { get; set; } = true;

    [Parameter] public string? Class { get; set; }

    [Parameter] public string? Style { get; set; }

    /// <summary>Raised after every edit, so a host can track the dirty state.</summary>
    [Parameter] public EventCallback DocumentChanged { get; set; }

    /// <summary>
    /// Raised whenever the caret or the selection moves.
    /// </summary>
    /// <remarks>
    /// Separate from <see cref="DocumentChanged"/> because chrome around the editor has to follow the
    /// caret as well as the edits: without this a wrapper's toolbar only refreshes once something is
    /// typed, so clicking into a bulleted paragraph leaves the list buttons unlit and the nesting
    /// buttons greyed out until the next keystroke. The slide editor carries the same callback for
    /// the same reason.
    /// </remarks>
    [Parameter] public EventCallback SelectionChanged { get; set; }

    /// <summary>The live controller — selection, caret format, formatting commands, undo.</summary>
    public DocumentEditorController? Controller => this.controller;

    /// <summary>Puts the keyboard focus on the editor, so the platform starts sending it text.</summary>
    public async Task FocusAsync()
    {
        if (this.inputModule is null)
            return;

        try
        {
            await this.inputModule.InvokeVoidAsync("focus", this.input);
        }
        catch (JSException ex)
        {
            // Reported rather than swallowed: a focus that quietly fails looks exactly like an editor
            // that has stopped accepting input, with nothing anywhere to say why.
            Console.Error.WriteLine($"[Shiny.Office] Could not focus the editor: {ex.Message}");
        }
    }

    string InputStyle
    {
        get
        {
            if (this.controller is null)
                return "left:-9999px;top:0";

            // Parked at the caret so the IME composition window appears in the right place.
            var caret = this.controller.CaretRect(this.controller.Selection.Focus);
            var x = caret.X + this.controller.PageX + this.controller.PagePadding;
            var y = caret.Y - this.controller.Viewport.ScrollY;
            return $"left:{Css(x)}px;top:{Css(y)}px;height:{Css(Math.Max(12, caret.Height))}px";
        }
    }

    static string Css(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    protected override void OnInitialized()
        // The canvas only redraws when told to, so a scheme flip has to invalidate it explicitly.
        => this.scheme = new ThemeSchemeWatcher(this.Js, () =>
        {
            this.canvas?.Invalidate();
            this.StateHasChanged();
            return Task.CompletedTask;
        });

    protected override void OnParametersSet()
    {
        // First, before any of the early returns below: SKCanvasView only repaints when Invalidate is
        // called, so a theme change that does not reach this leaves the old pixels on screen and the
        // toggle appears to do nothing.
        if (this.paintedTheme != this.EffectiveTheme)
        {
            this.paintedTheme = this.EffectiveTheme;
            this.canvas?.Invalidate();
        }

        if (this.Document is null)
        {
            this.controller = null;
            return;
        }

        this.measurer ??= new SkiaTextMeasurer();
        this.painter ??= new DocumentPainter(this.measurer);

        if (this.controller is null || !ReferenceEquals(this.controller.Document, this.Document))
        {
            if (this.controller is not null)
                this.controller.Changed -= this.OnControllerChanged;

            this.controller = new DocumentEditorController(this.Document, this.measurer, this.SpellChecker);
            this.controller.Changed += this.OnControllerChanged;

            if (this.lastWidth > 0)
                this.controller.Resize(this.lastWidth, this.lastHeight);
        }

        this.controller.Zoom = this.Zoom;
        this.controller.PageLayout = this.PageLayout;
        this.controller.IsSpellCheckEnabled = this.SpellCheckEnabled;

        if (this.SpellChecker is not null)
            this.controller.SpellChecker = this.SpellChecker;
    }

    async void OnControllerChanged(object? sender, EventArgs e)
    {
        this.canvas?.Invalidate();
        this.StateHasChanged();

        if (this.SelectionChanged.HasDelegate)
            await this.SelectionChanged.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Before the DPR read: the canvas paints its first frame off this, and starting the
            // watch second would flash a white page in a dark app.
            await this.scheme.StartAsync(this.host);

            try
            {
                this.dpr = await this.Js.InvokeAsync<double>("eval", "window.devicePixelRatio || 1");
            }
            catch (Exception)
            {
                this.dpr = 1;
            }

            if (this.dpr <= 0)
                this.dpr = 1;

            this.canvas?.Invalidate();

            if (await OfficeFonts.EnsureLoadedAsync(this.Js))
            {
                this.canvas?.Invalidate();
                this.StateHasChanged();
            }

            await this.AttachInputAsync();
            await this.AttachDropAsync();
        }

        if (this.focusInput)
        {
            this.focusInput = false;
            await this.FocusAsync();
        }
    }

    void OnPaint(SKPaintSurfaceEventArgs e)
    {
        var info = e.Info;
        var theme = this.EffectiveTheme;

        if (this.controller is null || this.painter is null)
        {
            e.Surface.Canvas.Clear(new SKColor(theme.SurroundBackground.R, theme.SurroundBackground.G, theme.SurroundBackground.B));
            return;
        }

        // Device scale times the view scale: in print the controller works in the paper's units
        // and zoom is applied here, so one layout unit is dpr * zoom device pixels.
        var scale = (float)(this.dpr * this.controller.ViewScale);
        var width = info.Width / this.dpr;
        var height = info.Height / this.dpr;

        if (this.lastWidth <= 0 || Math.Abs(width - this.lastWidth) > 0.5 || Math.Abs(height - this.lastHeight) > 0.5)
        {
            this.lastWidth = width;
            this.lastHeight = height;
            this.controller.Resize(width, height);
        }

        this.painter.Paint(e.Surface.Canvas, new DocumentPaintRequest
        {
            Watermark = this.Watermark,
            Blocks = this.controller.Blocks,
            Viewport = this.controller.Viewport,
            Theme = theme,
            Scale = scale,
            PageX = this.controller.PageX,
            ContentX = this.controller.ContentX,
            PageWidth = this.controller.PageWidth,
            PageHeight = this.controller.PageHeight,
            Pages = this.controller.VisiblePages(),
            Setup = this.controller.Document.Page,
            Selection = this.controller.SelectionRects().ToList(),
            FindMatches = this.controller.FindMatchRects().ToList(),
            Spelling = this.controller.SpellingRects().ToList(),

            // The caret only belongs on screen while the editor has focus; a document showing a caret
            // it does not own reads as editable when it is not.
            Caret = this.focused && !this.ReadOnly && this.controller.SelectedObject is null
                ? this.controller.CaretRect(this.controller.Selection.Focus)
                : null,

            TouchHandles = this.controller.UsesTouch
                ? this.controller.TouchHandleRects()
                : [],

            ObjectChrome = this.BuildObjectChrome()
        });
    }

    /// <summary>The frame and handles around a selected inline object, or null when none is selected.</summary>
    DocumentObjectChrome? BuildObjectChrome()
    {
        if (this.ReadOnly || this.controller is null)
            return null;

        if (this.controller.SelectedObjectBounds() is not { } bounds)
            return null;

        return new DocumentObjectChrome
        {
            Frame = bounds,
            Handles = this.controller.SelectedObjectHandles().Select(x => x.Rect).ToList()
        };
    }

    // ---- pointer ----

    void OnPointerDown(PointerEventArgs e)
    {
        if (this.controller is null)
            return;

        this.spellingMenu = null;

        // Objects first: a picture sits on top of the text it displaces, so a click inside one is
        // always about the picture even though there is a caret position underneath it.
        if (this.controller.BeginObjectDrag(e.OffsetX, e.OffsetY))
        {
            this.focusInput = true;
            return;
        }

        // Under touch a drag pans the page, so neither the caret nor a selection may be moved on the
        // way down: until the finger lifts there is no telling a tap from the start of a pan. A grab
        // on one of the selection's handles is the exception - that gesture is unambiguous.
        if (e.PointerType == "touch")
        {
            this.controller.UsesTouch = true;

            this.draggingHandle = this.controller.TouchHandleAt(e.OffsetX, e.OffsetY);
            if (this.draggingHandle is not null)
                return;

            this.panning = true;
            this.panOriginX = e.OffsetX;
            this.panOriginY = e.OffsetY;
            this.panScroll = this.controller.Viewport.ScrollY;
            this.panScrollX = this.controller.Viewport.ScrollX;
            this.panMoved = false;
            this.tapCandidate = this.controller.PositionAt(e.OffsetX, e.OffsetY);
            this.focusInput = true;
            return;
        }

        if (this.controller.PositionAt(e.OffsetX, e.OffsetY) is not { } position)
            return;

        if (e.ShiftKey)
            this.controller.Selection.ExtendTo(position);
        else
            this.controller.Selection.MoveTo(position);

        this.dragging = true;

        // The click's default action would move focus off the hidden input the moment the browser
        // finishes handling it - which is why pointerdown is prevented on the host element. Without
        // that, focus is set here and silently taken away again a few milliseconds later.
        this.focusInput = true;
    }

    void OnPointerMove(PointerEventArgs e)
    {
        if (this.controller is null || (e.Buttons & 1) != 1)
            return;

        if (this.controller.IsDraggingObject)
        {
            this.controller.DragObject(e.OffsetX, e.OffsetY);
            return;
        }

        if (this.draggingHandle is { } grabbed)
        {
            this.controller.DragTouchHandle(grabbed, e.OffsetX, e.OffsetY);
            return;
        }

        if (this.panning)
        {
            var travelled = this.panOriginY - e.OffsetY;
            var travelledX = this.panOriginX - e.OffsetX;

            if (!this.panMoved && Math.Abs(travelled) <= TapSlop && Math.Abs(travelledX) <= TapSlop)
                return;

            this.panMoved = true;

            // Both axes: a page is a fixed width, so on a phone it is always wider than the screen and
            // the right-hand end of every line is off it.
            //
            // travelled is in control pixels and the viewport scrolls in view units, which differ by
            // the zoom - the same conversion ScrollByControlPixels does.
            var scale = this.controller.ViewScale;
            this.controller.ScrollToHorizontal(this.panScrollX + (travelledX / scale));
            this.controller.ScrollTo(this.panScroll + (travelled / scale));
            return;
        }

        if (!this.dragging)
            return;

        if (this.controller.PositionAt(e.OffsetX, e.OffsetY) is { } position)
            this.controller.Selection.ExtendTo(position);
    }

    void OnPointerUp(PointerEventArgs e)
    {
        this.dragging = false;
        this.controller?.EndObjectDrag();

        // A press that went nowhere was a tap, and a tap places the caret.
        if (this.panning && !this.panMoved && this.tapCandidate is { } tapped)
        {
            this.controller?.Selection.MoveTo(tapped);
            this.focusInput = true;
        }

        this.panning = false;
        this.panMoved = false;
        this.draggingHandle = null;
        this.tapCandidate = null;
    }

    /// <summary>
    /// Widens the selection to a word on the second click and to the paragraph on the third.
    /// </summary>
    /// <remarks>
    /// On click rather than on pointerdown because pointerdown does not carry a click count - its
    /// <c>detail</c> is 0, measured, not assumed. The count lives on click, which still fires here even
    /// though pointerdown's default is prevented; mousedown, by contrast, is suppressed entirely.
    /// Pointerdown has already placed the caret by the time this runs, so this only has to widen.
    /// </remarks>
    void OnClick(MouseEventArgs e)
    {
        if (this.controller is null || e.Detail < 2)
            return;

        if (this.controller.PositionAt(e.OffsetX, e.OffsetY) is not { } position)
            return;

        if (e.Detail >= 3)
            this.controller.SelectParagraphAt(position);
        else
            this.controller.SelectWordAt(position);

        // Pointerup has already cleared the drag flag, but a click arriving without one would leave a
        // stray move able to collapse the selection that was just made.
        this.dragging = false;
        this.focusInput = true;
    }

    // ---- file drop ----

    /// <summary>
    /// Receives one dropped file from the browser.
    /// </summary>
    /// <remarks>
    /// <paramref name="base64"/> is null for a file the script refused to read because it was too
    /// large. That is reported rather than ignored: a drop that silently does nothing reads as a
    /// broken editor.
    /// </remarks>
    [JSInvokable]
    public async Task HandleFileDrop(string name, string contentType, string? base64, double x, double y)
    {
        if (this.controller is null || this.ReadOnly)
            return;

        if (base64 is null)
        {
            await this.RaiseDropRejectedAsync(name, "The file is too large to embed.");
            return;
        }

        if (ImageContentTypes.Resolve(name, contentType) is not { } resolved)
        {
            await this.RaiseDropRejectedAsync(name, "Only images can be dropped into a document.");
            return;
        }

        // Dropped where the pointer was, not at wherever the caret happened to be left — the drop
        // point is the only thing the user actually indicated.
        if (this.controller.PositionAt(x, y) is { } position)
            this.controller.Selection.MoveTo(position);

        this.controller.InsertImage(Convert.FromBase64String(base64), resolved, name: Path.GetFileNameWithoutExtension(name));

        await this.RaiseChangedAsync();
        this.StateHasChanged();
    }

    async Task RaiseDropRejectedAsync(string name, string reason)
    {
        if (this.DropRejected.HasDelegate)
            await this.DropRejected.InvokeAsync(new OfficeDropRejected(name, reason));
    }

    async Task AttachDropAsync()
    {
        if (!this.AllowFileDrop)
            return;

        try
        {
            this.dropModule = await this.Js.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Shiny.Blazor.Controls.Office/officeDrop.js");

            this.dropHandle = await this.dropModule.InvokeAsync<IJSObjectReference>(
                "attach", this.host, this.selfReference, nameof(HandleFileDrop));
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Shiny.Office] File drop is unavailable: {ex.Message}");
        }
    }

    // ---- spelling menu ----

    sealed record SpellingMenu(double X, double Y, DocumentPosition At, string Word, IReadOnlyList<string> Suggestions);

    static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.InvariantCulture;

    SpellingMenu? spellingMenu;

    /// <summary>
    /// Right-click over a misspelling offers corrections; anywhere else it is an ordinary click.
    /// </summary>
    /// <remarks>
    /// The browser's own context menu is suppressed on the editor because the canvas has no text for
    /// it to act on - it would offer "Back" and "Reload" over a document.
    /// </remarks>
    async Task OnContextMenu(MouseEventArgs e)
    {
        this.spellingMenu = null;

        if (this.controller is null || this.ReadOnly)
            return;

        if (this.controller.PositionAt(e.OffsetX, e.OffsetY) is not { } position)
            return;

        if (this.controller.SpellingErrorAt(position) is not { } error)
        {
            this.StateHasChanged();
            return;
        }

        var suggestions = await this.controller.SuggestAtAsync(position);

        this.spellingMenu = new SpellingMenu(e.OffsetX, e.OffsetY, position, error.Word, suggestions);
        this.StateHasChanged();
    }

    /// <summary>
    /// Opens the spelling menu for the word the caret is in, anchored under it.
    /// </summary>
    /// <remarks>
    /// The toolbar's entry point. A right-click supplies its own coordinates because the pointer says
    /// where the menu goes; stepping to an error from the Review tab has no pointer, so the caret's
    /// own rectangle is the anchor.
    /// </remarks>
    public async Task ShowSpellingMenuForCaretAsync()
    {
        this.spellingMenu = null;

        if (this.controller is null || this.ReadOnly)
            return;

        var position = this.controller.Selection.Focus;
        if (this.controller.SpellingErrorAt(position) is not { } error)
        {
            this.StateHasChanged();
            return;
        }

        var suggestions = await this.controller.SuggestAtAsync(position);
        var caret = this.controller.CaretRect(position);
        var scale = this.controller.ViewScale;

        // CaretRect is in flow coordinates; the menu is placed in the surface's.
        var x = (caret.X + this.controller.ContentX) * scale;
        var y = (this.controller.Pagination.FlowToView(caret.Bottom) - this.controller.Viewport.ScrollY) * scale;

        this.spellingMenu = new SpellingMenu(x, y, position, error.Word, suggestions);
        this.StateHasChanged();
    }

    async Task ApplySuggestionAsync(string suggestion)
    {
        if (this.spellingMenu is { } menu && this.controller is not null)
            this.controller.ApplySuggestion(menu.At, suggestion);

        await this.CloseSpellingMenuAsync();
    }

    async Task IgnoreAsync()
    {
        if (this.spellingMenu is { } menu)
            this.controller?.IgnoreSpelling(menu.Word);

        await this.CloseSpellingMenuAsync();
    }

    async Task LearnAsync()
    {
        if (this.spellingMenu is { } menu)
            this.controller?.LearnSpelling(menu.Word);

        await this.CloseSpellingMenuAsync();
    }

    async Task CloseSpellingMenuAsync()
    {
        this.spellingMenu = null;
        this.canvas?.Invalidate();
        this.StateHasChanged();

        // Focus has to go back deliberately: clicking a menu button took it off the hidden input, and
        // leaving it there means the next keystroke goes nowhere.
        await this.FocusAsync();
    }

    /// <summary>
    /// Wheel scrolls; ctrl-wheel zooms; a wheel with a sideways component pans.
    /// </summary>
    /// <remarks>
    /// Ctrl-wheel is not a keyboard shortcut anyone had to learn - it is what a trackpad pinch is
    /// delivered as in every browser, so this is the pinch gesture as much as it is a modifier.
    /// </remarks>
    void OnWheel(WheelEventArgs e)
    {
        if (this.controller is not { } controller)
            return;

        if (e.CtrlKey)
        {
            // Small steps: a trackpad pinch arrives as a stream of these, and a per-notch factor big
            // enough to feel on a mouse wheel makes a pinch jump straight to the clamp.
            controller.Zoom *= e.DeltaY < 0 ? 1.05 : 1 / 1.05;
            return;
        }

        if (Math.Abs(e.DeltaX) > Math.Abs(e.DeltaY))
        {
            controller.ScrollHorizontally(e.DeltaX / controller.ViewScale);
            return;
        }

        controller.ScrollByControlPixels(e.DeltaY);
    }

    void OnFocus()
    {
        this.focused = true;
        this.canvas?.Invalidate();
    }

    void OnBlur()
    {
        this.focused = false;
        this.canvas?.Invalidate();
    }

    // ---- text input ----

    /// <summary>
    /// The single entry point for inserted text.
    /// </summary>
    /// <remarks>
    /// <c>beforeinput</c> rather than <c>keypress</c>: it is the only event that reports IME
    /// composition results, autocorrect, dictation and paste as ordinary text insertions. Handling
    /// keys instead works for a US keyboard and silently drops every other input method.
    /// </remarks>
    [JSInvokable]
    public async Task HandleBeforeInput(string inputType, string? data)
    {
        if (this.controller is null || this.ReadOnly)
            return;

        switch (inputType)
        {
            case "insertText":
            case "insertCompositionText":
            case "insertFromPaste":
            case "insertReplacementText":
                if (!string.IsNullOrEmpty(data))
                    this.controller.InsertText(data);

                break;

            case "insertParagraph":
            case "insertLineBreak":
                this.controller.InsertParagraph();
                break;

            case "deleteContentBackward":
                this.controller.DeleteBackward();
                break;

            case "deleteContentForward":
                this.controller.DeleteForward();
                break;

            case "deleteWordBackward":
                this.controller.Move(CaretMove.WordLeft, extend: true);
                this.controller.DeleteBackward();
                break;

            default:
                return;
        }

        await this.RaiseChangedAsync();
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (this.controller is null)
            return;

        var extend = e.ShiftKey;
        var word = e.CtrlKey || e.AltKey;
        this.preventKeyDefault = true;

        switch (e.Key)
        {
            case "ArrowLeft": this.controller.Move(word ? CaretMove.WordLeft : CaretMove.Left, extend); break;
            case "ArrowRight": this.controller.Move(word ? CaretMove.WordRight : CaretMove.Right, extend); break;
            case "ArrowUp": this.controller.Move(CaretMove.Up, extend); break;
            case "ArrowDown": this.controller.Move(CaretMove.Down, extend); break;
            case "Home": this.controller.Move(e.MetaKey || e.CtrlKey ? CaretMove.DocumentStart : CaretMove.LineStart, extend); break;
            case "End": this.controller.Move(e.MetaKey || e.CtrlKey ? CaretMove.DocumentEnd : CaretMove.LineEnd, extend); break;

            case "Tab":
                // Inside a list this nests the item; anywhere else it inserts a tab. Either way the
                // browser must not move focus out of the editor, which is what its default does.
                if (!this.controller.HandleTab(e.ShiftKey))
                    this.preventKeyDefault = false;
                else
                    await this.RaiseChangedAsync();

                break;

            case "a" when e.CtrlKey || e.MetaKey:
                this.controller.SelectAll();
                break;

            case "b" when e.CtrlKey || e.MetaKey:
                this.controller.ToggleBold();
                await this.RaiseChangedAsync();
                break;

            case "i" when e.CtrlKey || e.MetaKey:
                this.controller.ToggleItalic();
                await this.RaiseChangedAsync();
                break;

            case "u" when e.CtrlKey || e.MetaKey:
                this.controller.ToggleUnderline();
                await this.RaiseChangedAsync();
                break;

            case "z" when e.CtrlKey || e.MetaKey:
                if (e.ShiftKey)
                    this.controller.Redo();
                else
                    this.controller.Undo();

                await this.RaiseChangedAsync();
                break;

            case "y" when e.CtrlKey || e.MetaKey:
                this.controller.Redo();
                await this.RaiseChangedAsync();
                break;

            default:
                // Everything else - printable characters included - arrives through beforeinput, which
                // is what makes IME and dictation work. Swallowing it here would break both.
                this.preventKeyDefault = false;
                break;
        }
    }

    async Task AttachInputAsync()
    {
        try
        {
            this.selfReference = DotNetObjectReference.Create(this);
            this.inputModule = await this.Js.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Shiny.Blazor.Controls.Office/documentEditor.js");

            this.inputHandle = await this.inputModule.InvokeAsync<IJSObjectReference>("attach", this.input, this.selfReference);
        }
        catch (Exception ex)
        {
            // Prerendering or a host without JS interop leaves the editor navigable but unable to
            // accept text. Reported rather than swallowed: silence here is indistinguishable from an
            // editor that simply ignores the keyboard.
            Console.Error.WriteLine($"[Shiny.Office] Text input is unavailable: {ex.Message}");
        }
    }

    async Task RaiseChangedAsync()
    {
        this.canvas?.Invalidate();

        if (this.DocumentChanged.HasDelegate)
            await this.DocumentChanged.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (this.controller is not null)
            this.controller.Changed -= this.OnControllerChanged;

        await this.scheme.DisposeAsync();

        try
        {
            if (this.inputModule is not null && this.inputHandle is not null)
            {
                await this.inputModule.InvokeVoidAsync("detach", this.inputHandle);

                // The JS detach cannot free the handle: Blazor hands the module the unwrapped object,
                // which carries no reference id. Only .NET disposing it drops the JS-side entry that
                // otherwise keeps the listener closure - and with it the detached element - alive.
                await this.inputHandle.DisposeAsync();
            }

            if (this.inputModule is not null)
                await this.inputModule.DisposeAsync();

            if (this.dropModule is not null && this.dropHandle is not null)
            {
                await this.dropModule.InvokeVoidAsync("detach", this.dropHandle);

                // The JS detach cannot free the handle: Blazor hands the module the unwrapped object,
                // which carries no reference id. Only .NET disposing it drops the JS-side entry that
                // otherwise keeps the listener closure - and with it the detached element - alive.
                await this.dropHandle.DisposeAsync();
            }

            if (this.dropModule is not null)
                await this.dropModule.DisposeAsync();
        }
        catch (Exception)
        {
            // The circuit may already be gone; detaching a listener is best-effort.
        }

        this.selfReference?.Dispose();
        this.painter?.Dispose();
        this.measurer?.Dispose();
    }

    /// <summary>
    /// A picture drawn behind the content - a logo, a DRAFT stamp, a company mark.
    /// </summary>
    /// <remarks>
    /// A <b>display</b> watermark: it is drawn, not written into the file. The three Office formats
    /// have no common notion of one, so persisting would mean three unrelated mechanisms where drawing
    /// means one. See <see cref="OfficeWatermark"/>.
    /// </remarks>
    [Parameter] public OfficeWatermark? Watermark { get; set; }

}
