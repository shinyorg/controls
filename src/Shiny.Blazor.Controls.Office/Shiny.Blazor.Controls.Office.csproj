<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <RootNamespace>Shiny.Blazor.Controls.Office</RootNamespace>
        <Description>Spreadsheet viewer and editor for Blazor WebAssembly, rendering .xlsx on a SkiaSharp canvas.</Description>
    </PropertyGroup>

    <ItemGroup>
        <!-- Fails the consumer's build when the wasm-tools workload is missing, instead of letting
             them publish an app that dies on the first Skia call. See the targets file. -->
        <None Include="buildTransitive/Shiny.Blazor.Controls.Office.targets" Pack="true" PackagePath="buildTransitive/Shiny.Blazor.Controls.Office.targets" />
    </ItemGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web"/>
        <PackageReference Include="SkiaSharp.Views.Blazor"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.Blazor.Controls.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Controls.Office.Shared\Shiny.Controls.Office.Shared.csproj"/>
        <ProjectReference Include="..\Shiny.Controls.Office.Skia\Shiny.Controls.Office.Skia.csproj"/>

        <!-- DocumentEditorView composes the core package's ShinyToolbar. Without this reference the
             element is not a component at all: Razor emits it as unknown markup and the toolbar
             silently does not exist. -->
        <ProjectReference Include="..\Shiny.Blazor.Controls\Shiny.Blazor.Controls.csproj"/>
    </ItemGroup>
</Project>
