@using SkiaSharp
@using SkiaSharp.Views.Blazor
@using Shiny.Controls.Office.Presentation
@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="shiny-slides @(IsPresenting ? "shiny-slides-presenting" : null) @Class"
     @ref="schemeHost"
     style="@(IsPresenting ? null : Style)"
     tabindex="0"
     @onwheel="OnWheel"
     @onwheel:preventDefault="true"
     @onkeydown="OnKeyDown"
     @onkeydown:preventDefault="preventKeyDefault">

    <SKCanvasView @ref="canvas"
                  class="shiny-slides-canvas"
                  IgnorePixelScaling="false"
                  OnPaintSurface="OnPaint"
                  @onclick="OnClick" />

    @if (IsPresenting && ShowPresenterControls)
    {
        @if (notesShown)
        {
            <div class="shiny-slides-notes">@(string.IsNullOrWhiteSpace(CurrentNotes) ? "No notes on this slide." : CurrentNotes)</div>
        }

        <div class="shiny-slides-chrome" @onclick:stopPropagation="true">
            <button type="button" class="shiny-slides-btn" aria-label="Previous slide"
                    disabled="@(controller?.CanGoPrevious != true)" @onclick="Previous">&lsaquo;</button>

            <span class="shiny-slides-counter">@(SlideIndex + 1) / @(controller?.Count ?? 0)</span>

            <button type="button" class="shiny-slides-btn" aria-label="Next slide"
                    disabled="@(controller?.CanGoNext != true)" @onclick="Next">&rsaquo;</button>

            @if (DeckHasNotes)
            {
                <button type="button" class="shiny-slides-btn shiny-slides-btn-text"
                        aria-pressed="@notesShown" @onclick="ToggleNotes">Notes</button>
            }

            <button type="button" class="shiny-slides-btn shiny-slides-btn-text"
                    @onclick="StopPresentingAsync">Exit</button>
        </div>
    }
</div>

@code {
    /// <summary>The left edge band where a click goes back instead of forward, as a fraction of the width.</summary>
    const double BackClickZone = 0.25;

    SKCanvasView? canvas;
    SkiaTextMeasurer? measurer;
    SlidePainter? painter;
    SlideController? controller;
    bool preventKeyDefault;
    bool applyingParameters;
    bool presentingApplied;
    bool notesShown;
    IJSObjectReference? module;
    DotNetObjectReference<SlideView>? selfRef;
    double lastWidth;
    double lastHeight;

    /// <summary>
    /// The theme the canvas was last painted with.
    /// </summary>
    /// <remarks>
    /// SKCanvasView only repaints when Invalidate is called; a Blazor re-render does not touch the
    /// canvas contents. Without this comparison a theme change updates the parameter, re-renders the
    /// component, and leaves the old pixels on screen - the toggle appears to do nothing at all.
    /// </remarks>
    SlideTheme? paintedTheme;
    ThemeSchemeWatcher scheme = null!;
    ElementReference schemeHost;

    /// <summary>
    /// Device pixel ratio, read once from the browser.
    /// </summary>
    /// <remarks>
    /// SKCanvasView hands back a surface in device pixels but does not expose the ratio it used.
    /// Deriving it from the last known CSS width is circular — width = info.Width / (info.Width /
    /// lastWidth) is just lastWidth — so the size could never change after the first paint, and the
    /// grid stayed frozen at whatever the element measured on its very first frame.
    /// </remarks>
    double dpr = 1;

    [Parameter] public SlideDeck? Deck { get; set; }

    /// <summary>
    /// Chrome colours. Left unset the surface follows the page's light/dark scheme;
    /// setting it pins the choice, including to <see cref="SlideTheme.Light"/>.
    /// </summary>
    [Parameter] public SlideTheme? Theme { get; set; }

    // Presenting overrides the surface's own theme rather than composing with it: a projected deck is
    // black-surrounded whatever the page is set to. Composing instead left the app's own surface colour
    // as the surround, which on a light page is a pale blue frame around the slide on the projector.
    SlideTheme EffectiveTheme => this.IsPresenting
        ? SlideTheme.Presentation
        : OfficeScheme.Resolve(this.scheme, this.Theme);

    [Parameter] public SlideViewMode Mode { get; set; } = SlideViewMode.Single;

    [Parameter] public EventCallback<SlideViewMode> ModeChanged { get; set; }

    [Parameter] public int SlideIndex { get; set; }

    [Parameter] public EventCallback<int> SlideIndexChanged { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public string? Style { get; set; }

    /// <summary>
    /// Present the deck full screen: the slide edge to edge on black, the page's own chrome gone, and
    /// the presenter bar fading out until the pointer moves.
    /// </summary>
    /// <remarks>
    /// The CSS class does the covering and the browser's Fullscreen API is asked for on top of it, not
    /// the other way round: a fullscreen request can be refused — an iframe without
    /// <c>allowfullscreen</c>, iOS Safari, a gesture the browser did not accept, prerendering — and a
    /// refusal must still give the room a full-window deck rather than nothing at all.
    /// <see cref="Mode"/> is ignored while presenting and reapplied when the show ends.
    /// </remarks>
    [Parameter] public bool IsPresenting { get; set; }

    [Parameter] public EventCallback<bool> IsPresentingChanged { get; set; }

    /// <summary>
    /// Show the auto-hiding presenter bar over a presented deck. Default <c>true</c>; turn it off for a
    /// kiosk or a second screen nobody is meant to be driving from the surface itself.
    /// </summary>
    [Parameter] public bool ShowPresenterControls { get; set; } = true;

    public SlideController? Controller => this.controller;

    /// <summary>Speaker notes on the slide being shown, if it has any.</summary>
    public string? CurrentNotes => this.controller?.Current?.Notes;

    bool DeckHasNotes => this.Deck?.Slides.Any(x => !string.IsNullOrWhiteSpace(x.Notes)) == true;

    /// <summary>Advance one slide. Clamped at the end of the deck.</summary>
    public void Next() => this.controller?.Next();

    /// <summary>Go back one slide. Clamped at the start of the deck.</summary>
    public void Previous() => this.controller?.Previous();

    /// <summary>Start the show. A no-op without a deck.</summary>
    public Task StartPresentingAsync()
        => this.Deck is null ? Task.CompletedTask : this.SetPresentingAsync(true);

    /// <summary>End the show and return to the inline viewer.</summary>
    public Task StopPresentingAsync() => this.SetPresentingAsync(false);

    /// <summary>Flip <see cref="IsPresenting"/>.</summary>
    public Task TogglePresentingAsync() => this.SetPresentingAsync(!this.IsPresenting);

    async Task SetPresentingAsync(bool value)
    {
        if (this.IsPresenting == value)
            return;

        this.IsPresenting = value;
        this.presentingApplied = value;

        if (this.controller is not null)
        {
            this.controller.IsPresenting = value;

            // Presenting forced Single on the controller; ending the show puts back whatever mode the
            // host asked for, which is usually the thumbnail grid the presenter started from.
            if (!value)
                this.controller.Mode = this.Mode;
        }

        if (!value)
            this.notesShown = false;

        if (this.IsPresentingChanged.HasDelegate)
            await this.IsPresentingChanged.InvokeAsync(value);

        await this.ApplyPresentingAsync(value);

        this.canvas?.Invalidate();
        this.StateHasChanged();
    }

    async Task ApplyPresentingAsync(bool value)
    {
        if (this.module is null)
            return;

        try
        {
            if (value)
            {
                await this.module.InvokeAsync<bool>("present", this.schemeHost);
                await this.module.InvokeVoidAsync("wake", this.schemeHost);
            }
            else
            {
                await this.module.InvokeVoidAsync("exit", this.schemeHost);
            }
        }
        catch (JSException)
        {
            // A refused fullscreen request is not a refused show: the CSS class is already covering
            // the viewport, so there is nothing to undo.
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>
    /// The browser left fullscreen. Escape and F11 never reach the component's own key handler, so this
    /// is the only thing that keeps <see cref="IsPresenting"/> honest about them.
    /// </summary>
    [JSInvokable]
    public async Task OnPresentingChangedJs(bool isFullscreen)
    {
        // Entering is always something this component asked for, and a browser-chrome fullscreen (F11)
        // reports a different element - neither is a show starting.
        if (isFullscreen || !this.IsPresenting)
            return;

        await this.SetPresentingAsync(false);
    }

    void ToggleNotes() => this.notesShown = !this.notesShown;

    protected override void OnInitialized()
        // The canvas only redraws when told to, so a scheme flip has to invalidate it explicitly.
        => this.scheme = new ThemeSchemeWatcher(this.Js, () =>
        {
            this.canvas?.Invalidate();
            this.StateHasChanged();
            return Task.CompletedTask;
        });

    protected override void OnParametersSet()
    {
        // First, before any of the early returns below: SKCanvasView only repaints when Invalidate is
        // called, so a theme change that does not reach this leaves the old pixels on screen and the
        // toggle appears to do nothing.
        if (this.paintedTheme != this.EffectiveTheme)
        {
            this.paintedTheme = this.EffectiveTheme;
            this.canvas?.Invalidate();
        }

        if (this.Deck is null)
        {
            this.controller = null;
            return;
        }

        this.measurer ??= new SkiaTextMeasurer();
        this.painter ??= new SlidePainter(this.measurer);

        if (this.controller is null || !ReferenceEquals(this.controller.Deck, this.Deck))
        {
            if (this.controller is not null)
                this.controller.Changed -= this.OnControllerChanged;

            this.controller = new SlideController(this.Deck);
            this.controller.Changed += this.OnControllerChanged;

            if (this.lastWidth > 0)
                this.controller.Resize(this.lastWidth, this.lastHeight);
        }

        // Applying parameters mutates the controller, which raises Changed. Without this guard that
        // event writes the controller's *current* state back to the parent mid-update: assigning Mode
        // fires Changed while Index is still the old value, the stale index is pushed to the parent,
        // and the navigation the parent just requested is silently undone.
        this.applyingParameters = true;
        try
        {
            this.controller.Index = this.SlideIndex;
            this.controller.IsPresenting = this.IsPresenting;

            // Mode is ignored while presenting: the controller forces Single there, and re-asserting the
            // host's parameter would put the thumbnail wall back up on the projector every render.
            if (!this.IsPresenting)
                this.controller.Mode = this.Mode;
        }
        finally
        {
            this.applyingParameters = false;
        }
    }

    async void OnControllerChanged(object? sender, EventArgs e)
    {
        if (this.controller is { } controller && !this.applyingParameters)
        {
            if (controller.Index != this.SlideIndex)
            {
                this.SlideIndex = controller.Index;
                if (this.SlideIndexChanged.HasDelegate)
                    await this.SlideIndexChanged.InvokeAsync(controller.Index);
            }

            if (controller.Mode != this.Mode)
            {
                this.Mode = controller.Mode;
                if (this.ModeChanged.HasDelegate)
                    await this.ModeChanged.InvokeAsync(controller.Mode);
            }
        }

        this.canvas?.Invalidate();
        this.StateHasChanged();
    }

    void OnPaint(SKPaintSurfaceEventArgs e)
    {
        var info = e.Info;
        var theme = this.EffectiveTheme;
        var surface = e.Surface.Canvas;

        surface.Clear(new SKColor(theme.Surround.R, theme.Surround.G, theme.Surround.B));

        if (this.controller is null || this.painter is null)
            return;

        // The surface arrives in device pixels; the layout works in CSS pixels.
        var scale = (float)this.dpr;
        var width = info.Width / this.dpr;
        var height = info.Height / this.dpr;

        if (this.lastWidth <= 0 || Math.Abs(width - this.lastWidth) > 0.5 || Math.Abs(height - this.lastHeight) > 0.5)
        {
            this.lastWidth = width;
            this.lastHeight = height;
            this.controller.Resize(width, height);
        }

        if (this.controller.Mode == SlideViewMode.Grid)
        {
            foreach (var placement in this.controller.VisibleThumbnails())
                this.PaintPlacement(surface, placement, theme, scale);

            return;
        }

        if (this.controller.SinglePlacement() is { } single)
            this.PaintPlacement(surface, single, theme, scale);
    }

    void PaintPlacement(SKCanvas surface, SlidePlacement placement, SlideTheme theme, float scale)
    {
        if (this.controller is null || this.painter is null)
            return;

        this.painter.Paint(surface, new SlidePaintRequest
        {
            Watermark = this.Watermark,
            Slide = placement.Slide,
            SlideWidth = this.controller.Deck.SlideWidth,
            SlideHeight = this.controller.Deck.SlideHeight,
            DestinationX = placement.X,
            DestinationY = placement.Y,
            DestinationWidth = placement.Width,
            DestinationHeight = placement.Height,
            Theme = theme,
            Scale = scale,
            DrawBorder = !this.IsPresenting
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            // A host that bound IsPresenting rather than calling StartPresentingAsync gets the fullscreen
            // request here, once the parameter has actually rendered.
            if (this.IsPresenting != this.presentingApplied)
            {
                this.presentingApplied = this.IsPresenting;
                await this.ApplyPresentingAsync(this.IsPresenting);
            }

            return;
        }

        // Before the DPR read: the canvas paints its first frame off this, and starting the watch
        // second would flash a white page in a dark app.
        await this.scheme.StartAsync(this.schemeHost);

        try
        {
            this.dpr = await this.Js.InvokeAsync<double>("eval", "window.devicePixelRatio || 1");
        }
        catch (Exception)
        {
            // Prerendering or a locked-down host: 1 is the safe assumption.
            this.dpr = 1;
        }

        if (this.dpr <= 0)
            this.dpr = 1;

        this.canvas?.Invalidate();

        if (await OfficeFonts.EnsureLoadedAsync(this.Js))
        {
            // The first frame painted with fallback metrics; the measurer's cache is invalidated by
            // the new registrations, so a repaint now re-measures against the real faces.
            this.canvas?.Invalidate();
            this.StateHasChanged();
        }

        await this.LoadPresentingModuleAsync();

        if (this.IsPresenting)
        {
            this.presentingApplied = true;
            await this.ApplyPresentingAsync(true);
        }
    }

    async Task LoadPresentingModuleAsync()
    {
        try
        {
            this.module = await this.Js.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Shiny.Blazor.Controls.Office/slideView.js");

            this.selfRef = DotNetObjectReference.Create(this);
            await this.module.InvokeVoidAsync("attach", this.schemeHost, this.selfRef);
        }
        catch (Exception)
        {
            // Prerendering, or a host that does not serve static web assets. Presenting then falls back
            // to the CSS-only full-window surface, which needs no module at all.
            this.module = null;
        }
    }

    void OnWheel(WheelEventArgs e)
    {
        if (this.controller is null)
            return;

        if (this.controller.Mode == SlideViewMode.Grid)
        {
            this.controller.Scroll(e.DeltaY);
            return;
        }

        if (e.DeltaY > 0)
            this.controller.Next();
        else
            this.controller.Previous();
    }

    void OnClick(MouseEventArgs e)
    {
        if (this.controller is null)
            return;

        if (this.IsPresenting)
        {
            // Tap-anywhere-to-advance, with a back band down the left edge. The presenter bar stops
            // propagation, so its own buttons never also move the deck.
            if (e.OffsetX < this.lastWidth * BackClickZone)
                this.controller.Previous();
            else
                this.controller.Next();

            return;
        }

        if (this.controller.Mode != SlideViewMode.Grid)
            return;

        var index = this.controller.ThumbnailAt(e.OffsetX, e.OffsetY);
        if (index < 0)
            return;

        this.controller.Index = index;
        this.controller.Mode = SlideViewMode.Single;
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (this.controller is null)
            return;

        this.preventKeyDefault = true;

        switch (e.Key)
        {
            // PowerPoint's own keys for starting and ending a show.
            case "F5":
                await this.StartPresentingAsync();
                return;

            case "Escape" when this.IsPresenting:
                await this.StopPresentingAsync();
                return;

            case "ArrowRight":
            case "ArrowDown":
            case "PageDown":
            case " ": this.controller.Next(); break;

            case "ArrowLeft":
            case "ArrowUp":
            case "PageUp": this.controller.Previous(); break;

            case "Home": this.controller.Index = 0; break;
            case "End": this.controller.Index = this.controller.Count - 1; break;

            case "Escape":
                this.controller.Mode = this.controller.Mode == SlideViewMode.Grid
                    ? SlideViewMode.Single
                    : SlideViewMode.Grid;

                break;

            default: this.preventKeyDefault = false; break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (this.controller is not null)
            this.controller.Changed -= this.OnControllerChanged;

        if (this.module is not null)
        {
            try
            {
                await this.module.InvokeVoidAsync("detach", this.schemeHost);
                await this.module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit went away first; the listeners went with it.
            }
        }

        this.selfRef?.Dispose();

        this.painter?.Dispose();
        this.measurer?.Dispose();
        await this.scheme.DisposeAsync();
    }

    /// <summary>
    /// A picture drawn behind the content - a logo, a DRAFT stamp, a company mark.
    /// </summary>
    /// <remarks>
    /// A <b>display</b> watermark: it is drawn, not written into the file. The three Office formats
    /// have no common notion of one, so persisting would mean three unrelated mechanisms where drawing
    /// means one. See <see cref="OfficeWatermark"/>.
    /// </remarks>
    [Parameter] public OfficeWatermark? Watermark { get; set; }

}
