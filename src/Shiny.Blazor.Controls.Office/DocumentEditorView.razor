    // ---- dialogs ----

    enum DialogKind
    {
        None,
        Header,
        Footer,
        Replace,
        Hyperlink,
        Comment,
        Bookmark,
        Footnote,
        Watermark,
        WordCount,
        Symbols
    }

    DialogKind dialog;
    string textOne = string.Empty;
    string textTwo = string.Empty;
    bool matchCase;
    bool wholeWord;
    string? status;
    DocumentStatistics stats = DocumentStatistics.Empty;

    string DialogTitle => this.dialog switch
    {
        DialogKind.Header => "Header",
        DialogKind.Footer => "Footer",
        DialogKind.Replace => "Find and Replace",
        DialogKind.Hyperlink => this.C?.CurrentHyperlink is null ? "Insert Link" : "Edit Link",
        DialogKind.Comment => "New Comment",
        DialogKind.Bookmark => "Bookmark",
        DialogKind.Footnote => "Insert Footnote",
        DialogKind.Watermark => "Custom Watermark",
        DialogKind.WordCount => "Word Count",
        DialogKind.Symbols => "Symbol",
        _ => string.Empty
    };

    string CommitLabel => this.dialog switch
    {
        DialogKind.Comment => "Post",
        DialogKind.Bookmark => "Add",
        DialogKind.Footnote => "Insert",
        DialogKind.Watermark => "Apply",
        _ => "Set"
    };

    void Open(DialogKind kind)
    {
        if (this.C is null)
            return;

        this.dialog = kind;
        this.textOne = string.Empty;
        this.textTwo = string.Empty;
        this.status = null;

        if (kind == DialogKind.WordCount)
            this.stats = this.C.Statistics;
    }

    void OpenChrome(bool header)
    {
        if (this.C is not { } controller || this.Disabled)
            return;

        this.Open(header ? DialogKind.Header : DialogKind.Footer);
        this.textOne = controller.ChromeText(header) ?? string.Empty;
    }

    void OpenReplace()
    {
        if (this.C is not { } controller)
            return;

        this.Open(DialogKind.Replace);
        var selected = this.SelectedText();
        this.textOne = selected.Length > 0 ? selected : controller.Find.Query;
        this.matchCase = controller.Find.Options.MatchCase;
        this.wholeWord = controller.Find.Options.WholeWord;
    }

    void OpenHyperlink()
    {
        if (this.C is not { } controller || this.Disabled)
            return;

        this.Open(DialogKind.Hyperlink);

        if (controller.CurrentHyperlink is { } link)
        {
            this.textOne = link.Text;
            this.textTwo = link.Target;
        }
        else
        {
            this.textOne = this.SelectedText();
        }
    }

    void OpenComment()
    {
        if (!this.Disabled)
            this.Open(DialogKind.Comment);
    }

    void OpenBookmark()
    {
        if (!this.Disabled)
            this.Open(DialogKind.Bookmark);
    }

    /// <summary>The selection's text when it lies within one paragraph, or empty.</summary>
    string SelectedText()
    {
        if (this.C is not { } controller || controller.Selection.IsEmpty)
            return string.Empty;

        var range = controller.Selection.Range;
        if (!range.IsWithinOneBlock)
            return string.Empty;

        var text = controller.Document.Paragraphs[range.Start.Block].PlainText;
        var from = Math.Min(range.Start.Offset, text.Length);
        var to = Math.Min(range.End.Offset, text.Length);
        return text[from..to].Replace("￼", string.Empty);
    }

    async Task OnShortcutRequested(WordCommand command)
    {
        switch (command)
        {
            case WordCommand.Find:
                // The find box lives on Home; bring the tab to the front so it is there to type into.
                this.selectedTab = "home";
                break;

            case WordCommand.Replace: this.OpenReplace(); break;
            case WordCommand.Hyperlink: this.OpenHyperlink(); break;
            case WordCommand.NewComment: this.OpenComment(); break;
            case WordCommand.WordCount: this.Open(DialogKind.WordCount); break;
        }

        await Task.CompletedTask;
        this.StateHasChanged();
    }

    async Task OnDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await this.CloseDialog();
            return;
        }

        // Enter commits a one-line form; in a textarea it is a new line unless Ctrl is held.
        if (e.Key != "Enter")
            return;

        switch (this.dialog)
        {
            case DialogKind.Replace:
                await this.ReplaceFindNext();
                break;

            case DialogKind.Comment or DialogKind.Footnote when !e.CtrlKey && !e.MetaKey:
                break;

            case DialogKind.WordCount or DialogKind.Symbols:
                await this.CloseDialog();
                break;

            default:
                await this.CommitDialog();
                break;
        }
    }

    async Task CloseDialog()
    {
        this.dialog = DialogKind.None;
        this.status = null;

        if (this.editor is { } surface)
            await surface.FocusAsync();
    }

    async Task CommitDialog()
    {
        if (this.C is not { } controller)
        {
            this.dialog = DialogKind.None;
            return;
        }

        var kind = this.dialog;
        var one = this.textOne;
        var two = this.textTwo;

        switch (kind)
        {
            case DialogKind.Header:
            case DialogKind.Footer:
                // An empty line removes it, which is the only way back out of having one.
                var text = string.IsNullOrWhiteSpace(one) ? null : one;
                if (kind == DialogKind.Header)
                    controller.SetHeaderText(text);
                else
                    controller.SetFooterText(text);

                break;

            case DialogKind.Hyperlink:
                if (string.IsNullOrWhiteSpace(two))
                    return;

                controller.InsertHyperlink(NormalizeAddress(two), one);
                break;

            case DialogKind.Comment:
                if (string.IsNullOrWhiteSpace(one))
                    return;

                controller.AddComment(one);
                break;

            case DialogKind.Bookmark:
                if (!controller.InsertBookmark(one.Trim()))
                    return;

                break;

            case DialogKind.Footnote:
                controller.InsertFootnote(one);
                break;

            case DialogKind.Watermark:
                controller.SetWatermarkText(string.IsNullOrWhiteSpace(one) ? null : one);
                break;
        }

        await this.CloseDialog();
        await this.RaiseChangedAsync();
    }

    /// <summary>A bare domain gets a scheme, as Word's link dialog does; a bookmark or mail link is left alone.</summary>
    static string NormalizeAddress(string address)
    {
        address = address.Trim();

        if (address.StartsWith('#') || address.Contains("://", StringComparison.Ordinal) ||
            address.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase))
        {
            return address;
        }

        return address.Contains('@') ? "mailto:" + address : "https://" + address;
    }

    void PickBookmarkTarget(DocumentBookmark mark) => this.textTwo = "#" + mark.Name;

    async Task RemoveLink()
    {
        this.C?.RemoveHyperlink();
        await this.CloseDialog();
        await this.RaiseChangedAsync();
    }

    async Task GoToBookmark(string name)
    {
        this.C?.GoToBookmark(name);
        await this.CloseDialog();
    }

    async Task InsertSymbol(string symbol)
    {
        // The grid stays open, like Word's, so several symbols can go in one after another.
        if (this.C is { } controller && !this.Disabled)
        {
            controller.InsertSymbol(symbol);
            await this.RaiseChangedAsync();
        }
    }

    /// <summary>Points the finder at the dialog's query, re-running it only when something changed.</summary>
    bool SyncFind()
    {
        if (this.C is not { } controller || string.IsNullOrEmpty(this.textOne))
            return false;

        var options = new FindOptions { MatchCase = this.matchCase, WholeWord = this.wholeWord };
        var changed = controller.Find.Query != this.textOne || controller.Find.Options != options;

        controller.Find.Options = options;
        controller.Find.Query = this.textOne;
        return changed;
    }

    async Task ReplaceFindNext()
    {
        if (this.C is not { } controller)
            return;

        // A changed query lands on its first hit by itself; stepping again would skip that one.
        if (!this.SyncFind())
            controller.Find.FindNext();

        this.status = controller.Find.Count == 0 ? "No matches." : $"Match {controller.Find.Status}";
        await Task.CompletedTask;
    }

    async Task ReplaceOne()
    {
        if (this.C is not { } controller || this.Disabled)
            return;

        this.SyncFind();
        controller.ReplaceCurrent(this.textTwo ?? string.Empty);

        this.status = controller.Find.Count == 0 ? "All done." : $"Match {controller.Find.Status}";
        await this.RaiseChangedAsync();
    }

    async Task ReplaceAll()
    {
        if (this.C is not { } controller || this.Disabled || string.IsNullOrEmpty(this.textOne))
            return;

        var options = new FindOptions { MatchCase = this.matchCase, WholeWord = this.wholeWord };
        var count = controller.ReplaceAll(this.textOne, this.textTwo ?? string.Empty, options);

        this.status = count == 0 ? "No matches." : $"{count} replaced.";
        await this.RaiseChangedAsync();
    }

    // ---- zoom ----

    /// <summary>The zoom stops the buttons step through.</summary>
    static readonly double[] ZoomStops = [0.5, 0.75, 1.0, 1.25, 1.5, 2.0, 3.0];

    double? zoomOverride;

    /// <summary>The zoom in force: the toolbar's own, or the host's if it has not been overridden here.</summary>
    double ZoomLevel => this.zoomOverride ?? this.Zoom;

    bool CanZoomIn => this.ZoomLevel < ZoomStops[^1] - 0.001;

    bool CanZoomOut => this.ZoomLevel > ZoomStops[0] + 0.001;

    async Task StepZoom(int direction)
    {
        var current = this.ZoomLevel;

        var next = direction > 0
            ? ZoomStops.FirstOrDefault(z => z > current + 0.001, ZoomStops[^1])
            : ZoomStops.LastOrDefault(z => z < current - 0.001, ZoomStops[0]);

        await this.SetZoomAsync(next);
    }

    /// <summary>Sets the zoom so the page exactly spans the window. Only in print.</summary>
    async Task FitToWidth()
    {
        if (this.C is not { IsPaginated: true } controller)
            return;

        var page = controller.PageWidth;
        var available = controller.Viewport.Width * controller.ViewScale;

        if (page <= 0 || available <= 0)
            return;

        await this.SetZoomAsync(available / page);
    }

    async Task SetZoomAsync(double value)
    {
        this.zoomOverride = value;

        if (this.C is { } controller)
            controller.Zoom = value;

        await this.ZoomChanged.InvokeAsync(value);
    }

    // ---- spelling ----

    bool SpellCheckOn => this.spellCheckOverride ?? this.SpellCheckEnabled;

    bool? spellCheckOverride;

    async Task ToggleSpellCheck()
    {
        var next = !this.SpellCheckOn;
        this.spellCheckOverride = next;

        if (this.C is { } controller)
            controller.IsSpellCheckEnabled = next;

        await this.SpellCheckEnabledChanged.InvokeAsync(next);
    }

    async Task GoToSpellingError(bool backwards)
    {
        if (this.C is not { } controller || this.Disabled)
            return;

        if (await controller.GoToNextSpellingErrorAsync(backwards) is null)
            return;

        if (this.editor is { } surface)
            await surface.ShowSpellingMenuForCaretAsync();
    }

    // ---- commands ----

    /// <summary>The document's current margins, for the gallery to mark. Null until one is open.</summary>
    PageMargins? Margins => this.C?.PageMargins;

    PageOrientation Orientation => this.C?.PageOrientation ?? PageOrientation.Portrait;

    string ColorHex => OfficeColors.ToHex(this.Format.Color);

    /// <summary>
    /// Runs a command against the controller, then gives the editor its focus back and reports the
    /// change. Commands that only look — navigation, view toggles — pass <c>requireEditable: false</c>.
    /// </summary>
    async Task Run(Action<DocumentEditorController> action, bool requireEditable = true)
    {
        if (this.C is not { } controller || (requireEditable && this.Disabled))
            return;

        action(controller);

        // Focus goes back to the editor after every toolbar action: leaving it on the button means the
        // next keystroke goes nowhere, which reads as the editor having silently stopped working.
        if (this.editor is { } surface)
            await surface.FocusAsync();

        await this.RaiseChangedAsync();
    }

    Task Run(Func<DocumentEditorController, bool> action, bool requireEditable = true)
        => this.Run(c => { _ = action(c); }, requireEditable);

    async Task Paste(bool plain)
    {
        if (this.editor is { } surface && !this.Disabled)
            await surface.PasteAsync(plain);
    }

    async Task Cut()
    {
        if (this.editor is { } surface && !this.Disabled)
            await surface.CutAsync();
    }

    async Task Copy()
    {
        if (this.editor is { } surface)
        {
            await surface.CopyAsync();
            await surface.FocusAsync();
        }
    }

    Task Align(TextAlignment alignment) => this.Run(c => c.SetAlignment(alignment));

    Task OnFontChanged(string family)
        => family is { Length: > 0 }
            ? this.Run(c => c.SetFontFamily(family))
            : Task.CompletedTask;

    Task OnSizeChanged(double size)
        => size > 0
            ? this.Run(c => c.SetFontSize(size))
            : Task.CompletedTask;

    Task OnColorChanged(string hex)
        => OfficeColors.TryParse(hex, out var color)
            ? this.Run(c => c.SetTextColor(color))
            : Task.CompletedTask;

    Task OnHighlightPicked(ArgbColor? color) => this.Run(c => c.SetHighlight(color));

    Task OnMarginsPicked(PageMargins margins) => this.Run(c => c.SetPageMargins(margins));

    Task OnShapePicked(ShapeGeometry geometry)
        => this.Run(c => c.InsertShape(geometry, this.ShapeWidth, this.ShapeHeight));

    Task OnTablePicked((int Rows, int Columns) size)
        => this.Run(c => c.InsertTable(size.Rows, size.Columns));

    Task OnImagePicked(OfficePickedImage image)
        => this.Run(c => c.InsertImage(
            image.Data,
            image.ContentType,
            this.PictureWidth,
            name: Path.GetFileNameWithoutExtension(image.FileName)));

    async Task OnDocumentChanged() => await this.RaiseChangedAsync();

    async Task RaiseChangedAsync()
    {
        this.StateHasChanged();

        if (this.DocumentChanged.HasDelegate)
            await this.DocumentChanged.InvokeAsync();
    }

    /// <summary>The colour this control wears: its ribbon's header band and tab underline.</summary>
    [Parameter] public OfficeAccent? Accent { get; set; } = OfficeAccent.Document;

    string? AccentBackground => this.Accent is { } a ? Css(a.Color) : null;

    string? AccentInk => this.Accent is { } a ? Css(a.Ink) : null;

    static string Css(ArgbColor value)
        => $"rgba({value.R},{value.G},{value.B},{(value.A / 255d).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)})";

    /// <summary>A picture drawn behind the page. Forwarded to the surface.</summary>
    [Parameter] public OfficeWatermark? Watermark { get; set; }

    Task OnWatermarkPicked(OfficeWatermark? mark)
    {
        this.Watermark = mark;
        this.StateHasChanged();
        return Task.CompletedTask;
    }
}
