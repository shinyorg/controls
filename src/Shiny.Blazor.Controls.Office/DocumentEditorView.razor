@using Shiny.Blazor.Controls
@using Shiny.Controls.Office.Document
@using Shiny.Controls.Office.Icons
@using Shiny.Controls.Office.Packaging
@using Shiny.Controls.Office.Shapes
@using Shiny.Controls.Office.Spreadsheet
@using Shiny.Controls.Office.Text
@implements IDisposable

@*
    DocumentEditor with Word's chrome on top: the ribbon, its dialogs, a navigation pane and read mode.

    The tabs follow Word's own — Home, Insert, Design, Layout, References, Review, View — with the
    contextual Table tab appearing while the caret is in a table. Every command runs through the
    shared DocumentEditorController, so this file only decides where a command sits and what it is
    called; the MAUI DocumentEditorView builds the same bar from the same calls.

    The pickers (font, size, colour, highlight) are the core package's own. Every plain button draws
    from the shared Office icon set, the Word-only ones from WordIcons, so the mark for a command is
    one definition rendered on both hosts.
*@
<div class="shiny-doc-editor-view @OfficeScheme.ScopeClass(this.Theme) @Class" style="@Style">

    @if (ShowToolbar && !ReadModeOn)
    {
        @*
            The class stays on a div declared here, not on the Ribbon's CssClass. This file's scoped
            rules read `.doc-toolbar ::deep .x`, which compiles to `.doc-toolbar[scope-of-this-file] .x`
            - put the class on a child component's root and it carries that component's scope id
            instead, and every rule in this stylesheet silently stops matching.
        *@
        <div class="doc-toolbar">
        <Ribbon ShowTabStrip="ShowRibbonTabs"
                AllowCollapse="ShowRibbonTabs"
                SmallItemRows="2"
                SelectedKey="@selectedTab"
                SelectedKeyChanged="k => this.selectedTab = k"
                ApplicationButtonText="@(FileClicked.HasDelegate ? "File" : null)"
                ApplicationButtonClicked="FileClicked"
                HeaderBackgroundColor="@(AccentBackground ?? ChosenToolbarBackground)"
                HeaderForegroundColor="@AccentInk"
                AccentColor="@AccentInk"
                BodyBackgroundColor="@ChosenToolbarBackground">
            <QuickAccess>
                <RibbonButton Size="RibbonItemSize.Small" Tooltip="Undo (Ctrl+Z)" Icon="@Ico(OfficeIcon.Undo)"
                              Disabled="@(Disabled || !(C?.CanUndo ?? false))"
                              Clicked="() => Run(c => c.Undo())" />
                <RibbonButton Size="RibbonItemSize.Small" Tooltip="Redo (Ctrl+Y)" Icon="@Ico(OfficeIcon.Redo)"
                              Disabled="@(Disabled || !(C?.CanRedo ?? false))"
                              Clicked="() => Run(c => c.Redo())" />
            </QuickAccess>

            <ChildContent>
                @* ================================ HOME ================================ *@
                <RibbonTab Title="Home" Key="home">

                    <RibbonGroup Title="Clipboard" Priority="95">
                        <RibbonSplitButton Text="Paste" Tooltip="Paste (Ctrl+V)" Icon="@Ico(OfficeIcon.Paste)"
                                           Disabled="Disabled" Menu="PasteMenu" Clicked="() => Paste(plain: false)" />
                        <RibbonButton Size="RibbonItemSize.Small" Text="Cut" Tooltip="Cut (Ctrl+X)" Icon="@Ico(OfficeIcon.Cut)"
                                      Disabled="Disabled" Clicked="Cut" />
                        <RibbonButton Size="RibbonItemSize.Small" Text="Copy" Tooltip="Copy (Ctrl+C)" Icon="@Ico(OfficeIcon.Copy)"
                                      Disabled="@(Document is null)" Clicked="Copy" />
                        @* A split button: the face paints once, the menu keeps the brush loaded until it is
                           put down - Word's double-click, which a ribbon button has no way to see. *@
                        <RibbonSplitButton Size="RibbonItemSize.Small"
                                           Text="@((C?.IsFormatPainterActive ?? false) ? "Painting…" : "Format Painter")"
                                           Tooltip="Format Painter (Ctrl+Shift+C, then select; Esc to stop)"
                                           Icon="@Ico(WordIcons.FormatPainter)"
                                           Disabled="Disabled" Menu="PainterMenu"
                                           Clicked="() => Run(c => c.CopyFormatting())" />
                    </RibbonGroup>

                    @*
                        Row flow, which is what Word actually draws: the boxes on top and the run of
                        marks underneath.
                    *@
                    <RibbonGroup Title="Font" Priority="100">
                        <RibbonRow>
                            <RibbonContent Size="RibbonItemSize.Small">
                                <FontPickerButton AvailableFonts="FontFamilies"
                                                  SelectedFont="@Format.FontFamily"
                                                  Disabled="Disabled"
                                                  SelectedFontChanged="OnFontChanged" />
                            </RibbonContent>
                            <RibbonContent Size="RibbonItemSize.Small">
                                <FontSizePickerButton AvailableFontSizes="FontSizes"
                                                      SelectedFontSize="Format.FontSize"
                                                      Disabled="Disabled"
                                                      SelectedFontSizeChanged="OnSizeChanged" />
                            </RibbonContent>
                            <RibbonButton Size="RibbonItemSize.Small" Tooltip="Increase Font Size (Ctrl+Shift+>)" Icon="@Ico(WordIcons.GrowFont)"
                                          Disabled="Disabled" Clicked="() => Run(c => c.GrowFont())" />
                            <RibbonButton Size="RibbonItemSize.Small" Tooltip="Decrease Font Size (Ctrl+Shift+<)" Icon="@Ico(WordIcons.ShrinkFont)"
                                          Disabled="Disabled" Clicked="() => Run(c => c.ShrinkFont())" />
                            <RibbonMenuButton Size="RibbonItemSize.Small" Tooltip="Change Case (Shift+F3)" Icon="@Ico(WordIcons.ChangeCase)"
                                              Disabled="Disabled" Menu="CaseMenu" />
                            <RibbonButton Size="RibbonItemSize.Small" Tooltip="Clear All Formatting (Ctrl+Space)" Icon="@Ico(OfficeIcon.ClearFormat)"
                                          Disabled="Disabled" Clicked="() => Run(c => c.ClearFormatting())" />
                        </RibbonRow>

                        <RibbonRow>
                            <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Bold (Ctrl+B)" Icon="@Ico(OfficeIcon.Bold)"
                                                Checked="Format.Bold" Disabled="Disabled" Clicked="_ => Run(c => c.ToggleBold())" />
                            <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Italic (Ctrl+I)" Icon="@Ico(OfficeIcon.Italic)"
                                                Checked="Format.Italic" Disabled="Disabled" Clicked="_ => Run(c => c.ToggleItalic())" />
                            <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Underline (Ctrl+U)" Icon="@Ico(OfficeIcon.Underline)"
                                                Checked="Format.Underline" Disabled="Disabled" Clicked="_ => Run(c => c.ToggleUnderline())" />
                            <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Strikethrough" Icon="@Ico(OfficeIcon.Strikethrough)"
                                                Checked="Format.Strike" Disabled="Disabled" Clicked="_ => Run(c => c.ToggleStrikethrough())" />
                            <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Subscript (Ctrl+=)" Icon="@Ico(WordIcons.Subscript)"
                                                Checked="Format.Subscript" Disabled="Disabled" Clicked="_ => Run(c => c.ToggleSubscript())" />
                            <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Superscript (Ctrl+Shift+=)" Icon="@Ico(WordIcons.Superscript)"
                                                Checked="Format.Superscript" Disabled="Disabled" Clicked="_ => Run(c => c.ToggleSuperscript())" />

                            <RibbonSeparator />

                            @* Pickers with their own popup surface, which a ribbon button cannot be. *@
                            <RibbonContent Size="RibbonItemSize.Small">
                                <ColorPickerButton Text="Text colour"
                                                   SelectedColor="@ColorHex"
                                                   ShowOpacity="false"
                                                   Disabled="Disabled"
                                                   Style="--shiny-picker-height: 24px"
                                                   SelectedColorChanged="OnColorChanged" />
                            </RibbonContent>
                            <RibbonContent Size="RibbonItemSize.Small">
                                <OfficeHighlightButton Current="Format.Highlight"
                                                       Disabled="Disabled"
                                                       ShowTooltips="ShowToolbarTooltips"
                                                       Picked="OnHighlightPicked" />
                            </RibbonContent>
                        </RibbonRow>
                    </RibbonGroup>

                    <RibbonGroup Title="Paragraph" Priority="90">
                        <RibbonRow>
                            <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Bullets (Ctrl+Shift+L)" Icon="@Ico(OfficeIcon.BulletList)"
                                                Checked="@(Format.List == ListStyle.Bullet)" Disabled="Disabled"
                                                Clicked="_ => Run(c => c.ToggleBulletList())" />
                            <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Numbering" Icon="@Ico(OfficeIcon.NumberedList)"
                                                Checked="@(Format.List == ListStyle.Numbered)" Disabled="Disabled"
                                                Clicked="_ => Run(c => c.ToggleNumberedList())" />
                            @* A numbered list is already nine levels deep (1., a., i.); Tab walks them. *@
                            <RibbonButton Size="RibbonItemSize.Small" Tooltip="Multilevel List (Tab / Shift+Tab to change level)"
                                          Icon="@Ico(WordIcons.MultilevelList)" Disabled="Disabled"
                                          Clicked="() => Run(c => c.SetListStyle(ListStyle.Numbered))" />
                            <RibbonButton Size="RibbonItemSize.Small" Tooltip="Decrease Indent (Ctrl+Shift+M)" Icon="@Ico(OfficeIcon.Outdent)"
                                          Disabled="@(Disabled || (Format.List == ListStyle.None ? Format.IndentLeft <= 0 : Format.ListLevel == 0))"
                                          Clicked="() => Run(c => c.ChangeIndent(-1))" />
                            <RibbonButton Size="RibbonItemSize.Small" Tooltip="Increase Indent (Ctrl+M)" Icon="@Ico(OfficeIcon.Indent)"
                                          Disabled="Disabled" Clicked="() => Run(c => c.ChangeIndent(1))" />
                            <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Show/Hide ¶ (Ctrl+Shift+8)" Icon="@Ico(WordIcons.ShowMarks)"
                                                Checked="@(C?.ShowFormattingMarks ?? false)" Disabled="@(Document is null)"
                                                Clicked="_ => Run(c => c.ShowFormattingMarks = !c.ShowFormattingMarks, requireEditable: false)" />
                        </RibbonRow>

                        <RibbonRow>
                            <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Align Left (Ctrl+L)" Icon="@Ico(OfficeIcon.AlignLeft)"
                                                Checked="@(Format.Alignment == TextAlignment.Left)" Disabled="Disabled"
                                                Clicked="_ => Align(TextAlignment.Left)" />
                            <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Center (Ctrl+E)" Icon="@Ico(OfficeIcon.AlignCenter)"
                                                Checked="@(Format.Alignment == TextAlignment.Center)" Disabled="Disabled"
                                                Clicked="_ => Align(TextAlignment.Center)" />
                            <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Align Right (Ctrl+R)" Icon="@Ico(OfficeIcon.AlignRight)"
                                                Checked="@(Format.Alignment == TextAlignment.Right)" Disabled="Disabled"
                                                Clicked="_ => Align(TextAlignment.Right)" />
                            <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Justify (Ctrl+J)" Icon="@Ico(OfficeIcon.AlignJustify)"
                                                Checked="@(Format.Alignment == TextAlignment.Justify)" Disabled="Disabled"
                                                Clicked="_ => Align(TextAlignment.Justify)" />
                            <RibbonMenuButton Size="RibbonItemSize.Small" Tooltip="Line and Paragraph Spacing" Icon="@Ico(WordIcons.LineSpacing)"
                                              Disabled="Disabled" Menu="LineSpacingMenu" />
                            <RibbonMenuButton Size="RibbonItemSize.Small" Tooltip="Shading" Icon="@Ico(OfficeIcon.FillColor)"
                                              Disabled="Disabled" Menu="ShadingMenu" />
                            <RibbonMenuButton Size="RibbonItemSize.Small" Tooltip="Borders" Icon="@Ico(WordIcons.Borders)"
                                              Disabled="Disabled" Menu="BordersMenu" />
                        </RibbonRow>
                    </RibbonGroup>

                    <RibbonGroup Title="Styles" Priority="80">
                        <RibbonMenuButton Text="@CurrentStyleName" Tooltip="Styles" Icon="@Ico(WordIcons.Styles)"
                                          Disabled="Disabled" Menu="StylesMenu" />
                    </RibbonGroup>

                    @*
                        Not gated on Disabled: finding changes nothing, so it works in a read-only
                        document. The bar disables itself when there is no document to search.
                    *@
                    <RibbonGroup Title="Editing" Priority="60">
                        <RibbonContent>
                            <OfficeFindBar Find="@(C?.Find)"
                                           ShowTooltips="ShowToolbarTooltips"
                                           Moved="StateHasChanged" />
                        </RibbonContent>
                        <RibbonButton Size="RibbonItemSize.Small" Text="Replace" Tooltip="Replace (Ctrl+H)" Icon="@Ico(WordIcons.Replace)"
                                      Disabled="Disabled" Clicked="OpenReplace" />
                        <RibbonButton Size="RibbonItemSize.Small" Text="Select All" Tooltip="Select All (Ctrl+A)" Icon="@Ico(WordIcons.SelectAll)"
                                      Disabled="@(Document is null)" Clicked="() => Run(c => c.SelectAll(), requireEditable: false)" />
                    </RibbonGroup>

                    @if (ToolbarContent != null)
                    {
                        @* Never folds into an overflow button: whatever the host added is theirs. *@
                        <RibbonGroup Title="@ToolbarContentTitle" Priority="200" CanCollapse="false">
                            <RibbonContent>@ToolbarContent</RibbonContent>
                        </RibbonGroup>
                    }
                </RibbonTab>

                @* ================================ INSERT ================================ *@
                <RibbonTab Title="Insert" Key="insert">
                    <RibbonGroup Title="Pages" Priority="80">
                        <RibbonButton Size="RibbonItemSize.Small" Text="Blank Page" Tooltip="Blank Page" Icon="@Ico(WordIcons.BlankPage)"
                                      Disabled="Disabled" Clicked="() => Run(c => c.InsertBlankPage())" />
                        <RibbonButton Size="RibbonItemSize.Small" Text="Page Break" Tooltip="Page Break (Ctrl+Enter)" Icon="@Ico(OfficeIcon.PageBreak)"
                                      Disabled="Disabled" Clicked="() => Run(c => c.InsertPageBreak())" />
                        <RibbonMenuButton Size="RibbonItemSize.Small" Text="Section Break" Tooltip="Section Break" Icon="@Ico(WordIcons.SectionBreak)"
                                          Disabled="@(Disabled || InTable)" Menu="SectionBreakMenu" />
                    </RibbonGroup>

                    <RibbonGroup Title="Tables &amp; Illustrations" Priority="100">
                        <RibbonContent>
                            <OfficeInsertMenu Disabled="Disabled"
                                              ShowTooltips="ShowToolbarTooltips"
                                              ShowShapes="false"
                                              ShapePicked="OnShapePicked"
                                              TablePicked="OnTablePicked"
                                              ImagePicked="OnImagePicked"
                                              ImageRejected="DropRejected" />
                        </RibbonContent>
                    </RibbonGroup>

                    <RibbonGroup Title="Links" Priority="90">
                        <RibbonButton Text="Link" Tooltip="Link (Ctrl+K)" Icon="@Ico(WordIcons.Hyperlink)"
                                      Disabled="Disabled" Clicked="OpenHyperlink" />
                        <RibbonButton Size="RibbonItemSize.Small" Text="Bookmark" Tooltip="Bookmark" Icon="@Ico(WordIcons.Bookmark)"
                                      Disabled="Disabled" Clicked="OpenBookmark" />
                        <RibbonButton Size="RibbonItemSize.Small" Text="Remove Link" Tooltip="Remove Link" Icon="@Ico(WordIcons.RemoveLink)"
                                      Disabled="@(Disabled || C?.CurrentHyperlink is null)" Clicked="() => Run(c => c.RemoveHyperlink())" />
                    </RibbonGroup>

                    <RibbonGroup Title="Comments" Priority="85">
                        <RibbonButton Text="Comment" Tooltip="New Comment (Ctrl+Alt+M)" Icon="@Ico(WordIcons.Comment)"
                                      Disabled="Disabled" Clicked="OpenComment" />
                    </RibbonGroup>

                    <RibbonGroup Title="Header &amp; Footer" Priority="75">
                        <RibbonButton Size="RibbonItemSize.Small" Text="Header" Tooltip="Header"
                                      Icon="@Ico(OfficeIcon.Header)"
                                      Disabled="Disabled" Clicked="() => OpenChrome(header: true)" />
                        <RibbonButton Size="RibbonItemSize.Small" Text="Footer" Tooltip="Footer"
                                      Icon="@Ico(OfficeIcon.Footer)"
                                      Disabled="Disabled" Clicked="() => OpenChrome(header: false)" />
                        @* A menu, not a button: a page number has a place and a form. *@
                        <RibbonMenuButton Size="RibbonItemSize.Small" Text="Page Number"
                                          Tooltip="Page Number"
                                          Icon="@Ico(OfficeIcon.PageNumber)"
                                          Disabled="Disabled" Menu="PageNumberMenu" />
                    </RibbonGroup>

                    <RibbonGroup Title="Text" Priority="70">
                        <RibbonMenuButton Size="RibbonItemSize.Small" Text="Date &amp; Time" Tooltip="Date &amp; Time"
                                          Icon="@Ico(WordIcons.DateTime)" Disabled="Disabled" Menu="DateTimeMenu" />
                        <RibbonButton Size="RibbonItemSize.Small" Text="Page Field" Tooltip="Insert the page number here"
                                      Icon="@Ico(OfficeIcon.PageNumber)" Disabled="Disabled"
                                      Clicked="() => Run(c => c.InsertPageNumberField())" />
                    </RibbonGroup>

                    <RibbonGroup Title="Symbols" Priority="65">
                        <RibbonButton Size="RibbonItemSize.Small" Text="Symbol" Tooltip="Symbol" Icon="@Ico(WordIcons.Symbol)"
                                      Disabled="Disabled" Clicked="() => Open(DialogKind.Symbols)" />
                        <RibbonButton Size="RibbonItemSize.Small" Text="Horizontal Line" Tooltip="Horizontal Line" Icon="@Ico(WordIcons.HorizontalLine)"
                                      Disabled="Disabled" Clicked="() => Run(c => c.InsertHorizontalLine())" />
                    </RibbonGroup>
                </RibbonTab>

                @* ================================ DESIGN ================================ *@
                <RibbonTab Title="Design" Key="design">
                    <RibbonGroup Title="Page Background" Priority="100">
                        <RibbonMenuButton Text="Watermark" Tooltip="Watermark" Icon="@Ico(OfficeIcon.Watermark)"
                                          Disabled="Disabled" Menu="WatermarkMenu" />
                        <RibbonMenuButton Text="Page Color" Tooltip="Page Color" Icon="@Ico(WordIcons.PageColor)"
                                          Disabled="Disabled" Menu="PageColorMenu" />
                        @* A picture drawn behind the page for display only - not written into the file. *@
                        <RibbonContent Size="RibbonItemSize.Small">
                            <OfficeWatermarkButton Disabled="Disabled"
                                                   ShowTooltips="ShowToolbarTooltips"
                                                   HasWatermark="@(Watermark is not null)"
                                                   Picked="OnWatermarkPicked"
                                                   Rejected="DropRejected" />
                        </RibbonContent>
                    </RibbonGroup>
                </RibbonTab>

                @* ================================ LAYOUT ================================ *@
                <RibbonTab Title="Layout" Key="layout">
                    <RibbonGroup Title="Page Setup" Priority="100">
                        <RibbonContent>
                            <OfficePageMarginsMenu Disabled="Disabled"
                                                   ShowTooltips="ShowToolbarTooltips"
                                                   Current="@Margins"
                                                   MarginsPicked="OnMarginsPicked" />
                        </RibbonContent>

                        @* Two toggles rather than one, because a page is one of two things. *@
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Portrait"
                                            Icon="@Ico(OfficeIcon.Portrait)"
                                            Checked="@(Orientation == PageOrientation.Portrait)"
                                            Disabled="Disabled"
                                            Clicked="_ => Run(c => c.SetPageOrientation(PageOrientation.Portrait))" />
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Landscape"
                                            Icon="@Ico(OfficeIcon.Landscape)"
                                            Checked="@(Orientation == PageOrientation.Landscape)"
                                            Disabled="Disabled"
                                            Clicked="_ => Run(c => c.SetPageOrientation(PageOrientation.Landscape))" />

                        <RibbonMenuButton Size="RibbonItemSize.Small" Text="Size" Tooltip="Size" Icon="@Ico(WordIcons.PageSize)"
                                          Disabled="Disabled" Menu="PageSizeMenu" />
                        <RibbonMenuButton Size="RibbonItemSize.Small" Text="Columns" Tooltip="Columns" Icon="@Ico(WordIcons.Columns)"
                                          Disabled="Disabled" Menu="ColumnsMenu" />
                        <RibbonMenuButton Size="RibbonItemSize.Small" Text="Breaks" Tooltip="Breaks" Icon="@Ico(OfficeIcon.PageBreak)"
                                          Disabled="Disabled" Menu="BreaksMenu" />
                    </RibbonGroup>

                    <RibbonGroup Title="Paragraph" Priority="90">
                        <RibbonRow>
                            <RibbonButton Size="RibbonItemSize.Small" Tooltip="Decrease Indent" Icon="@Ico(OfficeIcon.Outdent)"
                                          Disabled="Disabled" Clicked="() => Run(c => c.ChangeIndent(-1))" />
                            <RibbonButton Size="RibbonItemSize.Small" Tooltip="Increase Indent" Icon="@Ico(OfficeIcon.Indent)"
                                          Disabled="Disabled" Clicked="() => Run(c => c.ChangeIndent(1))" />
                            <RibbonMenuButton Size="RibbonItemSize.Small" Text="@IndentLabel" Tooltip="Indentation" Icon="@Ico(OfficeIcon.Indent)"
                                              Disabled="Disabled" Menu="IndentMenu" />
                        </RibbonRow>
                        <RibbonRow>
                            <RibbonMenuButton Size="RibbonItemSize.Small" Text="@($"Before {Format.SpaceBefore:0.#} pt")" Tooltip="Spacing Before"
                                              Icon="@Ico(WordIcons.LineSpacing)" Disabled="Disabled" Menu="SpaceBeforeMenu" />
                            <RibbonMenuButton Size="RibbonItemSize.Small" Text="@($"After {Format.SpaceAfter:0.#} pt")" Tooltip="Spacing After"
                                              Icon="@Ico(WordIcons.LineSpacing)" Disabled="Disabled" Menu="SpaceAfterMenu" />
                        </RibbonRow>
                    </RibbonGroup>
                </RibbonTab>

                @* ================================ REFERENCES ================================ *@
                <RibbonTab Title="References" Key="references">
                    <RibbonGroup Title="Table of Contents" Priority="100">
                        <RibbonButton Text="Table of Contents" Tooltip="Insert a table of contents from Heading 1–3"
                                      Icon="@Ico(WordIcons.TableOfContents)" Disabled="Disabled"
                                      Clicked="() => Run(c => c.InsertTableOfContents())" />
                        <RibbonButton Size="RibbonItemSize.Small" Text="Update Table" Tooltip="Update Table"
                                      Icon="@Ico(WordIcons.UpdateTable)"
                                      Disabled="@(Disabled || !(C?.HasTableOfContents ?? false))"
                                      Clicked="() => Run(c => c.UpdateTableOfContents())" />
                    </RibbonGroup>

                    <RibbonGroup Title="Footnotes" Priority="90">
                        <RibbonButton Text="Insert Footnote" Tooltip="Insert Footnote" Icon="@Ico(WordIcons.Footnote)"
                                      Disabled="Disabled" Clicked="() => Open(DialogKind.Footnote)" />
                        <RibbonButton Size="RibbonItemSize.Small" Text="Next Footnote" Tooltip="Next Footnote" Icon="@Ico(OfficeIcon.Next)"
                                      Disabled="@(Document is null || (C?.Footnotes.Count ?? 0) == 0)"
                                      Clicked="() => Run(c => c.NextFootnote(), requireEditable: false)" />
                    </RibbonGroup>
                </RibbonTab>

                @* ================================ REVIEW ================================ *@
                <RibbonTab Title="Review" Key="review">
                    <RibbonGroup Title="Proofing" Priority="100">
                        <RibbonToggleButton Text="Spelling" Tooltip="Check spelling"
                                            Icon="@Ico(OfficeIcon.SpellCheck)"
                                            Checked="@SpellCheckOn" Disabled="Disabled"
                                            Clicked="_ => ToggleSpellCheck()" />
                        <RibbonButton Size="RibbonItemSize.Small" Tooltip="Previous misspelling"
                                      Icon="@Ico(OfficeIcon.Previous)"
                                      Disabled="@(Disabled || !SpellCheckOn)"
                                      Clicked="() => GoToSpellingError(backwards: true)" />
                        <RibbonButton Size="RibbonItemSize.Small" Tooltip="Next misspelling"
                                      Icon="@Ico(OfficeIcon.Next)"
                                      Disabled="@(Disabled || !SpellCheckOn)"
                                      Clicked="() => GoToSpellingError(backwards: false)" />
                        <RibbonButton Size="RibbonItemSize.Small" Text="Word Count" Tooltip="Word Count (Ctrl+Shift+G)"
                                      Icon="@Ico(WordIcons.WordCount)" Disabled="@(Document is null)"
                                      Clicked="() => Open(DialogKind.WordCount)" />
                    </RibbonGroup>

                    <RibbonGroup Title="Comments" Priority="90">
                        <RibbonButton Text="New Comment" Tooltip="New Comment (Ctrl+Alt+M)" Icon="@Ico(WordIcons.Comment)"
                                      Disabled="Disabled" Clicked="OpenComment" />
                        <RibbonButton Size="RibbonItemSize.Small" Text="Delete" Tooltip="Delete Comment" Icon="@Ico(WordIcons.DeleteComment)"
                                      Disabled="@(Disabled || C?.CurrentComment is null)"
                                      Clicked="() => Run(c => c.DeleteComment())" />
                        <RibbonButton Size="RibbonItemSize.Small" Text="Previous" Tooltip="Previous Comment" Icon="@Ico(OfficeIcon.Previous)"
                                      Disabled="@(Document is null || (C?.Comments.Count ?? 0) == 0)"
                                      Clicked="() => Run(c => c.PreviousComment(), requireEditable: false)" />
                        <RibbonButton Size="RibbonItemSize.Small" Text="Next" Tooltip="Next Comment" Icon="@Ico(OfficeIcon.Next)"
                                      Disabled="@(Document is null || (C?.Comments.Count ?? 0) == 0)"
                                      Clicked="() => Run(c => c.NextComment(), requireEditable: false)" />
                        <RibbonToggleButton Size="RibbonItemSize.Small" Text="Show Comments" Tooltip="Show Comments"
                                            Icon="@Ico(WordIcons.Comment)"
                                            Checked="@(C?.ShowComments ?? true)" Disabled="@(Document is null)"
                                            Clicked="_ => Run(c => c.ShowComments = !c.ShowComments, requireEditable: false)" />
                    </RibbonGroup>

                    <RibbonGroup Title="Tracking" Priority="80">
                        <RibbonToggleButton Text="Track Changes" Tooltip="Track Changes (Ctrl+Shift+E)"
                                            Icon="@Ico(WordIcons.TrackChanges)"
                                            Checked="@(C?.IsTrackingChanges ?? false)" Disabled="Disabled"
                                            Clicked="_ => Run(c => c.IsTrackingChanges = !c.IsTrackingChanges)" />
                    </RibbonGroup>

                    <RibbonGroup Title="Changes" Priority="70">
                        <RibbonSplitButton Text="Accept" Tooltip="Accept and Move to Next" Icon="@Ico(WordIcons.Accept)"
                                           Disabled="@(Disabled || (C?.Revisions.Count ?? 0) == 0)"
                                           Menu="AcceptMenu" Clicked="() => Run(c => c.AcceptChange())" />
                        <RibbonSplitButton Text="Reject" Tooltip="Reject and Move to Next" Icon="@Ico(WordIcons.Reject)"
                                           Disabled="@(Disabled || (C?.Revisions.Count ?? 0) == 0)"
                                           Menu="RejectMenu" Clicked="() => Run(c => c.RejectChange())" />
                        <RibbonButton Size="RibbonItemSize.Small" Text="Previous" Tooltip="Previous Change" Icon="@Ico(OfficeIcon.Previous)"
                                      Disabled="@(Document is null || (C?.Revisions.Count ?? 0) == 0)"
                                      Clicked="() => Run(c => c.PreviousChange(), requireEditable: false)" />
                        <RibbonButton Size="RibbonItemSize.Small" Text="Next" Tooltip="Next Change" Icon="@Ico(OfficeIcon.Next)"
                                      Disabled="@(Document is null || (C?.Revisions.Count ?? 0) == 0)"
                                      Clicked="() => Run(c => c.NextChange(), requireEditable: false)" />
                    </RibbonGroup>
                </RibbonTab>

                @* ================================ VIEW ================================ *@
                <RibbonTab Title="View" Key="view">
                    <RibbonGroup Title="Views" Priority="100">
                        <RibbonToggleButton Text="Read Mode" Tooltip="Read Mode" Icon="@Ico(WordIcons.ReadMode)"
                                            Checked="ReadModeOn" Disabled="@(Document is null)"
                                            Clicked="_ => SetReadMode(!ReadModeOn)" />
                        <RibbonToggleButton Text="Print Layout" Tooltip="Print Layout"
                                            Icon="@Ico(OfficeIcon.PrintLayout)"
                                            Checked="@(LayoutMode == DocumentPageLayout.Print)"
                                            Clicked="_ => SetLayout(DocumentPageLayout.Print)" />
                        <RibbonToggleButton Text="Web Layout" Tooltip="Web Layout — one continuous column"
                                            Icon="@Ico(OfficeIcon.FitWidth)"
                                            Checked="@(LayoutMode == DocumentPageLayout.Reflow)"
                                            Clicked="_ => SetLayout(DocumentPageLayout.Reflow)" />
                    </RibbonGroup>

                    <RibbonGroup Title="Show" Priority="90">
                        <RibbonToggleButton Size="RibbonItemSize.Small" Text="Navigation Pane" Tooltip="Navigation Pane"
                                            Icon="@Ico(WordIcons.NavigationPane)"
                                            Checked="navigationPane" Disabled="@(Document is null)"
                                            Clicked="_ => this.navigationPane = !this.navigationPane" />
                        <RibbonToggleButton Size="RibbonItemSize.Small" Text="Formatting Marks" Tooltip="Show/Hide ¶ (Ctrl+Shift+8)"
                                            Icon="@Ico(WordIcons.ShowMarks)"
                                            Checked="@(C?.ShowFormattingMarks ?? false)" Disabled="@(Document is null)"
                                            Clicked="_ => Run(c => c.ShowFormattingMarks = !c.ShowFormattingMarks, requireEditable: false)" />
                    </RibbonGroup>

                    @* Minus, readout, plus - on one row, in that order. *@
                    <RibbonGroup Title="Zoom" Priority="80">
                        <RibbonRow>
                            <RibbonButton Size="RibbonItemSize.Small" Tooltip="Zoom out"
                                          Icon="@Ico(OfficeIcon.ZoomOut)"
                                          Disabled="@(!CanZoomOut)" Clicked="() => StepZoom(-1)" />
                            <RibbonContent Size="RibbonItemSize.Small">
                                <span class="zoom-readout">@($"{ZoomLevel * 100:0}%")</span>
                            </RibbonContent>
                            <RibbonButton Size="RibbonItemSize.Small" Tooltip="Zoom in"
                                          Icon="@Ico(OfficeIcon.ZoomIn)"
                                          Disabled="@(!CanZoomIn)" Clicked="() => StepZoom(1)" />
                        </RibbonRow>
                        <RibbonRow>
                            <RibbonButton Size="RibbonItemSize.Small" Text="100%" Tooltip="Zoom to 100%"
                                          Icon="@Ico(OfficeIcon.ZoomIn)" Clicked="() => SetZoomAsync(1.0)" />
                            <RibbonButton Size="RibbonItemSize.Small" Text="Fit width"
                                          Tooltip="Fit the page to the window"
                                          Icon="@Ico(OfficeIcon.FitWidth)"
                                          Clicked="FitToWidth" />
                        </RibbonRow>
                    </RibbonGroup>
                </RibbonTab>

                @* ============================ TABLE (contextual) ============================ *@
                <RibbonTab Title="Table" Key="table" Visible="InTable" ContextTitle="Table Tools">
                    <RibbonGroup Title="Rows &amp; Columns" Priority="100">
                        <RibbonRow>
                            <RibbonButton Size="RibbonItemSize.Small" Text="Insert Above" Tooltip="Insert Row Above" Icon="@Ico(OfficeIcon.InsertRow)"
                                          Disabled="Disabled" Clicked="() => Run(c => c.InsertTableRowAbove())" />
                            <RibbonButton Size="RibbonItemSize.Small" Text="Insert Below" Tooltip="Insert Row Below" Icon="@Ico(OfficeIcon.InsertRow)"
                                          Disabled="Disabled" Clicked="() => Run(c => c.InsertTableRowBelow())" />
                        </RibbonRow>
                        <RibbonRow>
                            <RibbonButton Size="RibbonItemSize.Small" Text="Insert Left" Tooltip="Insert Column Left" Icon="@Ico(OfficeIcon.InsertColumn)"
                                          Disabled="Disabled" Clicked="() => Run(c => c.InsertTableColumnLeft())" />
                            <RibbonButton Size="RibbonItemSize.Small" Text="Insert Right" Tooltip="Insert Column Right" Icon="@Ico(OfficeIcon.InsertColumn)"
                                          Disabled="Disabled" Clicked="() => Run(c => c.InsertTableColumnRight())" />
                        </RibbonRow>
                        <RibbonMenuButton Text="Delete" Tooltip="Delete Rows, Columns or the Table" Icon="@Ico(WordIcons.DeleteTable)"
                                          Disabled="Disabled" Menu="TableDeleteMenu" />
                    </RibbonGroup>

                    <RibbonGroup Title="Merge" Priority="90">
                        <RibbonButton Text="Merge Cells" Tooltip="Merge the selected cells" Icon="@Ico(WordIcons.MergeCells)"
                                      Disabled="@(Disabled || !(C?.CanMergeTableCells ?? false))"
                                      Clicked="() => Run(c => c.MergeTableCells())" />
                        <RibbonButton Text="Split Cells" Tooltip="Split Cells" Icon="@Ico(WordIcons.SplitCells)"
                                      Disabled="Disabled" Clicked="() => Run(c => c.SplitTableCell())" />
                    </RibbonGroup>
                </RibbonTab>

                <OfficeShapesTab Disabled="Disabled" Picked="OnShapePicked" />
            </ChildContent>
        </Ribbon>
        </div>
    }

    <div class="doc-body">
        @if (navigationPane && !ReadModeOn && C is { } nav)
        {
            <nav class="doc-nav" aria-label="Navigation">
                <div class="doc-nav-title">
                    <span>Navigation</span>
                    <button type="button" class="doc-nav-close" aria-label="Close navigation pane"
                            @onclick="() => this.navigationPane = false">@OfficeToolbarIcons.Get(WordIcons.Reject, 14)</button>
                </div>

                @{ var headings = nav.Headings(); }
                @if (headings.Count == 0)
                {
                    <div class="doc-nav-empty">Headings you add to the document appear here.</div>
                }
                else
                {
                    @foreach (var heading in headings)
                    {
                        <button type="button"
                                class="doc-nav-item @(IsCurrentHeading(heading, headings) ? "on" : null)"
                                style="padding-left:@(8 + (Math.Min(heading.Level, 6) - 1) * 14)px"
                                @onclick="() => GoToHeading(heading)">@heading.Text</button>
                    }
                }
            </nav>
        }

        <div class="doc-surface">
            <DocumentEditor @ref="editor"
                            Document="Document"
                            Theme="Theme"
                            Zoom="ZoomLevel"
                            Watermark="Watermark"
                            PageLayout="@(ReadModeOn ? DocumentPageLayout.Reflow : LayoutMode)"
                            ReadOnly="@(ReadOnly || ReadModeOn)"
                            SpellChecker="SpellChecker"
                            SpellCheckEnabled="SpellCheckOn"
                            AllowFileDrop="AllowFileDrop"
                            DropRejected="DropRejected"
                            SelectionChanged="StateHasChanged"
                            ShortcutRequested="OnShortcutRequested"
                            LinkClicked="LinkClicked"
                            DocumentChanged="OnDocumentChanged" />

            @if (ReadModeOn)
            {
                <button type="button" class="doc-readmode-exit" @onclick="() => SetReadMode(false)">
                    @OfficeToolbarIcons.Get(WordIcons.ReadMode, 16)
                    <span>Exit Read Mode</span>
                </button>
            }

            @if (this.dialog != DialogKind.None)
            {
                <div class="dialog-backdrop" @onclick="CloseDialog"></div>

                <div class="dialog @(this.dialog == DialogKind.Symbols ? "dialog-wide" : null)" role="dialog"
                     aria-label="@DialogTitle" @onkeydown="OnDialogKeyDown">
                    <div class="dialog-title">@DialogTitle</div>

                    @switch (this.dialog)
                    {
                        case DialogKind.Header:
                        case DialogKind.Footer:
                            <label class="dialog-label" for="dlg-one">
                                @(this.dialog == DialogKind.Header ? "Shown at the top of every page" : "Shown at the bottom of every page")
                            </label>
                            <input id="dlg-one" class="dialog-input" @bind="textOne" @bind:event="oninput" />
                            break;

                        case DialogKind.Replace:
                            <label class="dialog-label" for="dlg-find">Find what</label>
                            <input id="dlg-find" class="dialog-input" @bind="textOne" @bind:event="oninput" />
                            <label class="dialog-label" for="dlg-replace">Replace with</label>
                            <input id="dlg-replace" class="dialog-input" @bind="textTwo" @bind:event="oninput" />
                            <div class="dialog-checks">
                                <label><input type="checkbox" @bind="matchCase" /> Match case</label>
                                <label><input type="checkbox" @bind="wholeWord" /> Find whole words only</label>
                            </div>
                            <div class="dialog-status" aria-live="polite">@status</div>
                            break;

                        case DialogKind.Hyperlink:
                            <label class="dialog-label" for="dlg-text">Text to display</label>
                            <input id="dlg-text" class="dialog-input" @bind="textOne" @bind:event="oninput" />
                            <label class="dialog-label" for="dlg-address">Address</label>
                            <input id="dlg-address" class="dialog-input" placeholder="https://… or #bookmark"
                                   @bind="textTwo" @bind:event="oninput" />
                            @if (C?.Bookmarks is { Count: > 0 } marks)
                            {
                                <div class="dialog-label">Or a place in this document</div>
                                <div class="dialog-list">
                                    @foreach (var mark in marks)
                                    {
                                        <button type="button" @onclick="() => PickBookmarkTarget(mark)">@mark.Name</button>
                                    }
                                </div>
                            }
                            break;

                        case DialogKind.Comment:
                            <label class="dialog-label" for="dlg-comment">Comment by @(C?.Author)</label>
                            <textarea id="dlg-comment" class="dialog-input dialog-textarea" @bind="textOne" @bind:event="oninput"></textarea>
                            break;

                        case DialogKind.Bookmark:
                            <label class="dialog-label" for="dlg-bookmark">Bookmark name</label>
                            <input id="dlg-bookmark" class="dialog-input" @bind="textOne" @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(textOne) && !DocumentEditorController.IsValidBookmarkName(textOne))
                            {
                                <div class="dialog-status dialog-error">Start with a letter; letters, digits and _ only; 40 characters at most.</div>
                            }
                            @if (C?.Bookmarks is { Count: > 0 } existing)
                            {
                                <div class="dialog-list">
                                    @foreach (var mark in existing)
                                    {
                                        <button type="button" @onclick="() => GoToBookmark(mark.Name)">Go to @mark.Name</button>
                                    }
                                </div>
                            }
                            break;

                        case DialogKind.Footnote:
                            <label class="dialog-label" for="dlg-note">Footnote text</label>
                            <textarea id="dlg-note" class="dialog-input dialog-textarea" @bind="textOne" @bind:event="oninput"></textarea>
                            break;

                        case DialogKind.Watermark:
                            <label class="dialog-label" for="dlg-mark">Watermark text</label>
                            <input id="dlg-mark" class="dialog-input" @bind="textOne" @bind:event="oninput" />
                            break;

                        case DialogKind.WordCount:
                            <table class="dialog-stats">
                                <tr><td>Pages</td><td>@stats.Pages.ToString("N0")</td></tr>
                                <tr><td>Words</td><td>@stats.Words.ToString("N0")</td></tr>
                                <tr><td>Characters (no spaces)</td><td>@stats.CharactersNoSpaces.ToString("N0")</td></tr>
                                <tr><td>Characters (with spaces)</td><td>@stats.CharactersWithSpaces.ToString("N0")</td></tr>
                                <tr><td>Paragraphs</td><td>@stats.Paragraphs.ToString("N0")</td></tr>
                                <tr><td>Lines</td><td>@stats.Lines.ToString("N0")</td></tr>
                                @if (stats.SelectedWords > 0)
                                {
                                    <tr><td>Words selected</td><td>@stats.SelectedWords.ToString("N0")</td></tr>
                                }
                            </table>
                            break;

                        case DialogKind.Symbols:
                            <div class="dialog-symbols">
                                @foreach (var symbol in DocumentEditorController.CommonSymbols)
                                {
                                    <button type="button" title="@symbol" @onclick="() => InsertSymbol(symbol)">@symbol</button>
                                }
                            </div>
                            break;
                    }

                    <div class="dialog-actions">
                        @switch (this.dialog)
                        {
                            case DialogKind.Replace:
                                <button type="button" @onclick="ReplaceFindNext">Find Next</button>
                                <button type="button" @onclick="ReplaceOne">Replace</button>
                                <button type="button" class="dialog-primary" @onclick="ReplaceAll">Replace All</button>
                                <button type="button" @onclick="CloseDialog">Close</button>
                                break;

                            case DialogKind.WordCount:
                            case DialogKind.Symbols:
                                <button type="button" class="dialog-primary" @onclick="CloseDialog">Close</button>
                                break;

                            case DialogKind.Hyperlink:
                                @if (C?.CurrentHyperlink is not null)
                                {
                                    <button type="button" @onclick="RemoveLink">Remove Link</button>
                                }
                                <button type="button" @onclick="CloseDialog">Cancel</button>
                                <button type="button" class="dialog-primary" @onclick="CommitDialog">OK</button>
                                break;

                            default:
                                <button type="button" @onclick="CloseDialog">Cancel</button>
                                <button type="button" class="dialog-primary" @onclick="CommitDialog">@CommitLabel</button>
                                break;
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    DocumentEditor? editor;

    [Parameter] public WordDocument? Document { get; set; }

    /// <summary>Forwarded to the surface. Unset there means "follow the page's scheme".</summary>
    [Parameter] public DocumentTheme? Theme { get; set; }

    [Parameter] public double Zoom { get; set; } = 1.0;

    /// <summary>Raised whenever the zoom changes — the ribbon, Ctrl+wheel, a pinch — so a host can `@bind` to it.</summary>
    [Parameter] public EventCallback<double> ZoomChanged { get; set; }

    /// <summary>
    /// Continuous column, or sheets of paper with the document's own headers and footers. Print by
    /// default, matching the editor it wraps.
    /// </summary>
    [Parameter] public DocumentPageLayout PageLayout { get; set; } = DocumentPageLayout.Print;

    /// <summary>Raised when the View tab's layout toggles are used, so a host can `@bind`.</summary>
    [Parameter] public EventCallback<DocumentPageLayout> PageLayoutChanged { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Read Mode: no ribbon, one reflowed column, nothing editable — the document for reading. A
    /// floating button leaves it.
    /// </summary>
    [Parameter] public bool ReadMode { get; set; }

    /// <summary>Raised when Read Mode is entered or left from the view itself.</summary>
    [Parameter] public EventCallback<bool> ReadModeChanged { get; set; }

    /// <summary>
    /// Raised when the File button is pressed. The File button is only drawn when this is bound — it is
    /// the hook for a host's backstage.
    /// </summary>
    [Parameter] public EventCallback FileClicked { get; set; }

    /// <summary>Raised with fresh figures whenever the word count or current page may have changed.</summary>
    [Parameter] public EventCallback<DocumentStatistics> StatisticsChanged { get; set; }

    /// <summary>Raised with the style id when the caret moves onto a paragraph of a different style.</summary>
    [Parameter] public EventCallback<string> CurrentStyleChanged { get; set; }

    /// <summary>Raised when a hyperlink out of the document is followed; left unbound, it opens in a new tab.</summary>
    [Parameter] public EventCallback<DocumentLinkEventArgs> LinkClicked { get; set; }

    /// <summary>Passed straight through to the inner <see cref="DocumentEditor"/>.</summary>
    [Parameter] public ISpellChecker? SpellChecker { get; set; }

    [Parameter] public bool SpellCheckEnabled { get; set; } = true;

    /// <summary>Raised when the Review tab's toggle is used, so a host can `@bind` to it.</summary>
    [Parameter] public EventCallback<bool> SpellCheckEnabledChanged { get; set; }

    [Parameter] public bool ShowToolbar { get; set; } = true;

    /// <summary>Whether the icon-only toolbar buttons carry a tooltip naming what they do.</summary>
    [Parameter] public bool ShowToolbarTooltips { get; set; } = true;

    /// <summary>Whether dragging an image file onto the document inserts it. On by default.</summary>
    [Parameter] public bool AllowFileDrop { get; set; } = true;

    /// <summary>Raised when a dropped or chosen file could not be inserted, so a host can say so.</summary>
    [Parameter] public EventCallback<OfficeDropRejected> DropRejected { get; set; }

    /// <summary>The size of shape the toolbar inserts, in pixels.</summary>
    [Parameter] public double ShapeWidth { get; set; } = 160;

    [Parameter] public double ShapeHeight { get; set; } = 120;

    /// <summary>How wide an inserted picture is, in pixels. Its height follows the image's own ratio.</summary>
    [Parameter] public double PictureWidth { get; set; } = 240;

    /// <summary>Extra items appended to the Home tab, after the built-in groups.</summary>
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    [Parameter] public IReadOnlyList<string> FontFamilies { get; set; } =
    [
        "Calibri", "Cambria", "Arial", "Times New Roman", "Georgia", "Verdana", "Courier New"
    ];

    /// <summary>The sizes the picker offers.</summary>
    [Parameter] public IReadOnlyList<double> FontSizes { get; set; } =
    [
        8, 9, 10, 11, 12, 14, 16, 18, 20, 24, 28, 32, 36, 48, 72
    ];

    /// <summary>Group title for <see cref="ToolbarContent"/>.</summary>
    [Parameter] public string ToolbarContentTitle { get; set; } = "Actions";

    /// <summary>
    /// Draw the tab strip. On by default: the bar has Word's full set of tabs, and with the strip off
    /// every tab but Home is unreachable.
    /// </summary>
    [Parameter] public bool ShowRibbonTabs { get; set; } = true;

    /// <summary>A shared-set icon as the ribbon takes it: inline SVG markup, not a MarkupString.</summary>
    static string Ico(OfficeIcon icon) => OfficeToolbarIcons.Get(icon).Value;

    [Parameter] public double ToolbarHeight { get; set; } = 44;

    // The Ribbon's own stylesheet carries this; forwarding it unconditionally would beat any rule an
    // app writes against the ribbon, so only a caller-chosen value is passed on.
    internal const string DefaultToolbarBackground = "var(--shiny-color-surface-container-low, #EFF4FB)";

    [Parameter] public string ToolbarBackground { get; set; } = DefaultToolbarBackground;

    string? ChosenToolbarBackground
        => this.ToolbarBackground == DefaultToolbarBackground ? null : this.ToolbarBackground;
    [Parameter] public string ToolbarForeground { get; set; } = "var(--shiny-color-on-surface, #161C23)";
    [Parameter] public string ToolbarBorder { get; set; } = "var(--shiny-color-outline-variant, #BBC7DF)";

    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    [Parameter] public EventCallback DocumentChanged { get; set; }

    /// <summary>The underlying editor, so a host can focus it or reach its controller.</summary>
    public DocumentEditor? Editor => this.editor;

    public DocumentEditorController? Controller => this.editor?.Controller;

    /// <summary>Word count, characters, paragraphs, pages and the caret's page — for a status bar.</summary>
    public DocumentStatistics Statistics => this.C?.Statistics ?? DocumentStatistics.Empty;

    /// <summary>The caret paragraph's style id — for a style gallery.</summary>
    public string CurrentStyleId => this.C?.CurrentStyleId ?? "Normal";

    DocumentEditorController? C => this.editor?.Controller;

    bool Disabled => this.ReadOnly || this.Document is null || this.ReadModeOn;

    bool InTable => this.C?.IsInTable ?? false;

    CaretFormat Format => this.C?.CaretFormat ?? CaretFormat.Default;

    string? selectedTab;
    bool navigationPane;

    // ---- controller subscriptions ----

    DocumentEditorController? subscribed;

    protected override void OnAfterRender(bool firstRender) => this.Subscribe();

    /// <summary>
    /// Follows the controller: a new document is a new controller, and a handler left on the old one
    /// would report figures for a document that is no longer open.
    /// </summary>
    void Subscribe()
    {
        var current = this.C;
        if (ReferenceEquals(current, this.subscribed))
            return;

        this.Unsubscribe();
        this.subscribed = current;

        if (current is null)
            return;

        current.StatisticsChanged += this.OnStatisticsChanged;
        current.CurrentStyleChanged += this.OnCurrentStyleChanged;
        current.ZoomChanged += this.OnZoomChanged;
    }

    void Unsubscribe()
    {
        if (this.subscribed is not { } previous)
            return;

        previous.StatisticsChanged -= this.OnStatisticsChanged;
        previous.CurrentStyleChanged -= this.OnCurrentStyleChanged;
        previous.ZoomChanged -= this.OnZoomChanged;
        this.subscribed = null;
    }

    void OnStatisticsChanged(object? sender, EventArgs e)
    {
        if (!this.StatisticsChanged.HasDelegate || sender is not DocumentEditorController controller)
            return;

        _ = this.InvokeAsync(() => this.StatisticsChanged.InvokeAsync(controller.Statistics));
    }

    void OnCurrentStyleChanged(object? sender, EventArgs e)
    {
        if (sender is not DocumentEditorController controller)
            return;

        _ = this.InvokeAsync(async () =>
        {
            if (this.CurrentStyleChanged.HasDelegate)
                await this.CurrentStyleChanged.InvokeAsync(controller.CurrentStyleId);

            this.StateHasChanged();
        });
    }

    /// <summary>
    /// A zoom made on the surface itself — Ctrl+wheel, a trackpad pinch — has to become the view's too,
    /// or the next render hands the surface the old value and the page snaps back.
    /// </summary>
    void OnZoomChanged(object? sender, EventArgs e)
    {
        if (sender is not DocumentEditorController controller || Math.Abs(controller.Zoom - this.ZoomLevel) < 0.001)
            return;

        var zoom = controller.Zoom;
        this.zoomOverride = zoom;

        _ = this.InvokeAsync(async () =>
        {
            await this.ZoomChanged.InvokeAsync(zoom);
            this.StateHasChanged();
        });
    }

    public void Dispose() => this.Unsubscribe();

    // ---- read mode and layout ----

    bool? readModeOverride;

    bool ReadModeOn => this.readModeOverride ?? this.ReadMode;

    async Task SetReadMode(bool on)
    {
        this.readModeOverride = on;
        this.dialog = DialogKind.None;
        await this.ReadModeChanged.InvokeAsync(on);
    }

    DocumentPageLayout? layoutOverride;

    /// <summary>The layout in force: the toolbar's own choice, or the host's if it has not been overridden.</summary>
    DocumentPageLayout LayoutMode => this.layoutOverride ?? this.PageLayout;

    async Task SetLayout(DocumentPageLayout layout)
    {
        this.layoutOverride = layout;

        if (this.ReadModeOn)
            await this.SetReadMode(false);

        if (this.C is { } controller)
            controller.PageLayout = layout;

        await this.PageLayoutChanged.InvokeAsync(layout);
    }

    // ---- navigation pane ----

    void GoToHeading(DocumentHeading heading)
    {
        this.C?.GoToParagraph(heading.Paragraph);
        _ = this.editor?.FocusAsync();
    }

    /// <summary>The heading whose section the caret is in: the last one at or above it.</summary>
    bool IsCurrentHeading(DocumentHeading heading, IReadOnlyList<DocumentHeading> headings)
    {
        var caret = this.C?.Selection.Focus.Block ?? -1;
        var current = headings.LastOrDefault(x => x.Paragraph <= caret);
        return ReferenceEquals(current, heading);
    }

    // ---- menus ----

    static RibbonMenuEntry Separator() => new() { IsSeparator = true };

    RibbonMenuEntry Entry(string text, Action<DocumentEditorController> action, bool isChecked = false, string? icon = null)
        => new()
        {
            Text = text,
            Icon = icon,
            IsChecked = isChecked,
            IsDisabled = this.Disabled,
            OnClick = EventCallback.Factory.Create(this, () => this.Run(action))
        };

    RibbonMenuEntry Entry(string text, Func<Task> action, bool isChecked = false, string? icon = null)
        => new()
        {
            Text = text,
            Icon = icon,
            IsChecked = isChecked,
            IsDisabled = this.Disabled,
            OnClick = EventCallback.Factory.Create(this, action)
        };

    /// <summary>A colour swatch as menu icon markup: inline SVG, never an emoji square.</summary>
    static string Swatch(string? hex) => hex is null
        ? """<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="1.5" width="13" height="13" rx="2" fill="none" stroke="currentColor" stroke-opacity=".5"/><path d="M3 13L13 3" stroke="currentColor" stroke-opacity=".6"/></svg>"""
        : $"""<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="1.5" width="13" height="13" rx="2" fill="#{hex}" stroke="currentColor" stroke-opacity=".35"/></svg>""";

    static readonly (string Name, string Hex)[] ShadingSwatches =
    [
        ("Yellow", "FFF2CC"), ("Light Blue", "DDEBF7"), ("Light Green", "E2EFDA"), ("Light Orange", "FCE4D6"),
        ("Light Gray", "EDEDED"), ("Gray", "BFBFBF"), ("Blue", "9BC2E6"), ("Rose", "F8CBAD")
    ];

    static readonly (string Name, string Hex)[] PageSwatches =
    [
        ("Cream", "FFF8E7"), ("Pale Yellow", "FFFBD6"), ("Pale Blue", "EAF2FB"), ("Pale Green", "EDF7EA"),
        ("Pale Rose", "FCEEEE"), ("Light Gray", "F2F2F2"), ("Lavender", "F1EDFA"), ("Mint", "E8F7F3")
    ];

    List<RibbonMenuEntry> PasteMenu =>
    [
        Entry("Paste (Keep Source Formatting)", () => this.Paste(plain: false)),
        Entry("Paste Text Only (Ctrl+Shift+Alt+V)", () => this.Paste(plain: true))
    ];

    List<RibbonMenuEntry> PainterMenu =>
    [
        Entry("Paint Once", c => { if (!c.IsFormatPainterActive) c.CopyFormatting(); }),
        Entry("Keep Painting", c => { c.CancelFormatPainter(); c.CopyFormatting(sticky: true); },
            isChecked: this.C?.IsFormatPainterSticky ?? false),
        Entry("Stop Painting", c => c.CancelFormatPainter())
    ];

    List<RibbonMenuEntry> CaseMenu =>
    [
        Entry("Sentence case.", c => c.ChangeCase(TextCase.Sentence)),
        Entry("lowercase", c => c.ChangeCase(TextCase.Lower)),
        Entry("UPPERCASE", c => c.ChangeCase(TextCase.Upper)),
        Entry("Capitalize Each Word", c => c.ChangeCase(TextCase.Capitalize)),
        Entry("tOGGLE cASE", c => c.ChangeCase(TextCase.Toggle))
    ];

    List<RibbonMenuEntry> LineSpacingMenu =>
    [
        .. DocumentEditorController.LineSpacingPresets.Select(value =>
            Entry(value.ToString("0.0#", System.Globalization.CultureInfo.CurrentCulture), c => c.SetLineSpacing(value),
