@using Shiny.Blazor.Controls
@using Shiny.Controls.Office.Document
@using Shiny.Controls.Office.Icons
@using Shiny.Controls.Office.Packaging
@using Shiny.Controls.Office.Shapes
@using Shiny.Controls.Office.Spreadsheet
@using Shiny.Controls.Office.Text

@*
    DocumentEditor with formatting chrome on top.

    The toolbar is a ShinyToolbar from the core Blazor package, filled through its ChildContent, and
    the pickers in it are the core package's own — FontPickerButton, FontSizePickerButton and
    ColorPickerButton — which is what the MAUI DocumentEditorView puts in the same three slots.

    The row inside is its own flex container. ShinyToolbar renders ChildContent into a plain block, so
    left to itself every control here would be an inline-level box on a text line, aligned to the text
    baseline — and a button's baseline, a select's baseline and a swatch's baseline are all in
    different places, which is exactly what "the toolbar buttons look slightly off" is.

    Every plain button is an OfficeToolbarButton drawing from the shared icon set, so the mark for
    "align centre" is one definition rendered twice rather than two that drift. The pickers stay as
    they are: a font, a size and a colour have to show what they are currently set to, which is the
    one thing a monochrome icon cannot do.
*@
<div class="shiny-doc-editor-view @Class" style="@Style">

    @if (ShowToolbar)
    {
        @*
            The class stays on a div declared here, not on the Ribbon's CssClass. This file's scoped
            rules read `.doc-toolbar ::deep .x`, which compiles to `.doc-toolbar[scope-of-this-file] .x`
            - put the class on a child component's root and it carries that component's scope id
            instead, and every rule in this stylesheet silently stops matching.
        *@
        <div class="doc-toolbar">
        <Ribbon ShowTabStrip="ShowRibbonTabs"
                AllowCollapse="ShowRibbonTabs"
                SmallItemRows="2"
                HeaderBackgroundColor="@(AccentBackground ?? ChosenToolbarBackground)"
                HeaderForegroundColor="@AccentInk"
                AccentColor="@AccentInk"
                BodyBackgroundColor="@ChosenToolbarBackground">
            <QuickAccess>
                <RibbonButton Size="RibbonItemSize.Small" Tooltip="Undo (Ctrl+Z)" Icon="@Ico(OfficeIcon.Undo)"
                              Disabled="@(Disabled || !(editor?.Controller?.CanUndo ?? false))"
                              Clicked="() => Run(c => c.Undo())" />
                <RibbonButton Size="RibbonItemSize.Small" Tooltip="Redo (Ctrl+Shift+Z)" Icon="@Ico(OfficeIcon.Redo)"
                              Disabled="@(Disabled || !(editor?.Controller?.CanRedo ?? false))"
                              Clicked="() => Run(c => c.Redo())" />
            </QuickAccess>

            <ChildContent>
                <RibbonTab Title="Home" Key="home">

                    @*
                        Row flow, which is what Word actually draws: the two boxes on top and the run
                        of marks underneath. Filling columns instead put bold above italic and
                        underline above strikethrough - a 2x2 block of a run people read across - and
                        forced the font picker to share a column with a toggle, where the column took
                        the picker's width and stretched the 16px B across all 150px of it.
                    *@
                    <RibbonGroup Title="Font" Priority="100">
                        <RibbonRow>
                        <RibbonContent Size="RibbonItemSize.Small">
                            <FontPickerButton AvailableFonts="FontFamilies"
                                              SelectedFont="@Format.FontFamily"
                                              Disabled="Disabled"
                                              SelectedFontChanged="OnFontChanged" />
                        </RibbonContent>
                        <RibbonContent Size="RibbonItemSize.Small">
                            <FontSizePickerButton AvailableFontSizes="FontSizes"
                                                  SelectedFontSize="Format.FontSize"
                                                  Disabled="Disabled"
                                                  SelectedFontSizeChanged="OnSizeChanged" />
                        </RibbonContent>

                        </RibbonRow>

                        <RibbonRow>
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Bold (Ctrl+B)" Icon="@Ico(OfficeIcon.Bold)"
                                            Checked="Format.Bold" Disabled="Disabled" Clicked="_ => Run(c => c.ToggleBold())" />
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Italic (Ctrl+I)" Icon="@Ico(OfficeIcon.Italic)"
                                            Checked="Format.Italic" Disabled="Disabled" Clicked="_ => Run(c => c.ToggleItalic())" />
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Underline (Ctrl+U)" Icon="@Ico(OfficeIcon.Underline)"
                                            Checked="Format.Underline" Disabled="Disabled" Clicked="_ => Run(c => c.ToggleUnderline())" />
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Strikethrough" Icon="@Ico(OfficeIcon.Strikethrough)"
                                            Checked="Format.Strike" Disabled="Disabled" Clicked="_ => Run(c => c.ToggleStrikethrough())" />

                        <RibbonSeparator />

                        @* Pickers with their own popup surface, which a ribbon button cannot be. *@
                        <RibbonContent Size="RibbonItemSize.Small">
                            @* Sized to the row rather than left at the picker's own 30px: a solid
                               swatch is the heaviest mark on the bar, and at 30px beside 16px glyphs
                               it read as the one thing on the ribbon that had gone wrong. *@
                            <ColorPickerButton Text="Text colour"
                                               SelectedColor="@ColorHex"
                                               ShowOpacity="false"
                                               Disabled="Disabled"
                                               Style="--shiny-picker-height: 24px"
                                               SelectedColorChanged="OnColorChanged" />
                        </RibbonContent>
                        <RibbonContent Size="RibbonItemSize.Small">
                            <OfficeHighlightButton Current="Format.Highlight"
                                                   Disabled="Disabled"
                                                   ShowTooltips="ShowToolbarTooltips"
                                                   Picked="OnHighlightPicked" />
                        </RibbonContent>
                        </RibbonRow>
                    </RibbonGroup>

                    @*
                        Lists and the indent pair on top, the four alignments underneath - Word's own
                        arrangement, and two full rows of four rather than a ragged 2x4 grid that read
                        align-left / align-right down the first column.
                    *@
                    <RibbonGroup Title="Paragraph" Priority="90">
                        <RibbonRow>
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Bulleted list" Icon="@Ico(OfficeIcon.BulletList)"
                                            Checked="@(Format.List == ListStyle.Bullet)" Disabled="Disabled"
                                            Clicked="_ => Run(c => c.ToggleBulletList())" />
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Numbered list" Icon="@Ico(OfficeIcon.NumberedList)"
                                            Checked="@(Format.List == ListStyle.Numbered)" Disabled="Disabled"
                                            Clicked="_ => Run(c => c.ToggleNumberedList())" />

                        @* Enabled only inside a list, because that is the only thing they move. Word
                           greys them out the same way rather than repurposing them as paragraph
                           indent, which would make one button mean two things by caret position. *@
                        <RibbonButton Size="RibbonItemSize.Small" Tooltip="Outdent (Shift+Tab)" Icon="@Ico(OfficeIcon.Outdent)"
                                      Disabled="@(Disabled || Format.List == ListStyle.None || Format.ListLevel == 0)"
                                      Clicked="() => Run(c => c.ChangeListLevel(-1))" />
                        <RibbonButton Size="RibbonItemSize.Small" Tooltip="Indent (Tab)" Icon="@Ico(OfficeIcon.Indent)"
                                      Disabled="@(Disabled || Format.List == ListStyle.None)"
                                      Clicked="() => Run(c => c.ChangeListLevel(1))" />

                        </RibbonRow>

                        <RibbonRow>
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Align left" Icon="@Ico(OfficeIcon.AlignLeft)"
                                            Checked="@(Format.Alignment == TextAlignment.Left)" Disabled="Disabled"
                                            Clicked="_ => Align(TextAlignment.Left)" />
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Centre" Icon="@Ico(OfficeIcon.AlignCenter)"
                                            Checked="@(Format.Alignment == TextAlignment.Center)" Disabled="Disabled"
                                            Clicked="_ => Align(TextAlignment.Center)" />
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Align right" Icon="@Ico(OfficeIcon.AlignRight)"
                                            Checked="@(Format.Alignment == TextAlignment.Right)" Disabled="Disabled"
                                            Clicked="_ => Align(TextAlignment.Right)" />
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Justify" Icon="@Ico(OfficeIcon.AlignJustify)"
                                            Checked="@(Format.Alignment == TextAlignment.Justify)" Disabled="Disabled"
                                            Clicked="_ => Align(TextAlignment.Justify)" />
                        </RibbonRow>
                    </RibbonGroup>

                    @*
                        Proofing rides on Home rather than a Review tab of its own. Spelling is
                        something you do while writing, not a separate pass, and a tab holding three
                        buttons costs a click to reach and leaves most of a bar empty when you arrive.
                    *@
                    <RibbonGroup Title="Proofing" Priority="70">
                        @* Large and labelled: three icon-only buttons left a hole where the third row
                           would be, and "check spelling" is not a mark anyone reads off a 16px glyph.
                           The two steppers stack beside it, which is the column the hole used to be. *@
                        <RibbonToggleButton Text="Spelling" Tooltip="Check spelling"
                                            Icon="@Ico(OfficeIcon.SpellCheck)"
                                            Checked="@SpellCheckOn" Disabled="Disabled"
                                            Clicked="_ => ToggleSpellCheck()" />
                        <RibbonButton Size="RibbonItemSize.Small" Tooltip="Previous misspelling"
                                      Icon="@Ico(OfficeIcon.Previous)"
                                      Disabled="@(Disabled || !SpellCheckOn)"
                                      Clicked="() => GoToSpellingError(backwards: true)" />
                        <RibbonButton Size="RibbonItemSize.Small" Tooltip="Next misspelling"
                                      Icon="@Ico(OfficeIcon.Next)"
                                      Disabled="@(Disabled || !SpellCheckOn)"
                                      Clicked="() => GoToSpellingError(backwards: false)" />
                    </RibbonGroup>

                    @*
                        On Home, and last on it. Finding a word is something you do while writing
                        rather than a separate pass, so it sits on the tab that opens - but it is
                        reached less often than the formatting beside it, which is what the priority
                        orders and what decides which group folds into the overflow first on a narrow
                        window.

                        Not gated on Disabled: finding changes nothing, so it works in a read-only
                        document. The bar disables itself when there is no document to search.
                    *@
                    <RibbonGroup Title="Find" Priority="60">
                        @* Large: the bar is one control as tall as the group, and on a row of its own
                           it left the row underneath empty for the width of a search box. *@
                        <RibbonContent>
                            <OfficeFindBar Find="@(editor?.Controller?.Find)"
                                           ShowTooltips="ShowToolbarTooltips"
                                           Moved="StateHasChanged" />
                        </RibbonContent>
                    </RibbonGroup>

                    @if (ToolbarContent != null)
                    {
                        @* Never folds into an overflow button: whatever the host added is theirs. *@
                        <RibbonGroup Title="@ToolbarContentTitle" Priority="200" CanCollapse="false">
                            <RibbonContent>@ToolbarContent</RibbonContent>
                        </RibbonGroup>
                    }
                </RibbonTab>

                @*
                    Two tabs, not four. Home is what you do to the text under the caret; Layout is what
                    you do to the page it sits on. Splitting further gave Insert and Layout one group
                    each, which is a click to reach a bar with a single button on it.
                *@
                <RibbonTab Title="Layout" Key="layout">
                    <RibbonGroup Title="Page Setup" Priority="100">
                        @* Large: one control is the whole group, and on a single row it left the row
                           underneath it empty for the width of a menu button. *@
                        <RibbonContent>
                            <OfficePageMarginsMenu Disabled="Disabled"
                                                   ShowTooltips="ShowToolbarTooltips"
                                                   Current="@Margins"
                                                   MarginsPicked="OnMarginsPicked" />
                        </RibbonContent>
                    </RibbonGroup>

                    @*
                        Print layout is a way of looking at the document, so it is a toggle rather than
                        two buttons: the pressed state is what says which of the two you are in.
                    *@
                    <RibbonGroup Title="Page" Priority="90">
                        @* Two toggles rather than one, because a page is one of two things rather than
                           on or off - a single "Landscape" button leaves the user reading its pressed
                           state backwards to work out what portrait would be. *@
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Portrait"
                                            Icon="@Ico(OfficeIcon.Portrait)"
                                            Checked="@(Orientation == PageOrientation.Portrait)"
                                            Disabled="Disabled"
                                            Clicked="_ => Run(c => c.SetPageOrientation(PageOrientation.Portrait))" />
                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Landscape"
                                            Icon="@Ico(OfficeIcon.Landscape)"
                                            Checked="@(Orientation == PageOrientation.Landscape)"
                                            Disabled="Disabled"
                                            Clicked="_ => Run(c => c.SetPageOrientation(PageOrientation.Landscape))" />

                        <RibbonSeparator />

                        <RibbonToggleButton Size="RibbonItemSize.Small" Tooltip="Print layout"
                                            Icon="@Ico(OfficeIcon.PrintLayout)"
                                            Checked="@(LayoutMode == DocumentPageLayout.Print)"
                                            Clicked="_ => TogglePrintLayout()" />

                        <RibbonContent Size="RibbonItemSize.Small">
                            <OfficeWatermarkButton Disabled="Disabled"
                                                   ShowTooltips="ShowToolbarTooltips"
                                                   HasWatermark="@(Watermark is not null)"
                                                   Picked="OnWatermarkPicked"
                                                   Rejected="DropRejected" />
                        </RibbonContent>
                    </RibbonGroup>

                    @*
                        Minus, readout, plus - on one row, in that order. Filling columns put the
                        readout under the minus and the plus above "fit", which is a stepper whose two
                        halves are on different lines with the number wedged between them.
                    *@
                    <RibbonGroup Title="Zoom" Priority="80">
                        <RibbonRow>
                            <RibbonButton Size="RibbonItemSize.Small" Tooltip="Zoom out"
                                          Icon="@Ico(OfficeIcon.ZoomOut)"
                                          Disabled="@(!CanZoomOut)" Clicked="() => StepZoom(-1)" />
                            <RibbonContent Size="RibbonItemSize.Small">
                                <span class="zoom-readout">@($"{ZoomLevel * 100:0}%")</span>
                            </RibbonContent>
                            <RibbonButton Size="RibbonItemSize.Small" Tooltip="Zoom in"
                                          Icon="@Ico(OfficeIcon.ZoomIn)"
                                          Disabled="@(!CanZoomIn)" Clicked="() => StepZoom(1)" />
                        </RibbonRow>
                        <RibbonRow>
                            <RibbonButton Size="RibbonItemSize.Small" Text="Fit width"
                                          Tooltip="Fit the page to the window"
                                          Icon="@Ico(OfficeIcon.FitWidth)"
                                          Clicked="FitToWidth" />
                        </RibbonRow>
                    </RibbonGroup>
                </RibbonTab>

                @*
                    Insert stands on its own now that it has something to hold: what goes *in* the
                    document (a table, a picture) and what goes *around* it (the running head and foot,
                    the number on every page, and the break between two of them).
                *@
                <RibbonTab Title="Insert" Key="insert">
                    <RibbonGroup Title="Objects" Priority="100">
                        <RibbonContent>
                            <OfficeInsertMenu Disabled="Disabled"
                                              ShowTooltips="ShowToolbarTooltips"
                                              ShowShapes="false"
                                              ShapePicked="OnShapePicked"
                                              TablePicked="OnTablePicked"
                                              ImagePicked="OnImagePicked"
                                              ImageRejected="DropRejected" />
                        </RibbonContent>
                    </RibbonGroup>

                    @*
                        Labelled, and two rows rather than three items filling columns two deep - which
                        left the page-number menu alone in a second column with a hole under it. These
                        are things you insert by name, not marks you recognise: nobody reads "footer"
                        off a 16px glyph.
                    *@
                    <RibbonGroup Title="Header &amp; Footer" Priority="90">
                        <RibbonRow>
                            <RibbonButton Size="RibbonItemSize.Small" Text="Header" Tooltip="Header"
                                          Icon="@Ico(OfficeIcon.Header)"
                                          Disabled="Disabled" Clicked="() => OpenChrome(header: true)" />
                            <RibbonButton Size="RibbonItemSize.Small" Text="Footer" Tooltip="Footer"
                                          Icon="@Ico(OfficeIcon.Footer)"
                                          Disabled="Disabled" Clicked="() => OpenChrome(header: false)" />
                        </RibbonRow>
                        <RibbonRow>
                            @* A menu, not a button: a page number has a place and a form, and picking
                               them afterwards means finding the header you just wrote into. *@
                            <RibbonMenuButton Size="RibbonItemSize.Small" Text="Page number"
                                              Tooltip="Page number"
                                              Icon="@Ico(OfficeIcon.PageNumber)"
                                              Disabled="Disabled" Menu="PageNumberMenu" />
                        </RibbonRow>
                    </RibbonGroup>

                    @* One command, so it is drawn the way a single command should be: large, with its
                       name on it. A lone 16px glyph under a caption reading "Breaks" said nothing. *@
                    <RibbonGroup Title="Pages" Priority="80">
                        <RibbonButton Text="Page break" Tooltip="Page break (Ctrl+Enter)"
                                      Icon="@Ico(OfficeIcon.PageBreak)"
                                      Disabled="Disabled" Clicked="() => Run(c => c.InsertPageBreak())" />
                    </RibbonGroup>
                </RibbonTab>

                <OfficeShapesTab Disabled="Disabled" Picked="OnShapePicked" />
            </ChildContent>
        </Ribbon>
        </div>
    }

    <div class="doc-surface">
        <DocumentEditor @ref="editor"
                        Document="Document"
                        Theme="Theme"
                        Zoom="ZoomLevel"
                        Watermark="Watermark"
                        PageLayout="LayoutMode"
                        ReadOnly="ReadOnly"
                        SpellChecker="SpellChecker"
                        SpellCheckEnabled="SpellCheckOn"
                        AllowFileDrop="AllowFileDrop"
                        DropRejected="DropRejected"
                        SelectionChanged="StateHasChanged"
                        DocumentChanged="OnDocumentChanged" />

    @*
        A small prompt rather than editing the head in place on the page. Header and footer are
        separate stories in the document - their own parts, laid out per page and repeated - so making
        them editable in the canvas means a second caret, a second selection and a way in and out of
        them. Asking for the line is the whole of what most documents need, and it is undoable like any
        other command.
    *@
    @if (this.chrome is { } editing)
    {
        <div class="chrome-backdrop" @onclick="() => this.chrome = null"></div>

        <div class="chrome-prompt" role="dialog"
             aria-label="@(editing.Header ? "Header" : "Footer")">
            <label class="chrome-label" for="chrome-text">
                @(editing.Header ? "Shown at the top of every page" : "Shown at the bottom of every page")
            </label>

            <input id="chrome-text"
                   class="chrome-input"
                   value="@editing.Text"
                   @oninput="e => this.chrome = (editing.Header, e.Value?.ToString() ?? string.Empty)"
                   @onkeydown="OnChromeKeyDown" />

            <div class="chrome-actions">
                <button type="button" @onclick="() => this.chrome = null">Cancel</button>
                <button type="button" class="chrome-primary" @onclick="CommitChrome">Set</button>
            </div>
        </div>
    }
    </div>
</div>

@code {
    DocumentEditor? editor;

    [Parameter] public WordDocument? Document { get; set; }

    /// <summary>Forwarded to the surface. Unset there means "follow the page's scheme".</summary>
    [Parameter] public DocumentTheme? Theme { get; set; }

    [Parameter] public double Zoom { get; set; } = 1.0;

    /// <summary>Raised when the Layout tab's zoom controls are used, so a host can `@bind` to it.</summary>
    [Parameter] public EventCallback<double> ZoomChanged { get; set; }

    /// <summary>
    /// Continuous column, or sheets of paper with the document's own headers and footers. Print by
    /// default, matching the editor it wraps.
    /// </summary>
    [Parameter] public DocumentPageLayout PageLayout { get; set; } = DocumentPageLayout.Print;

    /// <summary>Raised when the Layout tab's print-layout toggle is used, so a host can `@bind`.</summary>
    [Parameter] public EventCallback<DocumentPageLayout> PageLayoutChanged { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Passed straight through to the inner <see cref="DocumentEditor"/>.</summary>
    [Parameter] public ISpellChecker? SpellChecker { get; set; }

    [Parameter] public bool SpellCheckEnabled { get; set; } = true;

    /// <summary>Raised when the Review tab's toggle is used, so a host can `@bind` to it.</summary>
    [Parameter] public EventCallback<bool> SpellCheckEnabledChanged { get; set; }

    [Parameter] public bool ShowToolbar { get; set; } = true;

    /// <summary>
    /// Whether the icon-only toolbar buttons carry a tooltip naming what they do.
    /// </summary>
    /// <remarks>
    /// On, because every button on this bar is icon only and an icon with no label is a guess until
    /// something names it. Turning it off falls back to the browser's own <c>title</c>, which is
    /// slower to appear and cannot be themed but still says what the button is.
    /// </remarks>
    [Parameter] public bool ShowToolbarTooltips { get; set; } = true;

    /// <summary>Whether dragging an image file onto the document inserts it. On by default.</summary>
    [Parameter] public bool AllowFileDrop { get; set; } = true;

    /// <summary>Raised when a dropped or chosen file could not be inserted, so a host can say so.</summary>
    [Parameter] public EventCallback<OfficeDropRejected> DropRejected { get; set; }

    /// <summary>The size of shape the toolbar inserts, in pixels.</summary>
    [Parameter] public double ShapeWidth { get; set; } = 160;

    [Parameter] public double ShapeHeight { get; set; } = 120;

    /// <summary>How wide an inserted picture is, in pixels. Its height follows the image's own ratio.</summary>
    [Parameter] public double PictureWidth { get; set; } = 240;

    /// <summary>Extra items appended to the toolbar, after the built-in formatting controls.</summary>
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    [Parameter] public IReadOnlyList<string> FontFamilies { get; set; } =
    [
        "Calibri", "Cambria", "Arial", "Times New Roman", "Georgia", "Verdana", "Courier New"
    ];

    /// <summary>
    /// The sizes the picker offers. Doubles rather than ints so the list matches what a document can
    /// actually hold — and what the MAUI DocumentEditorView takes for the same property.
    /// </summary>
    [Parameter] public IReadOnlyList<double> FontSizes { get; set; } =
    [
        8, 9, 10, 11, 12, 14, 16, 18, 20, 24, 28, 32, 36, 48, 72
    ];

    /// <summary>Group title for <see cref="ToolbarContent"/>.</summary>
    [Parameter] public string ToolbarContentTitle { get; set; } = "Actions";

    /// <summary>
    /// Whether the bar shows the ribbon's tab strip, and with it the collapse chevron.
    /// </summary>
    /// <remarks>
    /// Off by default. This is a formatting bar wrapped around an editor, not an application's whole
    /// chrome, and there is one tab to show - a strip carrying a single "Home" is noise. Turn it on
    /// when the editor is the application rather than a component in one.
    /// </remarks>
    /// <summary>
    /// Draw the tab strip. On here, unlike the other two bars.
    /// </summary>
    /// <remarks>
    /// A strip carrying a single "Home" is noise, which is why the spreadsheet and slide bars leave it
    /// off. This one has Home, Insert, Layout and Review — with it off, three of the four are simply
    /// unreachable.
    /// </remarks>
    [Parameter] public bool ShowRibbonTabs { get; set; } = true;

    /// <summary>A shared-set icon as the ribbon takes it: inline SVG markup, not a MarkupString.</summary>
    static string Ico(OfficeIcon icon) => OfficeToolbarIcons.Get(icon).Value;

    [Parameter] public double ToolbarHeight { get; set; } = 44;
    // Theme tokens rather than literals: the bar sits in the app's chrome, not on the page the
    // editor is drawing, so it has to follow light/dark with everything else. A literal white
    // default left a stark white bar wrapped around a dark editor in dark mode.
    // The Ribbon's own stylesheet carries this; forwarding it unconditionally would beat any rule an
    // app writes against the ribbon, so only a caller-chosen value is passed on.
    internal const string DefaultToolbarBackground = "var(--shiny-color-surface-container-low, #EFF4FB)";

    [Parameter] public string ToolbarBackground { get; set; } = DefaultToolbarBackground;

    string? ChosenToolbarBackground
        => this.ToolbarBackground == DefaultToolbarBackground ? null : this.ToolbarBackground;
    [Parameter] public string ToolbarForeground { get; set; } = "var(--shiny-color-on-surface, #161C23)";
    [Parameter] public string ToolbarBorder { get; set; } = "var(--shiny-color-outline-variant, #BBC7DF)";

    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    [Parameter] public EventCallback DocumentChanged { get; set; }

    /// <summary>The underlying editor, so a host can focus it or reach its controller.</summary>
    public DocumentEditor? Editor => this.editor;

    public DocumentEditorController? Controller => this.editor?.Controller;

    bool Disabled => this.ReadOnly || this.Document is null;

    CaretFormat Format => this.editor?.Controller?.CaretFormat ?? CaretFormat.Default;

    /// <summary>
    /// Whether the spelling pass is running: the toolbar's own choice, or the host's if it has not
    /// been overridden here.
    /// </summary>
    /// <remarks>
    /// The override exists so the Review tab's toggle works in a host that passed
    /// <c>SpellCheckEnabled</c> one-way. Writing the parameter itself would be undone by the next
    /// render; a host that binds gets its value back through <c>SpellCheckEnabledChanged</c> and the
    /// override then agrees with it.
    /// </remarks>
    bool SpellCheckOn => this.spellCheckOverride ?? this.SpellCheckEnabled;

    bool? spellCheckOverride;

    DocumentPageLayout? layoutOverride;

    /// <summary>
    /// The layout in force: the toolbar's own choice, or the host's if it has not been overridden.
    /// </summary>
    /// <remarks>Same shape as the spelling toggle and the zoom, and for the same reason.</remarks>
    DocumentPageLayout LayoutMode => this.layoutOverride ?? this.PageLayout;

    async Task TogglePrintLayout()
    {
        var next = this.LayoutMode == DocumentPageLayout.Print
            ? DocumentPageLayout.Reflow
            : DocumentPageLayout.Print;

        this.layoutOverride = next;

        if (this.Controller is { } controller)
            controller.PageLayout = next;

        await this.PageLayoutChanged.InvokeAsync(next);
    }

    List<RibbonMenuEntry> PageNumberMenu =>
    [
        .. new[] { PageNumberPlacement.Footer, PageNumberPlacement.Header }
            .SelectMany(placement => new[] { PageNumberPosition.Left, PageNumberPosition.Center, PageNumberPosition.Right }
                .Select(position => new RibbonMenuEntry
                {
                    Text = $"{placement} — {position}",
                    IsDisabled = this.Disabled,
                    OnClick = EventCallback.Factory.Create(this, () => this.Run(c => c.InsertPageNumber(placement, position)))
                }))
    ];

    /// <summary>The header or footer being written, or null when the prompt is closed.</summary>
    (bool Header, string Text)? chrome;

    void OpenChrome(bool header)
    {
        if (this.Controller is not { } controller || this.Disabled)
            return;

        this.chrome = (header, controller.ChromeText(header) ?? string.Empty);
    }

    /// <summary>Enter commits, Escape abandons — the two keys a one-field prompt owes the keyboard.</summary>
    async Task OnChromeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await this.CommitChrome();
        else if (e.Key == "Escape")
            this.chrome = null;
    }

    async Task CommitChrome()
    {
        if (this.chrome is not { } editing || this.Controller is not { } controller)
            return;

        // An empty line removes it, which is the only way back out of having one.
        var text = string.IsNullOrWhiteSpace(editing.Text) ? null : editing.Text;

        if (editing.Header)
            controller.SetHeaderText(text);
        else
            controller.SetFooterText(text);

        this.chrome = null;
        await this.DocumentChanged.InvokeAsync();
    }

    /// <summary>The zoom stops the buttons step through.</summary>
    /// <remarks>
    /// Fixed stops rather than a multiplier: a percentage that lands on 87% is a worse answer than one
    /// that lands on 100%, and these are the ones a reader recognises from every other document app.
    /// </remarks>
    static readonly double[] ZoomStops = [0.5, 0.75, 1.0, 1.25, 1.5, 2.0, 3.0];

    double? zoomOverride;

    /// <summary>
    /// The zoom in force: the toolbar's own, or the host's if it has not been overridden here.
    /// </summary>
    /// <remarks>
    /// Same shape as the spelling toggle, and for the same reason - writing the <c>Zoom</c> parameter
    /// itself would be undone by the next render in a host that passed it one-way.
    /// </remarks>
    double ZoomLevel => this.zoomOverride ?? this.Zoom;

    bool CanZoomIn => this.ZoomLevel < ZoomStops[^1] - 0.001;

    bool CanZoomOut => this.ZoomLevel > ZoomStops[0] + 0.001;

    async Task StepZoom(int direction)
    {
        var current = this.ZoomLevel;

        var next = direction > 0
            ? ZoomStops.FirstOrDefault(z => z > current + 0.001, ZoomStops[^1])
            : ZoomStops.LastOrDefault(z => z < current - 0.001, ZoomStops[0]);

        await this.SetZoomAsync(next);
    }

    /// <summary>
    /// Sets the zoom so the page exactly spans the window.
    /// </summary>
    /// <remarks>
    /// Only in print. Reflow already fits the window by construction - it re-wraps to the measure - so
    /// there is nothing for this to do there.
    /// </remarks>
    async Task FitToWidth()
    {
        if (this.Controller is not { IsPaginated: true } controller)
            return;

        var page = controller.PageWidth;
        var available = controller.Viewport.Width * controller.ViewScale;

        if (page <= 0 || available <= 0)
            return;

        await this.SetZoomAsync(available / page);
    }

    async Task SetZoomAsync(double value)
    {
        this.zoomOverride = value;

        if (this.Controller is { } controller)
            controller.Zoom = value;

        await this.ZoomChanged.InvokeAsync(value);
    }

    async Task ToggleSpellCheck()
    {
        var next = !this.SpellCheckOn;
        this.spellCheckOverride = next;

        if (this.Controller is { } controller)
            controller.IsSpellCheckEnabled = next;

        await this.SpellCheckEnabledChanged.InvokeAsync(next);
    }

    /// <summary>
    /// Steps to the next misspelling and selects it, then offers what can be done about it.
    /// </summary>
    /// <remarks>
    /// The menu is the point. Stepping to an error and stopping there leaves the user with a selected
    /// word and the same problem they started with.
    /// </remarks>
    async Task GoToSpellingError(bool backwards)
    {
        if (this.Controller is not { } controller || this.Disabled)
            return;

        if (await controller.GoToNextSpellingErrorAsync(backwards) is null)
            return;

        if (this.editor is { } surface)
            await surface.ShowSpellingMenuForCaretAsync();
    }

    /// <summary>The document's current margins, for the gallery to mark. Null until one is open.</summary>
    PageMargins? Margins => this.editor?.Controller?.PageMargins;

    PageOrientation Orientation => this.editor?.Controller?.PageOrientation ?? PageOrientation.Portrait;

    string ColorHex => OfficeColors.ToHex(this.Format.Color);

    async Task Run(Action<DocumentEditorController> action)
    {
        if (this.editor?.Controller is not { } controller || this.Disabled)
            return;

        action(controller);

        // Focus goes back to the editor after every toolbar action: leaving it on the button means the
        // next keystroke goes nowhere, which reads as the editor having silently stopped working.
        await this.editor.FocusAsync();
        await this.RaiseChangedAsync();
    }

    Task Align(TextAlignment alignment) => this.Run(c => c.SetAlignment(alignment));

    Task OnFontChanged(string family)
        => family is { Length: > 0 }
            ? this.Run(c => c.SetFontFamily(family))
            : Task.CompletedTask;

    Task OnSizeChanged(double size)
        => size > 0
            ? this.Run(c => c.SetFontSize(size))
            : Task.CompletedTask;

    Task OnColorChanged(string hex)
        => OfficeColors.TryParse(hex, out var color)
            ? this.Run(c => c.SetTextColor(color))
            : Task.CompletedTask;

    Task OnHighlightPicked(ArgbColor? color) => this.Run(c => c.SetHighlight(color));

    /// <summary>
    /// Applies a margin preset to the whole document.
    /// </summary>
    /// <remarks>
    /// Offered in both layouts although only <see cref="DocumentPageLayout.Print"/> can show the
    /// result — the margins belong to the document and are written and saved either way, exactly as a
    /// page break is. Hiding the control in reflow would hide a setting the file still has.
    /// </remarks>
    Task OnMarginsPicked(PageMargins margins) => this.Run(c => c.SetPageMargins(margins));

    Task OnShapePicked(ShapeGeometry geometry)
        => this.Run(c => c.InsertShape(geometry, this.ShapeWidth, this.ShapeHeight));

    Task OnTablePicked((int Rows, int Columns) size)
        => this.Run(c => c.InsertTable(size.Rows, size.Columns));

    Task OnImagePicked(OfficePickedImage image)
        => this.Run(c => c.InsertImage(
            image.Data,
            image.ContentType,
            this.PictureWidth,
            name: Path.GetFileNameWithoutExtension(image.FileName)));

    async Task OnDocumentChanged() => await this.RaiseChangedAsync();

    async Task RaiseChangedAsync()
    {
        this.StateHasChanged();

        if (this.DocumentChanged.HasDelegate)
            await this.DocumentChanged.InvokeAsync();
    }

    /// <summary>
    /// The colour this control wears: its ribbon's header band and tab underline.
    /// </summary>
    /// <remarks>
    /// Defaults to <see cref="OfficeAccent.Document"/> - the colour Microsoft's own Word wears,
    /// because that is what a user reads as "a document" before any label has been looked at. Set it to
    /// take on the app's own brand instead, or to <c>null</c> to leave the bar on the theme's neutrals
    /// like the rest of the chrome.
    /// </remarks>
    [Parameter] public OfficeAccent? Accent { get; set; } = OfficeAccent.Document;

    string? AccentBackground => this.Accent is { } a ? Css(a.Color) : null;

    string? AccentInk => this.Accent is { } a ? Css(a.Ink) : null;

    static string Css(ArgbColor value)
        => $"rgba({value.R},{value.G},{value.B},{(value.A / 255d).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)})";


    /// <summary>A picture drawn behind the page. Forwarded to the surface.</summary>
    [Parameter] public OfficeWatermark? Watermark { get; set; }

    Task OnWatermarkPicked(OfficeWatermark? mark)
    {
        this.Watermark = mark;
        this.StateHasChanged();
        return Task.CompletedTask;
    }

}
