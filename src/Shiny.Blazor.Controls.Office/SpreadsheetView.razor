@using SkiaSharp
@using SkiaSharp.Views.Blazor
@using Shiny.Controls.Office.View
@using Shiny.Controls.Office.Shell
@using Shiny.Blazor.Controls
@using Microsoft.AspNetCore.Components.Rendering
@implements IAsyncDisposable
@inject IJSRuntime Js

@*
    A workbook, drawn on a Skia canvas, with the sheet strip that makes it a workbook rather than a
    grid. The strip is part of this control on purpose: a host that had to supply its own would be
    reimplementing tab order, hidden sheets and rename validation against an API it can already see.

    Everything interactive beyond the grid itself - the right-click menu, the filter dropdowns, Format
    Cells and every other dialog - is described by the controller and only drawn here, by SheetMenu and
    SheetDialogHost. That is what keeps this host and the MAUI one offering the same commands.
*@

<div class="shiny-spreadsheet-host @OfficeScheme.ScopeClass(this.Theme) @(this.ShowShell ? "has-shell" : null) @Class" style="@Style" @ref="root">

    @if (this.ShowShell)
    {
        @*
            Excel's window: title bar, ribbon (File opens the backstage), the sheet, the status bar, and
            the notes pane on the right. Every part is a slot of OfficeShell and every slot can be turned
            off; turning them all off is still not quite ShowShell="false", which drops the shell entirely.
        *@
        <OfficeShell App="OfficeApp.Excel"
                     IsBackstageOpen="this.backstageOpen"
                     IsBackstageOpenChanged="this.OnBackstageOpenChangedAsync"
                     IsRightPaneOpen="this.commentsOpen"
                     IsRightPaneOpenChanged="this.OnCommentsOpenChangedAsync"
                     ShellLayoutChanged="this.OnShellLayoutChanged"
                     TitleBar="@(this.ShowTitleBar ? (RenderFragment)this.RenderTitleBar : null)"
                     Ribbon="@(this.ShowToolbar && this.controller is not null ? (RenderFragment)this.RenderShellRibbon : null)"
                     RightPane="@(this.ShowCommentsPane ? (RenderFragment)this.RenderCommentsPane : null)"
                     StatusBar="@(this.ShowStatusBar ? (RenderFragment)this.RenderStatusBar : null)"
                     Backstage="@(this.ShowBackstage ? (RenderFragment)this.RenderBackstage : null)">
            <div class="shiny-spreadsheet-body">
                @((RenderFragment)this.RenderSheet)
            </div>
        </OfficeShell>
    }
    else
    {
        @if (this.ShowToolbar && this.controller is not null)
        {
            <SpreadsheetToolbar Controller="this.controller"
                                ReadOnly="this.EffectiveReadOnly"
                                ShowTooltips="this.ShowTooltips"
                                ToolbarContent="this.ToolbarContent"
                                Watermark="this.Watermark"
                                WatermarkChanged="this.OnWatermarkChanged"
                                ShowFormulaBar="this.showFormulaBar"
                                ShowFormulaBarChanged="this.OnShowFormulaBarChanged"
                                FileMenuRequested="this.FileMenuRequested"
                                Changed="this.OnSheetsChanged" />
        }

        @((RenderFragment)this.RenderSheet)
    }

    <SheetDialogHost Dialog="this.dialog" DialogChanged="this.OnDialogChanged" />
</div>

@code {
    ElementReference host;
    ElementReference root;
    ElementReference editor;
    SKCanvasView? canvas;
    SpreadsheetPainter? painter;
    SpreadsheetController? controller;
    SpreadsheetScript? script;
    bool focusEditor;
    bool gridAttached;

    readonly FormulaAssistSession assist = new();
    SheetDialog? dialog;
    SheetMenuRequest? menu;

    /// <summary>Drives the marching-ants border; see <see cref="StartMarching"/>.</summary>
    PeriodicTimer? marching;
    float dashPhase;
    double lastWidth = 800;
    double lastHeight = 600;

    /// <summary>What the formula bar is actually doing, which the View tab can flip.</summary>
    bool showFormulaBar = true;
    bool? lastShowFormulaBarParameter;
    double? lastZoomParameter;

    // ---- touch gestures ----
    readonly Dictionary<long, (double X, double Y)> touches = new();
    bool pinching;
    double pinchDistance;
    double pinchZoom;
    CancellationTokenSource? longPress;
    (double X, double Y) pressOrigin;

    /// <summary>
    /// The theme the canvas was last painted with.
    /// </summary>
    /// <remarks>
    /// SKCanvasView only repaints when Invalidate is called; a Blazor re-render does not touch the
    /// canvas contents. Without this comparison a theme change updates the parameter, re-renders the
    /// component, and leaves the old pixels on screen - the toggle appears to do nothing at all.
    /// </remarks>
    SpreadsheetTheme? paintedTheme;
    ThemeSchemeWatcher scheme = null!;

    /// <summary>
    /// Device pixel ratio, read once from the browser.
    /// </summary>
    /// <remarks>
    /// SKCanvasView hands back a surface in device pixels but does not expose the ratio it used.
    /// Deriving it from the last known CSS width is circular — width = info.Width / (info.Width /
    /// lastWidth) is just lastWidth — so the size could never change after the first paint, and the
    /// grid stayed frozen at whatever the element measured on its very first frame.
    /// </remarks>
    double dpr = 1;

    /// <summary>The workbook to display. Setting it rebuilds the view.</summary>
    [Parameter] public Workbook? Workbook { get; set; }

    /// <summary>Name of the sheet to show. Defaults to the first sheet.</summary>
    [Parameter] public string? SheetName { get; set; }

    /// <summary>
    /// Raised when the sheet on screen changes — a tab click, or a sheet edit that took the old one
    /// away. Bind it with <c>@bind-SheetName</c> to keep a host's own idea of the sheet in step.
    /// </summary>
    [Parameter] public EventCallback<string> SheetNameChanged { get; set; }

    /// <summary>
    /// Whether to show the strip of sheet tabs under the grid. On by default: a workbook with no way
    /// to reach its other sheets is a worse default than a single tab that does nothing.
    /// </summary>
    [Parameter] public bool ShowSheetTabs { get; set; } = true;

    /// <summary>
    /// Whether to show the name box and formula field above the grid.
    /// </summary>
    /// <remarks>
    /// On by default. The grid paints the <em>result</em> of a formula, so without this a cell reading
    /// 84 gives no way to discover that it holds <c>=B1*2</c> — and no way to edit it as a formula
    /// rather than retyping it from scratch. The ribbon's View ▸ Formula Bar flips it too, and reports
    /// through <see cref="ShowFormulaBarChanged"/>.
    /// </remarks>
    [Parameter] public bool ShowFormulaBar { get; set; } = true;

    /// <summary>Raised when View ▸ Formula Bar is toggled, for <c>@bind-ShowFormulaBar</c>.</summary>
    [Parameter] public EventCallback<bool> ShowFormulaBarChanged { get; set; }

    /// <summary>
    /// Whether to show the ribbon above the formula bar.
    /// </summary>
    /// <remarks>
    /// On by default — a change: it used to be off, when the bar was a formatting strip a viewer did
    /// not need. It is now Excel's ribbon — Home, Insert, Formulas, Data, Review, View — and a
    /// spreadsheet without it hides most of what it can do. Set it to false for a plain viewer.
    /// </remarks>
    [Parameter] public bool ShowToolbar { get; set; } = true;

    /// <summary>Whether the toolbar's icon-only buttons carry a hover tooltip.</summary>
    [Parameter] public bool ShowTooltips { get; set; } = true;

    /// <summary>Extra items appended to the toolbar, after the built-in controls.</summary>
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    /// <summary>
    /// Raised by the ribbon's File button. The control has no backstage of its own: open, save, print
    /// and share are the app's, so the app decides what File shows.
    /// </summary>
    [Parameter] public EventCallback FileMenuRequested { get; set; }

    /// <summary>
    /// The magnification, 0.1 to 4. Two-way: Ctrl+wheel, a pinch and the View tab's zoom all change it
    /// and report through <see cref="ZoomChanged"/>, for <c>@bind-Zoom</c> and a status bar's slider.
    /// </summary>
    [Parameter] public double Zoom { get; set; } = 1;

    [Parameter] public EventCallback<double> ZoomChanged { get; set; }

    /// <summary>
    /// Raised when the selection's Average, Count, Numerical Count, Min, Max or Sum may have changed —
    /// when the selection moves or the data under it is edited. Read <see cref="SelectionStatistics"/>.
    /// </summary>
    [Parameter] public EventCallback<SelectionStatistics> SelectionStatisticsChanged { get; set; }

    /// <summary>What a status bar shows about the selection. Empty when there is no workbook.</summary>
    public SelectionStatistics SelectionStatistics => this.controller?.SelectionStatistics ?? SelectionStatistics.Empty;

    /// <summary>
    /// Whether the tab strip can add, rename, reorder, hide and delete sheets, as opposed to only
    /// switching between them.
    /// </summary>
    [Parameter] public bool AllowSheetEditing { get; set; } = true;

    /// <summary>Blocks formatting and structural sheet edits. Cell editing is unaffected.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Grid chrome colours. Left unset the control follows the host page's light/dark scheme, so a
    /// spreadsheet dropped into a dark app is dark without the app wiring anything up. Setting it
    /// pins the choice - including to <see cref="SpreadsheetTheme.Light"/>, which is how a host asks
    /// for a paper-white grid regardless of the app around it.
    /// </summary>
    [Parameter] public SpreadsheetTheme? Theme { get; set; }

    /// <summary>The theme actually painted: <see cref="Theme"/> when set, otherwise the page's scheme.</summary>
    SpreadsheetTheme EffectiveTheme => OfficeScheme.Resolve(this.scheme, this.Theme);

    [Parameter] public string? Class { get; set; }

    [Parameter] public string? Style { get; set; }

    /// <summary>Raised after any edit, so a host can track the dirty state.</summary>
    [Parameter] public EventCallback<CellRef> CellChanged { get; set; }

    /// <summary>The live controller, exposed so a toolbar or formula bar can drive the same state.</summary>
    public SpreadsheetController? Controller => this.controller;

    protected override void OnInitialized()
        // Repaint on a scheme flip: the canvas only redraws when told to, so without this the grid
        // keeps the pixels it had when the app was the other way round.
        => this.scheme = new ThemeSchemeWatcher(this.Js, () =>
        {
            this.canvas?.Invalidate();
            this.StateHasChanged();
            return Task.CompletedTask;
        });

    protected override void OnParametersSet()
    {
        if (this.paintedTheme != this.EffectiveTheme)
        {
            this.paintedTheme = this.EffectiveTheme;
            this.canvas?.Invalidate();
        }

        // Taken from the parameter only when the parent actually changed it: an unbound host leaves it
        // at its default, and re-applying that on every render would undo every Ctrl+wheel.
        if (this.lastShowFormulaBarParameter != this.ShowFormulaBar)
        {
            this.lastShowFormulaBarParameter = this.ShowFormulaBar;
            this.showFormulaBar = this.ShowFormulaBar;
        }

        if (this.Workbook is null)
        {
            this.Detach();
            this.controller = null;
            return;
        }

        var sheet = this.SheetName is null
            ? this.Workbook.Sheets.FirstOrDefault()
            : this.Workbook.Sheets.FirstOrDefault(x => x.Name == this.SheetName);

        if (sheet is null)
            return;

        if (this.controller is not null && ReferenceEquals(this.controller.Workbook, this.Workbook))
        {
            if (this.controller.Sheet.Name != sheet.Name)
                this.controller.SwitchSheet(sheet);

            this.ApplyZoomParameter();
            return;
        }

        this.Detach();

        this.controller = new SpreadsheetController(this.Workbook, sheet);
        this.controller.Changed += this.OnControllerChanged;
        this.controller.EditingChanged += this.OnEditingChanged;
        this.controller.ActiveSheetChanged += this.OnActiveSheetChanged;
        this.controller.ClipboardChanged += this.OnClipboardChanged;
        this.controller.DialogRequested += this.OnDialogRequested;
        this.controller.MenuRequested += this.OnMenuRequested;
        this.controller.HyperlinkActivated += this.OnHyperlinkActivated;
        this.controller.ZoomChanged += this.OnZoomChanged;
        this.controller.SelectionStatisticsChanged += this.OnStatisticsChanged;
        this.controller.Resize(this.lastWidth, this.lastHeight);

        this.lastZoomParameter = null;
        this.ApplyZoomParameter();
        this.OnWorkbookAttached(this.Workbook);
    }

    void ApplyZoomParameter()
    {
        if (this.controller is null || this.lastZoomParameter == this.Zoom)
            return;

        this.lastZoomParameter = this.Zoom;
        this.controller.Zoom = this.Zoom;
    }

    /// <summary>
    /// Keeps <see cref="SheetName"/> in step with the controller.
    /// </summary>
    /// <remarks>
    /// Writing the parameter back as well as raising the callback matters: an unbound host leaves
    /// SheetName at whatever it was, and the next OnParametersSet would then switch the grid straight
    /// back to the sheet the user just navigated away from.
    /// </remarks>
    void OnActiveSheetChanged(object? sender, Worksheet sheet)
    {
        this.SheetName = sheet.Name;

        if (this.SheetNameChanged.HasDelegate)
            _ = this.InvokeAsync(() => this.SheetNameChanged.InvokeAsync(sheet.Name));

        this.StateHasChanged();
    }

    Task OnSheetsChanged()
    {
        this.canvas?.Invalidate();
        this.StateHasChanged();
        return Task.CompletedTask;
    }

    void OnControllerChanged(object? sender, EventArgs e)
    {
        this.UpdateStatus();
        this.ScheduleAutoSave();
        this.canvas?.Invalidate();
        this.StateHasChanged();
    }

    void OnEditingChanged(object? sender, CellRef? cell)
    {
        // The input is rendered by the next diff, so focusing has to wait until after it exists.
        this.focusEditor = cell is not null;
        this.assist.Reset();

        if (cell is not null && this.controller is { } c && c.EditingText.StartsWith('='))
            this.assist.Update(c.EditingText, c.EditingText.Length, this.Names());

        this.UpdateStatus();

        this.StateHasChanged();
    }

    void OnZoomChanged(object? sender, double zoom)
    {
        // Remembered as if the parent had set it, so its unchanged parameter does not snap it back.
        this.lastZoomParameter = zoom;
        this.Zoom = zoom;

        if (this.ZoomChanged.HasDelegate)
            _ = this.InvokeAsync(() => this.ZoomChanged.InvokeAsync(zoom));
    }

    void OnStatisticsChanged(object? sender, EventArgs e)
    {
        this.UpdateStatus();

        if (this.SelectionStatisticsChanged.HasDelegate)
            _ = this.InvokeAsync(() => this.SelectionStatisticsChanged.InvokeAsync(this.SelectionStatistics));
    }

    void OnDialogRequested(object? sender, SheetDialog request)
    {
        this.menu = null;
        this.dialog = request;
        _ = this.InvokeAsync(this.StateHasChanged);
    }

    async Task OnDialogChanged(SheetDialog? next)
    {
        this.dialog = next;
        this.canvas?.Invalidate();
        this.StateHasChanged();

        if (next is null)
            await this.FocusGridAsync();
    }

    void OnMenuRequested(object? sender, SheetMenuRequest request)
    {
        this.menu = request;
        _ = this.InvokeAsync(this.StateHasChanged);
    }

    async Task OnMenuClosed()
    {
        this.menu = null;
        this.canvas?.Invalidate();
        this.StateHasChanged();
        await this.FocusGridAsync();
    }

    void OnHyperlinkActivated(object? sender, string url)
    {
        if (this.script is { } s)
            _ = this.InvokeAsync(() => s.InvokeAsync("openUrl", url));
    }

    async Task OnShowFormulaBarChanged(bool show)
    {
        this.showFormulaBar = show;
        this.StateHasChanged();

        if (this.ShowFormulaBarChanged.HasDelegate)
            await this.ShowFormulaBarChanged.InvokeAsync(show);
    }

    async Task FocusGridAsync()
    {
        try
        {
            await this.host.FocusAsync();
        }
        catch (Exception)
        {
            // Not rendered, or already gone.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Before the DPR read: the canvas paints its first frame off this, and starting the watch
            // second would flash a white grid in a dark app.
            await this.scheme.StartAsync(this.root);
            await this.ReadDevicePixelRatioAsync();

            this.script = new SpreadsheetScript(this.Js);

            if (await OfficeFonts.EnsureLoadedAsync(this.Js))
            {
                // The first frame painted with fallback metrics; the measurer's cache is invalidated by
                // the new registrations, so a repaint now re-measures against the real faces.
                this.canvas?.Invalidate();
                this.StateHasChanged();
            }
        }

        this.SyncCommands();

        if (!this.gridAttached && this.script is { } s)
        {
            this.gridAttached = true;
            await s.InvokeAsync("attachGrid", this.host);
        }

        if (this.focusEditor)
        {
            this.focusEditor = false;
            try
            {
                await this.editor.FocusAsync();
                if (this.script is { } module)
                    await module.InvokeAsync("attachAssist", this.editor);
            }
            catch (Exception)
            {
                // The editor can be torn down between the flag being set and this running; a lost focus
                // call is not worth failing the render over.
            }
        }
    }

    void OnPaint(SKPaintSurfaceEventArgs e)
    {
        var info = e.Info;
        this.painter ??= new SpreadsheetPainter();

        if (this.controller is null)
        {
            var theme = this.EffectiveTheme;
            e.Surface.Canvas.Clear(new SKColor(theme.Background.R, theme.Background.G, theme.Background.B));
            return;
        }

        // The surface is in device pixels; everything above it works in CSS pixels.
        var width = info.Width / this.dpr;
        var height = info.Height / this.dpr;

        if (Math.Abs(width - this.lastWidth) > 0.5 || Math.Abs(height - this.lastHeight) > 0.5)
        {
            this.lastWidth = width;
            this.lastHeight = height;
            this.controller.Resize(width, height);
        }

        this.painter.Paint(e.Surface.Canvas, SpreadsheetPaintRequest.For(this.controller, this.EffectiveTheme, (float)this.dpr) with
        {
            Watermark = this.Watermark,
            ClipboardDashPhase = this.dashPhase
        });
    }


    /// <summary>The formula bar, the grid and the sheet tabs — the same in both layouts.</summary>
    void RenderSheet(RenderTreeBuilder __builder)
    {
        @if (this.showFormulaBar && this.controller is not null)
        {
            <FormulaBar Controller="this.controller"
                        ReadOnly="this.EffectiveReadOnly"
                        Changed="this.OnSheetsChanged" />
        }

        <div class="shiny-spreadsheet"
             tabindex="0"
             @ref="host"
             @onkeydown="OnKeyDown"
             @onwheel="OnWheel"
             @onwheel:preventDefault="true"
             @oncontextmenu="OnContextMenu"
             @oncontextmenu:preventDefault="true">

            <SKCanvasView @ref="canvas"
                          class="shiny-spreadsheet-canvas"
                          IgnorePixelScaling="false"
                          OnPaintSurface="OnPaint"
                          @onpointerdown="OnPointerDown"
                          @onpointermove="OnPointerMove"
                          @onpointerup="OnPointerUp"
                          @onpointercancel="OnPointerUp"
                          @onpointerleave="OnPointerLeave"
                          @ondblclick="OnDoubleClick" />

            @if (Controller?.EditorBounds is { } rect)
            {
                <input class="shiny-spreadsheet-editor"
                       style="left:@(Css(rect.X))px;top:@(Css(rect.Y))px;width:@(Css(rect.Width))px;height:@(Css(rect.Height))px;font-size:@(Css(Controller.EditorFontSize))px"
                       value="@Controller.EditingText"
                       spellcheck="false"
                       data-assist-open="@(this.assist.IsOpen ? "true" : "false")"
                       @ref="editor"
                       @oninput="OnEditorInput"
                       @onkeydown="OnEditorKeyDown"
                       @onkeydown:stopPropagation="true"
                       @onblur="OnEditorBlur" />

                <FormulaAssistPopup State="this.assist.State"
                                    IsOpen="this.assist.IsOpen"
                                    Index="this.assist.Index"
                                    OnPick="this.OnEditorPickAsync"
                                    Style="@($"left:{Css(rect.X)}px;top:{Css(rect.Bottom + 2)}px")" />
            }

            <SheetMenu Request="this.menu"
                       HostWidth="this.lastWidth"
                       HostHeight="this.lastHeight"
                       Closed="this.OnMenuClosed" />
        </div>

        @if (this.ShowSheetTabs && this.controller is not null)
        {
            <SheetTabStrip Controller="this.controller"
                           AllowEditing="@(this.AllowSheetEditing && !this.EffectiveReadOnly)"
                           Changed="this.OnSheetsChanged" />
        }
    }

    void RenderTitleBar(RenderTreeBuilder __builder)
    {
        <OfficeTitleBar DocumentName="@this.EffectiveDocumentName"
                        DocumentNameChanged="this.OnDocumentNameChangedAsync"
                        DocumentLocation="@this.Workbook?.Path"
                        SaveState="this.EffectiveSaveState"
                        AutoSave="this.AutoSave"
                        AutoSaveChanged="this.OnAutoSaveChangedAsync"
                        CanUndo="@(this.controller?.CanUndo ?? false)"
                        CanRedo="@(this.controller?.CanRedo ?? false)"
                        SaveRequested="this.SaveAsync"
                        UndoRequested="this.UndoFromShell"
                        RedoRequested="this.RedoFromShell"
                        CommandIndex="this.commands"
                        SearchSubmitted="this.OnSearchSubmitted"
                        UserName="@this.UserName" />
    }

    void RenderShellRibbon(RenderTreeBuilder __builder)
    {
        <SpreadsheetToolbar @ref="toolbar"
                            Controller="this.controller"
                            InShell="true"
                            DisplayMode="@(this.simplifiedRibbon ? RibbonDisplayMode.Simplified : RibbonDisplayMode.Expanded)"
                            ReadOnly="this.EffectiveReadOnly"
                            ShowTooltips="this.ShowTooltips"
                            ToolbarContent="this.ToolbarContent"
                            Watermark="this.Watermark"
                            WatermarkChanged="this.OnWatermarkChanged"
                            ShowFormulaBar="this.showFormulaBar"
                            ShowFormulaBarChanged="this.OnShowFormulaBarChanged"
                            FileMenuRequested="this.OnFileMenuAsync"
                            Changed="this.OnSheetsChanged">
            <HeaderEnd>
                @if (this.ShowRibbonActions)
                {
                    <OfficeRibbonActions IsCommentsOpen="this.commentsOpen"
                                         IsCommentsOpenChanged="this.OnCommentsOpenChangedAsync"
                                         ShowComments="this.ShowCommentsPane"
                                         EditMode="this.editMode"
                                         EditModeChanged="this.OnEditModeChanged"
                                         ShareClicked="this.ShareRequested" />
                }
            </HeaderEnd>
        </SpreadsheetToolbar>
    }

    void RenderCommentsPane(RenderTreeBuilder __builder)
    {
        <OfficeSidePane Title="Comments">
            @{ var notes = this.Workbook is { } book ? SpreadsheetShell.Notes(book) : []; }
            @if (notes.Count == 0)
            {
                <p class="shiny-spreadsheet-notes__empty">No notes in this workbook. Add one from Review ▸ New Note or the right-click menu.</p>
            }
            else
            {
                <ul class="shiny-spreadsheet-notes">
                    @foreach (var note in notes)
                    {
                        var n = note;
                        <li>
                            <button type="button" class="shiny-spreadsheet-note" title="Go to @n.Address" @onclick="() => this.GoToNote(n)">
                                <span class="shiny-spreadsheet-note__where">@n.Address</span>
                                @if (!string.IsNullOrWhiteSpace(n.Author))
                                {
                                    <span class="shiny-spreadsheet-note__author">@n.Author</span>
                                }
                                <span class="shiny-spreadsheet-note__text">@n.Text</span>
                            </button>
                        </li>
                    }
                </ul>
            }
        </OfficeSidePane>
    }

    void RenderStatusBar(RenderTreeBuilder __builder)
    {
        <OfficeStatusBar Items="this.statusItems"
                         SelectedViewMode="@SpreadsheetShell.ViewModeId(this.controller?.ViewMode ?? SheetViewMode.Normal)"
                         SelectedViewModeChanged="this.OnViewModeChanged"
                         Zoom="@(this.controller?.Zoom ?? this.Zoom)"
                         ZoomChanged="this.OnStatusZoomChanged"
                         ZoomModel="ShellZoom" />
    }

    void RenderBackstage(RenderTreeBuilder __builder)
    {
        <OfficeBackstage DocumentName="@this.EffectiveDocumentName"
                         Templates="@(this.Templates ?? SpreadsheetTemplates.All)"
                         RecentFiles="this.RecentFiles"
                         DocumentInfo="this.documentInfo"
                         TemplateSelected="this.OnTemplateSelectedAsync"
                         RecentFileSelected="this.RecentFileSelected"
                         OpenRequested="this.OpenRequested"
                         SaveRequested="this.SaveAsync"
                         SaveAsRequested="f => this.WriteFileAsync(f, SpreadsheetFileAction.SaveAs)"
                         ExportRequested="f => this.WriteFileAsync(f, SpreadsheetFileAction.Export)"
                         PrintRequested="this.PrintAsync" />
    }

    static string Css(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    async Task ReadDevicePixelRatioAsync()
    {
        try
        {
            this.dpr = await this.Js.InvokeAsync<double>("eval", "window.devicePixelRatio || 1");
        }
        catch (Exception)
        {
            // Prerendering or a locked-down host: 1 is the safe assumption.
            this.dpr = 1;
        }

        if (this.dpr <= 0)
            this.dpr = 1;

        this.canvas?.Invalidate();
    }

    // ---- pointer ----

    void OnPointerDown(PointerEventArgs e)
    {
        if (this.controller is null)
            return;

        // The secondary button is the context menu's, which arrives as its own event.
        if (e.Button == 2)
            return;

        var kind = KindOf(e.PointerType);

        if (kind == PointerKind.Touch)
        {
            this.touches[e.PointerId] = (e.OffsetX, e.OffsetY);

            if (this.touches.Count == 2)
            {
                // A second finger turns whatever the first began - a pan, a tap - into a pinch.
                this.CancelLongPress();
                this.controller.PointerUp();
                this.pinching = true;
                this.pinchDistance = this.TouchDistance();
                this.pinchZoom = this.controller.Zoom;
                return;
            }

            if (this.touches.Count > 2)
                return;

            this.pressOrigin = (e.OffsetX, e.OffsetY);
            this.StartLongPress(e.OffsetX, e.OffsetY);
        }

        this.controller.PointerDown(e.OffsetX, e.OffsetY, e.ShiftKey, kind, e.CtrlKey || e.MetaKey);
    }

    /// <summary>
    /// The browser reports the pointer kind as a string; anything unrecognised is treated as a mouse.
    /// </summary>
    static PointerKind KindOf(string? pointerType)
        => pointerType switch
        {
            "touch" => PointerKind.Touch,
            "pen" => PointerKind.Pen,
            _ => PointerKind.Mouse
        };

    double TouchDistance()
    {
        var points = this.touches.Values.Take(2).ToArray();
        if (points.Length < 2)
            return 1;

        var dx = points[0].X - points[1].X;
        var dy = points[0].Y - points[1].Y;
        return Math.Max(1, Math.Sqrt(dx * dx + dy * dy));
    }

    void OnPointerMove(PointerEventArgs e)
    {
        if (this.controller is null)
            return;

        if (this.touches.ContainsKey(e.PointerId))
        {
            this.touches[e.PointerId] = (e.OffsetX, e.OffsetY);

            if (this.pinching)
            {
                this.controller.Zoom = this.pinchZoom * this.TouchDistance() / this.pinchDistance;
                return;
            }

            if (this.longPress is not null && (Math.Abs(e.OffsetX - this.pressOrigin.X) > 6 || Math.Abs(e.OffsetY - this.pressOrigin.Y) > 6))
                this.CancelLongPress();
        }

        // Buttons is a bitmask; 1 is the primary button still being held.
        if ((e.Buttons & 1) == 1)
            this.controller.PointerMove(e.OffsetX, e.OffsetY);
        else if (e.PointerType == "mouse")
            this.controller.PointerHover(e.OffsetX, e.OffsetY);
    }

    void OnPointerUp(PointerEventArgs e)
    {
        this.CancelLongPress();

        if (this.touches.Remove(e.PointerId) && this.pinching)
        {
            // The pinch ends when the fingers do; the one left on the glass starts nothing.
            if (this.touches.Count == 0)
                this.pinching = false;

            return;
        }

        this.controller?.PointerUp();
    }

    void OnPointerLeave(PointerEventArgs e) => this.controller?.PointerExit();

    void StartLongPress(double x, double y)
    {
        this.CancelLongPress();
        var cancel = new CancellationTokenSource();
        this.longPress = cancel;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(500, cancel.Token);
            }
            catch (TaskCanceledException)
            {
                return;
            }

            // A held finger is a touch user's right-click: end the pan it began (which selects the cell
            // it is on), then open that cell's menu.
            await this.InvokeAsync(() =>
            {
                if (cancel.IsCancellationRequested || this.controller is null)
                    return;

                this.longPress = null;
                this.controller.PointerUp();
                this.controller.OpenContextMenu(x, y);
            });
        });
    }

    void CancelLongPress()
    {
        this.longPress?.Cancel();
        this.longPress = null;
    }

    void OnContextMenu(MouseEventArgs e) => this.controller?.OpenContextMenu(e.OffsetX, e.OffsetY);

    void OnDoubleClick(MouseEventArgs e) => this.controller?.DoubleClick(e.OffsetX, e.OffsetY);

    /// <summary>The wheel scrolls; with Ctrl (or a trackpad pinch, which browsers report as Ctrl+wheel) it zooms.</summary>
    void OnWheel(WheelEventArgs e)
    {
        if (this.controller is null)
            return;

        if (e.CtrlKey)
        {
            this.controller.Zoom *= e.DeltaY < 0 ? 1.1 : 1 / 1.1;
            return;
        }

        this.controller.Scroll(e.DeltaX, e.DeltaY);
    }

    // ---- keyboard ----

    /// <summary>
    /// Every grid shortcut is the controller's: one table for both hosts. Which keys also need the
    /// browser's default stopped is decided in spreadsheet.js, in the same event, because Blazor's
    /// preventDefault flag is read at render time and would always apply to the key after this one.
    /// </summary>
    void OnKeyDown(KeyboardEventArgs e)
    {
        if (this.controller is null)
            return;

        var modifiers = SheetKeyModifiers.None;
        if (e.ShiftKey) modifiers |= SheetKeyModifiers.Shift;
        if (e.CtrlKey) modifiers |= SheetKeyModifiers.Control;
        if (e.AltKey) modifiers |= SheetKeyModifiers.Alt;
        if (e.MetaKey) modifiers |= SheetKeyModifiers.Meta;

        // Save and Print are the window's, not the grid's: Excel answers them from any cell.
        if ((e.CtrlKey || e.MetaKey) && !e.ShiftKey && !e.AltKey && this.ShowShell)
        {
            if (string.Equals(e.Key, "s", StringComparison.OrdinalIgnoreCase))
            {
                _ = this.SaveAsync();
                return;
            }

            if (string.Equals(e.Key, "p", StringComparison.OrdinalIgnoreCase))
            {
                _ = this.PrintAsync();
                return;
            }
        }

        this.controller.HandleKey(e.Key, modifiers);
    }

    /// <summary>Moves to the next or previous visible sheet, stopping at either end.</summary>
    public void StepSheet(int offset) => this.controller?.StepSheet(offset);

    // ---- clipboard animation ----

    /// <summary>Starts or stops the marching-ants animation as the clipboard fills and empties.</summary>
    void OnClipboardChanged(object? sender, EventArgs e)
    {
        if (this.controller?.ClipboardRange is null)
            this.StopMarching();
        else
            this.StartMarching();
    }

    /// <summary>
    /// Walks the dash phase forward until the clipboard is abandoned.
    /// </summary>
    /// <remarks>
    /// A timer rather than a CSS animation because the border is drawn into a canvas, and the canvas
    /// only redraws when something calls Invalidate. It runs only while there is something on the
    /// clipboard: a permanent frame loop under a grid that is usually idle would keep the tab awake
    /// and, in a Blazor Server circuit, would do it once per connected user.
    /// </remarks>
    void StartMarching()
    {
        if (this.marching is not null)
            return;

        var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(120));
        this.marching = timer;

        _ = Task.Run(async () =>
        {
            try
            {
                while (await timer.WaitForNextTickAsync())
                {
                    // Two dashes' worth of travel per cycle, so the phase never grows without bound.
                    this.dashPhase = (this.dashPhase + 2f) % 10f;
                    await this.InvokeAsync(() => this.canvas?.Invalidate());
                }
            }
            catch (ObjectDisposedException)
            {
                // The component went away mid-tick; there is nothing left to repaint.
            }
        });
    }

    void StopMarching()
    {
        var timer = this.marching;
        this.marching = null;

        if (timer is null)
            return;

        timer.Dispose();
        this.dashPhase = 0;
        this.canvas?.Invalidate();
    }

    // ---- the in-cell editor ----

    IEnumerable<string> Names() => this.controller?.Workbook.VisibleNames.Select(x => x.Name) ?? [];

    async Task OnEditorInput(ChangeEventArgs e)
    {
        if (this.controller is null)
            return;

        var text = e.Value?.ToString() ?? string.Empty;
        this.controller.UpdateEditingText(text);

        var caret = this.script is null ? text.Length : await this.script.CaretAsync(this.editor, text.Length);
        this.assist.Update(text, caret, this.Names());
    }

    Task OnEditorPickAsync(int index) => this.AcceptSuggestionAsync(index);

    async Task AcceptSuggestionAsync(int? index)
    {
        if (this.controller is null || this.assist.Accept(this.controller.EditingText, index) is not { } result)
            return;

        this.controller.UpdateEditingText(result.Text);

        if (this.script is not null)
            await this.script.InvokeAsync("setValue", this.editor, result.Text, result.Caret);

        this.assist.Update(result.Text, result.Caret, this.Names());
    }

    async Task OnEditorKeyDown(KeyboardEventArgs e)
    {
        if (this.controller is null)
            return;

        // An open suggestion list owns the arrows, Tab and Enter; spreadsheet.js has already stopped
        // the browser acting on them.
        if (this.assist.IsOpen)
        {
            switch (e.Key)
            {
                case "ArrowDown":
                    this.assist.Move(1);
                    return;

                case "ArrowUp":
                    this.assist.Move(-1);
                    return;

                case "Tab":
                case "Enter":
                    await this.AcceptSuggestionAsync(null);
                    return;

                case "Escape":
                    this.assist.Dismiss();
                    return;
            }
        }

        var cell = this.controller.EditingCell;

        switch (e.Key)
        {
            case "Enter":
                this.controller.CommitEdit(e.ShiftKey ? EditCommitDirection.Up : EditCommitDirection.Down);
                break;

            case "Tab":
                this.controller.CommitEdit(e.ShiftKey ? EditCommitDirection.Left : EditCommitDirection.Right);
                break;

            case "Escape":
                this.controller.CancelEdit();
                break;

            default:
                return;
        }

        this.assist.Reset();

        if (cell is { } committed && this.CellChanged.HasDelegate)
            await this.CellChanged.InvokeAsync(committed);

        await this.FocusGridAsync();
    }

    void OnEditorBlur()
    {
        // Clicking away commits, matching Excel rather than discarding what was typed. A refused entry
        // (data validation) leaves a message dialog open rather than the editor.
        this.assist.Reset();
        this.controller?.CommitEdit(EditCommitDirection.None);
    }

    void Detach()
    {
        if (this.controller is null)
            return;

        this.controller.Changed -= this.OnControllerChanged;
        this.controller.EditingChanged -= this.OnEditingChanged;
        this.controller.ActiveSheetChanged -= this.OnActiveSheetChanged;
        this.controller.ClipboardChanged -= this.OnClipboardChanged;
        this.controller.DialogRequested -= this.OnDialogRequested;
        this.controller.MenuRequested -= this.OnMenuRequested;
        this.controller.HyperlinkActivated -= this.OnHyperlinkActivated;
        this.controller.ZoomChanged -= this.OnZoomChanged;
        this.controller.SelectionStatisticsChanged -= this.OnStatisticsChanged;
    }

    public async ValueTask DisposeAsync()
    {
        this.DisposeShell();
        this.Detach();
        this.StopMarching();
        this.CancelLongPress();
        this.painter?.Dispose();
        await this.scheme.DisposeAsync();

        if (this.script is not null)
        {
            await this.script.InvokeAsync("detachGrid", this.host);
            await this.script.DisposeAsync();
        }
    }

    Task OnWatermarkChanged(OfficeWatermark? mark)
    {
        this.Watermark = mark;
        this.canvas?.Invalidate();
        this.StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// A picture drawn behind the content - a logo, a DRAFT stamp, a company mark.
    /// </summary>
    /// <remarks>
    /// A <b>display</b> watermark: it is drawn, not written into the file. The three Office formats
    /// have no common notion of one, so persisting would mean three unrelated mechanisms where drawing
    /// means one. See <see cref="OfficeWatermark"/>.
    /// </remarks>
    [Parameter] public OfficeWatermark? Watermark { get; set; }
}
