@using SkiaSharp
@using SkiaSharp.Views.Blazor
@implements IAsyncDisposable
@inject IJSRuntime Js

@*
    A workbook, drawn on a Skia canvas, with the sheet strip that makes it a workbook rather than a
    grid. The strip is part of this control on purpose: a host that had to supply its own would be
    reimplementing tab order, hidden sheets and rename validation against an API it can already see.
*@

<div class="shiny-spreadsheet-host @OfficeScheme.ScopeClass(this.Theme) @Class" style="@Style">

    @if (this.ShowToolbar && this.controller is not null)
    {
        <SpreadsheetToolbar Controller="this.controller"
                            ReadOnly="this.ReadOnly"
                            ShowTooltips="this.ShowTooltips"
                            ToolbarContent="this.ToolbarContent"
                            Watermark="this.Watermark"
                            WatermarkChanged="this.OnWatermarkChanged"
                            Changed="this.OnSheetsChanged" />
    }

    @if (this.ShowFormulaBar && this.controller is not null)
    {
        <FormulaBar Controller="this.controller"
                    ReadOnly="this.ReadOnly"
                    Changed="this.OnSheetsChanged" />
    }

    <div class="shiny-spreadsheet"
         tabindex="0"
         @ref="host"
         @onkeydown="OnKeyDown"
         @onkeydown:preventDefault="preventKeyDefault"
         @onwheel="OnWheel"
         @onwheel:preventDefault="true">

        <SKCanvasView @ref="canvas"
                      class="shiny-spreadsheet-canvas"
                      IgnorePixelScaling="false"
                      OnPaintSurface="OnPaint"
                      @onpointerdown="OnPointerDown"
                      @onpointermove="OnPointerMove"
                      @onpointerup="OnPointerUp"
                      @ondblclick="OnDoubleClick" />

        @if (Controller?.EditingCell is { } editing)
        {
            var rect = Controller.Viewport.CellRect(editing);

            <input class="shiny-spreadsheet-editor"
                   style="left:@(Css(rect.X))px;top:@(Css(rect.Y))px;width:@(Css(rect.Width))px;height:@(Css(rect.Height))px"
                   value="@Controller.EditingText"
                   @ref="editor"
                   @oninput="OnEditorInput"
                   @onkeydown="OnEditorKeyDown"
                   @onkeydown:stopPropagation="true"
                   @onblur="OnEditorBlur" />
        }
    </div>

    @if (this.ShowSheetTabs && this.controller is not null)
    {
        <SheetTabStrip Controller="this.controller"
                       AllowEditing="@(this.AllowSheetEditing && !this.ReadOnly)"
                       Changed="this.OnSheetsChanged" />
    }
</div>

@code {
    ElementReference host;
    ElementReference editor;
    SKCanvasView? canvas;
    SpreadsheetPainter? painter;
    SpreadsheetController? controller;
    bool preventKeyDefault;
    bool focusEditor;

    /// <summary>Drives the marching-ants border; see <see cref="StartMarching"/>.</summary>
    PeriodicTimer? marching;
    float dashPhase;
    double lastWidth;
    double lastHeight;

    /// <summary>
    /// The theme the canvas was last painted with.
    /// </summary>
    /// <remarks>
    /// SKCanvasView only repaints when Invalidate is called; a Blazor re-render does not touch the
    /// canvas contents. Without this comparison a theme change updates the parameter, re-renders the
    /// component, and leaves the old pixels on screen - the toggle appears to do nothing at all.
    /// </remarks>
    SpreadsheetTheme? paintedTheme;
    ThemeSchemeWatcher scheme = null!;

    /// <summary>
    /// Device pixel ratio, read once from the browser.
    /// </summary>
    /// <remarks>
    /// SKCanvasView hands back a surface in device pixels but does not expose the ratio it used.
    /// Deriving it from the last known CSS width is circular — width = info.Width / (info.Width /
    /// lastWidth) is just lastWidth — so the size could never change after the first paint, and the
    /// grid stayed frozen at whatever the element measured on its very first frame.
    /// </remarks>
    double dpr = 1;

    /// <summary>The workbook to display. Setting it rebuilds the view.</summary>
    [Parameter] public Workbook? Workbook { get; set; }

    /// <summary>Name of the sheet to show. Defaults to the first sheet.</summary>
    [Parameter] public string? SheetName { get; set; }

    /// <summary>
    /// Raised when the sheet on screen changes — a tab click, or a sheet edit that took the old one
    /// away. Bind it with <c>@bind-SheetName</c> to keep a host's own idea of the sheet in step.
    /// </summary>
    [Parameter] public EventCallback<string> SheetNameChanged { get; set; }

    /// <summary>
    /// Whether to show the strip of sheet tabs under the grid. On by default: a workbook with no way
    /// to reach its other sheets is a worse default than a single tab that does nothing.
    /// </summary>
    [Parameter] public bool ShowSheetTabs { get; set; } = true;

    /// <summary>
    /// Whether to show the name box and formula field above the grid.
    /// </summary>
    /// <remarks>
    /// On by default. The grid paints the <em>result</em> of a formula, so without this a cell reading
    /// 84 gives no way to discover that it holds <c>=B1*2</c> — and no way to edit it as a formula
    /// rather than retyping it from scratch.
    /// </remarks>
    [Parameter] public bool ShowFormulaBar { get; set; } = true;

    /// <summary>
    /// Whether to show the formatting toolbar above the formula bar.
    /// </summary>
    /// <remarks>
    /// Off by default, unlike the formula bar and the tab strip. Those two are how a workbook is read;
    /// the toolbar is how one is authored, it is the tallest piece of chrome here, and a viewer that
    /// gained a formatting bar it never asked for would be a breaking change to every existing use.
    /// </remarks>
    [Parameter] public bool ShowToolbar { get; set; }

    /// <summary>Whether the toolbar's icon-only buttons carry a hover tooltip.</summary>
    [Parameter] public bool ShowTooltips { get; set; } = true;

    /// <summary>Extra items appended to the toolbar, after the built-in controls.</summary>
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    /// <summary>
    /// Whether the tab strip can add, rename, reorder, hide and delete sheets, as opposed to only
    /// switching between them.
    /// </summary>
    [Parameter] public bool AllowSheetEditing { get; set; } = true;

    /// <summary>Blocks formatting and structural sheet edits. Cell editing is unaffected.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Grid chrome colours. Left unset the control follows the host page's light/dark scheme, so a
    /// spreadsheet dropped into a dark app is dark without the app wiring anything up. Setting it
    /// pins the choice - including to <see cref="SpreadsheetTheme.Light"/>, which is how a host asks
    /// for a paper-white grid regardless of the app around it.
    /// </summary>
    [Parameter] public SpreadsheetTheme? Theme { get; set; }

    /// <summary>The theme actually painted: <see cref="Theme"/> when set, otherwise the page's scheme.</summary>
    SpreadsheetTheme EffectiveTheme => OfficeScheme.Resolve(this.scheme, this.Theme);

    [Parameter] public string? Class { get; set; }

    [Parameter] public string? Style { get; set; }

    /// <summary>Raised after any edit, so a host can track the dirty state.</summary>
    [Parameter] public EventCallback<CellRef> CellChanged { get; set; }

    /// <summary>The live controller, exposed so a toolbar or formula bar can drive the same state.</summary>
    public SpreadsheetController? Controller => this.controller;

    protected override void OnInitialized()
        // Repaint on a scheme flip: the canvas only redraws when told to, so without this the grid
        // keeps the pixels it had when the app was the other way round.
        => this.scheme = new ThemeSchemeWatcher(this.Js, () =>
        {
            this.canvas?.Invalidate();
            this.StateHasChanged();
            return Task.CompletedTask;
        });

    protected override void OnParametersSet()
    {
        // First, before any of the early returns below: SKCanvasView only repaints when Invalidate is
        // called, so a theme change that does not reach this leaves the old pixels on screen and the
        // toggle appears to do nothing.
        if (this.paintedTheme != this.EffectiveTheme)
        {
            this.paintedTheme = this.EffectiveTheme;
            this.canvas?.Invalidate();
        }

        if (this.Workbook is null)
        {
            this.Detach();
            this.controller = null;
            return;
        }

        var sheet = this.SheetName is null
            ? this.Workbook.Sheets.FirstOrDefault()
            : this.Workbook.Sheets.FirstOrDefault(x => x.Name == this.SheetName);

        if (sheet is null)
            return;

        if (this.controller is not null && ReferenceEquals(this.controller.Workbook, this.Workbook))
        {
            if (this.controller.Sheet.Name != sheet.Name)
                this.controller.SwitchSheet(sheet);

            return;
        }

        this.Detach();

        this.controller = new SpreadsheetController(this.Workbook, sheet);
        this.controller.Changed += this.OnControllerChanged;
        this.controller.EditingChanged += this.OnEditingChanged;
        this.controller.ActiveSheetChanged += this.OnActiveSheetChanged;
        this.controller.ClipboardChanged += this.OnClipboardChanged;
        this.controller.Resize(this.lastWidth > 0 ? this.lastWidth : 800, this.lastHeight > 0 ? this.lastHeight : 600);
    }

    /// <summary>
    /// Keeps <see cref="SheetName"/> in step with the controller.
    /// </summary>
    /// <remarks>
    /// Writing the parameter back as well as raising the callback matters: an unbound host leaves
    /// SheetName at whatever it was, and the next OnParametersSet would then switch the grid straight
    /// back to the sheet the user just navigated away from.
    /// </remarks>
    void OnActiveSheetChanged(object? sender, Worksheet sheet)
    {
        this.SheetName = sheet.Name;

        if (this.SheetNameChanged.HasDelegate)
            _ = this.InvokeAsync(() => this.SheetNameChanged.InvokeAsync(sheet.Name));

        this.StateHasChanged();
    }

    Task OnSheetsChanged()
    {
        this.canvas?.Invalidate();
        this.StateHasChanged();
        return Task.CompletedTask;
    }

    void OnControllerChanged(object? sender, EventArgs e)
    {
        this.canvas?.Invalidate();
        this.StateHasChanged();
    }

    void OnEditingChanged(object? sender, CellRef? cell)
    {
        // The input is rendered by the next diff, so focusing has to wait until after it exists.
        this.focusEditor = cell is not null;
        this.StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Before the DPR read: the canvas paints its first frame off this, and starting the watch
            // second would flash a white grid in a dark app.
            await this.scheme.StartAsync(this.host);
            await this.ReadDevicePixelRatioAsync();
        if (await OfficeFonts.EnsureLoadedAsync(this.Js))
        {
            // The first frame painted with fallback metrics; the measurer's cache is invalidated by
            // the new registrations, so a repaint now re-measures against the real faces.
            this.canvas?.Invalidate();
            this.StateHasChanged();
        }
        }

        if (this.focusEditor)
        {
            this.focusEditor = false;
            try
            {
                await this.editor.FocusAsync();
            }
            catch (Exception)
            {
                // The editor can be torn down between the flag being set and this running; a lost focus
                // call is not worth failing the render over.
            }
        }
    }

    void OnPaint(SKPaintSurfaceEventArgs e)
    {
        var info = e.Info;
        this.painter ??= new SpreadsheetPainter();

        if (this.controller is null)
        {
            var theme = this.EffectiveTheme;
            e.Surface.Canvas.Clear(new SKColor(theme.Background.R, theme.Background.G, theme.Background.B));
            return;
        }

        // The surface is in device pixels; everything above it works in CSS pixels.
        var scale = (float)this.dpr;
        var width = info.Width / this.dpr;
        var height = info.Height / this.dpr;

        if (Math.Abs(width - this.lastWidth) > 0.5 || Math.Abs(height - this.lastHeight) > 0.5)
        {
            this.lastWidth = width;
            this.lastHeight = height;
            this.controller.Resize(width, height);
        }

        this.painter.Paint(e.Surface.Canvas, new SpreadsheetPaintRequest
        {
            Watermark = this.Watermark,
            Workbook = this.controller.Workbook,
            Sheet = this.controller.Sheet,
            Viewport = this.controller.Viewport,
            Selection = this.controller.Selection,
            Theme = this.EffectiveTheme,
            Scale = scale,
            EditingCell = this.controller.EditingCell,
            ClipboardRange = this.controller.ClipboardRange,
            FindMatches = this.controller.FindMatchCells(),
            ClipboardDashPhase = this.dashPhase,
            ShowTouchHandles = this.controller.UsesTouch
        });
    }

    static string Css(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    async Task ReadDevicePixelRatioAsync()
    {
        try
        {
            this.dpr = await this.Js.InvokeAsync<double>("eval", "window.devicePixelRatio || 1");
        }
        catch (Exception)
        {
            // Prerendering or a locked-down host: 1 is the safe assumption.
            this.dpr = 1;
        }

        if (this.dpr <= 0)
            this.dpr = 1;

        this.canvas?.Invalidate();
    }

    void OnPointerDown(PointerEventArgs e)
    {
        this.controller?.PointerDown(e.OffsetX, e.OffsetY, e.ShiftKey, KindOf(e.PointerType));
    }

    /// <summary>
    /// The browser reports the pointer kind as a string; anything unrecognised is treated as a mouse.
    /// </summary>
    /// <remarks>
    /// Mouse is the safe default: it keeps drag-to-extend, whereas guessing touch would turn a drag
    /// into a pan on a device that has no other way to select a range.
    /// </remarks>
    static PointerKind KindOf(string? pointerType)
        => pointerType switch
        {
            "touch" => PointerKind.Touch,
            "pen" => PointerKind.Pen,
            _ => PointerKind.Mouse
        };

    void OnPointerMove(PointerEventArgs e)
    {
        // Buttons is a bitmask; 1 is the primary button still being held.
        if ((e.Buttons & 1) == 1)
            this.controller?.PointerMove(e.OffsetX, e.OffsetY);
    }

    void OnPointerUp(PointerEventArgs e) => this.controller?.PointerUp();

    void OnDoubleClick(MouseEventArgs e) => this.controller?.DoubleClick(e.OffsetX, e.OffsetY);

    void OnWheel(WheelEventArgs e) => this.controller?.Scroll(e.DeltaX, e.DeltaY);

    void OnKeyDown(KeyboardEventArgs e)
    {
        if (this.controller is null)
            return;

        // Arrow keys and Tab would otherwise scroll the page or move focus out of the grid.
        this.preventKeyDefault = true;

        switch (e.Key)
        {
            case "ArrowUp": this.controller.Move(MoveDirection.Up, e.ShiftKey, e.CtrlKey || e.MetaKey); break;
            case "ArrowDown": this.controller.Move(MoveDirection.Down, e.ShiftKey, e.CtrlKey || e.MetaKey); break;
            case "ArrowLeft": this.controller.Move(MoveDirection.Left, e.ShiftKey, e.CtrlKey || e.MetaKey); break;
            case "ArrowRight": this.controller.Move(MoveDirection.Right, e.ShiftKey, e.CtrlKey || e.MetaKey); break;
            case "Tab": this.controller.Advance(byRow: false, backwards: e.ShiftKey); break;
            case "Enter": this.controller.Advance(byRow: true, backwards: e.ShiftKey); break;
            case "Delete":
            case "Backspace": this.controller.ClearSelection(); break;
            case "F2": this.controller.BeginEdit(); break;

            case "Escape":
                // Excel's own way out of a pending cut or copy, and the only one that does not also
                // change the sheet.
                this.controller.CancelEdit();
                this.controller.ClearClipboard();
                break;

            case "c" when e.CtrlKey || e.MetaKey: this.controller.Copy(); break;
            case "x" when e.CtrlKey || e.MetaKey: this.controller.Cut(); break;
            case "v" when e.CtrlKey || e.MetaKey: this.controller.Paste(); break;

            // Excel's own sheet shortcuts, and the only way to change sheet without the mouse.
            case "PageUp" when e.CtrlKey || e.MetaKey: this.StepSheet(-1); break;
            case "PageDown" when e.CtrlKey || e.MetaKey: this.StepSheet(1); break;

            case "z" when e.CtrlKey || e.MetaKey:
                if (e.ShiftKey)
                    this.controller.Redo();
                else
                    this.controller.Undo();

                break;

            case "y" when e.CtrlKey || e.MetaKey:
                this.controller.Redo();
                break;

            default:
                // A single printable character starts an edit and becomes its first keystroke.
                if (e.Key.Length == 1 && !e.CtrlKey && !e.MetaKey && !e.AltKey)
                    this.controller.BeginEdit(e.Key);
                else
                    this.preventKeyDefault = false;

                break;
        }
    }

    /// <summary>Moves to the next or previous visible sheet, stopping at either end.</summary>
    void StepSheet(int offset)
    {
        if (this.controller is not { } controller)
            return;

        var sheets = controller.VisibleSheets;
        var at = -1;
        for (var i = 0; i < sheets.Count && at < 0; i++)
        {
            if (ReferenceEquals(sheets[i], controller.Sheet))
                at = i;
        }

        if (at >= 0 && sheets.ElementAtOrDefault(at + offset) is { } target)
            controller.SwitchSheet(target);
    }

    /// <summary>Starts or stops the marching-ants animation as the clipboard fills and empties.</summary>
    void OnClipboardChanged(object? sender, EventArgs e)
    {
        if (this.controller?.ClipboardRange is null)
            this.StopMarching();
        else
            this.StartMarching();
    }

    /// <summary>
    /// Walks the dash phase forward until the clipboard is abandoned.
    /// </summary>
    /// <remarks>
    /// A timer rather than a CSS animation because the border is drawn into a canvas, and the canvas
    /// only redraws when something calls Invalidate. It runs only while there is something on the
    /// clipboard: a permanent frame loop under a grid that is usually idle would keep the tab awake
    /// and, in a Blazor Server circuit, would do it once per connected user.
    /// </remarks>
    void StartMarching()
    {
        if (this.marching is not null)
            return;

        var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(120));
        this.marching = timer;

        _ = Task.Run(async () =>
        {
            try
            {
                while (await timer.WaitForNextTickAsync())
                {
                    // Two dashes' worth of travel per cycle, so the phase never grows without bound.
                    this.dashPhase = (this.dashPhase + 2f) % 10f;
                    await this.InvokeAsync(() => this.canvas?.Invalidate());
                }
            }
            catch (ObjectDisposedException)
            {
                // The component went away mid-tick; there is nothing left to repaint.
            }
        });
    }

    void StopMarching()
    {
        var timer = this.marching;
        this.marching = null;

        if (timer is null)
            return;

        timer.Dispose();
        this.dashPhase = 0;
        this.canvas?.Invalidate();
    }

    void OnEditorInput(ChangeEventArgs e) => this.controller?.UpdateEditingText(e.Value?.ToString() ?? string.Empty);

    async Task OnEditorKeyDown(KeyboardEventArgs e)
    {
        if (this.controller is null)
            return;

        var cell = this.controller.EditingCell;

        switch (e.Key)
        {
            case "Enter":
                this.controller.CommitEdit(e.ShiftKey ? EditCommitDirection.Up : EditCommitDirection.Down);
                break;

            case "Tab":
                this.controller.CommitEdit(e.ShiftKey ? EditCommitDirection.Left : EditCommitDirection.Right);
                break;

            case "Escape":
                this.controller.CancelEdit();
                break;

            default:
                return;
        }

        if (cell is { } committed && this.CellChanged.HasDelegate)
            await this.CellChanged.InvokeAsync(committed);

        await this.host.FocusAsync();
    }

    void OnEditorBlur()
    {
        // Clicking away commits, matching Excel rather than discarding what was typed.
        this.controller?.CommitEdit(EditCommitDirection.None);
    }

    void Detach()
    {
        if (this.controller is null)
            return;

        this.controller.Changed -= this.OnControllerChanged;
        this.controller.EditingChanged -= this.OnEditingChanged;
        this.controller.ActiveSheetChanged -= this.OnActiveSheetChanged;
        this.controller.ClipboardChanged -= this.OnClipboardChanged;
    }

    public async ValueTask DisposeAsync()
    {
        this.Detach();
        this.StopMarching();
        this.painter?.Dispose();
        await this.scheme.DisposeAsync();
    }

    Task OnWatermarkChanged(OfficeWatermark? mark)
    {
        this.Watermark = mark;
        this.canvas?.Invalidate();
        this.StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// A picture drawn behind the content - a logo, a DRAFT stamp, a company mark.
    /// </summary>
    /// <remarks>
    /// A <b>display</b> watermark: it is drawn, not written into the file. The three Office formats
    /// have no common notion of one, so persisting would mean three unrelated mechanisms where drawing
    /// means one. See <see cref="OfficeWatermark"/>.
    /// </remarks>
    [Parameter] public OfficeWatermark? Watermark { get; set; }

}
