<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- iOS and Android get a native multi-touch platform view (a stick and a button held at once,
             touches that miss every element fall through to the game beneath). Every other target -
             Mac Catalyst, Windows, and the plain net10.0 build the AppKit and GTK heads use - runs the
             stock GraphicsView handler, which reports one pointer: enough for a mouse. -->
        <TargetFrameworks>$(BaseTargetFramework);$(BaseTargetFramework)-ios;$(BaseTargetFramework)-android;$(BaseTargetFramework)-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="'$(ForceWindowsTfm)' == 'true' Or $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);$(BaseTargetFramework)-windows10.0.19041.0</TargetFrameworks>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <UseMaui>true</UseMaui>
        <IsAotCompatible>true</IsAotCompatible>
        <SingleProject>true</SingleProject>
        <RootNamespace>Shiny.Maui.Controls.Gaming</RootNamespace>
        <Description>An on-screen gamepad for .NET MAUI - NES, SNES, Xbox/PlayStation, twin-stick and arcade layouts as a game overlay or an inline controller, with multi-touch sticks and d-pads, turbo, haptics, a drag-and-pinch layout editor, and auto-hide when a real controller connects. It is a Shiny.Gamepad IGamepad, so game code reads it exactly like hardware.</Description>
        <PackageTags>maui shiny gamepad controller joystick dpad touch virtual onscreen game</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls"/>
        <PackageReference Include="Shiny.Gamepad"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Controls.Gamepad.Shared\Shiny.Controls.Gamepad.Shared.csproj"/>
    </ItemGroup>

</Project>
