<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <RootNamespace>Shiny.Blazor.Controls.Camera</RootNamespace>
        <Description>Blazor WebAssembly camera component (getUserMedia preview + capture) with pluggable in-browser frame analysis (native BarcodeDetector where available) surfaced as Shiny Camera Detection DTOs.</Description>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.Blazor.Controls.Camera.Tests" />
    </ItemGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Controls.Camera.Shared\Shiny.Controls.Camera.Shared.csproj" />
        <ProjectReference Include="..\Shiny.Controls.Analysis.Shared\Shiny.Controls.Analysis.Shared.csproj" />
        <!-- frame analyzer descriptors, the JS detection helpers and the audio tap, shared with MediaElement -->
        <ProjectReference Include="..\Shiny.Blazor.Controls.Analysis\Shiny.Blazor.Controls.Analysis.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Shiny.Controls.Analysis" />
        <Using Include="Shiny.Blazor.Controls.Analysis" />
    </ItemGroup>
</Project>
