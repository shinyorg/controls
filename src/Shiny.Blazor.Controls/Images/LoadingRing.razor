@namespace Shiny.Blazor.Controls.Images
@using Shiny.Blazor.Controls.Theming

@* One control for both modes. Set Percent and the ring fills with a label; leave it null - which is
   what a queued request or a response without a Content-Length produces - and the same ring spins.
   Swapping between two elements would make the size jump the moment a queued download starts. *@

<div class="shiny-ring @(Percent is null ? "is-indeterminate" : "")" style="@RootStyle">
    <svg class="shiny-ring-svg" viewBox="0 0 100 100" role="progressbar" aria-label="Loading image"
         aria-valuemin="0" aria-valuemax="100"
         aria-valuenow="@(Percent is null ? null : ((int)(Percent.Value * 100)).ToString())">
        <circle class="shiny-ring-track" cx="50" cy="50" r="@Radius" fill="none" stroke-width="@StrokeUnits" />
        <circle class="shiny-ring-arc" cx="50" cy="50" r="@Radius" fill="none" stroke-width="@StrokeUnits"
                stroke-linecap="round"
                stroke-dasharray="@DashArray"
                stroke-dashoffset="@DashOffset" />
    </svg>

    @if (Percent is not null && ShowPercentText)
    {
        <span class="shiny-ring-label">@((int)Math.Round(Percent.Value * 100))%</span>
    }
</div>

@code {
    /// <summary>Completion from 0-1, or null to spin.</summary>
    [Parameter] public double? Percent { get; set; }

    /// <summary>Diameter in pixels.</summary>
    [Parameter] public double Size { get; set; } = 48;

    /// <summary>Ring thickness in pixels.</summary>
    [Parameter] public double StrokeWidth { get; set; } = 4;

    /// <summary>Whether the percentage is drawn in the middle. Never shown when indeterminate.</summary>
    [Parameter] public bool ShowPercentText { get; set; } = true;

    /// <summary>Colour of the progress arc. Defaults to the theme primary token.</summary>
    // Mirrored in LoadingRing.razor.css; only a caller-chosen value inlines. See StyleDefaults.
    internal const string DefaultRingColor = "var(--shiny-color-primary, #0055D9)";
    internal const string DefaultTrackColor = "var(--shiny-color-surface-container-highest, #D7DCE1)";
    internal const string DefaultTextColor = "var(--shiny-color-on-surface, #161C23)";

    [Parameter] public string RingColor { get; set; } = DefaultRingColor;

    /// <summary>Colour of the unfilled track.</summary>
    [Parameter] public string TrackColor { get; set; } = DefaultTrackColor;

    /// <summary>Colour of the percentage label.</summary>
    [Parameter] public string TextColor { get; set; } = DefaultTextColor;

    // The SVG is a fixed 100x100 viewBox scaled by CSS, so the stroke has to be expressed in those
    // units rather than pixels - otherwise a 24px ring and a 96px ring would draw different weights.
    double StrokeUnits => Size > 0 ? Math.Clamp(StrokeWidth / Size * 100, 0.5, 40) : 8;

    double Radius => 50 - StrokeUnits / 2;

    double Circumference => 2 * Math.PI * Radius;

    string DashArray => Percent is null
        ? Format(Circumference * 0.25) + " " + Format(Circumference)
        : Format(Circumference);

    string DashOffset => Percent is null
        ? "0"
        : Format(Circumference * (1 - Math.Clamp(Percent.Value, 0, 1)));

    string RootStyle =>
        $"--ring-size: {Format(Size)}px;"
        + StyleDefaults.Override("--ring-color", RingColor, DefaultRingColor)
        + StyleDefaults.Override("--ring-track", TrackColor, DefaultTrackColor)
        + StyleDefaults.Override("--ring-text", TextColor, DefaultTextColor)
        + $"--ring-label-size: {Format(Math.Max(9, Size * 0.26))}px;";

    static string Format(double value) => value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}
