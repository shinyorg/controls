<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <RootNamespace>Shiny.Blazor.Controls</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The icon artwork and motion definitions, shared verbatim with the MAUI package so the
             two hosts cannot drift apart. -->
        <ProjectReference Include="..\Shiny.Controls.MotionIcons.Shared\Shiny.Controls.MotionIcons.Shared.csproj" />
        <!-- The Gantt scheduling engine: working calendars, dependency cascades, critical path and
             the time-to-pixel geometry, shared verbatim with the MAUI package so the two hosts
             cannot schedule a plan differently. -->
        <ProjectReference Include="..\Shiny.Controls.Gantt.Shared\Shiny.Controls.Gantt.Shared.csproj" />
        <!-- The keyboard shortcut engine: gesture parsing and display, scopes and the registry the
             service keeps. keyboard-shortcuts.js mirrors its matching rules for the browser. -->
        <ProjectReference Include="..\Shiny.Controls.Keyboard.Shared\Shiny.Controls.Keyboard.Shared.csproj" />
        <!-- The range picker engine: selection rules, month grids, presets, time slots and range
             formatting, shared verbatim with the MAUI package. -->
        <ProjectReference Include="..\Shiny.Controls.RangePickers.Shared\Shiny.Controls.RangePickers.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.Controls.MotionIcons.Tests" />
        <InternalsVisibleTo Include="Shiny.Blazor.Controls.Tests" />
    </ItemGroup>
</Project>
