@namespace Shiny.Blazor.Controls
@using Shiny.Blazor.Controls.Theming

<SheetView @bind-IsOpen="isOpen"
           IsLocked="@IsLocked"
           Direction="@Direction"
           Detents="@resolvedDetents"
           SheetBackgroundColor="@PanelBackgroundColor"
           SheetCornerRadius="@PanelCornerRadius"
           HasBackdrop="@HasBackdrop"
           CloseOnBackdropTap="false">
    <SheetContent>
        <div class="shiny-sigpad">
            <div class="shiny-sigpad-title">Draw your signature below</div>

            <div class="shiny-sigpad-canvas-host">
                @* Mounted with the sheet's content; the surface sizes itself to the host as it animates in. *@
                <SignatureView @ref="signatureView"
                               @bind-HasSignature="hasSignature"
                               StrokeColor="@StrokeColor"
                               StrokeWidth="@StrokeWidth"
                               SignatureBackgroundColor="@SignatureBackgroundColor"
                               ExportWidth="@ExportWidth"
                               ExportHeight="@ExportHeight"
                               Height="100%"
                               Style="position:absolute;inset:0;" />
            </div>

            <div class="shiny-sigpad-buttons">
                @if (ShowCancelButton)
                {
                    <button class="shiny-sigpad-btn shiny-sigpad-btn-cancel"
                            style="@StyleDefaults.Override("background", CancelButtonColor, DefaultCancelButtonColor)"
                            @onclick="OnCancel">@CancelButtonText</button>
                }
                <button class="shiny-sigpad-btn shiny-sigpad-btn-sign"
                        style="@StyleDefaults.Override("background", SignButtonColor, DefaultSignButtonColor)"
                        disabled="@(!hasSignature)"
                        @onclick="OnSign">@SignButtonText</button>
            </div>
        </div>
    </SheetContent>
</SheetView>
