@namespace Shiny.Blazor.Controls

@* @attributes comes first so a caller's splatted style cannot replace the custom properties the
   component sets on itself. *@
<div @attributes="AdditionalAttributes"
     class="shiny-rs @CssClass"
     style="@RootStyle">

    @if (ShowTooltip)
    {
        <div class="shiny-rs-tooltip" style="left: clamp(0%, @(LowerPercentage)% , 100%); @TooltipTransform(LowerPercentage)">
            @if (TooltipTemplate is not null)
            {
                @TooltipTemplate(LowerValue)
            }
            else
            {
                <div class="shiny-rs-tooltip-badge" style="@TooltipBadgeStyle">
                    <span class="shiny-rs-tooltip-text">@FormatValue(LowerValue)</span>
                    <div class="shiny-rs-tooltip-pointer" style="@TooltipPointerStyle"></div>
                </div>
            }
        </div>
        <div class="shiny-rs-tooltip" style="left: clamp(0%, @(UpperPercentage)% , 100%); @TooltipTransform(UpperPercentage)">
            @if (TooltipTemplate is not null)
            {
                @TooltipTemplate(UpperValue)
            }
            else
            {
                <div class="shiny-rs-tooltip-badge" style="@TooltipBadgeStyle">
                    <span class="shiny-rs-tooltip-text">@FormatValue(UpperValue)</span>
                    <div class="shiny-rs-tooltip-pointer" style="@TooltipPointerStyle"></div>
                </div>
            }
        </div>
    }

    <div class="shiny-rs-track" style="@TrackStyle" @onclick="OnTrackClick" @ref="trackRef">
        <div class="shiny-rs-track-fill" style="@TrackFillStyle"></div>
        @* onclick is stopped as well as onpointerdown: the track's own click seeks the nearer thumb to
           wherever it was pressed, and a thumb big enough to hold content is big enough to hit by
           accident. *@
        <div class="shiny-rs-thumb"
             data-thumb="lower"
             style="@ThumbStyle(LowerPercentage, LowerColor)"
             @onpointerdown:stopPropagation
             @onclick:stopPropagation>
            @if (LowerThumbContent is not null)
            {
                @LowerThumbContent(LowerValue)
            }
        </div>
        <div class="shiny-rs-thumb"
             data-thumb="upper"
             style="@ThumbStyle(UpperPercentage, UpperColor)"
             @onpointerdown:stopPropagation
             @onclick:stopPropagation>
            @if (UpperThumbContent is not null)
            {
                @UpperThumbContent(UpperValue)
            }
        </div>
    </div>
</div>
