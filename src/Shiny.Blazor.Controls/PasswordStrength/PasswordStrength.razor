@namespace Shiny.Blazor.Controls

<div class="shiny-pws @CssClass" @attributes="AdditionalAttributes">

    <TextEntry Placeholder="@Placeholder"
               Variant="@Variant"
               Text="@Password"
               TextChanged="OnTextChanged"
               Completed="Completed"
               IsPassword="@(!IsPasswordRevealed)"
               RightTools="@tools"
               HintText="@WarningText"
               HasError="@(WarningText is not null)"
               IsSpellCheckEnabled="false"
               IsTextPredictionEnabled="false"
               CssClass="shiny-pws-entry" />

    @if (ShowMeter || ShowStrengthLabel)
    {
        <div class="shiny-pws-meter-row">
            @if (ShowMeter)
            {
                <div class="shiny-pws-meter"
                     style="@MeterStyleAttribute"
                     role="progressbar"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="@Score"
                     aria-valuetext="@LevelAriaText"
                     aria-label="Password strength">

                    @if (MeterStyle == PasswordStrengthMeterStyle.Bar)
                    {
                        <div class="shiny-pws-track">
                            <div class="shiny-pws-fill" style="width: @(Score)%; background-color: @FillColor;"></div>
                        </div>
                    }
                    else
                    {
                        @for (var i = 1; i <= SegmentCount; i++)
                        {
                            <div class="shiny-pws-segment"
                                 style="background-color: @(i <= (int)Level ? FillColor : TrackColorValue);"></div>
                        }
                    }
                </div>
            }

            @if (ShowStrengthLabel)
            {
                <span class="shiny-pws-strength" style="color: @FillColor;" aria-live="polite">@LevelText</span>
            }
        </div>
    }

    @if (TimeToCrackCaption is { } timeToCrack)
    {
        <div class="shiny-pws-crack-time"
             style="font-size: @(RuleFontSize)px; color: @RuleTextColorValue;"
             aria-live="polite">@timeToCrack</div>
    }

    @if (ShowRules && result is not null)
    {
        <ul class="shiny-pws-rules" style="font-size: @(RuleFontSize)px;">
            @foreach (var rule in result.Rules)
            {
                <li class="shiny-pws-rule @(rule.IsSatisfied ? "shiny-pws-rule--met" : "")"
                    style="@RuleRowStyle(rule)">
                    <span class="shiny-pws-rule-glyph" aria-hidden="true">@(rule.IsSatisfied ? SatisfiedGlyph : UnsatisfiedGlyph)</span>
                    <span class="shiny-pws-rule-text">@RuleText(rule)</span>
                    <span class="shiny-pws-sr">@(rule.IsSatisfied ? ", met" : ", not met")</span>
                </li>
            }
        </ul>
    }
</div>
