@namespace Shiny.Blazor.Controls.Scheduler
@using System.Globalization
@using Microsoft.JSInterop
@implements IDisposable
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="shiny-agenda" @ref="rootElement">
    @if (allDayEvents.Count > 0)
    {
        <div class="shiny-agenda-allday">
            <div class="shiny-agenda-allday-label">All-day</div>
            <div class="shiny-agenda-allday-list">
                @foreach (var evt in allDayEvents)
                {
                    var captured = evt;
                    <div class="shiny-agenda-allday-event"
                         style="background:@(evt.Color ?? DefaultEventColor);color:@(ContrastInk.For(evt.Color ?? DefaultEventColor));"
                         @onclick="() => OnEventTapped(captured)">@evt.Title</div>
                }
            </div>
        </div>
    }

    @if (ShowCarouselDatePicker && DatePickerMode == AgendaDatePickerMode.Carousel)
    {
        <div class="shiny-agenda-datepicker">
            @for (var i = -3; i <= 3; i++)
            {
                var d = SelectedDate.AddDays(i);
                var captured = d;
                var isSel = d == SelectedDate;
                var inRange = !isSel && d > SelectedDate && d < SelectedDate.AddDays(Days);
                var isToday = d == DateOnly.FromDateTime(DateTime.Today);
                <div class="shiny-agenda-date @(isSel ? "is-selected" : "") @(inRange ? "is-inrange" : "") @(isToday ? "is-today" : "")"
                     @onclick="() => SetSelectedDateAsync(captured)">
                    <div class="shiny-agenda-date-name">@d.ToString("ddd")</div>
                    <div class="shiny-agenda-date-num">@d.Day</div>
                </div>
            }
        </div>
    }
    else if (ShowCarouselDatePicker && DatePickerMode == AgendaDatePickerMode.Calendar)
    {
        <div class="shiny-agenda-calendar">
            <div class="shiny-agenda-calendar-head">
                <button type="button" @onclick="() => ShiftMonth(-1)">‹</button>
                <span>@calendarMonth.ToString("MMMM yyyy")</span>
                <button type="button" @onclick="() => ShiftMonth(1)">›</button>
            </div>
            <div class="shiny-agenda-calendar-grid">
                @foreach (var dowName in DayOfWeekNames)
                {
                    <div class="shiny-agenda-calendar-dow">@dowName</div>
                }
                @foreach (var cell in CalendarCells())
                {
                    if (cell is null)
                    {
                        <div></div>
                    }
                    else
                    {
                        var captured = cell.Value;
                        var isSel = captured == SelectedDate;
                        var isToday = captured == DateOnly.FromDateTime(DateTime.Today);
                        <div class="shiny-agenda-calendar-cell @(isSel ? "is-selected" : "") @(isToday ? "is-today" : "")"
                             @onclick="() => SelectCalendarDateAsync(captured)">@captured.Day</div>
                    }
                }
            </div>
        </div>
    }

    <div class="shiny-agenda-dayheaders" style="@GridColumnsStyle">
        <div class="shiny-agenda-tzabbr">
            @if (ShowTz)
            {
                @foreach (var line in TzAbbreviation(TimeZoneInfo.Local))
                {
                    <div>@line</div>
                }
            }
        </div>
        @if (ShowTz)
        {
            @foreach (var tz in AdditionalTimezones!)
            {
                <div class="shiny-agenda-tzabbr shiny-agenda-tzabbr--extra">
                    @foreach (var line in TzAbbreviation(tz))
                    {
                        <div>@line</div>
                    }
                </div>
            }
        }
        @for (var i = 0; i < Days; i++)
        {
            var date = SelectedDate.AddDays(i);
            <div class="shiny-agenda-dayheader @(Days > 1 ? "shiny-agenda-dayheader--multi" : "")">
                @date.ToString(Days > 1 ? "ddd, MMM d" : "dddd, MMMM d, yyyy")
            </div>
        }
    </div>

    <div class="shiny-agenda-day">
        <div class="shiny-agenda-timeline" style="@GridColumnsStyle">
            <div class="shiny-agenda-timecol">
                @for (var hour = 0; hour < 24; hour++)
                {
                    <div class="shiny-agenda-timecell" style="height:@(TimeSlotHeight)px;">@FormatHour(hour)</div>
                }
            </div>
            @if (ShowTz)
            {
                @foreach (var tz in AdditionalTimezones!)
                {
                    var capturedTz = tz;
                    <div class="shiny-agenda-timecol shiny-agenda-timecol--extra">
                        @for (var hour = 0; hour < 24; hour++)
                        {
                            <div class="shiny-agenda-timecell" style="height:@(TimeSlotHeight)px;">@FormatHourIn(hour, capturedTz)</div>
                        }
                    </div>
                }
            }
            @for (var i = 0; i < Days; i++)
            {
                var date = SelectedDate.AddDays(i);
                var isToday = date == DateOnly.FromDateTime(DateTime.Today);
                <div class="shiny-agenda-daycol" style="height:@(TimeSlotHeight * 24)px;" data-day-index="@i">
                    @for (var hour = 0; hour < 24; hour++)
                    {
                        var hCaptured = hour;
                        var dCaptured = date;
                        <div class="shiny-agenda-hourcell" style="height:@(TimeSlotHeight)px;"
                             @onclick="() => OnTimeSlotTappedAsync(dCaptured, hCaptured)"></div>
                    }
                    @foreach (var p in PositionedEvents(date))
                    {
                        var captured = p.Event;
                        <div class="shiny-agenda-event"
                             style="top:@(Px(p.Top))px;height:@(Px(p.Height))px;left:@(Px(p.LeftPct))%;width:calc(@(Px(p.WidthPct))% - 4px);background:@(p.Event.Color ?? DefaultEventColor);color:@(ContrastInk.For(p.Event.Color ?? DefaultEventColor));"
                             data-event-id="@p.Event.Identifier"
                             data-draggable="@(DragEnabled ? "true" : null)"
                             @onclick:stopPropagation
                             @onclick="() => OnEventTapped(captured)">
                            @if (AllowEventResize && p.Height >= GripHeight * 3)
                            {
                                <span class="shiny-agenda-grip shiny-agenda-grip--start"></span>
                                <span class="shiny-agenda-grip shiny-agenda-grip--end"></span>
                            }
                            <div class="shiny-agenda-event-title">@p.Event.Title</div>
                            <div class="shiny-agenda-event-time">@p.Event.Start.LocalDateTime.ToString(TimeFormat) – @p.Event.End.LocalDateTime.ToString(TimeFormat)</div>
                        </div>
                    }
                    @if (DragEnabled)
                    {
                        @* Rendered by Blazor and merely positioned by JS - a guide the module appended
                           itself would be a foreign node inside a container the renderer diffs. *@
                        <div class="shiny-agenda-snapguide" style="display:none;background:@(DragSnapGuideColor ?? "rgba(120,120,120,0.6)");"></div>
                    }
                    @if (ShowCurrentTimeMarker && isToday)
                    {
                        var minutes = DateTime.Now.TimeOfDay.TotalMinutes;
                        var top = AgendaGeometry.MinutesToY(minutes, TimeSlotHeight);
                        <div class="shiny-agenda-now" style="top:@(Px(top))px;background:@CurrentTimeMarkerColor;"></div>
                    }
                </div>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="shiny-agenda-loader">Loading…</div>
    }
</div>

@code {
    static readonly string[] DayOfWeekNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    readonly List<SchedulerEvent> allDayEvents = new();
    readonly List<SchedulerEvent> timedEvents = new();
    bool isLoading;
    CancellationTokenSource? loadCts;
    System.Threading.Timer? markerTimer;
    DateOnly calendarMonth = DateOnly.FromDateTime(DateTime.Today);

    [Parameter] public ISchedulerEventProvider? Provider { get; set; }
    [Parameter] public DateOnly SelectedDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    [Parameter] public EventCallback<DateOnly> SelectedDateChanged { get; set; }
    [Parameter] public int DaysToShow { get; set; } = 1;
    [Parameter] public bool ShowCarouselDatePicker { get; set; } = true;
    [Parameter] public AgendaDatePickerMode DatePickerMode { get; set; } = AgendaDatePickerMode.Carousel;
    [Parameter] public bool ShowAdditionalTimezones { get; set; }
    [Parameter] public IList<TimeZoneInfo>? AdditionalTimezones { get; set; }
    [Parameter] public bool ShowCurrentTimeMarker { get; set; } = true;
    [Parameter] public string CurrentTimeMarkerColor { get; set; } = "#EF4444";
    [Parameter] public string DefaultEventColor { get; set; } = "#6366F1";
    [Parameter] public double TimeSlotHeight { get; set; } = 60.0;
    [Parameter] public DateOnly? MinDate { get; set; }
    [Parameter] public DateOnly? MaxDate { get; set; }
    [Parameter] public bool Use24HourTime { get; set; } = true;

    /// <summary>Drag an event to a new time (and, when <c>DaysToShow</c> &gt; 1, another day).</summary>
    /// <remarks>
    /// Off by default, and the provider must also override
    /// <see cref="ISchedulerEventProvider.CanChangeEvent"/> - the opt-in is required on both sides.
    /// </remarks>
    [Parameter] public bool AllowEventDrag { get; set; }

    /// <summary>Drag the top/bottom edge of an event to change its duration.</summary>
    [Parameter] public bool AllowEventResize { get; set; }

    /// <summary>Snap granularity in minutes, clamped to 1-60.</summary>
    [Parameter] public int DragSnapMinutes { get; set; } = 15;

    /// <summary>Resize floor. A move never changes duration, so this only gates resize.</summary>
    [Parameter] public TimeSpan MinEventDuration { get; set; } = TimeSpan.FromMinutes(15);

    /// <summary>
    /// Long-press arming delay for touch and pen. <see cref="TimeSpan.Zero"/> arms immediately.
    /// Mouse input never waits.
    /// </summary>
    [Parameter] public TimeSpan DragActivationDelay { get; set; } = TimeSpan.FromMilliseconds(350);

    /// <summary>Only meaningful when <c>DaysToShow</c> &gt; 1.</summary>
    [Parameter] public bool AllowCrossDayDrag { get; set; } = true;

    /// <summary>The horizontal guide line drawn at the snapped position while dragging.</summary>
    [Parameter] public string? DragSnapGuideColor { get; set; }

    /// <summary>How often the provider is asked to validate the in-flight position.</summary>
    [Parameter] public AgendaDragValidationMode DragValidationMode { get; set; } = AgendaDragValidationMode.OnCommit;

    /// <summary>
    /// Raised when <see cref="ISchedulerEventProvider.OnEventChanged"/> threw. The change has
    /// already been reverted; a revert with no explanation is the worst failure mode here.
    /// </summary>
    [Parameter] public EventCallback<SchedulerEventChangeFailure> EventChangeFailed { get; set; }

    const double GripHeight = 16;

    ElementReference rootElement;
    IJSObjectReference? dragModule;
    bool disposed;
    DotNetObjectReference<SchedulerAgendaView>? selfRef;
    string? lastDragOptions;

    bool DragEnabled => AllowEventDrag || AllowEventResize;

    int Days => Math.Clamp(DaysToShow, 1, 7);
    bool ShowTz => ShowAdditionalTimezones && (AdditionalTimezones?.Count ?? 0) > 0;
    string TimeFormat => Use24HourTime ? "HH:mm" : "h:mm tt";

    string GridColumnsStyle
    {
        get
        {
            var tzCols = ShowTz ? string.Concat(Enumerable.Repeat(" 56px", AdditionalTimezones!.Count)) : "";
            return $"grid-template-columns: 56px{tzCols} repeat({Days}, minmax(0, 1fr));";
        }
    }

    static string Px(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    ISchedulerEventProvider? lastProvider;
    DateOnly lastSelectedDate;
    int lastDays;

    protected override void OnInitialized()
        => markerTimer = new System.Threading.Timer(
            _ => _ = InvokeAsync(StateHasChanged), null,
            TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Provider, lastProvider) || SelectedDate != lastSelectedDate || Days != lastDays)
        {
            lastProvider = Provider;
            lastSelectedDate = SelectedDate;
            lastDays = Days;
            calendarMonth = new DateOnly(SelectedDate.Year, SelectedDate.Month, 1);
            _ = LoadEventsAsync();
        }
    }

    string FormatHour(int hour) => Use24HourTime ? $"{hour:D2}:00" : new TimeOnly(hour, 0).ToString("h tt");

    string FormatHourIn(int hour, TimeZoneInfo tz)
    {
        var localDt = DateTime.SpecifyKind(
            SelectedDate.ToDateTime(new TimeOnly(hour, 0)), DateTimeKind.Local);
        var converted = TimeZoneInfo.ConvertTime(localDt, TimeZoneInfo.Local, tz);
        return converted.ToString(Use24HourTime ? "HH:mm" : "h tt");
    }

    static IEnumerable<string> TzAbbreviation(TimeZoneInfo tz)
    {
        var offset = tz.BaseUtcOffset;
        var sign = offset >= TimeSpan.Zero ? "+" : "-";
        var abs = offset.Duration();
        var offsetStr = abs.Minutes == 0
            ? $"UTC{sign}{abs.Hours}"
            : $"UTC{sign}{abs.Hours}:{abs.Minutes:D2}";

        var id = tz.Id;
        if (id.Contains('/'))
            id = id[(id.LastIndexOf('/') + 1)..].Replace("_", " ");

        if (id.Length <= 10)
        {
            yield return id;
            yield return offsetStr;
        }
        else
        {
            yield return offsetStr;
        }
    }

    // ------------- calendar sheet picker -------------
    void ShiftMonth(int delta) => calendarMonth = calendarMonth.AddMonths(delta);

    IEnumerable<DateOnly?> CalendarCells()
    {
        var first = new DateOnly(calendarMonth.Year, calendarMonth.Month, 1);
        for (var i = 0; i < (int)first.DayOfWeek; i++)
            yield return null;
        var days = DateTime.DaysInMonth(calendarMonth.Year, calendarMonth.Month);
        for (var d = 1; d <= days; d++)
            yield return new DateOnly(calendarMonth.Year, calendarMonth.Month, d);
    }

    async Task SelectCalendarDateAsync(DateOnly d)
    {
        if (Provider?.CanCalendarSelect(d) == false) return;
        await SetSelectedDateAsync(d);
        Provider?.OnCalendarDateSelected(d);
    }

    // ------------- event layout (overlap-aware) -------------
    IEnumerable<(SchedulerEvent Event, double Top, double Height, double LeftPct, double WidthPct)> PositionedEvents(DateOnly date)
    {
        var dayStart = date.ToDateTime(TimeOnly.MinValue);
        var items = timedEvents
            .Where(e => DateOnly.FromDateTime(e.Start.LocalDateTime) <= date
                     && DateOnly.FromDateTime(e.End.LocalDateTime) >= date)
            .Select(e =>
            {
                var s = e.Start.LocalDateTime < dayStart ? dayStart : e.Start.LocalDateTime;
                var en = e.End.LocalDateTime > dayStart.AddDays(1) ? dayStart.AddDays(1) : e.End.LocalDateTime;
                var startMin = (s - dayStart).TotalMinutes;
                var endMin = Math.Max(startMin + 20, (en - dayStart).TotalMinutes);
                return (Event: e, StartMin: startMin, EndMin: endMin, Col: 0);
            })
            .OrderBy(x => x.StartMin)
            .ThenByDescending(x => x.EndMin)
            .ToArray();

        // cluster chain-overlapping events, assign columns greedily within each cluster
        var i = 0;
        while (i < items.Length)
        {
            var clusterEnd = items[i].EndMin;
            var clusterStartIdx = i;
            var j = i + 1;
            while (j < items.Length && items[j].StartMin < clusterEnd)
            {
                clusterEnd = Math.Max(clusterEnd, items[j].EndMin);
                j++;
            }

            var colEnds = new List<double>();
            for (var k = clusterStartIdx; k < j; k++)
            {
                var col = colEnds.FindIndex(end => items[k].StartMin >= end);
                if (col < 0)
                {
                    col = colEnds.Count;
                    colEnds.Add(items[k].EndMin);
                }
                else
                {
                    colEnds[col] = items[k].EndMin;
                }
                items[k].Col = col;
            }

            var colCount = Math.Max(1, colEnds.Count);
            for (var k = clusterStartIdx; k < j; k++)
            {
                // Through AgendaGeometry so the layout and the drag's inverse cannot drift apart.
                yield return (
                    items[k].Event,
                    AgendaGeometry.MinutesToY(items[k].StartMin, TimeSlotHeight),
                    Math.Max(20, AgendaGeometry.MinutesToY(items[k].EndMin - items[k].StartMin, TimeSlotHeight)),
                    items[k].Col * 100.0 / colCount,
                    100.0 / colCount);
            }

            i = j;
        }
    }

    async Task SetSelectedDateAsync(DateOnly d)
    {
        if (MinDate.HasValue && d < MinDate.Value) return;
        if (MaxDate.HasValue && d > MaxDate.Value) return;
        SelectedDate = d;
        await SelectedDateChanged.InvokeAsync(d);
    }

    Task OnTimeSlotTappedAsync(DateOnly date, int hour)
    {
        var dt = new DateTimeOffset(date.ToDateTime(new TimeOnly(hour, 0)));
        if (Provider is not null && Provider.CanSelectAgendaTime(dt))
            Provider.OnAgendaTimeSelected(dt);
        return Task.CompletedTask;
    }

    void OnEventTapped(SchedulerEvent evt) => Provider?.OnEventSelected(evt);

    async Task LoadEventsAsync()
    {
        if (Provider is null) return;
        loadCts?.Cancel();
        loadCts = new CancellationTokenSource();
        var token = loadCts.Token;
        isLoading = true;
        StateHasChanged();
        try
        {
            var startDto = new DateTimeOffset(SelectedDate.ToDateTime(TimeOnly.MinValue));
            var endDto = new DateTimeOffset(SelectedDate.AddDays(Days).ToDateTime(TimeOnly.MinValue));
            var events = await Provider.GetEvents(startDto, endDto);
            if (token.IsCancellationRequested) return;

            allDayEvents.Clear();
            allDayEvents.AddRange(events.Where(e => e.IsAllDay));
            timedEvents.Clear();
            timedEvents.AddRange(events
                .Where(e => !e.IsAllDay)
                .OrderBy(e => e.Start));
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    // ------------- drag / resize -------------
    // The pointer drag itself lives in scheduler-agenda.js; nothing here runs per pointermove.
    // JS reports a snapped *delta*, never an absolute time, so a clipped multi-day event's real
    // Start is what the change is applied to - and AgendaGeometry (the same math the MAUI host uses)
    // stays authoritative.

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!DragEnabled)
        {
            await DisposeModuleAsync();
            return;
        }

        var options = new AgendaDragOptions
        {
            TimeSlotHeight = TimeSlotHeight,
            SnapMinutes = Math.Clamp(DragSnapMinutes, 1, 60),
            MinDurationMinutes = MinEventDuration.TotalMinutes,
            ActivationDelayMs = DragActivationDelay.TotalMilliseconds,
            AllowDrag = AllowEventDrag,
            AllowResize = AllowEventResize,
            AllowCrossDay = AllowCrossDayDrag,
            PerPositionValidation = DragValidationMode == AgendaDragValidationMode.PerPosition,
            Days = Days
        };
        var key = string.Create(CultureInfo.InvariantCulture,
            $"{options.TimeSlotHeight}|{options.SnapMinutes}|{options.MinDurationMinutes}|{options.ActivationDelayMs}|{options.AllowDrag}|{options.AllowResize}|{options.AllowCrossDay}|{options.PerPositionValidation}|{options.Days}");

        try
        {
            if (dragModule is null)
            {
                selfRef ??= DotNetObjectReference.Create(this);
                var loaded = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/Shiny.Blazor.Controls/scheduler-agenda.js");
                if (disposed) { await loaded.ReleaseLateAsync(); return; }
                dragModule = loaded;
                await dragModule.InvokeVoidAsync("init", rootElement, selfRef, options);
            }
            else if (key != lastDragOptions)
            {
                await dragModule.InvokeVoidAsync("update", rootElement, options);
            }
            lastDragOptions = key;
        }
        catch (JSDisconnectedException) { }
    }


    /// <summary>Gates the gesture. Returning false leaves the event exactly where it is.</summary>
    [JSInvokable]
    public bool OnDragArm(string eventId)
    {
        if (!DragEnabled || Provider is null) return false;
        var evt = ResolveEvent(eventId);
        return evt is not null && Provider.CanChangeEvent(evt);
    }


    /// <summary>Only called when <see cref="DragValidationMode"/> is PerPosition.</summary>
    [JSInvokable]
    public bool OnDragValidate(string eventId, int kind, double deltaMinutes, int dayDelta)
    {
        if (!DragEnabled || Provider is null) return false;
        var evt = ResolveEvent(eventId);
        if (evt is null) return false;
        return Provider.CanChangeEventTo(BuildChange(evt, kind, deltaMinutes, dayDelta));
    }


    [JSInvokable]
    public async Task<bool> OnDragCommit(string eventId, int kind, double deltaMinutes, int dayDelta)
    {
        if (!DragEnabled || Provider is null) return false;

        var evt = ResolveEvent(eventId);
        if (evt is null) return false;

        var change = BuildChange(evt, kind, deltaMinutes, dayDelta);

        // Re-checked here even in PerPosition mode: JS is a preview, .NET is the authority.
        if (!Provider.CanChangeEventTo(change))
        {
            await InvokeAsync(StateHasChanged);
            return false;
        }

        // Optimistic: a provider that hits the network would otherwise leave the event pinned under
        // the pointer for the whole round trip.
        evt.Start = change.NewStart;
        evt.End = change.NewEnd;
        ReorderEvents();
        await InvokeAsync(StateHasChanged);

        var ok = false;
        try
        {
            ok = await Provider.OnEventChanged(change);
        }
        catch (Exception ex)
        {
            await EventChangeFailed.InvokeAsync(new SchedulerEventChangeFailure(change, ex));
        }

        if (!ok)
        {
            evt.Start = change.OriginalStart;
            evt.End = change.OriginalEnd;
            ReorderEvents();
            await InvokeAsync(StateHasChanged);
        }
        return ok;
    }


    SchedulerEventChange BuildChange(SchedulerEvent evt, int kind, double deltaMinutes, int dayDelta)
    {
        var changeKind = kind switch
        {
            1 => SchedulerEventChangeKind.ResizeStart,
            2 => SchedulerEventChangeKind.ResizeEnd,
            _ => SchedulerEventChangeKind.Move
        };
        var snapped = AgendaGeometry.SnapMinutes(deltaMinutes, DragSnapMinutes);
        var (start, end) = AgendaGeometry.Apply(
            evt.Start, evt.End, changeKind, snapped,
            changeKind == SchedulerEventChangeKind.Move ? dayDelta : 0,
            MinEventDuration);

        return new SchedulerEventChange
        {
            Event = evt,
            OriginalStart = evt.Start,
            OriginalEnd = evt.End,
            NewStart = start,
            NewEnd = end,
            Kind = changeKind
        };
    }


    /// <summary>
    /// The MAUI host matches the dragged event by object reference; this one round-trips through the
    /// DOM and so matches by <see cref="SchedulerEvent.Identifier"/>. It defaults to a Guid, but a
    /// consumer who assigns duplicates would otherwise move the wrong event - so an ambiguous match
    /// is a no-op, not a guess.
    /// </summary>
    SchedulerEvent? ResolveEvent(string eventId)
    {
        SchedulerEvent? found = null;
        foreach (var e in timedEvents)
        {
            if (e.Identifier != eventId) continue;
            if (found is not null)
            {
                System.Diagnostics.Debug.WriteLine(
                    $"[Shiny.Scheduler] duplicate SchedulerEvent.Identifier '{eventId}' - drag ignored.");
                return null;
            }
            found = e;
        }
        if (found is null)
            System.Diagnostics.Debug.WriteLine($"[Shiny.Scheduler] no event matched '{eventId}' - drag ignored.");
        return found;
    }


    void ReorderEvents()
    {
        var ordered = timedEvents.OrderBy(e => e.Start).ToList();
        timedEvents.Clear();
        timedEvents.AddRange(ordered);
    }


    async Task DisposeModuleAsync()
    {
        if (dragModule is null) return;
        var module = dragModule;
        dragModule = null;
        lastDragOptions = null;
        try
        {
            await module.InvokeVoidAsync("dispose", rootElement);
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }


    public void Dispose()
    {
        loadCts?.Cancel();
        markerTimer?.Dispose();
    }


    public async ValueTask DisposeAsync()
    {
        disposed = true;
        Dispose();
        await DisposeModuleAsync();
        selfRef?.Dispose();
    }
}
