@namespace Shiny.Blazor.Controls

@*
    The field and popover every range picker shares: a trigger that shows the committed range (or a
    placeholder), a popover under it, and the Clear / Cancel / Apply footer. One component so the three
    pickers cannot drift apart in how they open, dismiss and commit.

    CSS-only placement like ColorPickerButton: absolute under the trigger with a transparent backdrop to
    catch outside clicks, and a fixed, centred sheet with a scrim on narrow screens.
*@

<div class="shiny-rangefield @Class" style="@Style" data-popover-host>
    <button type="button"
            class="shiny-rangefield-trigger @(string.IsNullOrEmpty(Text) ? "is-placeholder" : null)"
            disabled="@Disabled"
            aria-haspopup="dialog"
            aria-expanded="@(IsOpen ? "true" : "false")"
            @onclick="OnToggle">
        <span class="shiny-rangefield-icon" aria-hidden="true">
            @if (Icon == RangePickerIcon.Clock)
            {
                <svg viewBox="0 0 20 20" width="18" height="18"><circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M10 6v4.2l2.8 1.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            }
            else
            {
                <svg viewBox="0 0 20 20" width="18" height="18"><rect x="3" y="4.5" width="14" height="12.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M3 8.5h14M7 3v3M13 3v3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
            }
        </span>
        <span class="shiny-rangefield-text">@(string.IsNullOrEmpty(Text) ? Placeholder : Text)</span>
        <svg class="shiny-rangefield-chevron" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>

    @if (IsOpen)
    {
        <div class="shiny-rangefield-backdrop" @onclick="OnDismiss"></div>

        <div class="shiny-rangefield-popover"
             role="dialog"
             aria-modal="false"
             aria-label="@(Title ?? Placeholder)"
             popover="manual"
             data-popover
             @ref="PopoverElement"
             @onkeydown="OnKeyDownAsync">
            @if (!string.IsNullOrEmpty(Title))
            {
                <div class="shiny-rangefield-title">@Title</div>
            }

            <div class="shiny-rangefield-body">@ChildContent</div>

            @if (Summary is not null)
            {
                <div class="shiny-rangefield-summary">@Summary</div>
            }

            <div class="shiny-rangefield-footer">
                @if (ShowClear)
                {
                    <button type="button" class="shiny-rangefield-button is-text" @onclick="OnClear">@ClearText</button>
                }
                <span class="shiny-rangefield-spacer"></span>
                <button type="button" class="shiny-rangefield-button is-text" @onclick="OnDismiss">@CancelText</button>
                @if (ShowApply)
                {
                    <button type="button" class="shiny-rangefield-button is-filled" disabled="@ApplyDisabled" @onclick="OnApply">@ApplyText</button>
                }
            </div>
        </div>
    }
</div>

@code {
    /// <summary>The committed range, already formatted. Empty shows <see cref="Placeholder"/>.</summary>
    [Parameter] public string? Text { get; set; }

    [Parameter] public string Placeholder { get; set; } = "";

    [Parameter] public RangePickerIcon Icon { get; set; } = RangePickerIcon.Calendar;

    [Parameter] public string? Title { get; set; }

    [Parameter] public bool IsOpen { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>The picking surface - a calendar, time lists.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>A line above the footer describing the draft ("Mar 3 – 9, 2026 · 7 days").</summary>
    [Parameter] public RenderFragment? Summary { get; set; }

    [Parameter] public bool ShowClear { get; set; } = true;
    [Parameter] public bool ShowApply { get; set; } = true;
    [Parameter] public bool ApplyDisabled { get; set; }
    [Parameter] public string ClearText { get; set; } = "Clear";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public string ApplyText { get; set; } = "Apply";

    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public EventCallback OnDismiss { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public EventCallback OnApply { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    /// <summary>The open popover, for a picker that has to scroll something inside it.</summary>
    public ElementReference PopoverElement { get; private set; }

    async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            await this.OnDismiss.InvokeAsync();
    }
}
