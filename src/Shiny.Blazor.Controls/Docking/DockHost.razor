@namespace Shiny.Blazor.Controls.Docking

<div class="shiny-dock-host" style="@HostStyle" @ref="hostRef">
    @if (layout is null)
    {
        <div class="shiny-dock-host__placeholder">
            No dock layout loaded
        </div>
    }
    else
    {
        var win = layout.MainWindow;

        @if (win.TopRail is not null || HasCollapsed(DockArea.Top))
        {
            @RenderRail(win.TopRail, DockArea.Top)
        }
        @if (win.LeftRail is not null || HasCollapsed(DockArea.Left))
        {
            @RenderRail(win.LeftRail, DockArea.Left)
        }

        <div class="shiny-dock-doc">@RenderNode(win.DocumentArea)</div>

        @if (win.RightRail is not null || HasCollapsed(DockArea.Right))
        {
            @RenderRail(win.RightRail, DockArea.Right)
        }
        @if (win.BottomRail is not null || HasCollapsed(DockArea.Bottom))
        {
            @RenderRail(win.BottomRail, DockArea.Bottom)
        }

        @for (var w = 0; w < layout.FloatingWindows.Count; w++)
        {
            var windowIndex = w;
            var fw = layout.FloatingWindows[w];
            var bounds = fw.Bounds ?? new DockRect(60 + w * 28, 48 + w * 28, DockLayoutOps.DefaultFloatWidth, DockLayoutOps.DefaultFloatHeight);
            var floatIcon = FloatIcon(fw);
            <div class="shiny-dock-float @(IsFloatingActive(fw) ? "shiny-dock-float--active" : "") @(IsSingleTabFloat(fw) ? "shiny-dock-float--single" : "")"
                 data-dock-float="@windowIndex"
                 role="dialog"
                 aria-label="@FloatTitle(fw)"
                 style="@FloatStyle(fw, bounds)"
                 @key="fw">
                <div class="shiny-dock-float__header" data-dock-float-header
                     @ondblclick="() => DockFloatingAsync(windowIndex)">
                    @if (floatIcon is not null)
                    {
                        <span class="shiny-dock-float__icon">@floatIcon</span>
                    }
                    <span class="shiny-dock-float__title">@FloatTitle(fw)</span>
                    @if (!IsLocked)
                    {
                        <span class="shiny-dock-float__actions" @ondblclick:stopPropagation="true">
                            <button type="button" class="shiny-dock-btn" data-dock-float-btn
                                    title="Dock" aria-label="Dock"
                                    @onclick="() => DockFloatingAsync(windowIndex)">@DockIcons.DockBack</button>
                            @if (CanCloseFloating(fw))
                            {
                                <button type="button" class="shiny-dock-btn shiny-dock-btn--close" data-dock-float-btn
                                        title="Close" aria-label="Close"
                                        @onclick="() => CloseFloatingAsync(windowIndex)">@DockIcons.Close</button>
                            }
                        </span>
                    }
                </div>
                <div class="shiny-dock-float__body">@RenderNode(fw.DocumentArea)</div>
                @if (!IsLocked)
                {
                    @foreach (var dir in FloatResizeEdges)
                    {
                        <div class="shiny-dock-float__rsz shiny-dock-float__rsz--@dir" data-dock-float-rsz="@dir"></div>
                    }
                }
            </div>
        }
    }
</div>

@code {
    static readonly string[] FloatResizeEdges = ["n", "s", "e", "w", "ne", "nw", "se", "sw"];

    RenderFragment RenderRail(DockNode? node, DockArea area) => __builder =>
    {
        var areaName = area.ToString().ToLowerInvariant();
        var collapsed = CollapsedFor(area);
        <div class="shiny-dock-railwrap shiny-dock-railwrap--@areaName">
            @if (collapsed.Count > 0)
            {
                <div class="shiny-dock-railbar shiny-dock-railbar--@areaName">
                    @foreach (var item in collapsed)
                    {
                        var captured = item;
                        <button type="button" class="shiny-dock-railbar__item"
                                title="@GetTabTitle(captured.Tab)"
                                @onclick="() => RestoreCollapsedAsync(captured)">
                            @if (GetTabIcon(captured.Tab) is { } barIcon)
                            {
                                <span class="shiny-dock-railbar__icon">@barIcon</span>
                            }
                            <span class="shiny-dock-railbar__text">@GetTabTitle(captured.Tab)</span>
                        </button>
                    }
                </div>
            }
            @if (node is not null)
            {
                <div class="shiny-dock-rail shiny-dock-rail--@areaName" style="@RailSizeStyle(area)">@RenderNode(node, area)</div>
            }
        </div>
        @if (node is not null)
        {
            <div class="shiny-dock-rail-rsz shiny-dock-rail-rsz--@areaName @(IsLocked ? "" : "shiny-dock-rail-rsz--live")"
                 data-dock-rail-resizer="@(IsLocked ? null : areaName)"></div>
        }
    };

    RenderFragment RenderNode(DockNode node) => RenderNode(node, null, false);

    RenderFragment RenderNode(DockNode node, DockArea? rail) => RenderNode(node, rail, false);

    RenderFragment RenderNode(DockNode node, DockArea? rail, bool inSplit) => __builder =>
    {
        switch (node)
        {
            case DockSplit split:
                var dirClass = split.Orientation == DockOrientation.Horizontal
                    ? "shiny-dock-split--h"
                    : "shiny-dock-split--v";
                var firstCollapsed = split.First is DockGroup { IsCollapsed: true };
                var secondCollapsed = split.Second is DockGroup { IsCollapsed: true };
                var anyCollapsed = firstCollapsed || secondCollapsed;
                <div class="shiny-dock-split @dirClass">
                    <div class="shiny-dock-split__child"
                         style="@(firstCollapsed ? "flex:0 0 auto;" : anyCollapsed ? "flex:1 1 0%;" : FlexStyle(split.Ratio))">@RenderNode(split.First, rail, true)</div>
                    @if (anyCollapsed)
                    {
                        @* no resizing against a collapsed pane *@
                        <div class="shiny-dock-split__separator"></div>
                    }
                    else
                    {
                        <div class="shiny-dock-split__separator @(IsLocked ? "" : "shiny-dock-split__separator--live")"
                             data-dock-splitter="@split.RuntimeId"></div>
                    }
                    <div class="shiny-dock-split__child"
                         style="@(secondCollapsed ? "flex:0 0 auto;" : anyCollapsed ? "flex:1 1 0%;" : FlexStyle(1 - split.Ratio))">@RenderNode(split.Second, rail, true)</div>
                </div>
                break;

            case DockGroup group:
                var activeIndex = Math.Clamp(group.ActiveTabIndex, 0, Math.Max(0, group.Tabs.Count - 1));
                var isFloating = layout is not null && DockLayoutOps.FloatingWindowOf(layout, group) is not null;
                <div class="shiny-dock-group @(group.IsCollapsed ? "shiny-dock-group--collapsed" : "") @(IsGroupFocused(group) ? "shiny-dock-group--focused" : "")"
                     data-dock-group="@group.GroupId">
                    <div class="shiny-dock-tabs" role="tablist" data-dock-tabstrip="@group.GroupId">
                        @for (var i = 0; i < group.Tabs.Count; i++)
                        {
                            var tabIndex = i;
                            var tab = group.Tabs[i];
                            <div @key="tab.PanelInstanceId"
                                 class="shiny-dock-tab @(tabIndex == activeIndex ? "shiny-dock-tab--active" : "")"
                                 role="tab"
                                 data-dock-tab="@tab.PanelInstanceId"
                                 aria-selected="@(tabIndex == activeIndex ? "true" : "false")"
                                 title="@GetTabTitle(tab)"
                                 @onclick="() => ActivateTab(group, tabIndex)"
                                 @ondblclick="() => OnTabDoubleClickAsync(tab)">
                                @if (GetTabIcon(tab) is { } tabIcon)
                                {
                                    <span class="shiny-dock-tab__icon">@tabIcon</span>
                                }
                                <span class="shiny-dock-tab__title">@GetTabTitle(tab)</span>
                                @if (!IsLocked && CanCloseTab(tab))
                                {
                                    <span class="shiny-dock-tab__close"
                                          title="Close"
                                          role="button"
                                          aria-label="Close @GetTabTitle(tab)"
                                          @onclick="() => HidePanelAsync(tab.PanelInstanceId)"
                                          @onclick:stopPropagation="true"
                                          @ondblclick:stopPropagation="true">@DockIcons.Close</span>
                                }
                            </div>
                        }
                        @if (!IsLocked)
                        {
                            <span class="shiny-dock-tabs__spacer"></span>
                            <span class="shiny-dock-tabs__tools">
                                @if (!isFloating && group.Tabs.Count > 0)
                                {
                                    <button type="button" class="shiny-dock-btn" title="Float" aria-label="Float panel"
                                            @onclick="() => FloatPanelAsync(group.Tabs[activeIndex].PanelInstanceId)">@DockIcons.Float</button>
                                }
                                @* one collapse button, collapsing toward where the panel is docked *@
                                @if (rail is { } railArea)
                                {
                                    <button type="button" class="shiny-dock-btn" title="Collapse panel" aria-label="Collapse panel"
                                            @onclick="() => CollapseActiveTabAsync(railArea, group)">@DockIcons.Chevron(railArea)</button>
                                }
                                else if (inSplit || group.IsCollapsed)
                                {
                                    <button type="button" class="shiny-dock-btn"
                                            title="@(group.IsCollapsed ? "Expand panel" : "Collapse panel")"
                                            aria-label="@(group.IsCollapsed ? "Expand panel" : "Collapse panel")"
                                            @onclick="() => ToggleGroupCollapsedAsync(group)">@DockIcons.Chevron(group.IsCollapsed ? DockArea.Right : DockArea.Bottom)</button>
                                }
                            </span>
                        }
                    </div>
                    <div class="shiny-dock-group__content" data-dock-group-content="@group.GroupId">
                        @for (var i = 0; i < group.Tabs.Count; i++)
                        {
                            var tab = group.Tabs[i];
                            <div @key="tab.PanelInstanceId"
                                 class="shiny-dock-panel @(i == activeIndex ? "shiny-dock-panel--active" : "")">
                                @if (fragments.TryGetValue(tab.PanelInstanceId, out var fragment))
                                {
                                    @fragment
                                }
                                else
                                {
                                    <div class="shiny-dock-missing">Unknown panel type '@tab.PanelTypeId'</div>
                                }
                            </div>
                        }
                    </div>
                </div>
                break;

            default:
                <div class="shiny-dock-empty" data-dock-empty>
                    <span class="shiny-dock-empty__hint">Drop a panel here</span>
                </div>
                break;
        }
    };
}
