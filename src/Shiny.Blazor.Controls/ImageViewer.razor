@namespace Shiny.Blazor.Controls
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (rendered)
{
    <div class="shiny-imgviewer @(IsOpen ? "is-open" : "")"
         popover="manual"
         @ref="rootEl"
         style="@(IsOpen ? "" : "pointer-events:none;")">
        <div class="shiny-imgviewer-backdrop" @ref="backdropEl"></div>
        <img class="shiny-imgviewer-img"
             @ref="imgEl"
             src="@Source"
             draggable="false"
             alt="" />
        @if (HeaderTemplate != null)
        {
            <div class="shiny-imgviewer-header">@HeaderTemplate</div>
        }
        @if (CloseButtonTemplate != null)
        {
            <div class="shiny-imgviewer-close" @onclick="OnCloseClick">@CloseButtonTemplate</div>
        }
        else
        {
            <button type="button" class="shiny-imgviewer-close" @onclick="OnCloseClick" aria-label="Close">
                @if (!String.IsNullOrWhiteSpace(CloseButtonImage))
                {
                    <img class="shiny-imgviewer-close-img" src="@CloseButtonImage" alt="" draggable="false" />
                }
                else
                {
                    @CloseButtonText
                }
            </button>
        }
        @if (FooterTemplate != null)
        {
            <div class="shiny-imgviewer-footer">@FooterTemplate</div>
        }
    </div>
}

@code {
    Microsoft.AspNetCore.Components.ElementReference rootEl;
    Microsoft.AspNetCore.Components.ElementReference backdropEl;
    Microsoft.AspNetCore.Components.ElementReference imgEl;
    IJSObjectReference? module;
    DotNetObjectReference<ImageViewer>? selfRef;
    bool rendered;
    bool wasOpen;

    [Parameter] public string? Source { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public double MaxZoom { get; set; } = 5.0;
    [Parameter] public RenderFragment? CloseButtonTemplate { get; set; }

    /// <summary>The glyph or word on the built-in close button. Ignored once <see cref="CloseButtonImage"/> or <see cref="CloseButtonTemplate"/> is set.</summary>
    [Parameter] public string CloseButtonText { get; set; } = "✕";

    /// <summary>A url for artwork inside the built-in close button, in place of <see cref="CloseButtonText"/>. Ignored once <see cref="CloseButtonTemplate"/> is set.</summary>
    [Parameter] public string? CloseButtonImage { get; set; }
    [Parameter] public RenderFragment? HeaderTemplate { get; set; }
    [Parameter] public RenderFragment? FooterTemplate { get; set; }

    /// <summary>Raised once the overlay is on screen, however it was opened.</summary>
    [Parameter] public EventCallback Opened { get; set; }

    /// <summary>Raised once the overlay has gone, whether from the close button, the backdrop or <see cref="IsOpen"/>.</summary>
    [Parameter] public EventCallback Closed { get; set; }

    protected override void OnInitialized() { rendered = true; wasOpen = IsOpen; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Shiny.Blazor.Controls/image-viewer.js");
            selfRef = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("init", rootEl, backdropEl, imgEl, selfRef, MaxZoom);
            if (IsOpen)
            {
                await module.InvokeVoidAsync("open", rootEl);
                await Opened.InvokeAsync();
            }
        }
        else if (IsOpen != wasOpen)
        {
            wasOpen = IsOpen;
            if (module is null) return;
            if (IsOpen)
            {
                await module.InvokeVoidAsync("open", rootEl);
                await Opened.InvokeAsync();
            }
            else
            {
                await module.InvokeVoidAsync("close", rootEl);
                await Closed.InvokeAsync();
            }
        }
    }

    // Deliberately does not clear wasOpen: letting the state change fall through to
    // OnAfterRenderAsync is what makes the close button, the backdrop and IsOpen all raise Closed
    // once, from one place, and reset the zoom on the way out.
    [JSInvokable]
    public Task OnRequestClose()
    {
        IsOpen = false;
        return IsOpenChanged.InvokeAsync(false);
    }

    Task OnCloseClick() => OnRequestClose();

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("dispose", rootEl); } catch { }
            try { await module.DisposeAsync(); } catch { }
        }
        selfRef?.Dispose();
    }
}
