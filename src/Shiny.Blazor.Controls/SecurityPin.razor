@namespace Shiny.Blazor.Controls
@using Microsoft.AspNetCore.Components.Web

<div class="shiny-pin" style="@HostStyle" @onclick="OnHostClickAsync">
    <input
        @ref="inputRef"
        class="shiny-pin-hidden"
        type="@InputType"
        inputmode="@InputMode"
        autocomplete="one-time-code"
        autocorrect="off"
        spellcheck="false"
        maxlength="@Math.Max(1, Length)"
        value="@Value"
        @oninput="OnInputChanged"
        @onkeydown="OnKeyDown"
        @onfocus="OnFocus"
        @onblur="OnBlur" />

    <div class="shiny-pin-cells" style="gap:@(CellSpacing.ToString(System.Globalization.CultureInfo.InvariantCulture))px;">
        @for (var i = 0; i < Math.Max(1, Length); i++)
        {
            var idx = i;
            var ch = idx < (Value?.Length ?? 0) ? (Value![idx].ToString()) : "";
            var display = !string.IsNullOrEmpty(HideCharacter) && !string.IsNullOrEmpty(ch) ? HideCharacter : ch;
            var isCurrent = HighlightCurrentCell && idx == CurrentIndex && isFocused;
            var ink = isCurrent ? CellFocusedTextColor ?? CellTextColor : CellTextColor;
            <div class="shiny-pin-cell @(isCurrent ? "is-current" : "")" style="@CellStyle(isCurrent)">
                <span style="font-size:@(FontSize.ToString(System.Globalization.CultureInfo.InvariantCulture))px;@(ink is null ? "" : $"color:{ink};")">@display</span>
            </div>
        }
    </div>
</div>

@code {
    Microsoft.AspNetCore.Components.ElementReference inputRef;
    bool isFocused;

    [Parameter] public int Length { get; set; } = 4;
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? HideCharacter { get; set; }
    [Parameter] public bool IsNumeric { get; set; } = true;
    [Parameter] public bool IsPassword { get; set; }
    [Parameter] public double CellSize { get; set; } = 50;
    [Parameter] public double CellSpacing { get; set; } = 8;
    [Parameter] public double CellCornerRadius { get; set; } = 8;
    [Parameter] public string? CellBorderColor { get; set; }
    [Parameter] public string? CellFocusedBorderColor { get; set; }
    [Parameter] public string? CellBackgroundColor { get; set; }
    /// <summary>Fill of the cell awaiting the next character. Unset keeps <see cref="CellBackgroundColor"/>.</summary>
    [Parameter] public string? CellFocusedBackgroundColor { get; set; }
    [Parameter] public string? CellTextColor { get; set; }
    /// <summary>Character colour of the cell awaiting the next character. Unset keeps <see cref="CellTextColor"/>.</summary>
    [Parameter] public string? CellFocusedTextColor { get; set; }
    [Parameter] public double CellBorderThickness { get; set; } = 1;
    /// <summary>Stroke width of the cell awaiting the next character. Unset keeps <see cref="CellBorderThickness"/>.</summary>
    [Parameter] public double? CellFocusedBorderThickness { get; set; }
    [Parameter] public SecurityPinBorderStyle CellBorderStyle { get; set; } = SecurityPinBorderStyle.Solid;
    /// <summary>Stroke style of the cell awaiting the next character. Unset keeps <see cref="CellBorderStyle"/>.</summary>
    [Parameter] public SecurityPinBorderStyle? CellFocusedBorderStyle { get; set; }
    /// <summary>
    /// While the pin has focus, the cell awaiting the next character takes the <c>CellFocused…</c>
    /// appearance and the focus ring. Turn it off to draw every cell alike.
    /// </summary>
    [Parameter] public bool HighlightCurrentCell { get; set; } = true;
    [Parameter] public double FontSize { get; set; } = 24;
    [Parameter] public EventCallback<SecurityPinCompletedEventArgs> Completed { get; set; }

    string InputType => IsPassword ? "password" : "text";
    string InputMode => IsNumeric ? "numeric" : "text";

    int CurrentIndex => Math.Min(Value?.Length ?? 0, Math.Max(1, Length) - 1);

    string HostStyle => "position:relative;display:inline-block;";

    string CellStyle(bool isCurrent)
    {
        var size = CellSize.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var radius = CellCornerRadius.ToString(System.Globalization.CultureInfo.InvariantCulture);

        // The focused cell takes the primary colour unless the consumer coloured the cells themselves
        // and said nothing about focus, in which case it keeps theirs - the same rule as MAUI.
        var border = isCurrent && (CellFocusedBorderColor is not null || CellBorderColor is null)
            ? CellFocusedBorderColor ?? "var(--shiny-color-primary, #0055D9)"
            : (CellBorderColor ?? "var(--shiny-color-outline-variant, #BBC7DF)");

        // "white" here painted a stark white cell in dark mode; the border beside it was already a
        // token, so the cell was half-themed.
        var bg = (isCurrent ? CellFocusedBackgroundColor ?? CellBackgroundColor : CellBackgroundColor)
            ?? "var(--shiny-color-surface-container-low, #EFF4FB)";

        var style = isCurrent ? CellFocusedBorderStyle ?? CellBorderStyle : CellBorderStyle;
        var width = (isCurrent ? CellFocusedBorderThickness ?? CellBorderThickness : CellBorderThickness)
            .ToString(System.Globalization.CultureInfo.InvariantCulture);
        var stroke = style switch
        {
            SecurityPinBorderStyle.Dashed => $"{width}px dashed {border}",
            SecurityPinBorderStyle.Dotted => $"{width}px dotted {border}",
            SecurityPinBorderStyle.None => "none",
            _ => $"{width}px solid {border}"
        };

        // box-sizing keeps a thicker focused border inside the cell, so the row doesn't shift.
        return $"box-sizing:border-box;width:{size}px;height:{size}px;border-radius:{radius}px;border:{stroke};background:{bg};";
    }

    public ValueTask FocusAsync() => inputRef.FocusAsync();

    Task OnHostClickAsync() => inputRef.FocusAsync().AsTask();

    public Task ClearAsync() => UpdateValueAsync("");

    void OnFocus() { isFocused = true; }
    void OnBlur() { isFocused = false; }

    async Task OnInputChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        if (IsNumeric)
            raw = new string(raw.Where(char.IsDigit).ToArray());
        var max = Math.Max(1, Length);
        if (raw.Length > max)
            raw = raw.Substring(0, max);

        await UpdateValueAsync(raw);

        if (raw.Length >= max)
            await Completed.InvokeAsync(new SecurityPinCompletedEventArgs(raw));
    }

    Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (Value?.Length ?? 0) >= Length)
            return Completed.InvokeAsync(new SecurityPinCompletedEventArgs(Value ?? ""));
        return Task.CompletedTask;
    }

    async Task UpdateValueAsync(string newValue)
    {
        if (Value != newValue)
        {
            Value = newValue;
            await ValueChanged.InvokeAsync(newValue);
        }
    }
}
