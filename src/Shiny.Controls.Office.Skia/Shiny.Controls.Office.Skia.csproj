<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <RootNamespace>Shiny.Controls.Office.Skia</RootNamespace>
        <Description>SkiaSharp rendering for the Shiny spreadsheet grid, shared by the MAUI and Blazor hosts.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.Controls.Office.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Controls.Office.Shared\Shiny.Controls.Office.Shared.csproj"/>
    </ItemGroup>
</Project>
