<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(BaseTargetFramework);$(BaseTargetFramework)-ios;$(BaseTargetFramework)-android;$(BaseTargetFramework)-maccatalyst;$(BaseTargetFramework)-macos</TargetFrameworks>
        <!-- Windows packaging (MakePri) only runs on Windows; add the Windows TFM only there so the solution still builds on macOS/Linux. -->
        <TargetFrameworks Condition="'$(ForceWindowsTfm)' == 'true' Or $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);$(BaseTargetFramework)-windows10.0.19041.0</TargetFrameworks>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <UseMaui>true</UseMaui>
        <IsAotCompatible>true</IsAotCompatible>
        <SingleProject>true</SingleProject>
        <RootNamespace>Shiny.Maui.Controls.Camera.Barcode</RootNamespace>
        <Description>Barcode/QR analyzer for the Shiny CameraView. Reads codes with the native scanner — Apple Vision (iOS/macOS) and Android MLKit, with the managed ZXing.Net decoder on Windows and bare net10.0 — and has a LongRange mode for codes across a room: it locates codes first, reads 1D codes with a blur-tolerant managed decoder, hands 2D codes to the native scanner as enlarged crops, tracks codes across frames and can zoom in on codes too small to read.</Description>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Controls.Camera.Shared\Shiny.Controls.Camera.Shared.csproj" />
        <ProjectReference Include="..\Shiny.Maui.Controls.Camera\Shiny.Maui.Controls.Camera.csproj" />
        <!-- the managed locator / 1D decoder / tracker behind BarcodeScanMode.LongRange; dependency-free -->
        <ProjectReference Include="..\Shiny.Controls.BarcodeReader.Shared\Shiny.Controls.BarcodeReader.Shared.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'android'">
        <PackageReference Include="Xamarin.Google.MLKit.BarcodeScanning" />
    </ItemGroup>

    <!-- no camera-based native scanner on Windows (or bare net10.0): decode the luminance plane with ZXing.Net -->
    <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'windows' Or '$(TargetPlatformIdentifier)' == ''">
        <PackageReference Include="ZXing.Net" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Platforms/**/*.cs" />
        <None Include="Platforms/**/*.cs" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'ios' Or '$(TargetPlatformIdentifier)' == 'maccatalyst' Or '$(TargetPlatformIdentifier)' == 'macos'">
        <Compile Include="Platforms/Apple/**/*.cs" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'android'">
        <Compile Include="Platforms/Android/**/*.cs" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'windows' Or '$(TargetPlatformIdentifier)' == ''">
        <Compile Include="Platforms/ZXing/**/*.cs" />
    </ItemGroup>

    <Target Name="_ReincludeNonMauiPlatforms" BeforeTargets="_MauiRemovePlatformCompileItems" Condition="'$(SingleProject)' == 'true'">
        <ItemGroup>
            <Compile Update="Platforms/Apple/**/*.cs" Condition="'$(TargetPlatformIdentifier)' == 'ios' Or '$(TargetPlatformIdentifier)' == 'maccatalyst' Or '$(TargetPlatformIdentifier)' == 'macos'">
                <ExcludeFromCurrentConfiguration>false</ExcludeFromCurrentConfiguration>
            </Compile>
            <Compile Update="Platforms/ZXing/**/*.cs" Condition="'$(TargetPlatformIdentifier)' == 'windows' Or '$(TargetPlatformIdentifier)' == ''">
                <ExcludeFromCurrentConfiguration>false</ExcludeFromCurrentConfiguration>
            </Compile>
        </ItemGroup>
    </Target>
</Project>
