<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- The engine, XAML and views are platform-neutral, so the plain net11.0 build serves every
             head — including the AppKit (macos) and GTK4 (linux) heads, which cannot consume
             ios/android/maccatalyst assets and tick on a dispatcher timer. The platform TFMs exist
             for the parts that genuinely need a platform: the vsync frame clock (CADisplayLink,
             Choreographer, CompositionTarget.Rendering), the reduced-motion query, and switching off a
             collection view's native item animations. -->
        <TargetFrameworks>$(BaseTargetFramework);$(BaseTargetFramework)-ios;$(BaseTargetFramework)-android;$(BaseTargetFramework)-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="'$(ForceWindowsTfm)' == 'true' Or $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);$(BaseTargetFramework)-windows10.0.19041.0</TargetFrameworks>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- The repo uses two feeds (nuget.org + dotnet10) without source mapping; NU1507 is a
             restore-config warning, not a code-quality one, so it must not fail these builds. -->
        <NoWarn>$(NoWarn);NU1507</NoWarn>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>
        <RootNamespace>Shiny.Maui.Controls.Keyframe</RootNamespace>
        <Description>Declarative animation for .NET MAUI — XAML keyframe timelines with CSS easing syntax (springs included), seekable/reversible playback, choreographed storyboards, trigger actions, animated visual-state transitions, implicit property transitions, item transitions, Keyframe page transitions, reduced motion by default, a vsync clock, and an animation layer that never breaks bindings, styles or visual states.</Description>
        <PackageTags>maui shiny keyframe animation timeline easing storyboard xaml transitions visualstate spring</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.Controls.Keyframe.Shared\Shiny.Controls.Keyframe.Shared.csproj" />
        <!-- For the page-transition animator seam, so Keyframes can drive a push or a pop. -->
        <ProjectReference Include="..\Shiny.Maui.Controls\Shiny.Maui.Controls.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.Maui.Controls.Keyframe.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- The timing engine lives in the shared package's namespace; surface it everywhere so
             call sites read the same as they did when Core was the parent namespace. -->
        <Using Include="Shiny.Controls.Keyframe" />
    </ItemGroup>

</Project>
