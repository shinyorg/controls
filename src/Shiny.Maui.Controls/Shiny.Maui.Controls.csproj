<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
        <TargetFrameworks>$(BaseTargetFramework);$(BaseTargetFramework)-ios;$(BaseTargetFramework)-android</TargetFrameworks>
        <!--
            Windows packaging (MakePri) only runs on Windows, so the Windows TFM is normally added
            only there and the solution still builds on macOS/Linux. ForceWindowsTfm=true adds it
            anyway, which is how Platforms/Windows gets *compile*-verified off Windows:

                dotnet restore -p:ForceWindowsTfm=true
                dotnet build -p:ForceWindowsTfm=true -f net10.0-windows10.0.19041.0 -t:Compile
        -->
        <TargetFrameworks Condition="'$(ForceWindowsTfm)' == 'true' Or $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);$(BaseTargetFramework)-windows10.0.19041.0</TargetFrameworks>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <UseMaui>true</UseMaui>
        <IsAotCompatible>true</IsAotCompatible>
		<SingleProject>true</SingleProject>
        <RootNamespace>Shiny.Maui.Controls</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls"/>
	</ItemGroup>

	<ItemGroup>
		<!-- The icon artwork and motion definitions, shared verbatim with the Blazor package so the
		     two hosts cannot drift apart. Nothing in it touches a platform SDK or MAUI itself. -->
		<ProjectReference Include="..\Shiny.Controls.MotionIcons.Shared\Shiny.Controls.MotionIcons.Shared.csproj" />
		<!-- Motion icons run on the repo's one animation engine rather than carrying a second one:
		     KeyframeScene draws them and Player owns playback. -->
		<ProjectReference Include="..\Shiny.Controls.Keyframe.Shared\Shiny.Controls.Keyframe.Shared.csproj" />
		<!-- The Gantt scheduling engine: working calendars, dependency cascades, critical path and
		     the time-to-pixel geometry. Shared verbatim with the Blazor package, because a plan that
		     schedules differently on two hosts is a bug neither host's code would ever reveal. -->
		<ProjectReference Include="..\Shiny.Controls.Gantt.Shared\Shiny.Controls.Gantt.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Shiny.Maui.Controls.Tests" />
		<!-- The Desktop add-on plugs its native-window presenter and AppKit/GTK entry polish into the
		     quick entry infrastructure declared here. -->
		<InternalsVisibleTo Include="Shiny.Maui.Controls.Desktop" />
		<InternalsVisibleTo Include="Shiny.Maui.Controls.Desktop.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="buildTransitive/Shiny.Maui.Controls.targets" Pack="true" PackagePath="buildTransitive/Shiny.Maui.Controls.targets" />
	</ItemGroup>
</Project>