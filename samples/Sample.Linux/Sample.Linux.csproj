<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Linux head is a plain net10.0 console-style app. Do NOT set UseMaui=true here;
             the Microsoft.Maui.Platforms.Linux.Gtk4 package brings its own MAUI hosting wiring. -->
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Sample.Linux</RootNamespace>
        <AssemblyName>Sample.Linux</AssemblyName>
        <IsPackable>false</IsPackable>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>
        <ShinyMauiShell_GenerateNavExtensions>true</ShinyMauiShell_GenerateNavExtensions>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4" />
        <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" />
        <!-- Packages required by source files linked from ..\Sample\ -->
        <PackageReference Include="Plugin.Maui.Audio" />
        <PackageReference Include="Shiny.Maui.Shell" />
        <PackageReference Include="Shiny.Speech" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls\Shiny.Maui.Controls.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Desktop\Shiny.Maui.Controls.Desktop.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Markdown\Shiny.Maui.Controls.Markdown.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.MermaidDiagrams\Shiny.Maui.Controls.MermaidDiagrams.csproj" />
        <!-- The GTK4 backend is its own package: there is no Linux TFM, so it can't live in the main one. -->
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.MediaElement.Linux\Shiny.Maui.Controls.MediaElement.Linux.csproj" />
        <!-- SpeechAddins has no plain net10.0 TFM: Shiny.Speech's net10.0 asset only implements the
             browser engine, so there is nothing behind it on GTK. Chat & speech pages are excluded below. -->
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <PackageReference Include="Microsoft.Maui.DevFlow.Agent.Gtk" />
    </ItemGroup>

    <ItemGroup>
        <!-- Linux additionally excludes DrawingCanvas + FloatingPanel feature: they rely on
             Microsoft.Maui.Graphics platform types (PlatformBitmapExportContext) that aren't
             available on plain net10.0.
             Keyframe is excluded for now — Shiny.Maui.Controls.Keyframe isn't referenced by this head.
             FloorPlan is excluded for the same reason SkiaSharp is absent here: SkiaSharp.Views.Maui
             ships no GTK4 asset, so the canvas has no platform view on this head at all. -->
        <Compile Include="..\Sample\**\*.cs"
                 Exclude="..\Sample\Platforms\**;..\Sample\MauiProgram.cs;..\Sample\MyCustomFeedbackService.cs;..\Sample\App.xaml.cs;..\Sample\AppShell.xaml.cs;..\Sample\Controls\DrawingCanvas.cs;..\Sample\Features\Chat\**;..\Sample\Features\Camera\**;..\Sample\Features\Barcodes\**;..\Sample\Features\KitchenSink\**;..\Sample\Features\FloatingPanel\**;..\Sample\Features\Keyframe\**;..\Sample\Features\FloorPlan\**;..\Sample\bin\**;..\Sample\obj\**"
                 Link="%(RecursiveDir)%(Filename)%(Extension)" />
        <MauiXaml Include="..\Sample\**\*.xaml"
                  Exclude="..\Sample\Platforms\**;..\Sample\App.xaml;..\Sample\AppShell.xaml;..\Sample\Features\Chat\**;..\Sample\Features\Camera\**;..\Sample\Features\Barcodes\**;..\Sample\Features\KitchenSink\**;..\Sample\Features\FloatingPanel\**;..\Sample\Features\Keyframe\**;..\Sample\Features\FloorPlan\**;..\Sample\bin\**;..\Sample\obj\**"
                  Link="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <MauiImage Include="..\Sample\Resources\Images\*" Link="Resources\Images\%(Filename)%(Extension)" />
        <MauiFont Include="..\Sample\Resources\Fonts\*" Link="Resources\Fonts\%(Filename)%(Extension)" />
        <MauiAsset Include="..\Sample\Resources\Raw\**" Link="Resources\Raw\%(RecursiveDir)%(Filename)%(Extension)" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
        <MauiAsset Include="..\..\README.md" LogicalName="README.md" />
    </ItemGroup>
    <!-- The gallery renders its own source under each demo page. -->
    <Import Project="..\Sample\Sample.Source.targets" />

</Project>
