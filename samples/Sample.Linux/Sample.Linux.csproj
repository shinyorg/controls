<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- DevFlow's XAML source maps add every .xaml a second time without the item metadata MAUI's
             XAML source generator needs; on this head the untagged copy wins, nothing is generated,
             and InitializeComponent / every x:Name field goes missing. -->
        <DevFlowXamlSourceMapsEnabled>false</DevFlowXamlSourceMapsEnabled>
        <!-- Linux head is a plain net11.0 console-style app. Do NOT set UseMaui=true here;
             the Microsoft.Maui.Platforms.Linux.Gtk4 package brings its own MAUI hosting wiring. -->
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Sample.Linux</RootNamespace>
        <AssemblyName>Sample.Linux</AssemblyName>
        <IsPackable>false</IsPackable>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>
        <ShinyMauiShell_GenerateNavExtensions>true</ShinyMauiShell_GenerateNavExtensions>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AGUI.Client"/>
        <!-- the agent page's "Your key" source: AGUI.Server in-process over an OpenAI-compatible IChatClient -->
        <PackageReference Include="AGUI.Server"/>
        <PackageReference Include="Microsoft.Extensions.AI"/>
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI"/>
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4" />
        <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" />
        <!-- Packages required by source files linked from ..\Sample\ -->
        <PackageReference Include="Plugin.Maui.Audio" />
        <PackageReference Include="Shiny.Maui.Shell" />
        <PackageReference Include="Shiny.Speech" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls\Shiny.Maui.Controls.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Desktop\Shiny.Maui.Controls.Desktop.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Markdown\Shiny.Maui.Controls.Markdown.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Agents\Shiny.Maui.Controls.Agents.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.MermaidDiagrams\Shiny.Maui.Controls.MermaidDiagrams.csproj" />
        <!-- the Page Transitions demo builds one of its transitions from Keyframes -->
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Keyframe\Shiny.Maui.Controls.Keyframe.csproj" />
        <!-- The GTK4 backend is its own package: there is no Linux TFM, so it can't live in the main one. -->
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.MediaElement.Linux\Shiny.Maui.Controls.MediaElement.Linux.csproj" />
        <!-- SpeechAddins has no plain net11.0 TFM: Shiny.Speech's net11.0 asset only implements the
             browser engine, so there is nothing behind it on GTK. Chat & speech pages are excluded below. -->
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <PackageReference Include="Microsoft.Maui.DevFlow.Agent.Gtk" />
    </ItemGroup>

    <ItemGroup>
        <!-- Linux additionally excludes DrawingCanvas + FloatingPanel feature: they rely on
             Microsoft.Maui.Graphics platform types (PlatformBitmapExportContext) that aren't
             available on plain net11.0.
             The Keyframe feature pages are excluded for now; the head references Shiny.Maui.Controls.Keyframe
             only for the Page Transitions demo.
             FloorPlan and Office are excluded for the same reason SkiaSharp is absent here: SkiaSharp.Views.Maui
             ships no GTK4 asset, so the canvas has no platform view on this head at all. -->
        <Compile Include="..\Sample\**\*.cs"
                 Exclude="..\Sample\Platforms\**;..\Sample\Features\Media\MediaAnalysisPage.*;..\Sample\MauiProgram.cs;..\Sample\MyCustomFeedbackService.cs;..\Sample\App.xaml.cs;..\Sample\AppShell.xaml.cs;..\Sample\Controls\DrawingCanvas.cs;..\Sample\Features\Chat\**;..\Sample\Features\Camera\**;..\Sample\Features\Barcodes\**;..\Sample\Features\Diagram\**;..\Sample\Features\Gamepad\**;..\Sample\Features\FloatingPanel\**;..\Sample\Features\Keyframe\**;..\Sample\Features\FloorPlan\**;..\Sample\Features\Office\**;..\Sample\bin\**;..\Sample\obj\**"
                 Link="%(RecursiveDir)%(Filename)%(Extension)" />
        <MauiXaml Include="..\Sample\**\*.xaml"
                  Exclude="..\Sample\Platforms\**;..\Sample\Features\Media\MediaAnalysisPage.*;..\Sample\App.xaml;..\Sample\AppShell.xaml;..\Sample\Features\Chat\**;..\Sample\Features\Camera\**;..\Sample\Features\Barcodes\**;..\Sample\Features\Diagram\**;..\Sample\Features\Gamepad\**;..\Sample\Features\FloatingPanel\**;..\Sample\Features\Keyframe\**;..\Sample\Features\FloorPlan\**;..\Sample\Features\Office\**;..\Sample\bin\**;..\Sample\obj\**"
                  Link="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <!-- On net11.0 the GTK4 package runs these through Resizetizer, which takes the resource name from Link
             (a Resources\Images\ prefix is rejected as an invalid name) and publishes images and fonts flat and
             assets at their Link. So Link is the published name here, not an IDE folder. -->
        <MauiImage Include="..\Sample\Resources\Images\*" Link="%(Filename)%(Extension)" />
        <MauiFont Include="..\Sample\Resources\Fonts\*" Link="%(Filename)%(Extension)" />
        <MauiAsset Include="..\Sample\Resources\Raw\**" Link="%(RecursiveDir)%(Filename)%(Extension)" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
        <MauiAsset Include="..\..\README.md" Link="README.md" LogicalName="README.md" />
        <!-- ShinyImage's resource:// demo on the Images page; must match the main head's LogicalName. -->
        <EmbeddedResource Include="..\Sample\Assets\embedded-icon.svg" LogicalName="Sample.Assets.embedded-icon.svg" />
        <!-- the agent page's "Recordings" source: the AGUI.Server streams the engine tests replay, linked not copied -->
        <EmbeddedResource Include="..\..\tests\Shiny.Controls.AgentUI.Tests\Fixtures\agui\*.sse" LogicalName="AgentRecordings/%(Filename)%(Extension)" Link="AgentRecordings\%(Filename)%(Extension)" />
    </ItemGroup>
    <!-- The gallery renders its own source under each demo page. -->
    <Import Project="..\Sample\Sample.Source.targets" />

	<ItemGroup>
		<!-- AGUI.Server's JSON options reach AGUI.Abstractions' interrupt content types by reflection; trimmed, their
		     constructors lose their parameter names and every "Your key" run fails with only
		     "An error occurred while streaming the agent response". Rooting keeps them whole. -->
		<TrimmerRootAssembly Include="AGUI.Abstractions" />
	</ItemGroup>

</Project>
