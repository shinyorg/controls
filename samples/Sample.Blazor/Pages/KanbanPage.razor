@page "/kanban"
@using Shiny.Blazor.Controls.Kanban
@using System.Collections.ObjectModel

<PageTitle>Kanban</PageTitle>

<h1>Kanban</h1>

<p class="status-message">@status</p>

<section class="demo-section">
    <h2>Options</h2>
    <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;">
        <label class="toggle-row"><span>Swimlanes</span><input type="checkbox" @bind="useSwimlanes" /></label>
        <label class="toggle-row"><span>Block at WIP</span><input type="checkbox" @bind="blockAtWip" /></label>
        <label class="toggle-row"><span>WIP styling</span><input type="checkbox" @bind="showWipLimits" /></label>
        <label>Add card
            <select @bind="addCardMode">
                @foreach (var value in Enum.GetValues<KanbanAddCardMode>())
                {
                    <option value="@value">@value</option>
                }
            </select>
        </label>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;">
        <button class="btn" @onclick="() => board!.CollapseAllColumns()">Collapse</button>
        <button class="btn" @onclick="() => board!.ExpandAllColumns()">Expand</button>
        <button class="btn" @onclick="Undo" disabled="@(undo.Count == 0)">Undo</button>
        <button class="btn" @onclick="Reset">Reset</button>
    </div>
</section>

<section class="demo-section">
    <h2>Sprint board</h2>
    <p>
        Drag a card between columns or up and down inside one. <strong>In progress</strong> is limited
        to two cards and <strong>Ready</strong> to four; turn on <em>Block at WIP</em> and a full
        column refuses the drop instead of merely turning red. The release card in review is locked,
        and a move into <strong>Done</strong> is cancelled unless the card came from review.
    </p>
    <div style="height:560px">
        <KanbanView @ref="board"
                    Cards="cards"
                    Columns="columns"
                    Swimlanes="swimlanes"
                    SwimlaneMode="@(useSwimlanes ? KanbanSwimlaneMode.Grouped : KanbanSwimlaneMode.None)"
                    WipBehavior="@(blockAtWip ? KanbanWipBehavior.Block : KanbanWipBehavior.Warn)"
                    ShowWipLimits="showWipLimits"
                    AddCardMode="addCardMode"
                    @bind-SelectedCard="selected"
                    OnCardMoving="OnCardMoving"
                    OnCardMoved="OnCardMoved"
                    OnDropRejected="OnDropRejected"
                    OnAddCardRequested="OnAddCardRequested" />
    </div>
</section>

@code {
    KanbanView? board;
    KanbanCard? selected;

    bool useSwimlanes;
    bool blockAtWip;
    bool showWipLimits = true;
    KanbanAddCardMode addCardMode = KanbanAddCardMode.Inline;

    string status = "Drag a card between columns, or up and down inside one";
    int added;

    readonly Stack<KanbanMove> undo = new();

    ObservableCollection<KanbanColumn> columns = SampleBoard.CreateColumns();
    ObservableCollection<KanbanSwimlane> swimlanes = SampleBoard.CreateSwimlanes();
    ObservableCollection<KanbanCard> cards = SampleBoard.CreateCards();


    /// <summary>
    /// Refuses a move into Done unless the card has been through review. The point of the cancellable
    /// event: the whole consequence is in hand before anything has moved.
    /// </summary>
    void OnCardMoving(KanbanCardMovingEventArgs e)
    {
        if (e.Move.ToColumnId != "done" || e.Move.FromColumnId == "review")
            return;

        e.Cancel = true;
        this.status = $"\"{e.Card.Title}\" has to go through review first";
    }


    void OnCardMoved(KanbanCardMovedEventArgs e)
    {
        this.undo.Push(e.Move);
        this.status = $"Moved \"{e.Card.Title}\" to {this.TitleOf(e.Move.ToColumnId)}";
    }


    void OnDropRejected(KanbanDropRejectedEventArgs e)
        => this.status = e.Reason switch
        {
            KanbanDropRejection.WipLimitReached => $"{e.Column?.Title} is at its WIP limit",
            KanbanDropRejection.CardLocked => $"\"{e.Card.Title}\" is locked",
            KanbanDropRejection.ColumnRejectsDrop => $"{e.Column?.Title} does not take drops",
            _ => "That card has nowhere to land"
        };


    /// <summary>
    /// The control raises the request and nothing else - creating the card is the app's job, which is
    /// the whole point of the contract.
    /// </summary>
    void OnAddCardRequested(KanbanAddCardEventArgs e)
    {
        this.cards.Add(new KanbanCard
        {
            Id = $"new-{++this.added}",
            Title = e.Title.Length > 0 ? e.Title : $"New card {this.added}",
            ColumnId = e.Column.Id,
            SwimlaneId = e.Swimlane?.Id,
            Order = int.MaxValue
        });

        this.status = $"Added a card to {e.Column.Title}";
    }


    void Undo()
    {
        if (!this.undo.TryPop(out var move))
            return;

        move.Card.ColumnId = move.FromColumnId;
        move.Card.SwimlaneId = move.FromSwimlaneId.Length == 0 ? null : move.FromSwimlaneId;
        move.Card.Order = move.FromIndex;

        this.status = $"Put \"{move.Card.Title}\" back in {this.TitleOf(move.FromColumnId)}";
    }


    void Reset()
    {
        this.undo.Clear();
        this.added = 0;
        this.columns = SampleBoard.CreateColumns();
        this.swimlanes = SampleBoard.CreateSwimlanes();
        this.cards = SampleBoard.CreateCards();
        this.status = "Board reset";
    }


    string TitleOf(string columnId)
        => this.columns.FirstOrDefault(c => c.Id == columnId)?.Title ?? columnId;
}
