@page "/slider"

<PageTitle>Gradient Slider</PageTitle>

<h1>Gradient Slider</h1>

<div class="demo-section">
    <h2>Basic (Temperature)</h2>
    <Slider @bind-Value="temperature"
                    Minimum="0"
                    Maximum="100"
                    ValueFormat="0°" />
    <div class="state">Temperature: <code>@temperature.ToString("0")°</code></div>
</div>

<div class="demo-section">
    <h2>Custom Colors (Green to Yellow)</h2>
    <Slider @bind-Value="intensity"
                    Minimum="0"
                    Maximum="10"
                    Step="0.5"
                    ColdColor="#10B981"
                    HotColor="#F59E0B"
                    ValueFormat="0.#" />
    <div class="state">Intensity: <code>@intensity.ToString("0.#")</code></div>
</div>

<div class="demo-section">
    <h2>Large Thumb, Tall Track</h2>
    <Slider @bind-Value="volume"
                    Minimum="0"
                    Maximum="100"
                    TrackHeight="12"
                    ThumbSize="32"
                    ColdColor="#6366F1"
                    HotColor="#EC4899" />
    <div class="state">Volume: <code>@volume.ToString("0")</code></div>
</div>

<div class="demo-section">
    <h2>No Tooltip</h2>
    <Slider @bind-Value="opacity"
                    Minimum="0"
                    Maximum="1"
                    Step="0.01"
                    ShowTooltip="false"
                    ColdColor="#94A3B8"
                    HotColor="#1E293B"
                    ValueFormat="P0" />
    <div class="state">Opacity: <code>@opacity.ToString("P0")</code></div>
</div>

<div class="demo-section">
    <h2>Custom Tooltip Template</h2>
    <Slider @bind-Value="rating" Minimum="1" Maximum="5" Step="1">
        <TooltipTemplate Context="val">
            <div style="background: #7C3AED; color: white; padding: 6px 14px; border-radius: 8px; font-weight: bold;">
                @GetStars((int)val)
            </div>
        </TooltipTemplate>
    </Slider>
    <div class="state">Rating: <code>@GetStars((int)rating)</code></div>
</div>

<div class="demo-section">
    <h2>Stop Points (snap to marks)</h2>
    <Slider @bind-Value="quality"
                    Minimum="0"
                    Maximum="3"
                    ShowTooltip="false"
                    ColdColor="#94A3B8"
                    HotColor="#F59E0B">
        <SliderMark Value="0" Text="Draft" Color="#94A3B8" />
        <SliderMark Value="1" Text="Good" Color="#38BDF8" />
        <SliderMark Value="2" Text="Better" Color="#22C55E" />
        <SliderMark Value="3" Text="Best" Color="#F59E0B" />
    </Slider>
    <div class="state">Quality: <code>@quality.ToString("0")</code></div>
</div>

<div class="demo-section">
    <h2>Bubbles</h2>
    <Slider @bind-Value="plan"
                    Minimum="0"
                    Maximum="100"
                    MarkShape="SliderMarkShape.Bubble"
                    ShowTooltip="false"
                    ColdColor="#6366F1"
                    HotColor="#EC4899">
        <SliderMark Value="0" Text="Free" Color="#E0E7FF" TextColor="#3730A3" />
        <SliderMark Value="50" Text="Pro" Color="#6366F1" TextColor="#FFFFFF" />
        <SliderMark Value="100" Text="Team" Color="#EC4899" TextColor="#FFFFFF" />
    </Slider>
    <div class="state">Plan: <code>@plan.ToString("0")</code></div>
</div>

<div class="demo-section">
    <h2>Reference Ticks (no snapping)</h2>
    <Slider @bind-Value="pressure"
                    Minimum="0"
                    Maximum="60"
                    Step="1"
                    SnapToMarks="false"
                    MarkShape="SliderMarkShape.Line"
                    TrackHeight="10"
                    ColdColor="#0EA5E9"
                    HotColor="#DC2626"
                    ValueFormat="0 psi">
        <SliderMark Value="15" Text="Low" />
        <SliderMark Value="32" Text="Target" Color="#22C55E" />
        <SliderMark Value="50" Text="Max" Color="#DC2626" />
    </Slider>
    <div class="state">Pressure: <code>@pressure.ToString("0") psi</code></div>
</div>

<div class="demo-section">
    <h2>Vertical</h2>
    <div style="display: flex; gap: 3rem; align-items: flex-start;">
        <Slider @bind-Value="bass"
                        Orientation="SliderOrientation.Vertical"
                        VerticalLength="180"
                        Minimum="0"
                        Maximum="10"
                        Step="1"
                        ColdColor="#0EA5E9"
                        HotColor="#22C55E" />
        <Slider @bind-Value="treble"
                        Orientation="SliderOrientation.Vertical"
                        VerticalLength="180"
                        Minimum="0"
                        Maximum="10"
                        ShowTooltip="false"
                        ColdColor="#8B5CF6"
                        HotColor="#F97316">
            <SliderMark Value="0" Text="Flat" />
            <SliderMark Value="5" Text="Mid" />
            <SliderMark Value="10" Text="Bright" />
        </Slider>
    </div>
    <div class="state">Bass: <code>@bass.ToString("0")</code> &middot; Treble: <code>@treble.ToString("0")</code></div>
</div>

<div class="demo-section">
    <h2>Custom Thumb (the value rides in it)</h2>
    <Slider @bind-Value="brightness"
                    Minimum="0"
                    Maximum="100"
                    ShowTooltip="false"
                    ThumbWidth="52"
                    ThumbHeight="28"
                    ThumbPadding="0 4px"
                    ColdColor="#0EA5E9"
                    HotColor="#F59E0B">
        <ThumbTemplate Context="value">
            <span style="font-size: 11px; font-weight: 700; white-space: nowrap;">@value.ToString("0")%</span>
        </ThumbTemplate>
    </Slider>
    <div class="state">Brightness: <code>@brightness.ToString("0")%</code></div>
</div>

<div class="demo-section">
    <h2>Custom Thumb (a glyph)</h2>
    <Slider @bind-Value="warmth"
                    Minimum="0"
                    Maximum="100"
                    ThumbSize="34"
                    ColdColor="#3B82F6"
                    HotColor="#EF4444"
                    ValueFormat="0°">
        <ThumbTemplate Context="value">
            <span style="font-size: 16px; line-height: 1;">@(value < 50 ? "\u2744" : "\U0001F525")</span>
        </ThumbTemplate>
    </Slider>
    <div class="state">Warmth: <code>@warmth.ToString("0")°</code></div>
</div>

<div class="demo-section">
    <h2>Disabled</h2>
    <Slider Value="65" IsEnabled="false" />
</div>

@code {
    double temperature = 50;
    double intensity = 5;
    double volume = 30;
    double opacity = 0.75;
    double rating = 3;
    double quality = 2;
    double plan = 50;
    double pressure = 32;
    double bass = 6;
    double treble = 5;
    double brightness = 60;
    double warmth = 35;

    string GetStars(int count) => new string('\u2B50', count);
}
