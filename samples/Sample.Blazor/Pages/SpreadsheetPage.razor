@page "/spreadsheet"
@using Shiny.Blazor.Controls.Office
@using Shiny.Controls.Office.Spreadsheet
@using Shiny.Controls.Office.Spreadsheet.Commands
@using Shiny.Controls.Office.Skia
@using Shiny.Controls.Office.Spreadsheet.View
@implements IDisposable

<PageTitle>Spreadsheet</PageTitle>

<h1>Spreadsheet</h1>
<p class="lead">
    An <code>.xlsx</code> viewer and editor. Edits are applied surgically to the open package, so
    anything the editor does not model survives a save untouched.
</p>

<div class="toolbar">
    <button class="btn" @onclick="Recalculate">Recalculate</button>
    <button class="btn" @onclick="AddRow">Add row</button>
    <button class="btn" disabled="@(!CanUndo)" @onclick="Undo">Undo</button>
    <button class="btn" disabled="@(!CanRedo)" @onclick="Redo">Redo</button>
    <button class="btn" @onclick="ToggleTheme">@(dark ? "Follow page" : "Force dark")</button>
    <span class="status">@Status</span>
</div>

@* What a status bar shows - the view reports it, so the app can put it wherever its chrome goes. *@
<div class="toolbar">
    <span class="status">Zoom @($"{this.zoom:P0}")</span>
    @if (this.statistics.IsMeaningful)
    {
        <span class="status">
            @(this.statistics.Average is { } average ? $"Average: {average:N2}   " : string.Empty)Count: @this.statistics.Count@(this.statistics.NumericalCount > 0 ? $"   Sum: {this.statistics.Sum:N2}" : string.Empty)
        </span>
    }
</div>

<div class="sheet-host">
    @*
        The ribbon, formula bar and sheet tabs are all the control's own - ShowToolbar,
        ShowFormulaBar and ShowSheetTabs turn each on or off. All three are on by default.
    *@
    @* Theme left null: the grid follows the page's light/dark scheme on its own. The button above
       pins it dark, to show that an explicit Theme still wins. *@
    <SpreadsheetView @ref="view"
                     Workbook="workbook"
                     @bind-Zoom="zoom"
                     SelectionStatisticsChanged="OnStatistics"
                     Theme="@(dark ? SpreadsheetTheme.Dark : null)"
                     CellChanged="OnCellChanged" />
</div>

<p class="hint">
    The ribbon is Excel's: <em>Home</em> formats (borders, merge &amp; center, conditional formatting,
    format as table, cell styles, fill, clear, sort &amp; filter); <em>Insert</em> adds tables, charts,
    links and notes; <em>Formulas</em> has the function library, Insert Function and the Name Manager;
    <em>Data</em> sorts, filters and validates; <em>Review</em> manages notes; <em>View</em> toggles
    gridlines, headings, the formula bar and formulas, zooms and freezes panes. Right-click (or
    long-press) a cell or header for its menu; Ctrl+1 opens Format Cells; drag the square on the
    selection's corner to fill a series; Ctrl+wheel or a pinch zooms. Every command is one undo step.
</p>

<p class="hint">
    The bar above the grid shows the formula in the active cell, not its result - type <code>=SU</code>
    to see autocomplete, and the signature once the parenthesis opens. The name box takes an address,
    a range or a defined name. The tabs below the grid switch sheets; Ctrl+PageUp and Ctrl+PageDown
    move between them from the keyboard.
</p>

@code {
    SpreadsheetView? view;
    Workbook? workbook;
    bool dark;
    int nextRow = 6;
    double zoom = 1;
    SelectionStatistics statistics = SelectionStatistics.Empty;

    bool CanUndo => this.workbook?.Undo.CanUndo ?? false;
    bool CanRedo => this.workbook?.Undo.CanRedo ?? false;

    string Status => this.workbook is null
        ? "loading"
        : $"{this.workbook.Calc.FormulaCount} formulas{(this.workbook.IsDirty ? " · unsaved" : string.Empty)}";

    protected override void OnInitialized()
    {
        // Built in memory rather than shipped as a binary fixture, so the demo also exercises the
        // "create a new workbook from nothing" path.
        this.workbook = Workbook.Create("Budget");

        Set("A1", CellValue.FromText("Item"));
        Set("B1", CellValue.FromText("Qty"));
        Set("C1", CellValue.FromText("Unit"));
        Set("D1", CellValue.FromText("Total"));

        AddItem(2, "Widget", 4, 12.50);
        AddItem(3, "Gadget", 2, 42.00);
        AddItem(4, "Doohickey", 7, 3.25);

        Set("A5", CellValue.FromText("Total"));
        this.workbook.Execute(new SetCellFormulaCommand("Budget", CellRef.Parse("D5"), "SUM(D2:D4)"));

        // A second sheet, so the tab strip has somewhere to go and the cross-sheet formula below has
        // something to read. Try renaming Budget from its tab: this formula follows it.
        this.workbook.Execute(new AddSheetCommand("Summary", 1));
        this.workbook.Execute(new SetCellValueCommand("Summary", CellRef.Parse("A1"), CellValue.FromText("Budget total")));
        this.workbook.Execute(new SetCellFormulaCommand("Summary", CellRef.Parse("B1"), "Budget!D5"));
    }

    void AddItem(int row, string name, double quantity, double unit)
    {
        Set($"A{row}", CellValue.FromText(name));
        Set($"B{row}", CellValue.FromNumber(quantity));
        Set($"C{row}", CellValue.FromNumber(unit));
        this.workbook!.Execute(new SetCellFormulaCommand("Budget", CellRef.Parse($"D{row}"), $"B{row}*C{row}"));
    }

    void Set(string reference, CellValue value)
        => this.workbook!.Execute(new SetCellValueCommand("Budget", CellRef.Parse(reference), value));

    void AddRow()
    {
        AddItem(this.nextRow, $"Item {this.nextRow}", this.nextRow, 5);

        // The total has to grow with the table; nothing rewrites ranges for us yet.
        this.workbook!.Execute(new SetCellFormulaCommand("Budget", CellRef.Parse("D5"), $"SUM(D2:D{this.nextRow})"));
        this.nextRow++;
        this.StateHasChanged();
    }

    void Recalculate()
    {
        this.workbook?.EnsureFormulasLoaded();
        this.StateHasChanged();
    }

    void Undo()
    {
        this.view?.Controller?.Undo();
        this.StateHasChanged();
    }

    void Redo()
    {
        this.view?.Controller?.Redo();
        this.StateHasChanged();
    }

    void ToggleTheme() => this.dark = !this.dark;

    void OnCellChanged(CellRef cell) => this.StateHasChanged();

    void OnStatistics(SelectionStatistics value) => this.statistics = value;

    public void Dispose() => this.workbook?.Dispose();
}
