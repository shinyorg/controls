@page "/camera"
@using Microsoft.Maui.Graphics
@using Shiny.Blazor.Controls.Camera
@using Shiny.Blazor.Controls.Camera.Ai
@using Shiny.Controls.Camera
@using Shiny.Controls.Analysis
@using Shiny.Blazor.Controls.Analysis

<PageTitle>Camera</PageTitle>

<h1>Camera</h1>

<div class="demo-section">
    <p>
        Live <code>getUserMedia</code> preview with in-browser barcode scanning (native
        <code>BarcodeDetector</code> — Chromium browsers). Boxes draw continuously, but a decoded value is only
        delivered when you tap <strong>Scan</strong> (<code>RequestBarcodeAsync</code>) — await it once, or tick
        <em>Keep scanning</em> to loop. Switch the detector to <strong>AI Document</strong> to detect a document
        in-browser (no OCR) and send just that frame to a Microsoft.Extensions.AI <code>IChatClient</code> for
        structured extraction (this demo uses an offline stand-in client). Face, motion and OCR are MAUI-only.
    </p>

    <div style="position:relative;width:100%;max-width:480px;aspect-ratio:3/4;border-radius:12px;overflow:hidden;background:#000;">
        <CameraView @ref="camera"
                    Facing="facing"
                    CameraId="@cameraId"
                    Analyzer="analyzer"
                    ShowOverlay="showBoxes"
                    Filter="filter"
                    Effects="effects"
                    BarcodesDetected="OnBarcodes"
                    OnError="OnError"
                    OnStarted="LoadCamerasAsync"
                    Style="width:100%;height:100%;" />
    </div>

    <!-- camera controls -->
    <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
        <button @onclick="Scan" disabled="@scanning">Scan</button>
        <button @onclick="StopScan" disabled="@(!scanning)">Stop scan</button>
        <label><input type="checkbox" @bind="continuous" /> Keep scanning</label>
        <button @onclick="Capture">Photo</button>
        <button @onclick="ToggleRecording">@(recording ? "Stop" : "Record")</button>
        <button @onclick="Flip">Flip</button>
        <button @onclick="ToggleRunning">@(running ? "Stop" : "Start")</button>
    </div>

    <!-- options (mirrors the MAUI options sheet, where the browser supports it) -->
    <div style="margin-top:16px;display:flex;gap:24px;flex-wrap:wrap;">
        <fieldset style="border:1px solid #E5E7EB;border-radius:8px;padding:8px 14px;">
            <legend style="font-size:12px;color:#6B7280;">Detector</legend>
            <label style="display:block;"><input type="radio" name="det" checked="@(mode == DetectorMode.Barcode)" @onchange="@(() => SetMode(DetectorMode.Barcode))" /> Barcode / QR</label>
            <label style="display:block;margin-top:6px;"><input type="checkbox" @bind="scanArea" @bind:after="RebuildAnalyzer" disabled="@(mode != DetectorMode.Barcode)" /> Restrict scan area</label>
            <label style="display:block;margin-top:6px;"><input type="radio" name="det" checked="@(mode == DetectorMode.Document)" @onchange="@(() => SetMode(DetectorMode.Document))" /> AI Document (MEAI)</label>
            <p style="margin:6px 0 0;font-size:12px;color:#9CA3AF;">Face / Motion / OCR — MAUI only</p>
        </fieldset>

        <fieldset style="border:1px solid #E5E7EB;border-radius:8px;padding:8px 14px;">
            <legend style="font-size:12px;color:#6B7280;">Camera</legend>
            <label style="display:block;"><input type="checkbox" @bind="showBoxes" /> Detection boxes</label>
            <label style="display:block;margin-top:6px;">Filter:
                <select @bind="filter">
                    @foreach (var f in Enum.GetValues<CameraFilter>())
                    {
                        <option value="@f">@f</option>
                    }
                </select>
            </label>
            <label style="display:block;margin-top:6px;">Effect:
                <select @bind="spatialEffect" @bind:after="ApplyEffects">
                    @foreach (var e in SpatialEffects)
                    {
                        <option value="@e">@e</option>
                    }
                </select>
            </label>
            @if (effectNote != null)
            {
                <p style="margin:4px 0 0;font-size:12px;color:#9CA3AF;">@effectNote</p>
            }
            <label style="display:block;margin-top:6px;">Lens:
                <select value="@cameraId" @onchange="OnLensChanged" disabled="@(cameras.Count == 0)">
                    @foreach (var c in cameras)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </label>
        </fieldset>
    </div>

    @if (lastPhoto != null)
    {
        <div style="margin-top:16px;">
            <img src="@lastPhoto" alt="Captured frame"
                 style="max-width:100%;border:1px solid #E5E7EB;border-radius:8px;" />
        </div>
    }

    @if (lastVideo != null)
    {
        <div style="margin-top:16px;">
            <video src="@lastVideo" controls
                   style="max-width:100%;border:1px solid #E5E7EB;border-radius:8px;"></video>
        </div>
    }

    <div class="state" style="margin-top:12px;">Status: <code>@status</code></div>

    @if (lastDoc != null)
    {
        <div style="margin-top:12px;border:1px solid #E5E7EB;border-radius:8px;padding:10px 14px;">
            <strong>@(lastDoc.DocumentType ?? "Document")</strong>
            <div style="color:#6B7280;font-size:13px;">@lastDoc.Summary</div>
            <ul style="margin:8px 0 0;">
                @foreach (var f in lastDoc.Fields)
                {
                    <li><strong>@f.Label:</strong> <code>@f.Value</code></li>
                }
            </ul>
        </div>
    }

    @if (barcodes.Count > 0)
    {
        <ul style="margin-top:8px;">
            @foreach (var b in barcodes)
            {
                <li><strong>@b.Format</strong> — <code>@b.Value</code></li>
            }
        </ul>
    }
</div>

@code {
    CameraView? camera;
    string status = "Starting…";
    string? lastPhoto;
    string? lastVideo;
    bool recording;
    bool running = true;   // AutoStart defaults true
    CameraFacing facing = CameraFacing.Back;
    string? cameraId;
    CameraFilter filter = CameraFilter.None;

    // The spatial looks — unlike the colour grades in `filter`, these need a pixel's neighbours, so they run
    // as SVG filters rather than a CSS shorthand. They stack on top of whatever `filter` is set to.
    static readonly string[] SpatialEffects = ["None", "Comic", "Sketch", "Posterize", "Pixelate", "Blur"];
    string spatialEffect = "None";
    IReadOnlyList<ICameraEffect>? effects;
    string? effectNote;

    void ApplyEffects()
    {
        if (SpatialEffect(spatialEffect) is { } spatial)
        {
            effects = [spatial];
            // coverage is uneven (no SVG primitive produces a mosaic, so Pixelate is stills-only here)
            var support = CameraView.GetEffectSupport(spatial);
            effectNote = support == EffectSupport.Full ? null : $"{spatialEffect}: {Describe(support)}";
        }
        else
        {
            effects = null;
            effectNote = null;
        }
    }

    static BuiltInCameraEffect? SpatialEffect(string name) => name switch
    {
        "Comic" => CameraEffects.Comic,
        "Sketch" => CameraEffects.Sketch,
        "Posterize" => CameraEffects.Posterize,
        "Pixelate" => CameraEffects.Pixelate,
        "Blur" => CameraEffects.Blur,
        _ => null
    };

    static string Describe(EffectSupport support) => support switch
    {
        EffectSupport.StillOnly => "photos only — the live preview can't run it",
        EffectSupport.ColorOnly => "approximated with a colour matrix",
        EffectSupport.Unsupported => "not supported in the browser",
        _ => ""
    };
    enum DetectorMode { Barcode, Document }
    DetectorMode mode = DetectorMode.Barcode;
    bool scanArea;
    FrameAnalyzer? analyzer = new BarcodeAnalyzer();
    bool showBoxes = true;
    bool continuous;

    // the scan window enabled by "Restrict scan area" — a center band the barcode analyzer scans
    static readonly RectF ScanBand = new(0.1f, 0.4f, 0.8f, 0.2f);

    // the AI document scanner ships a detected document's frame to an IChatClient (offline stand-in here)
    readonly AiDocumentScanner scanner = new(new SampleVisionChatClient());
    AiDocument? lastDoc;

    void SetMode(DetectorMode m) { mode = m; RebuildAnalyzer(); }

    // swap in a fresh analyzer instance so the component restarts the stream with the new options
    void RebuildAnalyzer()
        => analyzer = mode == DetectorMode.Document
            ? new DocumentAnalyzer()
            : new BarcodeAnalyzer { ScanWindow = scanArea ? ScanBand : null };
    bool scanning;
    CancellationTokenSource? scanCts;
    readonly List<CameraBarcode> barcodes = [];
    readonly List<CameraDevice> cameras = [];

    async Task LoadCamerasAsync()
    {
        if (camera == null)
            return;
        var list = await camera.GetAvailableCamerasAsync();
        cameras.Clear();
        cameras.AddRange(list);
        StateHasChanged();
    }

    void OnLensChanged(ChangeEventArgs e)
    {
        cameraId = (string?)e.Value;
        status = $"Lens: {cameras.FirstOrDefault(c => c.Id == cameraId)?.Name ?? cameraId}";
    }

    void Flip()
    {
        facing = facing == CameraFacing.Back ? CameraFacing.Front : CameraFacing.Back;
        cameraId = null;   // let the facing hint pick the lens (the component restarts on the change)
    }

    async Task ToggleRunning()
    {
        if (camera == null)
            return;
        if (running)
        {
            await camera.StopAsync();
            running = false;
        }
        else
        {
            await camera.StartAsync();   // raises OnStarted → LoadCamerasAsync
            running = true;
        }
    }

    async Task ToggleRecording()
    {
        if (camera == null)
            return;
        if (!recording)
        {
            await camera.StartRecordingAsync();
            recording = true;
            status = "Recording…";
        }
        else
        {
            var bytes = await camera.StopRecordingAsync();
            recording = false;
            if (bytes.Length > 0)
            {
                lastVideo = "data:video/webm;base64," + Convert.ToBase64String(bytes);
                status = $"Recorded {bytes.Length / 1024} KB";
            }
        }
    }

    // Gated request/response: arm, await the next decode, then go quiet. "Keep scanning" loops (re-arming each
    // time) until Stop scan — the await is the gate, looping is "keep going".
    async Task Scan()
    {
        if (camera == null)
            return;
        scanCts?.Cancel();
        scanCts = new CancellationTokenSource();
        var ct = scanCts.Token;
        scanning = true;
        status = mode == DetectorMode.Document ? "Point at a document…" : "Scanning…";
        try
        {
            do
            {
                if (mode == DetectorMode.Document)
                {
                    // waits (cheaply) for a document to be present, then ships that one frame to the model
                    lastDoc = await scanner.ScanAsync(camera, ct);
                    status = lastDoc is null ? "No document parsed" : $"Parsed: {lastDoc.Summary ?? lastDoc.DocumentType}";
                }
                else
                {
                    var barcode = await camera.RequestBarcodeAsync(ct);
                    if (!barcodes.Any(b => b.Value == barcode.Value && b.Format == barcode.Format))
                        barcodes.Insert(0, barcode);
                    status = $"{barcode.Format}: {barcode.Value}";
                }
                StateHasChanged();
            }
            while (continuous && !ct.IsCancellationRequested);
        }
        catch (OperationCanceledException) { /* Stop scan */ }
        finally
        {
            scanning = false;
            StateHasChanged();
        }
    }

    void StopScan() => scanCts?.Cancel();

    // Still fires (gated) while a scan is outstanding — the demo drives the list from Scan() instead, but this
    // shows the EventCallback path stays available. A frame can hold several codes, so it's an array.
    void OnBarcodes(IReadOnlyList<CameraBarcode> codes)
        => status = $"{codes.Count} code(s): {codes[0].Format} {codes[0].Value}";

    void OnError(string message)
    {
        status = message;
        StateHasChanged();
    }

    async Task Capture()
    {
        if (camera == null)
            return;
        var bytes = await camera.CapturePhotoAsync();
        if (bytes.Length > 0)
        {
            lastPhoto = "data:image/jpeg;base64," + Convert.ToBase64String(bytes);
            status = $"Captured {bytes.Length / 1024} KB";
        }
    }
}
