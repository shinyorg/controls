@page "/document-editor"
@using Shiny.Blazor.Controls.Office
@using Shiny.Controls.Office.Document
@using Shiny.Controls.Office.Skia
@implements IDisposable

<PageTitle>Document Editor</PageTitle>

<h1>Document Editor</h1>
<p class="lead">
    A <code>.docx</code> editor. Two controls: <code>DocumentEditor</code> is the bare surface,
    <code>DocumentEditorView</code> wraps it in Word's ribbon — Home (clipboard, font, paragraph,
    styles, find &amp; replace), Insert (pages, tables, links, comments, header &amp; footer, symbols),
    Design (watermark, page colour), Layout (margins, orientation, size, columns, breaks), References
    (table of contents, footnotes), Review (spelling, comments, track changes, word count) and View
    (read mode, navigation pane, zoom) — plus a Table tab while the caret is in a table.
</p>
<p class="lead">
    The Home tab's two list buttons make any paragraph a bulleted or numbered item, and typing
    <code>-&nbsp;</code> or <code>1.&nbsp;</code> at the start of a line does the same. <kbd>Tab</kbd>
    inside a list nests the item — the second level reads as <code>1a</code> — and
    <kbd>Shift</kbd>+<kbd>Tab</kbd> brings it back out.
</p>

@*
    Everything the ribbon carries is driven from the ribbon. What is left here is what it does not
    have: whether the wrapper is there at all, and the Theme parameter a host supplies.
*@
<div class="toolbar">
    <label class="chk"><input type="checkbox" @bind="withToolbar" /> Toolbar wrapper</label>
    <label class="chk"><input type="checkbox" @bind="readMode" /> Read mode</label>
    <button class="btn" @onclick="ToggleTheme">@(dark ? "Follow page" : "Force dark")</button>
    <span class="status">@Status</span>
</div>

<div class="editor-host">
    @if (withToolbar)
    {
        <DocumentEditorView Document="document"
                            Theme="@(dark ? DocumentTheme.Dark : null)"
                            SpellChecker="checker"
                            @bind-ReadMode="readMode"
                            StatisticsChanged="s => this.statistics = s"
                            DocumentChanged="OnChanged" />
    }
    else
    {
        <DocumentEditor Document="document"
                        Theme="@(dark ? DocumentTheme.Dark : null)"
                        SpellChecker="checker"
                        DocumentChanged="OnChanged" />
    }
</div>

<p class="hint">
    Click to place the caret, drag to select, double-click a word, triple-click a paragraph. Type to insert; Enter splits a paragraph; Backspace at the
    start of one joins it to the paragraph above. Word's shortcuts work: Ctrl/Cmd+B, I, U, C, X, V, Z, Y,
    H (replace), K (link), E/L/R/J (alignment), Ctrl+Shift+&gt;/&lt; (font size), Ctrl+Enter (page break),
    Ctrl+1/2/5 (line spacing) and Ctrl+Alt+1..3 (headings). Tab walks table cells; Ctrl+click follows a
    link. Right-click a red-underlined word for corrections.
</p>

@code {
    WordDocument? document;

    /// <summary>
    /// The web has no platform spell checker, so the sample supplies one.
    /// </summary>
    /// <remarks>
    /// On MAUI this parameter would be left off entirely — the package registers the iOS, Android,
    /// macOS and Windows checkers itself. Setting it is how any host overrides that.
    /// </remarks>
    readonly SampleSpellChecker checker = new();

    bool withToolbar = true;
    bool readMode;
    DocumentStatistics? statistics;
    bool dark;
    int edits;

    string Status => this.document is null
        ? "loading"
        : $"{(this.statistics is { } s ? $"Page {s.CurrentPage} of {s.Pages} · {s.Words} words · " : string.Empty)}{this.edits} edits{(this.document.IsDirty ? " · unsaved" : string.Empty)}";

    protected override async Task OnInitializedAsync()
    {
        var bytes = SampleOfficeDocuments.BuildDocument();
        this.document = await WordDocument.OpenAsync(new MemoryStream(bytes), editable: true);
    }

    void ToggleTheme() => this.dark = !this.dark;

    void OnChanged()
    {
        this.edits++;
        this.StateHasChanged();
    }

    public void Dispose() => this.document?.Dispose();
}
