@page "/visualstates"
@using Shiny.Blazor.Controls.Keyframe
@using Shiny.Controls.Keyframe

<PageTitle>Visual States</PageTitle>

<h1>Visual State Transitions</h1>

<p>
    Named states, each a look; transitions between them; and animations that run while a state is active.
    Interrupt a transition halfway and it carries on from what is on screen - the browser retargets from
    the computed value. No transitions at all means a state change snaps.
</p>

<section class="demo-section">
    <h2>A button with states</h2>
    <p>Hover, press, and toggle Busy. Pressing is quick and eases out; releasing springs back.</p>

    <VisualStates State="@ButtonState" Class="vs-button" data-testid="vs-button"
                  @onpointerenter="() => hover = true" @onpointerleave="() => { hover = false; pressed = false; }"
                  @onpointerdown="() => pressed = true" @onpointerup="() => pressed = false">
        <VisualState Name="Hover" Style="scale: 1.04; background-color: #4338CA" />
        <VisualState Name="Pressed" Style="scale: .96; opacity: .85; background-color: #3730A3" />
        <VisualState Name="Busy" Style="background-color: #64748B" />

        <VisualTransition To="Pressed" Duration="TimeSpan.FromMilliseconds(80)" Easing="CubicOut" />
        <VisualTransition From="Pressed" Duration="TimeSpan.FromMilliseconds(450)" Easing="spring(0.35, 12)" />
        <VisualTransition Duration="TimeSpan.FromMilliseconds(180)" />

        <StateAnimation State="Busy">
            <Keyframes Duration="TimeSpan.FromMilliseconds(900)" Iterations="Keyframes.Infinite" Direction="PlaybackDirection.Alternate">
                <Track Property="Opacity">
                    <Key Offset="0" Value="1" Easing="SinInOut" />
                    <Key Offset="1" Value="0.55" />
                </Track>
            </Keyframes>
        </StateAnimation>

        @(busy ? "Saving…" : "Save changes")
    </VisualStates>

    <label class="vs-toggle">
        <input type="checkbox" @bind="busy" data-testid="vs-busy" /> Busy
    </label>
    <div class="state" data-testid="vs-state">State: @(ButtonState ?? "(none)")</div>
</section>

<section class="demo-section">
    <h2>Cycling states</h2>
    <p>Three looks, one transition each way. Click quickly to interrupt: there is never a jump.</p>

    <VisualStates State="@cycle[cycleIndex]" Class="vs-shape" @onclick="() => cycleIndex = (cycleIndex + 1) % cycle.Length" data-testid="vs-shape">
        <VisualState Name="Square" Style="border-radius: 12px; rotate: 0deg; background-color: #0E7490" />
        <VisualState Name="Circle" Style="border-radius: 50%; rotate: 90deg; background-color: #7C3AED" />
        <VisualState Name="Pill" Style="border-radius: 40px; rotate: 180deg; scale: 1.3 .7; background-color: #B45309" />
        <VisualTransition Duration="TimeSpan.FromMilliseconds(700)" Easing="Emphasized" />
        @cycle[cycleIndex]
    </VisualStates>
</section>

<style>
    .vs-button { display: inline-flex; align-items: center; justify-content: center; min-width: 180px; padding: 14px 24px; border-radius: 12px; color: #fff; font-weight: 600; background-color: #4F46E5; cursor: pointer; user-select: none; }
    .vs-toggle { display: inline-flex; gap: 6px; margin-left: 16px; align-items: center; }
    .vs-shape { width: 96px; height: 96px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 13px; font-weight: 600; cursor: pointer; margin: 16px; user-select: none; }
</style>

@code {
    bool hover;
    bool pressed;
    bool busy;
    int cycleIndex;

    static readonly string[] cycle = ["Square", "Circle", "Pill"];

    string? ButtonState => busy ? "Busy" : pressed ? "Pressed" : hover ? "Hover" : null;
}
