@page "/slide-editor"
@using Shiny.Blazor.Controls.Office
@using Shiny.Controls.Office.Presentation
@using Shiny.Controls.Office.Skia
@implements IDisposable

<PageTitle>Slide Editor</PageTitle>

<h1>Slide Editor</h1>
<p class="lead">
    A <code>.pptx</code> editor dressed as PowerPoint. <code>SlideEditorView</code> wraps the bare
    <code>SlideEditor</code> surface in the Office shell: the red title bar (AutoSave, Save / Undo / Redo,
    From Beginning, the presentation name, the command search), PowerPoint's ribbon with Editing / Share
    at its right end, the status bar (slide counter, Notes, Normal / Slide Sorter / Reading View, zoom and
    fit) and the File backstage — New from a template, Save As, Export to PDF or pictures, Print.
</p>

<div class="toolbar">
    <label class="chk"><input type="checkbox" @bind="withShell" /> Office shell</label>
    <label class="chk"><input type="checkbox" @bind="withToolbar" /> Editor wrapper</label>
    <button class="btn" @onclick="ToggleTheme">@(dark ? "Follow page" : "Force dark")</button>
    <span class="status">@Status</span>
</div>

<div class="editor-host @(withShell && withToolbar ? "is-shell" : null)">
    @if (withToolbar)
    {
        <SlideEditorView Deck="deck"
                         ShowShell="withShell"
                         DocumentName="Shiny Office"
                         UserName="Allan Ritchie"
                         RecentFiles="recent"
                         DeckReplaced="d => deck = d"
                         @bind-SlideIndex="index"
                         Theme="@(dark ? SlideTheme.Dark : null)"
                         @bind-Zoom="zoom"
                         @bind-ViewMode="viewMode"
                         DeckChanged="OnChanged" />
    }
    else
    {
        <SlideEditor Deck="deck"
                     @bind-SlideIndex="index"
                     Theme="@(dark ? SlideTheme.Dark : null)"
                     DeckChanged="OnChanged" />
    }
</div>

<p class="hint">
    Click a shape to select it, then drag it or its handles to move and resize. Double-click (or press
    Enter) to put a caret inside its text; type, and Ctrl/Cmd+B, I, U format the selection. Tab and
    Shift+Tab change a bullet's outline level. Escape leaves the text, Delete removes the selected
    shape, and Ctrl/Cmd+Z undoes everything — including a whole drag, as one step.
    Shift/Ctrl-click or drag a box to select several; Ctrl+G groups them. Drag the round handle to
    rotate (Shift snaps to 15°). The Design, Transitions, Animations, Slide Show and View tabs carry
    themes, transitions, animations, presenter view, the outline, the sorter and the slide master;
    Ctrl+wheel zooms and F5 starts the show.
</p>

@code {
    SlideDeck? deck;
    bool withToolbar = true;
    bool withShell = true;

    /// <summary>The host keeps the recent list; the backstage shows it and raises the pick.</summary>
    readonly IReadOnlyList<Shiny.Controls.Office.Shell.OfficeRecentFile> recent =
    [
        new("Quarterly Review", "Documents", DateTimeOffset.Now.AddHours(-3)) { IsPinned = true },
        new("Product Launch", "Documents › Marketing", DateTimeOffset.Now.AddDays(-2))
    ];
    bool dark;
    int index;
    double? zoom;
    SlideEditorViewMode viewMode;
    int edits;

    string Status => this.deck is null
        ? "loading"
        : $"{this.deck.Slides.Count} slides · {this.viewMode} · {(this.zoom is { } z ? $"{Math.Round(z * 100)}%" : "fit")} · {this.edits} edits{(this.deck.IsDirty ? " · unsaved" : string.Empty)}";

    protected override async Task OnInitializedAsync()
    {
        var bytes = SampleOfficeDocuments.BuildDeck();
        this.deck = await SlideDeck.OpenAsync(new MemoryStream(bytes), editable: true);
    }

    void ToggleTheme() => this.dark = !this.dark;

    void OnChanged()
    {
        this.edits++;
        this.StateHasChanged();
    }

    public void Dispose() => this.deck?.Dispose();
}
