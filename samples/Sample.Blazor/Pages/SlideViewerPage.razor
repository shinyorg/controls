@page "/slide-viewer"
@using Shiny.Blazor.Controls.Office
@using Shiny.Controls.Office.Packaging
@using Shiny.Controls.Office.Presentation
@using Shiny.Controls.Office.Skia
@implements IDisposable

<PageTitle>Slide Viewer</PageTitle>

<h1>Slide Viewer</h1>
<p class="lead">
    A read-only <code>.pptx</code> viewer. Slides are fixed-size artboards, so the view scales rather
    than reflows — shapes and text keep the proportions they were authored at, at any size.
</p>

<div class="toolbar">
    <button class="btn" disabled="@(index <= 0)" @onclick="Previous">‹</button>
    <span class="counter">@(index + 1) / @(deck?.Slides.Count ?? 0)</span>
    <button class="btn" disabled="@(index >= (deck?.Slides.Count ?? 0) - 1)" @onclick="Next">›</button>
    <button class="btn" @onclick="ToggleMode">@(mode == SlideViewMode.Grid ? "Single" : "Grid")</button>
    <button class="btn" @onclick="ToggleTheme">@(dark ? "Follow page" : "Force dark")</button>
    <button class="btn" @onclick="PresentAsync">Present</button>
    <span class="status">@(deck is null ? "" : $"{deck.SlideWidth:0}×{deck.SlideHeight:0}")</span>
</div>

<div class="deck-host">
    <SlideView @ref="viewer"
               Deck="deck"
               @bind-SlideIndex="index"
               @bind-Mode="mode"
               @bind-IsPresenting="presenting"
               Theme="@(dark ? SlideTheme.Dark : null)" />
</div>

@if (Notes is { Length: > 0 })
{
    <div class="notes">
        <strong>Notes</strong>
        <p>@Notes</p>
    </div>
}

<p class="hint">
    Arrow keys, Page Up/Down and Space navigate; F5 presents the deck full screen and Escape leaves
    again; Escape otherwise toggles the thumbnail grid; clicking a thumbnail opens that slide. Charts, SmartArt and animations are preserved in the file but not drawn.
</p>

@code {
    SlideView? viewer;
    SlideDeck? deck;
    bool presenting;
    readonly UnsupportedFeatureCollector unsupported = new();
    int index;
    SlideViewMode mode = SlideViewMode.Single;
    bool dark;

    string? Notes => this.deck is null || this.index >= this.deck.Slides.Count
        ? null
        : this.deck.Slides[this.index].Notes;

    protected override async Task OnInitializedAsync()
    {
        var bytes = SampleOfficeDocuments.BuildDeck();
        this.deck = await SlideDeck.OpenAsync(new MemoryStream(bytes), this.unsupported);
    }

    // Driven through the two-way bound index rather than through view.Controller: @ref is only
    // populated after the first render, so a toolbar that reads it renders itself permanently
    // disabled and never re-renders to correct itself.
    void Next() => this.index = Math.Min(this.index + 1, (this.deck?.Slides.Count ?? 1) - 1);

    void Previous() => this.index = Math.Max(0, this.index - 1);

    void ToggleMode() => this.mode = this.mode == SlideViewMode.Grid ? SlideViewMode.Single : SlideViewMode.Grid;

    void ToggleTheme() => this.dark = !this.dark;

    // Through the component rather than by flipping the bound field: a browser only grants fullscreen
    // inside the gesture that asked for it, and a round trip through a parameter loses that gesture.
    // Setting `presenting` still works — it just falls back to the full-window surface.
    Task PresentAsync() => this.viewer?.StartPresentingAsync() ?? Task.CompletedTask;

    public void Dispose() => this.deck?.Dispose();
}
