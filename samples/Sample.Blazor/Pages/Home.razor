@page "/"

<PageTitle>Shiny Controls</PageTitle>

@* A slim banner rather than a full-bleed hero — the catalogue below is the point of the page. *@
<section class="hero">
    <span class="hero-logo-tile">
        <img src="css/shiny_logo.png" alt="" class="hero-logo" />
    </span>

    <div class="hero-text">
        <h1>Shiny Controls</h1>
        <p>One component library for .NET MAUI and Blazor — @Catalog.TotalControls live demos across @Catalog.Sections.Length categories.</p>
    </div>

    <div class="hero-actions">
        <a class="hero-btn hero-btn-primary" href="https://shinylib.net" target="_blank" rel="noopener">
            Documentation <span aria-hidden="true">↗</span>
        </a>
        <a class="hero-btn" href="https://github.com/shinyorg/controls" target="_blank" rel="noopener">
            GitHub <span aria-hidden="true">↗</span>
        </a>
        <a class="hero-btn" href="kitchensink">Kitchen Sink</a>
    </div>
</section>

@*
    Search sits directly above the catalogue rather than in the hero: it is a way of using the list
    below it, so it belongs with the list. Typing swaps the sectioned browse for a flat ranked grid —
    keeping the sections while filtering would leave a page of empty headings.
*@
<section class="catalog-search">
    <span class="catalog-search-icon" aria-hidden="true">⌕</span>

    <input class="catalog-search-input"
           type="search"
           placeholder="@($"Search {Catalog.TotalControls} controls — try \u201Cgrid\u201D, \u201Coffice\u201D, \u201Cpen\u201D")"
           aria-label="Search controls"
           @bind="query"
           @bind:event="oninput"
           @onkeydown="OnSearchKeyDown" />

    @if (query.Length > 0)
    {
        <button type="button" class="catalog-search-clear" @onclick="Clear" aria-label="Clear search">✕</button>
    }
</section>

@if (query.Length > 0)
{
    var hits = Catalog.Search(query);

    <section class="catalog-section">
        <h2 class="catalog-heading">
            <span class="catalog-swatch" style="background:#A78BFA;"></span>
            Results
            <span class="catalog-count">@hits.Count</span>
        </h2>

        @if (hits.Count == 0)
        {
            <p class="catalog-empty">Nothing matches “@query”.</p>
        }
        else
        {
            <div class="catalog-grid">
                @foreach (var hit in hits)
                {
                    <a class="catalog-card" href="@hit.Href" style="--accent:@hit.Color;">
                        <span class="catalog-icon">@hit.Icon</span>
                        <span class="catalog-name">@hit.Label</span>
                        <span class="catalog-blurb">@hit.Blurb</span>
                        <span class="catalog-section-tag">@hit.Section</span>
                    </a>
                }
            </div>
        }
    </section>
}
else
{
@foreach (var section in Catalog.Sections)
{
    <section class="catalog-section">
        <h2 class="catalog-heading">
            <span class="catalog-swatch" style="background:@section.Color;"></span>
            @section.Title
            <span class="catalog-count">@section.Items.Length</span>
        </h2>

        <div class="catalog-grid">
            @foreach (var item in section.Items)
            {
                <a class="catalog-card" href="@item.Href" style="--accent:@section.Color;">
                    <span class="catalog-icon">@item.Icon</span>
                    <span class="catalog-name">@item.Label</span>
                    <span class="catalog-blurb">@item.Blurb</span>
                </a>
            }
        </div>
    </section>
}
}

@code {
    string query = string.Empty;

    void Clear() => this.query = string.Empty;

    /// <summary>
    /// Enter opens the best match; Escape clears.
    /// </summary>
    /// <remarks>
    /// Enter is what anyone who has already typed enough to see the answer will press, and without it
    /// the search makes you take your hands off the keyboard to finish a job the keyboard started.
    /// </remarks>
    void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            this.Clear();
            return;
        }

        if (e.Key != "Enter")
            return;

        if (Catalog.Search(this.query) is [{ } first, ..])
            this.Nav.NavigateTo(first.Href);
    }

    [Inject] public NavigationManager Nav { get; set; } = null!;
}
