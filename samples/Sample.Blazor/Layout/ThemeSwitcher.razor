@namespace Sample.Blazor.Layout
@using Shiny.Blazor.Controls.Theming
@implements IDisposable
@inject IShinyThemeService Theme

@* The gallery's theme picker, over the library's own service. It used to inject a <link> into
   <head> per switch and hand a bool up to the layout for the dark class - which is exactly the
   hand-rolled arrangement IShinyThemeService exists to replace. *@

<div class="theme-switcher">
    <select aria-label="Theme" value="@(this.Theme.Pack ?? "")" @onchange="this.OnPackChangedAsync">
        <option value="">Basic</option>
        <option value="ocean">Ocean</option>
        <option value="material">Material</option>
        <option value="terminal">Terminal</option>
        <option value="aurora">Aurora</option>
    </select>
    <label class="theme-switcher-dark">
        <input type="checkbox" checked="@(this.Theme.Mode == ShinyThemeMode.Dark)" @onchange="this.OnDarkChangedAsync" />
        Dark
    </label>
</div>

@code {
    protected override void OnInitialized() => this.Theme.Changed += this.OnThemeChanged;

    Task OnPackChangedAsync(ChangeEventArgs e) => this.Theme.SetPackAsync(e.Value?.ToString());

    Task OnDarkChangedAsync(ChangeEventArgs e)
        => this.Theme.SetModeAsync((bool?)e.Value == true ? ShinyThemeMode.Dark : ShinyThemeMode.Light);

    void OnThemeChanged(object? sender, EventArgs e) => this.InvokeAsync(this.StateHasChanged);

    public void Dispose() => this.Theme.Changed -= this.OnThemeChanged;
}
