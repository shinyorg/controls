<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <RootNamespace>Sample.Blazor</RootNamespace>
        <!-- Fingerprints index.html's script/style references and fills its import map; see the note there. -->
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    </PropertyGroup>

    <!-- ProjectReference does not flow a package's buildTransitive targets, so the wasm-tools guard
         that ships in Shiny.Blazor.Controls.Office is imported by hand here — this sample publishes
         to GitHub Pages and a missing workload silently ships a broken Office demo. -->
    <Import Project="..\..\src\Shiny.Blazor.Controls.Office\buildTransitive\Shiny.Blazor.Controls.Office.targets" />
    <Import Project="..\..\src\Shiny.Blazor.Controls.FloorPlan\buildTransitive\Shiny.Blazor.Controls.FloorPlan.targets" />

    <ItemGroup>
        <PackageReference Include="AGUI.Client"/>
        <!-- "Your key": a real model in the browser, no server - AGUI.Server turns its stream into AG-UI events in-process -->
        <PackageReference Include="AGUI.Server"/>
        <PackageReference Include="Microsoft.Extensions.AI"/>
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI"/>
        <!-- AGUI.Server's JSON options reach AGUI.Abstractions' interrupt content types (InterruptResponseContent…)
             through the reflection resolver. Trimmed, their constructors lose their parameter names and every
             streamed update fails with NotSupportedException (ConstructorContainsNullParameterNames), which
             surfaces only as "An error occurred while streaming the agent response". Rooting keeps them whole. -->
        <TrimmerRootAssembly Include="AGUI.Abstractions" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls.SpeechAddins\Shiny.Blazor.Controls.SpeechAddins.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls\Shiny.Blazor.Controls.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls.Markdown\Shiny.Blazor.Controls.Markdown.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls.Agents\Shiny.Blazor.Controls.Agents.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls.MermaidDiagrams\Shiny.Blazor.Controls.MermaidDiagrams.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls.Barcodes\Shiny.Blazor.Controls.Barcodes.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls.Camera\Shiny.Blazor.Controls.Camera.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls.Camera.Ai\Shiny.Blazor.Controls.Camera.Ai.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls.MediaElement\Shiny.Blazor.Controls.MediaElement.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls.Office\Shiny.Blazor.Controls.Office.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls.FloorPlan\Shiny.Blazor.Controls.FloorPlan.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls.Diagram\Shiny.Blazor.Controls.Diagram.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls.Gamepad\Shiny.Blazor.Controls.Gamepad.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls.Themes.Ocean\Shiny.Blazor.Controls.Themes.Ocean.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls.Themes.Material\Shiny.Blazor.Controls.Themes.Material.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls.Themes.Terminal\Shiny.Blazor.Controls.Themes.Terminal.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls.Themes.Aurora\Shiny.Blazor.Controls.Themes.Aurora.csproj"/>
    </ItemGroup>
    <!--
        Ships the gallery's own page sources inside the app so each demo can show the code that makes
        it (see SampleSourceFiles.cs). The logical name keeps the folder for readability; look-up is by
        file name, which is unique across Pages\.
    -->
    <ItemGroup>
        <EmbeddedResource Include="Pages\**\*.razor;Pages\**\*.razor.css;Pages\**\*.cs"
                          LogicalName="SampleSource/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <!-- The scripted AG-UI agent the MAUI sample uses too, so both hosts demo the same conversations -->
        <Compile Include="..\Sample\Features\Agents\DemoAgentSession.cs" Link="Agents\DemoAgentSession.cs" />
        <Compile Include="..\Sample\Features\Agents\HttpAgentSession.cs" Link="Agents\HttpAgentSession.cs" />
        <Compile Include="..\Sample\Features\Agents\ReplayAgentSession.cs" Link="Agents\ReplayAgentSession.cs" />
        <Compile Include="..\Sample\Features\Agents\ChatClientAgentSession.cs" Link="Agents\ChatClientAgentSession.cs" />
        <!-- the "Recordings" source: AG-UI streams recorded off a real AGUI.Server endpoint -->
        <EmbeddedResource Include="..\..\tests\Shiny.Controls.AgentUI.Tests\Fixtures\agui\*.sse"
                          LogicalName="AgentRecordings/%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
