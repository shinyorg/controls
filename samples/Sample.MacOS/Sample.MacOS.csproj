<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- DevFlow's XAML source maps add every .xaml a second time without the item metadata MAUI's
             XAML source generator needs; on this head the untagged copy wins, nothing is generated,
             and InitializeComponent / every x:Name field goes missing. -->
        <DevFlowXamlSourceMapsEnabled>false</DevFlowXamlSourceMapsEnabled>
        <TargetFramework>$(BaseTargetFramework)-macos</TargetFramework>
        <OutputType>Exe</OutputType>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Sample.MacOS</RootNamespace>
        <AssemblyName>Sample.MacOS</AssemblyName>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>
        <ShinyMauiShell_GenerateNavExtensions>true</ShinyMauiShell_GenerateNavExtensions>

        <ApplicationTitle>Sample.MacOS</ApplicationTitle>
        <ApplicationId>org.shiny.controlsample.macos</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AGUI.Client"/>
        <!-- the agent page's "Your key" source: AGUI.Server in-process over an OpenAI-compatible IChatClient -->
        <PackageReference Include="AGUI.Server"/>
        <PackageReference Include="Microsoft.Extensions.AI"/>
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI"/>
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.Maui.Platforms.MacOS" />
        <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" />
        <!-- Packages required by source files linked from ..\Sample\ -->
        <PackageReference Include="Plugin.Maui.Audio" />
        <PackageReference Include="Shiny.Maui.Shell" />
        <PackageReference Include="Shiny.Speech" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <PackageReference Include="Microsoft.Maui.DevFlow.Agent" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls\Shiny.Maui.Controls.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Barcodes\Shiny.Maui.Controls.Barcodes.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Desktop\Shiny.Maui.Controls.Desktop.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Markdown\Shiny.Maui.Controls.Markdown.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Agents\Shiny.Maui.Controls.Agents.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.MermaidDiagrams\Shiny.Maui.Controls.MermaidDiagrams.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.MediaElement\Shiny.Maui.Controls.MediaElement.csproj" />
        <!-- the analyzers the Media Analysis page runs over a playing video -->
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Analysis.Ocr\Shiny.Maui.Controls.Analysis.Ocr.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Analysis.Barcode\Shiny.Maui.Controls.Analysis.Barcode.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Analysis.Face\Shiny.Maui.Controls.Analysis.Face.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Analysis.Motion\Shiny.Maui.Controls.Analysis.Motion.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Office\Shiny.Maui.Controls.Office.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.FloorPlan\Shiny.Maui.Controls.FloorPlan.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Keyframe\Shiny.Maui.Controls.Keyframe.csproj" />
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.SpeechAddins\Shiny.Maui.Controls.SpeechAddins.csproj" />
    </ItemGroup>

    <!--
        Share the pages, ViewModels, AppShell, and Resources from the main Sample head.
        Each file is linked so it shows up in IDE under its original path; LinkBase keeps the
        namespace structure when the C# tooling derives folders from file location.
    -->
    <ItemGroup>
        <Compile Include="..\Sample\**\*.cs"
                 Exclude="..\Sample\Platforms\**;..\Sample\MauiProgram.cs;..\Sample\MyCustomFeedbackService.cs;..\Sample\App.xaml.cs;..\Sample\AppShell.xaml.cs;..\Sample\Features\Chat\**;..\Sample\Features\Camera\**;..\Sample\Features\Diagram\**;..\Sample\Features\Gamepad\**;..\Sample\bin\**;..\Sample\obj\**"
                 Link="%(RecursiveDir)%(Filename)%(Extension)" />
        <MauiXaml Include="..\Sample\**\*.xaml"
                  Exclude="..\Sample\Platforms\**;..\Sample\App.xaml;..\Sample\AppShell.xaml;..\Sample\Features\Chat\**;..\Sample\Features\Camera\**;..\Sample\Features\Diagram\**;..\Sample\Features\Gamepad\**;..\Sample\bin\**;..\Sample\obj\**"
                  Link="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <!--
        The Microsoft.Maui.Platforms.MacOS workload currently only processes
        MauiIcon (generates the .icns). MauiImage / MauiFont / MauiAsset are
        ignored, so nothing else lands in Contents/Resources of the .app
        bundle. We emit BundleResource items manually with a flat LogicalName
        so MAUI's FileSystem / ImageSource.FromFile / font lookup all find
        the files via NSBundle.MainBundle.
    -->
    <ItemGroup>
        <BundleResource Include="..\Sample\Resources\Images\*.png"
                        Link="Resources\Images\%(Filename)%(Extension)">
            <LogicalName>%(Filename)%(Extension)</LogicalName>
        </BundleResource>
        <BundleResource Include="..\Sample\Resources\Fonts\*.ttf"
                        Link="Resources\Fonts\%(Filename)%(Extension)">
            <LogicalName>%(Filename)%(Extension)</LogicalName>
        </BundleResource>
        <!--
            Raw assets are addressed by filename via FileSystem.OpenAppPackageFile.
            dotnet_bot.png is excluded because the same filename is already pulled
            in from Resources/Images and would collide on LogicalName.
        -->
        <BundleResource Include="..\Sample\Resources\Raw\**\*"
                        Exclude="..\Sample\Resources\Raw\AboutAssets.txt;..\Sample\Resources\Raw\dotnet_bot.png"
                        Link="Resources\Raw\%(RecursiveDir)%(Filename)%(Extension)">
            <LogicalName>%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
        </BundleResource>
        <BundleResource Include="..\..\README.md">
            <LogicalName>README.md</LogicalName>
        </BundleResource>
        <!-- ShinyImage's resource:// demo on the Images page; must match the main head's LogicalName. -->
        <EmbeddedResource Include="..\Sample\Assets\embedded-icon.svg" LogicalName="Sample.Assets.embedded-icon.svg" />
        <!-- the agent page's "Recordings" source: the AGUI.Server streams the engine tests replay, linked not copied -->
        <EmbeddedResource Include="..\..\tests\Shiny.Controls.AgentUI.Tests\Fixtures\agui\*.sse" LogicalName="AgentRecordings/%(Filename)%(Extension)" Link="AgentRecordings\%(Filename)%(Extension)" />
    </ItemGroup>
    <!-- The gallery renders its own source under each demo page. -->
    <Import Project="..\Sample\Sample.Source.targets" />

	<ItemGroup>
		<!-- AGUI.Server's JSON options reach AGUI.Abstractions' interrupt content types by reflection; trimmed, their
		     constructors lose their parameter names and every "Your key" run fails with only
		     "An error occurred while streaming the agent response". Rooting keeps them whole. -->
		<TrimmerRootAssembly Include="AGUI.Abstractions" />
	</ItemGroup>

</Project>
