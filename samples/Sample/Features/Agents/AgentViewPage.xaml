<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             x:Class="Sample.Features.Agents.AgentViewPage"
             Title="Agent View"
             AutomationId="AgentViewPage">

    <!--
        The AgentView fills its row and owns the vertical scroll - nothing here wraps it in a
        ScrollView. The reading list beside it (below it on a phone) is bound to the conversation's
        shared state: ask the agent to "track my reading list" and watch it fill in.
    -->
    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">

        <!-- where the agent lives: the scripted demo (no key needed) or a live AG-UI endpoint -->
        <Grid Grid.ColumnSpan="2" Padding="12,8" ColumnSpacing="8" ColumnDefinitions="*,Auto,Auto,Auto">
            <Entry x:Name="EndpointEntry"
                   Placeholder="http://localhost:5299/agent"
                   Keyboard="Url"
                   AutomationId="AgentEndpointEntry"
                   SemanticProperties.Description="AG-UI endpoint URL" />
            <Button Grid.Column="1" Text="Connect" Clicked="OnConnect" AutomationId="AgentConnectButton" />
            <Button Grid.Column="2" Text="Demo" Clicked="OnDemo" AutomationId="AgentDemoButton" />
            <Button Grid.Column="3" Text="Clear" Clicked="OnClear" AutomationId="AgentClearButton" />
        </Grid>

        <shiny:AgentView x:Name="Agent"
                         Grid.Row="1"
                         ShowReasoning="Collapsed"
                         PlaceholderText="Ask the demo agent…"
                         AutomationId="SampleAgentView" />

        <!-- shared state panel: the side column on a wide window, the bottom row on a phone -->
        <Border x:Name="StatePanel"
                Grid.Row="1" Grid.Column="1"
                WidthRequest="260"
                Padding="14"
                Margin="0,0,12,12"
                StrokeShape="RoundRectangle 12"
                AutomationId="ReadingListPanel">
            <VerticalStackLayout Spacing="8">
                <Label Text="Reading list" FontAttributes="Bold" FontSize="16" />
                <Label x:Name="GoalLabel" FontSize="13" Text="Shared state - ask the agent to “track my reading list”." />
                <VerticalStackLayout x:Name="BooksStack" Spacing="4" />
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
