<?xml version="1.0" encoding="utf-8" ?>
<shiny:ShinyTabbedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:shiny="http://shiny.net/maui/controls"
                       xmlns:local="clr-namespace:Sample.Features.Tabs"
                       x:Class="Sample.Features.Tabs.TabsDemoPage"
                       x:DataType="local:TabsDemoViewModel"
                       Title="Tabs"
                       AutomationId="TabsDemoPage"
                       Transition="Slide"
                       TransitionDuration="220"
                       IndicatorStyle="Pill">

    <shiny:ShinyTabbedPage.Resources>
        <!-- A custom tab header: the bar's own animated icon beside a label that only turns bold
             when selected, plus a count drawn by the template itself. -->
        <DataTemplate x:Key="CustomTabHeader" x:DataType="shiny:TabHeaderContext">
            <Border Padding="10,4" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#1A6750A4, Dark=#33D0BCFF}" />
                    </DataTrigger>
                </Border.Triggers>
                <HorizontalStackLayout Spacing="6">
                    <ContentView Content="{Binding Icon}" VerticalOptions="Center" />
                    <Label Text="{Binding Title}" FontSize="12" VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="FontAttributes" Value="Bold" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsLabelVisible}" Value="False">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="{Binding Badge}" IsVisible="{Binding HasBadge}" FontSize="11"
                           TextColor="White" BackgroundColor="#B3261E" Padding="5,0" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </DataTemplate>
    </shiny:ShinyTabbedPage.Resources>

    <!-- The raised button in the middle. Mode="Menu" presents whatever the page that is showing
         declared via shiny:ShinyTabs.Actions / MenuContent — see the tabs below. -->
    <shiny:ShinyTabbedPage.CenterButton>
        <shiny:TabCenterButton Icon="plus" Mode="Menu" Size="60" />
    </shiny:ShinyTabbedPage.CenterButton>

    <!-- Tab 1 — inline content, built with the markup. -->
    <shiny:ShinyTabItem Title="Home" Icon="home" Route="home">
        <ScrollView x:Name="HomeScroller" shiny:ShinyTabs.HideOnScroll="True">
            <VerticalStackLayout Padding="24" Spacing="14">
                <Label Text="An improved TabbedPage" FontSize="22" FontAttributes="Bold" />
                <Label FontSize="14" TextColor="Gray"
                       Text="Animated icons, a per-tab badge, a transition between tabs, a raised centre button that presents the current page's actions — and the same bar drops onto a Shell." />

                <BoxView HeightRequest="1" Color="LightGray" />

                <Label Text="Transition" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Slide" Clicked="OnSlide" AutomationId="TransitionSlide" />
                    <Button Text="Fade" Clicked="OnFade" AutomationId="TransitionFade" />
                    <Button Text="Scale" Clicked="OnScale" AutomationId="TransitionScale" />
                </HorizontalStackLayout>

                <Label Text="Indicator" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Pill" Clicked="OnPill" AutomationId="IndicatorPill" />
                    <Button Text="Line" Clicked="OnLine" AutomationId="IndicatorLine" />
                    <Button Text="Dot" Clicked="OnDot" AutomationId="IndicatorDot" />
                    <Button Text="None" Clicked="OnNoIndicator" AutomationId="IndicatorNone" />
                </HorizontalStackLayout>

                <Label Text="Bar style" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Docked" Clicked="OnBarDocked" AutomationId="BarDocked" />
                    <Button Text="Floating" Clicked="OnBarFloating" AutomationId="BarFloating" />
                </HorizontalStackLayout>

                <Label Text="Hide the bar" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Hide" Clicked="OnHideBar" AutomationId="BarHide" />
                    <Button Text="Show" Clicked="OnShowBar" AutomationId="BarShow" />
                    <Button Text="Slide" Clicked="OnHideSlide" AutomationId="BarHideSlide" />
                    <Button Text="Fade" Clicked="OnHideFade" AutomationId="BarHideFade" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <Switch x:Name="HideOnScrollSwitch" IsToggled="True" Toggled="OnHideOnScrollToggled" AutomationId="BarHideOnScroll" VerticalOptions="Center" />
                    <Label Text="Hide while scrolling down" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label FontSize="12" TextColor="Gray"
                       Text="TabBarIsVisible slides the bar away and back, and the content takes its space while it is gone. shiny:ShinyTabs.HideOnScroll on this page's ScrollView hides it as you scroll down and brings it back as you scroll up, reach the top, or change tabs. It never overrides a bar you hid on purpose." />

                <Label Text="Bar transparency" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Solid" Clicked="OnBarSolid" AutomationId="BarSolid" />
                    <Button Text="60%" Clicked="OnBarTranslucent" AutomationId="BarTranslucent" />
                    <Button Text="35%" Clicked="OnBarSheer" AutomationId="BarSheer" />
                </HorizontalStackLayout>
                <Label FontSize="12" TextColor="Gray"
                       Text="BarBackgroundOpacity fades the background only — the icons, labels and badges stay fully opaque. The sheerest setting turns ContentBehindTabBar on too, so there is something to see through it." />

                <Label Text="Bar material" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Painted" Clicked="OnMaterialSolid" AutomationId="MaterialSolid" />
                    <Button Text="Glass" Clicked="OnMaterialGlass" AutomationId="MaterialGlass" />
                    <Button Text="Clear" Clicked="OnMaterialGlassClear" AutomationId="MaterialGlassClear" />
                    <Button Text="Tinted" Clicked="OnMaterialGlassTinted" AutomationId="MaterialGlassTinted" />
                </HorizontalStackLayout>
                <Label FontSize="12" TextColor="Gray"
                       Text="Real Apple Liquid Glass, and iOS 26 only — everywhere else the bar keeps painting its fill, which is why nothing changes here on Android, Windows or an older iOS. Where it does apply it takes over the background entirely, drops the shadow, and lets the content run underneath." />

                <Label Text="Indicator motion" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Slide" Clicked="OnIndicatorSlide" AutomationId="IndicatorSlide" />
                    <Button Text="No travel" Clicked="OnIndicatorStatic" AutomationId="IndicatorStatic" />
                    <Button Text="Slow" Clicked="OnSlowIndicator" AutomationId="IndicatorSlow" />
                </HorizontalStackLayout>

                <Label Text="Labels" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Always" Clicked="OnLabelsAlways" AutomationId="LabelsAlways" />
                    <Button Text="Selected only" Clicked="OnLabelsSelected" AutomationId="LabelsSelected" />
                    <Button Text="Never" Clicked="OnLabelsNever" AutomationId="LabelsNever" />
                </HorizontalStackLayout>

                <Label Text="Label position" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Below" Clicked="OnLabelBottom" AutomationId="LabelBottom" />
                    <Button Text="Above" Clicked="OnLabelTop" AutomationId="LabelTop" />
                    <Button Text="Start" Clicked="OnLabelStart" AutomationId="LabelStart" />
                    <Button Text="End" Clicked="OnLabelEnd" AutomationId="LabelEnd" />
                </HorizontalStackLayout>
                <Label FontSize="12" TextColor="Gray"
                       Text="LabelPosition on the page (or ShinyTabBar) sets every tab; ShinyTabItem.LabelPosition overrides one tab, and Hidden makes a single tab icon-only." />

                <Label Text="Header template" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Default" Clicked="OnHeaderDefault" AutomationId="HeaderDefault" />
                    <Button Text="Custom" Clicked="OnHeaderCustom" AutomationId="HeaderCustom" />
                </HorizontalStackLayout>
                <Label FontSize="12" TextColor="Gray"
                       Text="TabTemplate replaces what is drawn inside each tab. Its BindingContext is a TabHeaderContext; the bar still owns the tap, selection and overflow." />

                <Label Text="Tab animation" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Scale" Clicked="OnAnimScale" AutomationId="AnimScale" />
                    <Button Text="Lift" Clicked="OnAnimLift" AutomationId="AnimLift" />
                    <Button Text="Bounce" Clicked="OnAnimBounce" AutomationId="AnimBounce" />
                    <Button Text="Custom" Clicked="OnAnimCustom" AutomationId="AnimCustom" />
                </HorizontalStackLayout>

                <Label Text="Badges" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Add to Chat" Clicked="OnAddBadge" AutomationId="AddBadge" />
                    <Button Text="Clear" Clicked="OnClearBadge" AutomationId="ClearBadge" />
                </HorizontalStackLayout>

                <Label Text="{Binding Status}" AutomationId="TabsStatus" FontSize="13" TextColor="Gray" Margin="0,4,0,80" />
            </VerticalStackLayout>
        </ScrollView>
    </shiny:ShinyTabItem>

    <!-- Tab 2 — a badge the tab owns, so it shows before the tab has ever been opened. -->
    <shiny:ShinyTabItem Title="Chat" Icon="message" Route="chat" Badge="3">
        <shiny:ShinyTabItem.ContentTemplate>
            <DataTemplate>
                <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
                    <shiny:MotionIconView Icon="message" Trigger="Loop" Interval="0:0:2"
                                          WidthRequest="48" HeightRequest="48"
                                          HorizontalOptions="Center" />
                    <Label Text="Built on first selection" FontSize="18" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label FontSize="14" TextColor="Gray" HorizontalTextAlignment="Center"
                           Text="This tab is a ContentTemplate, so nothing here existed until you tapped it — and it is kept afterwards." />
                </VerticalStackLayout>
            </DataTemplate>
        </shiny:ShinyTabItem.ContentTemplate>
    </shiny:ShinyTabItem>

    <!-- Tab 3 — a whole ContentPage in the template. The page's BindingContext and ShinyTabs
         attached values come across when it is adopted; see TabsInboxPage. Title is set here as
         well as on the page, because the page does not exist until this tab is first selected —
         without it the tab would sit there unlabelled until you tapped it. -->
    <shiny:ShinyTabItem Title="Inbox" Icon="mail" Route="inbox">
        <shiny:ShinyTabItem.ContentTemplate>
            <DataTemplate>
                <local:TabsInboxPage />
            </DataTemplate>
        </shiny:ShinyTabItem.ContentTemplate>
    </shiny:ShinyTabItem>

    <!-- Tab 4 — its own centre-menu content instead of a list of actions. -->
    <shiny:ShinyTabItem Title="Search" Icon="search" Route="search">
        <shiny:ShinyTabItem.ContentTemplate>
            <DataTemplate>
                <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
                    <shiny:ShinyTabs.MenuContent>
                        <VerticalStackLayout Padding="20" Spacing="10" WidthRequest="260">
                            <Label Text="Saved searches" FontAttributes="Bold" />
                            <Label Text="Unread this week" FontSize="14" TextColor="Gray" />
                            <Label Text="From my team" FontSize="14" TextColor="Gray" />
                            <Label Text="Attachments only" FontSize="14" TextColor="Gray" />
                        </VerticalStackLayout>
                    </shiny:ShinyTabs.MenuContent>

                    <Label Text="Custom centre-button content" FontSize="18" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label FontSize="14" TextColor="Gray" HorizontalTextAlignment="Center"
                           Text="Tap the centre button: this tab hands the bar a whole view instead of a list of actions." />
                </VerticalStackLayout>
            </DataTemplate>
        </shiny:ShinyTabItem.ContentTemplate>
    </shiny:ShinyTabItem>

    <!-- Tab 5 — an odd tab count, so the centre button's spacer column is exercised. -->
    <shiny:ShinyTabItem Title="Me" Icon="user" Route="me">
        <shiny:ShinyTabItem.ContentTemplate>
            <DataTemplate>
                <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
                    <shiny:MotionIconView Icon="user" Trigger="Appear"
                                          WidthRequest="48" HeightRequest="48"
                                          HorizontalOptions="Center" />
                    <Label Text="Five tabs, one centre button" FontSize="18" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label FontSize="14" TextColor="Gray" HorizontalTextAlignment="Center"
                           Text="An odd tab count splits unevenly, so the bar pads the short side with an empty column and the centre button stays centred." />
                </VerticalStackLayout>
            </DataTemplate>
        </shiny:ShinyTabItem.ContentTemplate>
    </shiny:ShinyTabItem>

</shiny:ShinyTabbedPage>
