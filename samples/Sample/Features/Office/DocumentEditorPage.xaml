<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:office="clr-namespace:Shiny.Maui.Controls.Office;assembly=Shiny.Maui.Controls.Office"
             x:Class="Sample.Features.Office.DocumentEditorPage"
             Title="Document Editor">

    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="8">

        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Button Text="Toolbar" Clicked="OnToggleToolbar" />
            <Button Text="Theme" Clicked="OnToggleTheme" />
            <Button x:Name="SpellButton" Clicked="OnToggleSpelling" />
            <Button x:Name="MarginButton" Clicked="OnCycleMargins" />
            <Button Text="Read Mode" Clicked="OnReadMode" />
            <Button Text="Navigation" Clicked="OnNavigation" />
        </HorizontalStackLayout>

        <Border Grid.Row="1" StrokeThickness="1">
            <office:DocumentEditorView x:Name="Editor" />
        </Border>

        <VerticalStackLayout Grid.Row="2" Spacing="2">
            <!-- A stand-in status bar: DocumentEditorView.Statistics and StatisticsChanged are what a
                 real one binds to. -->
            <Label x:Name="StatisticsLabel" FontSize="12" />
            <Label x:Name="StatusLabel"
                   FontSize="12"
                   Opacity="0.7"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
