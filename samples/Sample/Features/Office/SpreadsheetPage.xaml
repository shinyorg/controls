<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:office="clr-namespace:Shiny.Maui.Controls.Office;assembly=Shiny.Maui.Controls.Office"
             x:Class="Sample.Features.Office.SpreadsheetPage"
             Title="Spreadsheet">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="12" RowSpacing="8">

        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Button Text="Add row" Clicked="OnAddRow" />
            <Button Text="Undo" Clicked="OnUndo" />
            <Button Text="Redo" Clicked="OnRedo" />
            <Button Text="Theme" Clicked="OnToggleTheme" />
        </HorizontalStackLayout>

        <!-- A read-only formula bar: it shows the formula behind the active cell, not its result. -->
        <Border Grid.Row="1" Padding="8,6" StrokeThickness="1">
            <Label x:Name="FormulaBar" FontFamily="Monospace" FontSize="13" LineBreakMode="TailTruncation" />
        </Border>

        <Border Grid.Row="2" StrokeThickness="1">
            <office:SpreadsheetView x:Name="Sheet" ShowToolbar="True" CellChanged="OnCellChanged" />
        </Border>

        <!-- A status bar in the app's own chrome: the view reports the selection's statistics and its
             zoom, and the app decides where to show them - as Excel's own status bar does. -->
        <VerticalStackLayout Grid.Row="3" Spacing="2">
            <Label x:Name="StatusBar" FontSize="12" />
            <Label FontSize="12"
                   Opacity="0.7"
                   Text="The ribbon is Excel's: Home (merge, borders, conditional formatting, tables, cell styles, sort and filter, fill), Insert (tables, charts, links, notes), Formulas (function library, name manager), Data, Review and View (gridlines, headings, zoom, freeze panes). Right-click or long-press for the context menu; pinch to zoom; drag the selection corner to fill." />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
