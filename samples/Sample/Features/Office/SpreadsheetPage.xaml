<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:office="clr-namespace:Shiny.Maui.Controls.Office;assembly=Shiny.Maui.Controls.Office"
             x:Class="Sample.Features.Office.SpreadsheetPage"
             Title="Spreadsheet">

    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="8">

        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Button Text="Add row" Clicked="OnAddRow" />
            <Button Text="Theme" Clicked="OnToggleTheme" />
            <Button Text="Shell on/off" Clicked="OnToggleShell" />
        </HorizontalStackLayout>

        <!--
            The control is Excel's whole window: the green title bar (AutoSave, Save/Undo/Redo, the name,
            command search), the ribbon with File -> backstage and Comments / Editing / Share at its end,
            the formula bar, the grid, the sheet tabs, and the status bar (Ready/Edit, Average/Count/Sum,
            Normal / Page Layout / Page Break Preview and a zoom slider bound to Zoom).
        -->
        <Border Grid.Row="1" StrokeThickness="1">
            <office:SpreadsheetView x:Name="Sheet"
                                    DocumentName="Budget"
                                    UserName="Allan Ritchie"
                                    FileRequested="OnFileRequested"
                                    CellChanged="OnCellChanged" />
        </Border>

        <Label Grid.Row="2"
               x:Name="LastFile"
               FontSize="12"
               Opacity="0.7"
               Text="File ▸ Save, Save As, Export (xlsx, CSV, PDF) and Print write into the app's cache folder here; the path shows on this line." />
    </Grid>
</ContentPage>
