<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sample.Features.Transitions.PageTransitionsPage"
             Title="Page Transitions"
             AutomationId="PageTransitionsPage">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="Page transitions" FontSize="22" FontAttributes="Bold" />
            <Label FontSize="14" TextColor="Gray"
                   Text="Set PageTransition.Push on a page and that is how it arrives; it leaves the same way in reverse unless PageTransition.Pop says otherwise. Navigation itself is untouched - PushAsync, PushModalAsync, GoToAsync and anything built on them pick it up from the page." />

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="Comes in from" FontAttributes="Bold" />
            <Picker x:Name="DirectionPicker" AutomationId="TransitionDirection" Title="Direction" />

            <HorizontalStackLayout Spacing="10">
                <Switch x:Name="ModalSwitch" AutomationId="TransitionModal" VerticalOptions="Center" />
                <Label Text="Present modally" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Push with" FontAttributes="Bold" />
            <FlexLayout x:Name="TransitionButtons" Wrap="Wrap" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="Per call" FontAttributes="Bold" />
            <Label FontSize="13" TextColor="Gray"
                   Text="The PushAsync / PopAsync / PushModalAsync / PopModalAsync / GoToAsync overloads take a transition (or a custom IPageTransitionAnimator) for that one navigation, ahead of anything the page sets. The pages pushed here set nothing themselves." />
            <FlexLayout Wrap="Wrap">
                <Button Text="PushAsync(page, SharedAxisZ)" AutomationId="PerCallSharedAxisZ" Clicked="OnPerCallSharedAxisZ" Margin="0,0,8,8" Padding="14,6" />
                <Button Text="PushAsync(page, Cover, FromBottom)" AutomationId="PerCallCover" Clicked="OnPerCallCover" Margin="0,0,8,8" Padding="14,6" />
                <Button Text="PushModalAsync(page, Zoom)" AutomationId="PerCallModal" Clicked="OnPerCallModal" Margin="0,0,8,8" Padding="14,6" />
                <Button Text="GoToAsync(route, FadeThrough)" AutomationId="PerCallGoTo" Clicked="OnPerCallGoTo" Margin="0,0,8,8" Padding="14,6" />
            </FlexLayout>

            <Label Text="Custom animator" FontAttributes="Bold" />
            <Label FontSize="13" TextColor="Gray"
                   Text="IPageTransitionAnimator animates the two pages however it likes: here the page swings in from a tilt while the one underneath recedes. Set it per call, on a page (PageTransition.Animator) or app-wide (DefaultAnimator)." />
            <FlexLayout Wrap="Wrap">
                <Button Text="PushAsync(page, swing)" AutomationId="CustomAnimatorPush" Clicked="OnCustomAnimatorPush" Margin="0,0,8,8" Padding="14,6" />
                <Button Text="Page with PageTransition.Animator" AutomationId="CustomAnimatorPage" Clicked="OnCustomAnimatorPage" Margin="0,0,8,8" Padding="14,6" />
                <Button Text="PushAsync(page, Keyframes drop)" AutomationId="KeyframeAnimatorPush" Clicked="OnKeyframeAnimatorPush" Margin="0,0,8,8" Padding="14,6" />
            </FlexLayout>

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="Hero" FontAttributes="Bold" />
            <Label FontSize="13" TextColor="Gray"
                   Text="Each card and the header on its detail page share a PageTransition.Hero name, so the card flies into place while the pages crossfade. The detail page's content cascades in with PageTransition.Entrance." />
            <HorizontalStackLayout x:Name="HeroCards" Spacing="12" />

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="In a NavigationPage" FontAttributes="Bold" />
            <Button Text="Open a ShinyNavigationPage" AutomationId="OpenTransitionNav" Clicked="OnOpenNavigationPage" />

            <Label FontSize="12" TextColor="Gray"
                   Text="Swipe back from anywhere on iOS (this sample turns on full-screen swipe-back); on Android 14+ the back gesture previews the page underneath. Shell tabs (the Data Grid section, for one) switch with SharedAxisX." />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
