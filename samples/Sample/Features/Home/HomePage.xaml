<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Sample.Features.Home"
             xmlns:sample="clr-namespace:Sample"
             xmlns:shiny="http://shiny.net/maui/controls"
             x:Class="Sample.Features.Home.HomePage"
             x:DataType="local:HomeViewModel"
             Title="Home"
             AutomationId="HomePage">

    <Grid BackgroundColor="{AppThemeBinding Light=#F5F3FF, Dark=#0F0D1A}">
        <!-- Gradient background -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{AppThemeBinding Light=#EDE9FE, Dark=#1E1B4B}" Offset="0.0" />
                    <GradientStop Color="{AppThemeBinding Light=#F5F3FF, Dark=#0F0D1A}" Offset="0.5" />
                    <GradientStop Color="{AppThemeBinding Light=#DBEAFE, Dark=#172554}" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Decorative circles -->
        <BoxView CornerRadius="120"
                 WidthRequest="240" HeightRequest="240"
                 Color="{AppThemeBinding Light=#7C3AED, Dark=#6D28D9}" Opacity="0.06"
                 HorizontalOptions="End" VerticalOptions="Start"
                 Margin="0,-60,-80,0" />
        <BoxView CornerRadius="80"
                 WidthRequest="160" HeightRequest="160"
                 Color="{AppThemeBinding Light=#4F46E5, Dark=#4338CA}" Opacity="0.05"
                 HorizontalOptions="Start" VerticalOptions="End"
                 Margin="-40,0,0,-40" />

        <!-- Content -->
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="32,40">

                <!-- Logo with glow -->
                <Border StrokeThickness="0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        WidthRequest="120" HeightRequest="120">
                    <Border.Shadow>
                        <Shadow Brush="#8B5CF6"
                                Offset="0,6"
                                Radius="30"
                                Opacity="0.5" />
                    </Border.Shadow>
                    <Image Source="shiny_logo.png"
                           HeightRequest="120"
                           WidthRequest="120" />
                </Border>

                <!-- Title -->
                <Label Text="Shiny Controls"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1E1B4B, Dark=#E0E7FF}"
                       HorizontalTextAlignment="Center">
                    <Label.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#7C3AED, Dark=#000000}"
                                Offset="0,2"
                                Radius="12"
                                Opacity="0.15" />
                    </Label.Shadow>
                </Label>

                <!-- Accent line -->
                <Border BackgroundColor="{AppThemeBinding Light=#7C3AED, Dark=#6D28D9}"
                        Opacity="0.4"
                        StrokeThickness="0"
                        HeightRequest="2"
                        WidthRequest="80"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="1" />
                    </Border.StrokeShape>
                </Border>

                <!-- Subtitle -->
                <Label Text="MAUI &amp; Blazor Component Gallery"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A78BFA}"
                       HorizontalTextAlignment="Center"
                       CharacterSpacing="0.5" />

                <!-- Description -->
                <Label FontSize="13"
                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                       HorizontalTextAlignment="Center"
                       Margin="0,8,0,0">
                    <Label.Text>
                        <MultiBinding StringFormat="{}{0} live demos across {1} categories — browse below or use the menu.">
                            <Binding Path="TotalControls" />
                            <Binding Path="TotalSections" />
                        </MultiBinding>
                    </Label.Text>
                </Label>

                <!-- Theme switcher (demo of the central theme packs) -->
                <Border Margin="0,20,0,0"
                        Padding="18"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1B4B}"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Live theme preview"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#1E1B4B, Dark=#E0E7FF}" />

                        <!-- Semantic pills + a primary FAB react to the theme picked in the menu -->
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                            <shiny:PillView Type="Success" Text="Success" />
                            <shiny:PillView Type="Info" Text="Info" />
                            <shiny:PillView Type="Warning" Text="Warning" />
                            <shiny:PillView Type="Critical" Text="Critical" />
                        </HorizontalStackLayout>

                        <shiny:Fab Text="Primary"
                                   HasShadow="False"
                                   HorizontalOptions="Center" />

                        <Label Text="Switch Basic / Ocean / Material / Terminal / Aurora &amp; dark mode from the flyout menu."
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                    </VerticalStackLayout>
                </Border>

                <!--
                    Search sits directly above the catalogue, because it is a way of using the list
                    rather than part of the banner. Typing swaps the sectioned browse for a flat
                    ranked list — filtering the sections would leave a page of empty headings.
                -->
                <Border Margin="0,32,0,0"
                        Padding="4,0"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#20000000, Dark=#28FFFFFF}"
                        BackgroundColor="{AppThemeBinding Light=#CCFFFFFF, Dark=#AA1E1B4B}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">
                        <SearchBar Text="{Binding Query}"
                                   Placeholder="Search controls — try &quot;grid&quot;, &quot;office&quot;, &quot;pen&quot;"
                                   AutomationId="CatalogSearch"
                                   CancelButtonColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                   TextColor="{AppThemeBinding Light=#1E1B4B, Dark=#E0E7FF}"
                                   PlaceholderColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />

                        <Button Grid.Column="1"
                                Text="✕"
                                Padding="10,0"
                                FontSize="14"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                                IsVisible="{Binding IsSearching}"
                                AutomationId="CatalogSearchClear"
                                Command="{Binding ClearSearchCommand}" />
                    </Grid>
                </Border>

                <!-- Results: one flat, ranked list while a query is in the box -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsSearching}">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Border BackgroundColor="#A78BFA"
                                StrokeThickness="0"
                                WidthRequest="4"
                                HeightRequest="18"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="2" />
                            </Border.StrokeShape>
                        </Border>

                        <Label Text="Results"
                               FontSize="17"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#1E1B4B, Dark=#E0E7FF}" />

                        <Border Padding="7,1"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light=#10000000, Dark=#14FFFFFF}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="9" />
                            </Border.StrokeShape>
                            <Label Text="{Binding ResultCount}"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                        </Border>
                    </HorizontalStackLayout>

                    <Label Text="{Binding Query, StringFormat='Nothing matches “{0}”.'}"
                           FontSize="13"
                           IsVisible="{Binding HasNoResults}"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />

                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start"
                                AlignItems="Start"
                                BindableLayout.ItemsSource="{Binding Results}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="sample:CatalogHit">
                                <Border Margin="0,0,10,10"
                                        Padding="14"
                                        WidthRequest="164"
                                        HeightRequest="140"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#12000000, Dark=#1AFFFFFF}"
                                        BackgroundColor="{AppThemeBinding Light=#CCFFFFFF, Dark=#AA1E1B4B}"
                                        AutomationId="{Binding Route}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type local:HomeViewModel}}, Path=NavigateCommand}"
                                            CommandParameter="{Binding Route}" />
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Icon}"
                                               FontSize="22"
                                               TextColor="{Binding AccentColor}" />

                                        <Label Text="{Binding Label}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#1E1B4B, Dark=#E0E7FF}" />

                                        <Label Text="{Binding Blurb}"
                                               FontSize="11"
                                               MaxLines="2"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />

                                        <!-- Which group it came from: the sectioned browse says that by
                                             position, a flat result list has to say it outright. -->
                                        <Label Text="{Binding Section}"
                                               FontSize="10"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation"
                                               Opacity="0.6"
                                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Catalogue: the same sectioned, colour-coded browse grid as the Blazor sample -->
                <VerticalStackLayout Spacing="28"
                                     Margin="0,8,0,0"
                                     IsVisible="{Binding IsBrowsing}"
                                     BindableLayout.ItemsSource="{Binding Sections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="sample:CatalogSection">
                            <VerticalStackLayout Spacing="12">

                                <!-- Section heading: swatch, title, count -->
                                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                    <Border BackgroundColor="{Binding AccentColor}"
                                            StrokeThickness="0"
                                            WidthRequest="4"
                                            HeightRequest="18"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="2" />
                                        </Border.StrokeShape>
                                    </Border>

                                    <Label Text="{Binding Title}"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#1E1B4B, Dark=#E0E7FF}" />

                                    <Border Padding="7,1"
                                            StrokeThickness="0"
                                            VerticalOptions="Center"
                                            BackgroundColor="{AppThemeBinding Light=#10000000, Dark=#14FFFFFF}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Items.Length}"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                    </Border>
                                </HorizontalStackLayout>

                                <!-- Cards. FlexLayout has no Spacing, so the gap is the cards' own margin. -->
                                <FlexLayout Wrap="Wrap"
                                            Direction="Row"
                                            JustifyContent="Start"
                                            AlignItems="Start"
                                            BindableLayout.ItemsSource="{Binding Items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="sample:CatalogItem">
                                            <Border Margin="0,0,10,10"
                                                    Padding="14"
                                                    WidthRequest="164"
                                                    HeightRequest="126"
                                                    StrokeThickness="1"
                                                    Stroke="{AppThemeBinding Light=#12000000, Dark=#1AFFFFFF}"
                                                    BackgroundColor="{AppThemeBinding Light=#CCFFFFFF, Dark=#AA1E1B4B}"
                                                    AutomationId="{Binding Route}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="14" />
                                                </Border.StrokeShape>

                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:HomeViewModel}}, Path=NavigateCommand}"
                                                        CommandParameter="{Binding Route}" />
                                                </Border.GestureRecognizers>

                                                <VerticalStackLayout Spacing="6">
                                                    <Label Text="{Binding Icon}"
                                                           FontSize="22"
                                                           TextColor="{Binding Source={RelativeSource AncestorType={x:Type sample:CatalogSection}}, Path=AccentColor}" />

                                                    <Label Text="{Binding Label}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#1E1B4B, Dark=#E0E7FF}" />

                                                    <Label Text="{Binding Blurb}"
                                                           FontSize="11"
                                                           MaxLines="3"
                                                           LineBreakMode="TailTruncation"
                                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
