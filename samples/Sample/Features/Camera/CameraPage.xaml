<?xml version="1.0" encoding="utf-8" ?>
<shiny:ShinyContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:cam="http://shiny.net/maui/camera"
                        xmlns:shiny="http://shiny.net/maui/controls"
                        x:Class="Sample.Features.Camera.CameraPage"
                        x:Name="Page"
                        Title="Camera"
                        AutomationId="CameraPage">

    <shiny:ShinyContentPage.PageContent>
        <Grid>
            <!-- A single analyzer runs at a time. The "Detector" picker in the options sheet swaps
                 Camera.Analyzer live (see code-behind); the analyzer instances are built there so their
                 OnDetected handlers stay wired across swaps. The BoxesSwitch toggles the active analyzer's
                 ShowBoundingBox; the ScanAreaSwitch sets a center-band ScanWindow on the barcode analyzer. -->
            <cam:CameraView x:Name="Camera"
                            Facing="Back"
                            ScaleMode="AspectFill"
                            IsPinchToZoomEnabled="True" />

            <!-- bounding-box overlay + scan-window reticle (auto-binds to the camera's analyzer) -->
            <cam:CameraOverlayView Camera="{x:Reference Camera}" InputTransparent="True" />

            <!-- last captured photo (confirms the filter is applied to stills); tap to resume after a capture+stop -->
            <Image x:Name="PhotoThumbnail"
                   WidthRequest="90"
                   HeightRequest="120"
                   Aspect="AspectFill"
                   Margin="16"
                   HorizontalOptions="End"
                   VerticalOptions="Start"
                   IsVisible="False">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnThumbnailTapped" />
                </Image.GestureRecognizers>
            </Image>

            <!-- status / errors -->
            <Label x:Name="StatusLabel"
                   Margin="16"
                   VerticalOptions="Start"
                   HorizontalOptions="Center"
                   TextColor="White"
                   BackgroundColor="#80000000"
                   Padding="10,4"
                   IsVisible="False" />

            <!-- on-screen camera controls; everything else lives in the Options sheet -->
            <VerticalStackLayout VerticalOptions="End"
                                 Padding="16"
                                 Spacing="10"
                                 BackgroundColor="#66000000">

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Label Text="Zoom" TextColor="White" VerticalOptions="Center" />
                    <Slider WidthRequest="220"
                            Minimum="{Binding MinZoom, Source={x:Reference Camera}}"
                            Maximum="{Binding MaxZoom, Source={x:Reference Camera}}"
                            Value="{Binding Zoom, Source={x:Reference Camera}, Mode=TwoWay}" />
                </HorizontalStackLayout>

                <!-- Quick-access look strip, like a real camera app. Each chip sets either CameraView.Filter
                     (the colour grades) or adds a CameraEffects.* spatial effect — the Options sheet still
                     exposes both as separate pickers, which is what shows they are distinct APIs. -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Looks}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Button Text="{Binding Name}"
                                        FontSize="12"
                                        Padding="12,4"
                                        MinimumHeightRequest="34"
                                        HeightRequest="34"
                                        Command="{Binding SelectLookCommand, Source={x:Reference Page}}"
                                        CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- arms every enabled analyzer for one scan; nothing is delivered until this is tapped -->
                <Button Text="Scan" Clicked="OnScanClicked" />

                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                    <Button Grid.Column="0" Text="Options" Clicked="OnOptionsClicked" />
                    <Button Grid.Column="1" Text="Flip" Clicked="OnFlipClicked" />
                    <Button Grid.Column="2" Text="Photo" Clicked="OnCaptureClicked" />
                    <Button Grid.Column="3" x:Name="RecordButton" Text="Record" Clicked="OnRecordClicked" />
                    <Button Grid.Column="4" Text="Torch" Clicked="OnTorchClicked" />
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </shiny:ShinyContentPage.PageContent>

    <shiny:ShinyContentPage.Panels>
        <!-- bottom-sheet of all the detector + camera options -->
        <shiny:FloatingPanel x:Name="OptionsPanel"
                             IsOpen="False"
                             HasBackdrop="True"
                             CloseOnBackdropTap="True"
                             HandleColor="Gray"
                             PanelCornerRadius="20"
                             IsContentScrollEnabled="False"
                             PanelBackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1E}">
            <!-- TableView scrolls itself, so disable the panel's outer ScrollView (nested scrolls collapse the table) -->
            <shiny:TableView>
                <shiny:TableRoot>
                    <shiny:TableSection Title="Detector">
                        <!-- one analyzer at a time — picking swaps Camera.Analyzer -->
                        <shiny:TextPickerCell x:Name="DetectorPicker"
                                              Title="Detector"
                                              PickerTitle="Detector"
                                              ItemsSource="{Binding Detectors}"
                                              SelectedItem="{Binding SelectedDetector, Mode=TwoWay}" />
                    </shiny:TableSection>

                    <shiny:TableSection Title="Camera">
                        <shiny:SwitchCell x:Name="BoxesSwitch"
                                          Title="Detection boxes"
                                          Description="Draw bounding boxes for detections"
                                          On="True" />
                        <shiny:SwitchCell x:Name="ScanAreaSwitch"
                                          Title="Restrict scan area"
                                          Description="Barcode only — scan a center band and frame it with a viewfinder reticle" />
                        <shiny:SwitchCell x:Name="ContinuousSwitch"
                                          Title="Keep scanning"
                                          Description="Barcode / motion / face stay armed after each result (tap Scan once); off = one result per Scan" />
                        <shiny:SwitchCell x:Name="CaptureStopSwitch"
                                          Title="Capture &amp; stop on detect"
                                          Description="Grab a still and freeze the preview when a document is recognized (tap the thumbnail to resume)" />
                        <shiny:SwitchCell x:Name="OverlayVideoSwitch"
                                          Title="Burn overlay into video"
                                          Description="Composite a live timestamp + watermark into the recorded file (not just the preview)" />
                        <!-- needs the Face detector selected above: the mask follows the analyzer's landmarks -->
                        <shiny:SwitchCell x:Name="FaceMaskSwitch"
                                          Title="Face mask"
                                          Description="Draw shades + a moustache pinned to every tracked face (select the Face detector first)" />
                        <shiny:SwitchCell x:Name="AiStylizeSwitch"
                                          Title="AI stylize on capture"
                                          Description="Run the captured still through an image model (offline stand-in here — adds seconds to a capture)" />
                        <!-- The display path only. Turn it off mid-recording and the file keeps being written,
                             overlay and all — it is IsActive that owns the session, and that would end the take. -->
                        <shiny:SwitchCell Title="Show preview"
                                          Description="Off takes the live picture off screen — the session, the analyzer and any recording carry on"
                                          On="{Binding ShowPreview, Source={x:Reference Camera}, Mode=TwoWay}" />
                        <!-- the gesture writes Zoom, so the slider above tracks it live and both stay inside MinZoom..MaxZoom -->
                        <shiny:SwitchCell Title="Pinch to zoom"
                                          Description="Two-finger pinch on the preview drives Zoom (clamped to the device's reported range)"
                                          On="{Binding IsPinchToZoomEnabled, Source={x:Reference Camera}, Mode=TwoWay}" />
                        <shiny:TextPickerCell Title="Filter"
                                              PickerTitle="Filter"
                                              ItemsSource="{Binding Filters}"
                                              SelectedItem="{Binding Filter, Source={x:Reference Camera}, Mode=TwoWay}" />
                        <!-- spatial effects: these see a pixel's neighbours, so a colour matrix can't express
                             them. They stack on top of Filter, which always applies first. -->
                        <shiny:TextPickerCell Title="Effect"
                                              PickerTitle="Spatial effect"
                                              ItemsSource="{Binding SpatialEffects}"
                                              SelectedItem="{Binding SelectedEffect, Mode=TwoWay}" />
                        <shiny:TextPickerCell Title="Lens"
                                              PickerTitle="Camera"
                                              ItemsSource="{Binding Cameras}"
                                              DisplayMember="Name"
                                              SelectedItem="{Binding SelectedCamera, Mode=TwoWay}" />
                    </shiny:TableSection>

                    <!-- Capture settings, not per-recording ones: both AVFoundation and CameraX fix these when
                         the session is configured, so changing one here reconfigures the running camera. -->
                    <shiny:TableSection Title="Video">
                        <shiny:TextPickerCell Title="Quality"
                                              PickerTitle="Video quality"
                                              ItemsSource="{Binding VideoQualities}"
                                              SelectedItem="{Binding VideoQuality, Source={x:Reference Camera}, Mode=TwoWay}" />
                        <shiny:TextPickerCell Title="Frame rate"
                                              PickerTitle="Frame rate (0 = platform default)"
                                              ItemsSource="{Binding FrameRates}"
                                              SelectedItem="{Binding SelectedFrameRate, Mode=TwoWay}" />
                        <!-- Covers the preview, stills, video and analyzer frames alike — rotate the device
                             on Device, then pin a landscape value and rotate again to see it hold. -->
                        <shiny:TextPickerCell Title="Orientation"
                                              PickerTitle="Capture orientation"
                                              ItemsSource="{Binding Orientations}"
                                              SelectedItem="{Binding Orientation, Source={x:Reference Camera}, Mode=TwoWay}" />
                    </shiny:TableSection>

                    <shiny:TableSection Title="Session">
                        <shiny:CommandCell Title="Scanned documents"
                                           ValueText="{Binding ScannedSummary}"
                                           Command="{Binding ViewSessionCommand}" />
                    </shiny:TableSection>
                </shiny:TableRoot>
            </shiny:TableView>
        </shiny:FloatingPanel>
    </shiny:ShinyContentPage.Panels>
</shiny:ShinyContentPage>
