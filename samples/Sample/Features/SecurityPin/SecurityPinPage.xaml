<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Sample.Features.SecurityPin"
             xmlns:shiny="http://shiny.net/maui/controls"
             x:Class="Sample.Features.SecurityPin.SecurityPinPage"
             x:DataType="local:SecurityPinViewModel"
             Title="Security Pin"
             AutomationId="SecurityPinPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="30">

            <Label Text="SecurityPin Demo"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

            <Label AutomationId="PinStatusLabel" Text="{Binding StatusMessage}"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalTextAlignment="Center" />

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Switch IsToggled="{Binding IsSecurityBeepEnabled}"
                        VerticalOptions="Center" />
                <Label Text="Sound Effects"
                       VerticalOptions="Center"
                       FontSize="14" />
            </HorizontalStackLayout>

            <Label Text="Sound effects are powered by a custom IFeedbackService using Plugin.Maui.Audio (IAudioManager). A click plays on each digit and a success tone plays on completion."
                   FontSize="11"
                   TextColor="Gray"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />

            <!-- Hidden PIN (masked) -->
            <VerticalStackLayout Spacing="8">
                <Label Text="4-digit masked PIN (HideCharacter='*')"
                       FontAttributes="Bold" />
                <shiny:SecurityPin x:Name="HiddenPinControl" AutomationId="HiddenPin"
                                   Length="4"
                                   HideCharacter="*"
                                   Value="{Binding HiddenPin}"
                                   Keyboard="Numeric"
                                   Completed="OnHiddenPinCompleted" />
                <Label AutomationId="HiddenPinValueLabel" Text="{Binding HiddenPin, StringFormat='Current value: {0}'}"
                       FontSize="12"
                       TextColor="Gray"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Visible PIN -->
            <VerticalStackLayout Spacing="8">
                <Label Text="6-digit visible PIN (no HideCharacter)"
                       FontAttributes="Bold" />
                <shiny:SecurityPin x:Name="VisiblePinControl" AutomationId="VisiblePin"
                                   Length="6"
                                   Value="{Binding VisiblePin}"
                                   Keyboard="Numeric"
                                   CellSize="42"
                                   FontSize="20"
                                   Completed="OnVisiblePinCompleted" />
            </VerticalStackLayout>

            <!-- Styled alpha PIN -->
            <VerticalStackLayout Spacing="8">
                <Label Text="5-character alphanumeric PIN (custom styling)"
                       FontAttributes="Bold" />
                <shiny:SecurityPin x:Name="AlphaPinControl"
                                   Length="5"
                                   Value="{Binding AlphaPin}"
                                   Keyboard="Default"
                                   HideCharacter="●"
                                   CellSize="48"
                                   CellSpacing="10"
                                   CellCornerRadius="12"
                                   CellBorderColor="LightGray"
                                   CellFocusedBorderColor="DodgerBlue"
                                   CellBackgroundColor="#F5F5F5"
                                   CellFocusedBackgroundColor="#E0EDFF"
                                   CellTextColor="Black"
                                   FontSize="22"
                                   Completed="OnAlphaPinCompleted" />
            </VerticalStackLayout>

            <!-- Current-cell highlight -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Current-cell highlight (dashed cells, thick solid focus)"
                       FontAttributes="Bold" />
                <shiny:SecurityPin AutomationId="HighlightPin"
                                   Length="4"
                                   Value="{Binding HighlightPin}"
                                   CellBorderStyle="Dashed"
                                   CellFocusedBorderStyle="Solid"
                                   CellFocusedBorderThickness="3"
                                   CellFocusedBorderColor="DarkOrange"
                                   CellFocusedBackgroundColor="#FFF3E0"
                                   CellFocusedTextColor="DarkOrange" />
            </VerticalStackLayout>

            <Button AutomationId="ClearPinsButton" Text="Clear All"
                    Command="{Binding ClearCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
