            <FontImageSource Glyph="&#x25BE;" Size="20"
                             Color="{AppThemeBinding Light=#D97706, Dark=#FBBF24}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate tv:PickerDemoPage}" Route="picker" />
    </FlyoutItem>

    <FlyoutItem Title="Styling">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x2726;" Size="20"
                             Color="{AppThemeBinding Light=#D97706, Dark=#FBBF24}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate tv:StylingPage}" Route="styling" />
    </FlyoutItem>

    <!-- ============================================================ -->
    <!--  PANELS &amp; OVERLAYS -->
    <!-- ============================================================ -->
    <MenuItem Text="PANELS &amp; OVERLAYS"
              StyleClass="SectionHeader"
              IsEnabled="False">
        <MenuItem.IconImageSource>
            <FontImageSource Glyph=" " Size="1" Color="Transparent" />
        </MenuItem.IconImageSource>
    </MenuItem>

    <FlyoutItem Title="Flyout">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x25E7;" Size="20"
