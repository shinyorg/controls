                  xmlns:autocomplete="clr-namespace:Sample.Features.AutoComplete"
                  xmlns:countryaddress="clr-namespace:Sample.Features.CountryAddress"
                  xmlns:sigpad="clr-namespace:Sample.Features.SignaturePad"
                  xmlns:pickers="clr-namespace:Sample.Features.Pickers"
                  xmlns:glass="clr-namespace:Sample.Features.FrostedGlass"
                  xmlns:toast="clr-namespace:Sample.Features.Toast"
                  xmlns:dialogs="clr-namespace:Sample.Features.Dialogs"
                  xmlns:datagrid="clr-namespace:Sample.Features.DataGrid"
                  xmlns:office="clr-namespace:Sample.Features.Office"
                  xmlns:feedback="clr-namespace:Sample.Features.Feedback"
                  xmlns:textentry="clr-namespace:Sample.Features.TextEntry"
                  xmlns:overlay="clr-namespace:Sample.Features.Overlay"
                  xmlns:skeleton="clr-namespace:Sample.Features.Skeleton"
                  xmlns:wizard="clr-namespace:Sample.Features.Wizard"
                  xmlns:walkthrough="clr-namespace:Sample.Features.Walkthrough"
                  xmlns:keyframe="clr-namespace:Sample.Features.Keyframe"
                  xmlns:motionicons="clr-namespace:Sample.Features.MotionIcons"
                  xmlns:badge="clr-namespace:Sample.Features.Badge"
                  xmlns:trayicon="clr-namespace:Sample.Features.TrayIcon"
                  xmlns:filedrop="clr-namespace:Sample.Features.FileDrop"
                  xmlns:quickentry="clr-namespace:Sample.Features.QuickEntry"
                  xmlns:osk="clr-namespace:Sample.Features.OnScreenKeyboard"
                  xmlns:progressbar="clr-namespace:Sample.Features.ProgressBar"
                  xmlns:progressline="clr-namespace:Sample.Features.ProgressLine"
                  xmlns:slider="clr-namespace:Sample.Features.Slider"
                  xmlns:expanders="clr-namespace:Sample.Features.Expanders"
                  xmlns:carouselgallery="clr-namespace:Sample.Features.CarouselGallery"
                  xmlns:staggeredgrid="clr-namespace:Sample.Features.StaggeredGrid"
                  xmlns:virtualizedgrid="clr-namespace:Sample.Features.VirtualizedGrid"
                  xmlns:parallax="clr-namespace:Sample.Features.ParallaxCollectionView"
                  xmlns:treeview="clr-namespace:Sample.Features.TreeView"
                  xmlns:barcodes="clr-namespace:Sample.Features.Barcodes"
                  xmlns:camera="clr-namespace:Sample.Features.Camera"
                  xmlns:mediaelement="clr-namespace:Sample.Features.Media"
                  xmlns:docking="clr-namespace:Sample.Features.Docking"
                  xmlns:ribbon="clr-namespace:Sample.Features.Ribbon"
                  Title="Shiny Controls"
                  FlyoutBackgroundColor="{AppThemeBinding Light=#F5F3FF, Dark=#0F0D1A}"
                  FlyoutWidth="310"
                  Shell.BackgroundColor="{AppThemeBinding Light=#7C3AED, Dark=#2D1B69}"
                  Shell.ForegroundColor="White"
                  Shell.TitleColor="White"
                  Shell.UnselectedColor="#C4B5FD"
                  FlyoutHeaderBehavior="CollapseOnScroll">

    <!-- ============================================================ -->
    <!-- FLYOUT HEADER — Logo + gradient hero -->
    <!-- ============================================================ -->
    <Shell.FlyoutHeader>
        <Grid HeightRequest="200">
            <!-- Gradient background -->
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7C3AED" Offset="0.0" />
                        <GradientStop Color="#4F46E5" Offset="0.5" />
                        <GradientStop Color="#2563EB" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Decorative circles for depth -->
            <BoxView CornerRadius="80"
                     WidthRequest="160" HeightRequest="160"
                     Color="#FFFFFF" Opacity="0.06"
                     HorizontalOptions="End" VerticalOptions="Start"
                     Margin="0,-30,-40,0" />
            <BoxView CornerRadius="50"
                     WidthRequest="100" HeightRequest="100"
                     Color="#FFFFFF" Opacity="0.04"
                     HorizontalOptions="Start" VerticalOptions="End"
                     Margin="-20,0,0,-20" />

            <!-- Logo + text -->
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="8"
                                 Padding="24,52,24,24">
                <!-- Logo with glow shadow -->
                <Border StrokeThickness="0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        WidthRequest="72" HeightRequest="72">
                    <Border.Shadow>
                        <Shadow Brush="#8B5CF6"
                                Offset="0,4"
                                Radius="20"
                                Opacity="0.6" />
                    </Border.Shadow>
                    <Image Source="shiny_logo.png"
                           HeightRequest="72"
                           WidthRequest="72" />
                </Border>

                <Label Text="Shiny Controls"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center">
                    <Label.Shadow>
                        <Shadow Brush="#000000"
                                Offset="0,2"
                                Radius="8"
                                Opacity="0.3" />
                    </Label.Shadow>
                </Label>

                <Border BackgroundColor="#FFFFFF"
                        Opacity="0.2"
                        StrokeThickness="0"
                        HeightRequest="2"
                        WidthRequest="60"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="1" />
                    </Border.StrokeShape>
                </Border>

                <Label Text="MAUI &amp; Blazor Component Gallery"
                       FontSize="11"
                       TextColor="#DDD6FE"
                       HorizontalTextAlignment="Center"
                       CharacterSpacing="0.5" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- ============================================================ -->
    <!-- ITEM TEMPLATE — Icon + Title with accent styling -->
    <!-- ============================================================ -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid Padding="8,2" HeightRequest="42">
                <Border Padding="10,6"
                        StrokeThickness="0"
                        BackgroundColor="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                        <Image Source="{Binding FlyoutIcon}"
                               HeightRequest="18" WidthRequest="18"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding Title}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#1E1B4B, Dark=#E0E7FF}"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <!-- ============================================================ -->
    <!-- SECTION HEADER TEMPLATE — Category labels -->
    <!-- ============================================================ -->
    <Shell.MenuItemTemplate>
        <DataTemplate>
            <Grid Padding="20,14,20,4" HeightRequest="36">
                <Label Text="{Binding Text}"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#7C3AED, Dark=#6D28D9}"
                       VerticalTextAlignment="End"
                       CharacterSpacing="1.5" />
            </Grid>
        </DataTemplate>
    </Shell.MenuItemTemplate>

    <!-- ============================================================ -->
    <!-- FLYOUT FOOTER — Branding -->
    <!-- ============================================================ -->
    <Shell.FlyoutFooter>
        <Grid Padding="16,8,16,12" RowDefinitions="Auto,Auto,Auto" RowSpacing="4"
              BackgroundColor="{AppThemeBinding Light=#F5F3FF, Dark=#0F0D1A}">
            <!-- Accent line -->
            <BoxView HeightRequest="1" Margin="20,0,20,2">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="Transparent" Offset="0.0" />
                        <GradientStop Color="{AppThemeBinding Light=#7C3AED, Dark=#6D28D9}" Offset="0.5" />
                        <GradientStop Color="Transparent" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Global theme switcher (Shiny theme packs) -->
            <VerticalStackLayout Grid.Row="1" Spacing="6" Margin="0,2,0,6">
                <Label Text="THEME"
                       FontSize="10"
                       FontAttributes="Bold"
                       CharacterSpacing="1"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" />
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Button x:Name="basicThemeButton" Text="Basic" FontSize="11" Padding="10,4" HeightRequest="32" Clicked="OnBasicTheme" AutomationId="theme-basic" />
                    <Button x:Name="oceanThemeButton" Text="Ocean" FontSize="11" Padding="10,4" HeightRequest="32" Clicked="OnOceanTheme" AutomationId="theme-ocean" />
                    <Button x:Name="materialThemeButton" Text="Material" FontSize="11" Padding="10,4" HeightRequest="32" Clicked="OnMaterialTheme" AutomationId="theme-material" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Button x:Name="terminalThemeButton" Text="Terminal" FontSize="11" Padding="10,4" HeightRequest="32" Clicked="OnTerminalTheme" AutomationId="theme-terminal" />
                    <Button x:Name="auroraThemeButton" Text="Aurora" FontSize="11" Padding="10,4" HeightRequest="32" Clicked="OnAuroraTheme" AutomationId="theme-aurora" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="Dark mode"
                           VerticalOptions="Center"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                    <Switch x:Name="darkSwitch" AutomationId="DarkModeSwitch" Toggled="OnDarkToggled" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Tappable badge — opens shinylib.net -->
            <Border x:Name="footerBadge"
                    Grid.Row="2"
                    BackgroundColor="{AppThemeBinding Light=#EDE9FE, Dark=#1E1B4B}"
                    StrokeThickness="0"
                    Padding="12,6"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFooterTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="shinylib.net"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A78BFA}"
                           VerticalTextAlignment="Center"
                           TextDecorations="Underline" />
                    <BoxView WidthRequest="3" HeightRequest="3" CornerRadius="2"
                             Color="{AppThemeBinding Light=#6D28D9, Dark=#A78BFA}"
                             VerticalOptions="Center" />
                    <Label Text=".NET MAUI &amp; Blazor"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#7C3AED, Dark=#8B5CF6}"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Shell.FlyoutFooter>

    <!-- ============================================================ -->
    <!--  GET STARTED -->
    <!-- ============================================================ -->
    <MenuItem Text="GET STARTED"
              StyleClass="SectionHeader"
              IsEnabled="False">
        <MenuItem.IconImageSource>
            <FontImageSource Glyph=" " Size="1" Color="Transparent" />
        </MenuItem.IconImageSource>
    </MenuItem>

    <FlyoutItem Title="Home">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x2302;" Size="20"
                             Color="{AppThemeBinding Light=#7C3AED, Dark=#A78BFA}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate home:HomePage}" Route="home" />
    </FlyoutItem>

    <FlyoutItem Title="Kitchen Sink">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x2699;" Size="20"
                             Color="{AppThemeBinding Light=#7C3AED, Dark=#A78BFA}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate kitchensink:KitchenSinkPage}" Route="kitchensinkchat" />
    </FlyoutItem>

    <!-- ============================================================ -->
    <!--  LAYOUT &amp; COLLECTIONS -->
    <!-- ============================================================ -->
    <MenuItem Text="LAYOUT &amp; COLLECTIONS"
              StyleClass="SectionHeader"
              IsEnabled="False">
        <MenuItem.IconImageSource>
            <FontImageSource Glyph=" " Size="1" Color="Transparent" />
        </MenuItem.IconImageSource>
    </MenuItem>

    <FlyoutItem Title="Expander">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x25BE;" Size="20"
                             Color="{AppThemeBinding Light=#0284C7, Dark=#60A5FA}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate expanders:ExpanderPage}" Route="expander" />
    </FlyoutItem>

    <FlyoutItem Title="Carousel Gallery">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x25C0;" Size="20"
                             Color="{AppThemeBinding Light=#0284C7, Dark=#60A5FA}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate carouselgallery:CarouselGalleryPage}" Route="carouselgallery" />
    </FlyoutItem>

    <FlyoutItem Title="Staggered Grid">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x25A6;" Size="20"
                             Color="{AppThemeBinding Light=#0284C7, Dark=#60A5FA}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate staggeredgrid:StaggeredGridPage}" Route="staggeredgrid" />
    </FlyoutItem>

    <FlyoutItem Title="Virtualized Grid">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x25A3;" Size="20"
                             Color="{AppThemeBinding Light=#0284C7, Dark=#60A5FA}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate virtualizedgrid:VirtualizedGridPage}" Route="virtualizedgrid" />
    </FlyoutItem>

    <FlyoutItem Title="Parallax Collection">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x25B0;" Size="20"
                             Color="{AppThemeBinding Light=#0284C7, Dark=#60A5FA}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate parallax:ParallaxCollectionViewPage}" Route="parallaxcollectionview" />
    </FlyoutItem>

    <FlyoutItem Title="Tree View">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x2387;" Size="20"
                             Color="{AppThemeBinding Light=#0284C7, Dark=#60A5FA}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate treeview:TreeViewPage}" Route="treeview" />
    </FlyoutItem>

    <FlyoutItem Title="Data Grid">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x25A6;" Size="20"
                             Color="{AppThemeBinding Light=#0284C7, Dark=#60A5FA}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent Title="Grid" ContentTemplate="{DataTemplate datagrid:DataGridPage}" Route="datagrid" />
        <ShellContent Title="Tree" ContentTemplate="{DataTemplate datagrid:TreeDataGridPage}" Route="treedatagrid" />
        <ShellContent Title="Formatting" ContentTemplate="{DataTemplate datagrid:DataGridFormattingPage}" Route="datagridformatting" />
        <ShellContent Title="Grouping" ContentTemplate="{DataTemplate datagrid:DataGridGroupingPage}" Route="datagridgrouping" />
    </FlyoutItem>

    <!-- The Office pages used to hang off the Data Grid item, which put nine tabs in one bar: only
         four fit, so every one of these lived behind the "More" overflow and "Slide Editor" was filed
         under "Data Grid". They get their own item, matching the Blazor gallery's Office section. -->
    <FlyoutItem Title="Docking">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x25A8;" Size="20"
                             Color="{AppThemeBinding Light=#0284C7, Dark=#60A5FA}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate docking:DockingPage}" Route="docking" />
    </FlyoutItem>

    <FlyoutItem Title="Ribbon">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x2637;" Size="20"
                             Color="{AppThemeBinding Light=#0284C7, Dark=#60A5FA}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate ribbon:RibbonPage}" Route="ribbon" />
    </FlyoutItem>

    <!--  OFFICE DOCUMENTS -->
    <MenuItem Text="OFFICE DOCUMENTS"
              StyleClass="SectionHeader"
              IsEnabled="False">
        <MenuItem.IconImageSource>
            <FontImageSource Glyph=" " Size="1" Color="Transparent" />
        </MenuItem.IconImageSource>
    </MenuItem>

    <!-- One flyout entry per Office control, rather than one "Office" item with five tabs. These are
         five separate controls, not five views of one - a viewer and an editor per format, plus the
         spreadsheet - and the Blazor gallery lists them the same way, under this same heading. -->
    <FlyoutItem Title="Spreadsheet">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x1F4CA;" Size="20"
                             Color="{AppThemeBinding Light=#0284C7, Dark=#60A5FA}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate office:SpreadsheetPage}" Route="spreadsheet" />
    </FlyoutItem>

    <FlyoutItem Title="Document Viewer">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x1F4C4;" Size="20"
                             Color="{AppThemeBinding Light=#0284C7, Dark=#60A5FA}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate office:DocumentViewerPage}" Route="documentviewer" />
    </FlyoutItem>

    <FlyoutItem Title="Document Editor">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x1F4DD;" Size="20"
                             Color="{AppThemeBinding Light=#0284C7, Dark=#60A5FA}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate office:DocumentEditorPage}" Route="documenteditor" />
    </FlyoutItem>

    <FlyoutItem Title="Slide Viewer">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x1F4FD;" Size="20"
                             Color="{AppThemeBinding Light=#0284C7, Dark=#60A5FA}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate office:SlideViewerPage}" Route="slideviewer" />
    </FlyoutItem>

    <FlyoutItem Title="Slide Editor">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x2728;" Size="20"
                             Color="{AppThemeBinding Light=#0284C7, Dark=#60A5FA}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate office:SlideEditorPage}" Route="slideeditor" />
    </FlyoutItem>

    <FlyoutItem Title="Notebook">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x1F4D3;" Size="20"
                             Color="{AppThemeBinding Light=#0284C7, Dark=#60A5FA}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate office:NotebookEditorPage}" Route="notebook" />
    </FlyoutItem>

    <!-- ============================================================ -->
    <!--  TABLE VIEW -->
    <!-- ============================================================ -->
    <MenuItem Text="TABLE VIEW"
              StyleClass="SectionHeader"
              IsEnabled="False">
        <MenuItem.IconImageSource>
            <FontImageSource Glyph=" " Size="1" Color="Transparent" />
        </MenuItem.IconImageSource>
    </MenuItem>

    <FlyoutItem Title="Basic">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x2630;" Size="20"
                             Color="{AppThemeBinding Light=#D97706, Dark=#FBBF24}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate tv:BasicSettingsPage}" Route="basic" />
    </FlyoutItem>

    <FlyoutItem Title="Dynamic">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x2637;" Size="20"
                             Color="{AppThemeBinding Light=#D97706, Dark=#FBBF24}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate tv:DynamicSectionsPage}" Route="dynamic" />
