            <FontImageSource Glyph="&#x25E8;" Size="20"
                             Color="{AppThemeBinding Light=#0891B2, Dark=#22D3EE}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate flyout:FlyoutDrawerPage}" Route="flyoutdrawer" />
    </FlyoutItem>

    <FlyoutItem Title="Tabbed Page">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x25A4;" Size="20"
                             Color="{AppThemeBinding Light=#0891B2, Dark=#22D3EE}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate tabs:TabsDemoPage}" Route="tabbedpage" />
    </FlyoutItem>

    <FlyoutItem Title="Navigation Page">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x25A2;" Size="20"
                             Color="{AppThemeBinding Light=#0891B2, Dark=#22D3EE}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate navpage:NavigationDemoPage}" Route="navigationpage" />
    </FlyoutItem>

    <FlyoutItem Title="Floating Panel">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x25A3;" Size="20"
                             Color="{AppThemeBinding Light=#0891B2, Dark=#22D3EE}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate fp:SheetPage}" Route="sheet" />
    </FlyoutItem>

    <FlyoutItem Title="Header Peek">
        <FlyoutItem.FlyoutIcon>
            <FontImageSource Glyph="&#x25A5;" Size="20"
                             Color="{AppThemeBinding Light=#0891B2, Dark=#22D3EE}" />
        </FlyoutItem.FlyoutIcon>
        <ShellContent ContentTemplate="{DataTemplate fp:MinimizedSheetStandalonePage}" Route="minimizedsheetstandalone" />
