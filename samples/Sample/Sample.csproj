<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(BaseTargetFramework)-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);$(BaseTargetFramework)-ios;$(BaseTargetFramework)-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);$(BaseTargetFramework)-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>Sample</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<ShinyMauiShell_GenerateNavExtensions>true</ShinyMauiShell_GenerateNavExtensions>
		<!-- MEAI001: Microsoft.Extensions.AI's IImageGenerator (used by the AI stylize demo) is still marked
		     evaluation-only. Any app consuming AiPhotoStylizer needs this same suppression. -->
		<NoWarn>$(NoWarn);MEAI001</NoWarn>

		<ApplicationTitle>Shiny Controls</ApplicationTitle>
		<ApplicationId>org.shiny.controlsample</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#7C3AED" />
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#7C3AED" BaseSize="128,128" />

		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiAsset Include="..\..\README.md" LogicalName="README.md" />

		<!-- Shows ShinyImage's resource:// scheme against a real embedded resource. The explicit
		     LogicalName is what the URI names, so the sample does not depend on how MSBuild would
		     otherwise derive it from the folder. -->
		<EmbeddedResource Include="Assets\embedded-icon.svg" LogicalName="Sample.Assets.embedded-icon.svg" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm"/>
		<PackageReference Include="Microsoft.Maui.Controls"/>
		<PackageReference Include="Plugin.Maui.Audio" />
		<PackageReference Include="Shiny.Maui.Shell"/>
		<PackageReference Include="Shiny.Speech" />
    </ItemGroup>
    
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Microsoft.Extensions.Logging.Debug"/>
        <PackageReference Include="Microsoft.Maui.DevFlow.Agent"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.SpeechAddins\Shiny.Maui.Controls.SpeechAddins.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls\Shiny.Maui.Controls.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.Themes.Ocean\Shiny.Maui.Controls.Themes.Ocean.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.Themes.Material\Shiny.Maui.Controls.Themes.Material.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.Themes.Terminal\Shiny.Maui.Controls.Themes.Terminal.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.Themes.Aurora\Shiny.Maui.Controls.Themes.Aurora.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.Desktop\Shiny.Maui.Controls.Desktop.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.Markdown\Shiny.Maui.Controls.Markdown.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.MermaidDiagrams\Shiny.Maui.Controls.MermaidDiagrams.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.Barcodes\Shiny.Maui.Controls.Barcodes.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.Keyframe\Shiny.Maui.Controls.Keyframe.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.Camera\Shiny.Maui.Controls.Camera.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.Camera.Motion\Shiny.Maui.Controls.Camera.Motion.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.Camera.Barcode\Shiny.Maui.Controls.Camera.Barcode.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.Camera.Face\Shiny.Maui.Controls.Camera.Face.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.Camera.Ocr\Shiny.Maui.Controls.Camera.Ocr.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.Camera.Documents\Shiny.Maui.Controls.Camera.Documents.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.Camera.Ai\Shiny.Maui.Controls.Camera.Ai.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.MediaElement\Shiny.Maui.Controls.MediaElement.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.Office\Shiny.Maui.Controls.Office.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.FloorPlan\Shiny.Maui.Controls.FloorPlan.csproj" />
		<ProjectReference Include="..\..\src\Shiny.Maui.Controls.Diagram\Shiny.Maui.Controls.Diagram.csproj" />
	</ItemGroup>
	<!-- The gallery renders its own source under each demo page. -->
	<Import Project="Sample.Source.targets" />

</Project>
