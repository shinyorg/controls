<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <NoWarn>$(NoWarn);NU1507</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="Shouldly"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The generator as a plain assembly, so the tests drive it in memory, and the engine whose
             attributes the test sources use. -->
        <ProjectReference Include="..\..\src\Shiny.Controls.AgentUI.SourceGenerators\Shiny.Controls.AgentUI.SourceGenerators.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Controls.AgentUI.Shared\Shiny.Controls.AgentUI.Shared.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
        <Using Include="Shouldly"/>
    </ItemGroup>
</Project>
