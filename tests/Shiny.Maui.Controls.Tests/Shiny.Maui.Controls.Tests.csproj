<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <UseMaui>true</UseMaui>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="Shouldly"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls\Shiny.Maui.Controls.csproj"/>

        <!-- For the composite Office views: they are the ones assembled in a constructor, which is
             where a field read before it is built goes unnoticed until the control is put on a page. -->
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Office\Shiny.Maui.Controls.Office.csproj"/>

        <!-- The theme packs, so ThemeContrastTests asserts about every theme that ships rather than
             only the built-in one. They are content-only (a generated dictionary each), so this costs
             the test run nothing. -->
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Themes.Aurora\Shiny.Maui.Controls.Themes.Aurora.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Themes.Material\Shiny.Maui.Controls.Themes.Material.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Themes.Ocean\Shiny.Maui.Controls.Themes.Ocean.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.Maui.Controls.Themes.Terminal\Shiny.Maui.Controls.Themes.Terminal.csproj"/>
    </ItemGroup>
</Project>
