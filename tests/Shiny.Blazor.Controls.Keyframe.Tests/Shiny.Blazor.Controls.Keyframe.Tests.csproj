<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- The state and transition tests build VisualTransition / PropertyTransition instances
             directly to test the matching logic without a renderer; BL0005 warns against setting
             parameters outside a component, which is the point here and nowhere else. -->
        <NoWarn>$(NoWarn);BL0005;NU1507</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="Shouldly"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
        <Using Include="Shouldly"/>
        <Using Include="Shiny.Controls.Keyframe"/>
        <Using Include="Shiny.Blazor.Controls.Keyframe"/>
        <Using Include="Shiny.Blazor.Controls.Keyframe.Compilation"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.Blazor.Controls.Keyframe\Shiny.Blazor.Controls.Keyframe.csproj"/>
    </ItemGroup>

</Project>
