                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-success-foreground"
                        },
                        "info": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
