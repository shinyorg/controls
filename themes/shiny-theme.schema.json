                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-muted-foreground"
                        },
                        "primary": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-primary"
                        },
                        "primary-foreground": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-primary-foreground"
                        },
                        "secondary": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-secondary"
                        },
                        "secondary-foreground": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-secondary-foreground"
                        },
                        "accent": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-accent"
                        },
                        "accent-foreground": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-accent-foreground"
                        },
                        "destructive": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
