{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://shinylib.net/controls/shiny-theme.schema.json",
    "title": "Shiny Controls Theme",
    "description": "Canonical definition of a Shiny Controls theme. A theme is described by a set of seed colors plus optional 'personality' blocks \u2014 shape, typography, elevation, density, border and state. The generator (tools/ShinyThemeGen) derives the full Material-3 tonal role set (light + dark) and the complete token contract from them. Every block except 'seeds' is optional; omitting one keeps the shared defaults, so a theme only states the axes it wants to differ on. This same file format drives the docs-site theme creator.",
    "type": "object",
    "required": [
        "name",
        "slug",
        "seeds"
    ],
    "additionalProperties": false,
    "properties": {
        "name": {
            "type": "string",
            "description": "Display name, e.g. 'Ocean'. Used for the generated theme class name (OceanTheme)."
        },
        "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Lowercase identifier used in file names and CSS, e.g. 'ocean' -> shiny-theme-ocean.css."
        },
        "description": {
            "type": "string"
        },
        "seeds": {
            "type": "object",
            "description": "Source colors. Each is expanded into a tonal palette; M3 roles are mapped from the tones for both light and dark schemes.",
            "required": [
                "primary",
                "secondary",
                "tertiary",
                "neutral",
                "neutralVariant",
                "error",
                "success",
                "info",
                "warning",
                "caution",
                "critical"
            ],
            "additionalProperties": false,
            "properties": {
                "primary": {
                    "$ref": "#/$defs/hex"
                },
                "secondary": {
                    "$ref": "#/$defs/hex"
                },
                "tertiary": {
                    "$ref": "#/$defs/hex"
                },
                "neutral": {
                    "$ref": "#/$defs/hex"
                },
                "neutralVariant": {
                    "$ref": "#/$defs/hex"
                },
                "error": {
                    "$ref": "#/$defs/hex"
                },
                "success": {
                    "$ref": "#/$defs/hex"
                },
                "info": {
                    "$ref": "#/$defs/hex"
                },
                "warning": {
                    "$ref": "#/$defs/hex"
                },
                "caution": {
                    "$ref": "#/$defs/hex"
                },
                "critical": {
                    "$ref": "#/$defs/hex"
                }
            }
        },
        "tokens": {
            "type": "object",
            "description": "The authoring layer - the small set a human edits. The 55 colour roles every control consumes are derived from these, so stating `primary` here moves the primary container, the surface tint and the focus ring with it. Omit the block entirely and every token is derived from `seeds`.",
            "additionalProperties": false,
            "properties": {
                "light": {
                    "type": "object",
                    "description": "Authoring token values for one scheme. Anything stated here wins over the value derived from the seeds; anything omitted keeps the derived one.",
                    "additionalProperties": false,
                    "properties": {
                        "background": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-background"
                        },
                        "foreground": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-foreground"
                        },
                        "card": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-card"
                        },
                        "popover": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-popover"
                        },
                        "muted": {
