                        },
                        "info-foreground": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-info-foreground"
                        },
                        "warning": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-warning"
                        },
                        "warning-foreground": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-warning-foreground"
                        },
                        "caution": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-caution"
                        },
                        "caution-foreground": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-caution-foreground"
                        },
                        "critical": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-critical"
                        },
                        "critical-foreground": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-critical-foreground"
                        },
                        "border": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-border"
                        },
                        "input": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-input"
                        },
                        "ring": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-ring"
                        },
                        "shadow-color": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-shadow-color"
                        }
                    }
                },
                "dark": {
                    "type": "object",
                    "description": "Authoring token values for one scheme. Anything stated here wins over the value derived from the seeds; anything omitted keeps the derived one.",
                    "additionalProperties": false,
                    "properties": {
                        "background": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-background"
                        },
                        "foreground": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-foreground"
                        },
                        "card": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-card"
                        },
                        "popover": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-popover"
                        },
                        "muted": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-muted"
                        },
                        "muted-foreground": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-muted-foreground"
                        },
                        "primary": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-primary"
                        },
                        "primary-foreground": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
