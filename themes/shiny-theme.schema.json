                        },
                        "info-foreground": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-info-foreground"
                        },
                        "warning": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-warning"
                        },
                        "warning-foreground": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-warning-foreground"
                        },
                        "caution": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-caution"
                        },
                        "caution-foreground": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
                            "description": "--shiny-caution-foreground"
                        },
                        "critical": {
                            "type": "string",
                            "pattern": "^#([0-9a-fA-F]{6})$",
